<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kalender Akademik - BAA</title>
  <link rel="stylesheet" href="/assets/landing-page/css/main.css">
  <link rel="stylesheet" href="/assets/landing-page/css/responsive.css">
  <link rel="web icon" href="/assets/landing-page/images/favicon.ico">
  <style>
    .calendar-pdf {
      width: 100%;
      height: 1200px;
      border-radius: 14px;
      box-shadow: 0 12px 40px rgba(0,0,0,0.08);
      border: 1px solid #e5e7eb;
    }
    .calendar-pdf-frame {
      max-width: 800px;
      margin: 0 auto;
    }
  </style>
</head>
<body>
  <!-- Header Section -->
  <%- include("../partials/landing-header") %>

  <!-- Sidebar Section -->
  <%- include("../partials/landing-aside") %>

  <main>
    <!-- Banner -->
    <div class="section-wrapper pb-0">
      <div class="section-banner-inner banner-inner-service">
        <div class="hero-container">
          <div class="d-flex flex-column gspace-2 text-center justify-content-center">
            <h1 class="secondary-accent">Kalender Akademik</h1>
            <nav class="breadcrumb">
              <a href="/" class="breadcrumb-item">Home</a>
              <span class="breadcrumb-icon">/</span>
              <span class="breadcrumb-item recent">Kalender Akademik</span>
            </nav>
          </div>
        </div>
      </div>
    </div>

    <!-- Content -->
    <div class="section">
      <div class="hero-container">
        <div class="d-flex flex-column gspace-4">
          <div class="service-title-container">
            <div class="row row-cols-md-2 row-cols-1 grid-spacer-2">
              <div class="col">
                <div class="d-flex flex-column gspace-2 justify-content-center text-md-start text-center">
                  <div class="sub-heading">
                    <i class="fa-solid fa-circle accent-color-2"></i>
                    <span class="sub-heading-title">Kalender Akademik</span>
                  </div>
                  <h2>Kalender per Tahun Ajaran</h2>
                  <p class="text-muted">Lihat kalender akademik terbaru lengkap dengan tanggal unggah dan pengunggah.</p>
                </div>
              </div>
              <div class="col d-flex justify-content-center justify-content-md-end align-items-center">
                <div class="badge accent-bg text-white px-3 py-2">
                  Total: <%= calendars ? calendars.length : 0 %> kalender
                </div>
              </div>
            </div>
          </div>

          <div class="row row-cols-1 grid-spacer-3">
            <% if (calendars && calendars.length) { %>
              <% calendars.forEach(function(item, idx){ %>
                <div class="col">
                  <div class="card card-service animate-box text-center" data-animate="animate__fadeInUp">
                    <div class="card-body">
                      <h3 class="mb-2 text-uppercase">Kalender Akademik Tahun Ajaran <%= item.tahunAjaran %></h3>
                      <p class="text-muted small mb-3">
                        Diunggah <%= item.createdAt ? item.createdAt.toLocaleDateString() : '-' %>
                        <% const uploader = item.createdBy ? (item.createdBy.name || item.createdBy.email) : null; %>
                        <% if (uploader) { %> oleh <%= uploader %><% } %>
                      </p>
                      <% if (item.file) { %>
                        <div class="calendar-pdf-frame mb-3">
                          <div class="pdf-thumb" data-url="<%= item.file %>"></div>
                        </div>
                        <a href="<%= item.file %>" target="_blank" class="btn btn-accent">
                          <span class="btn-title">Lihat / Unduh</span>
                          <span class="icon-circle"><i class="fa-solid fa-arrow-up-right-from-square"></i></span>
                        </a>
                      <% } else { %>
                        <div class="alert alert-warning">File kalender belum tersedia.</div>
                      <% } %>
                    </div>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <div class="col-12">
                <div class="alert alert-warning text-center">Belum ada kalender akademik.</div>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Footer Section -->
  <%- include("../partials/landing-footer") %>

  <script src="/assets/landing-page/js/vendor/jquery.min.js"></script>
  <script src="/assets/landing-page/js/vendor/bootstrap.bundle.min.js"></script>
  <script src="/assets/landing-page/js/vendor/swiper-bundle.min.js"></script>
  <script src="/assets/landing-page/js/vendor/isotope.pkgd.min.js"></script>
  <script src="/assets/landing-page/js/vendor/flatpickr.min.js"></script>
  <script src="/assets/landing-page/js/script.js"></script>
  <script src="/assets/landing-page/js/submit-form.js"></script>
  <script src="/assets/landing-page/js/swiper-script.js"></script>
</body>
</html>

