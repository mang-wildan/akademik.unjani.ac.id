<%#
  Shell panel admin v2 (docs/SPEC.md FR-ADM-01..05, docs/DESIGN.md §7.1, docs/ARCHITECTURE.md §2).
  res.renderPage(view, locals, 'layouts/admin-v2')
  Locals opsional: title, breadcrumb [{ label, href? }] (default: grup menu aktif › title),
  adminTheme / adminSidebar (middleware/adminPrefs), alertSuccess / alertError.
  Tanpa skrip atau gaya inline: halaman v2 dilayani dengan CSP ketat (middleware/strictCsp).
%>
<%
  const currentPath = locals.path || '/';
  const me = locals.user || {};
  const theme = locals.adminTheme || 'system';
  const sidebarState = locals.adminSidebar || 'open';
  const groups = adminNav
    .map(group => ({ ...group, items: group.items.filter(item => canSee(item, me)) }))
    .filter(group => group.items.length);
  const activeGroup = groups.find(group => group.items.some(item => isActive(item.href, currentPath)));
  const crumbs = locals.breadcrumb || [activeGroup && { label: activeGroup.group }, locals.title && { label: locals.title }].filter(Boolean);
  const collapsed = sidebarState === 'collapsed';
%>
<!DOCTYPE html>
<html lang="id" data-theme="<%= theme %>" data-sidebar="<%= sidebarState %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <title><%= locals.title ? `${locals.title} | Admin Bidang Akademik` : 'Admin Bidang Akademik' %></title>
  <link rel="icon" href="/img/lambang-unjani.png">
  <link rel="stylesheet" href="<%= assetUrl('/css/admin.css') %>">
  <script src="<%= assetUrl('/js/shared.js') %>" defer></script>
  <script src="<%= assetUrl('/js/admin.js') %>" defer></script>
  <script src="/js/vendor/alpine-csp.min.js" defer></script>
</head>
<body x-data="adminShell" class="min-h-dvh">
  <%# Pintasan keyboard global (DESIGN §8): N dan Ctrl/Cmd+S. %>
  <div x-data="shortcuts" x-on:keydown.window="keydown" hidden></div>
  <a class="skip-link sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-control focus:bg-surface focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:shadow-overlay" href="#konten">Langsung ke konten utama</a>

  <%# Sidebar desktop (≥1024px): 240px, diciutkan 64px. %>
  <aside id="sidebar-admin" aria-label="Navigasi admin"
         class="fixed inset-y-0 left-0 z-30 hidden w-60 flex-col border-r border-line bg-surface lg:flex lg:collapsed:w-16">
    <div class="flex h-12 shrink-0 items-center border-b border-line px-4 lg:collapsed:justify-center lg:collapsed:px-0">
      <a href="/admin/dashboard" class="flex min-w-0 items-center gap-2.5 text-ink no-underline">
        <img src="/img/lambang-unjani.png" alt="" width="24" height="24" class="size-6 shrink-0 object-contain">
        <span class="truncate text-sm font-semibold lg:collapsed:sr-only">Admin Akademik</span>
      </a>
    </div>
    <nav class="flex-1 overflow-y-auto px-2 py-3">
      <%- include('../admin/_ui/shell-nav', { groups, currentPath, collapsible: true }) %>
    </nav>
    <div class="space-y-0.5 border-t border-line p-2">
      <a href="/" title="Kembali ke situs"
         class="flex h-8 items-center gap-2.5 rounded-control px-2 text-sm font-medium text-muted no-underline hover:bg-sunken hover:text-ink lg:collapsed:justify-center lg:collapsed:px-0">
        <%- icon('arrow_back', 'size-5') %><span class="lg:collapsed:sr-only">Kembali ke situs</span>
      </a>
      <button type="button" x-on:click="toggleSidebar" aria-controls="sidebar-admin"
              aria-expanded="<%= !collapsed %>" x-bind:aria-expanded="sidebarExpanded"
              aria-label="<%= collapsed ? 'Lebarkan sidebar' : 'Ciutkan sidebar' %>" x-bind:aria-label="sidebarToggleLabel"
              class="flex h-8 w-full items-center gap-2.5 rounded-control px-2 text-sm font-medium text-muted hover:bg-sunken hover:text-ink lg:collapsed:justify-center lg:collapsed:px-0">
        <span class="lg:collapsed:hidden"><%- icon('left_panel_close', 'size-5') %></span>
        <span class="hidden lg:collapsed:inline"><%- icon('left_panel_open', 'size-5') %></span>
        <span class="lg:collapsed:sr-only" aria-hidden="true">Ciutkan</span>
      </button>
    </div>
  </aside>

  <%# Laci HP (<1024px): <dialog> native menangani Escape, batas fokus, dan pengembalian fokus. %>
  <dialog x-ref="drawer" x-on:click="drawerBackdrop" aria-label="Menu admin"
          class="m-0 h-dvh max-h-none w-70 max-w-[85vw] bg-surface p-0 text-ink backdrop:bg-black/50 lg:hidden">
    <div class="flex h-full flex-col">
      <div class="flex h-14 shrink-0 items-center justify-between gap-2 border-b border-line pl-4 pr-2">
        <span class="flex min-w-0 items-center gap-2.5">
          <img src="/img/lambang-unjani.png" alt="" width="24" height="24" class="size-6 shrink-0 object-contain">
          <span class="truncate text-sm font-semibold">Admin Akademik</span>
        </span>
        <button type="button" x-on:click="closeDrawer" aria-label="Tutup menu"
                class="inline-flex size-11 items-center justify-center rounded-control text-muted hover:bg-sunken hover:text-ink">
          <%- icon('close', 'size-6') %>
        </button>
      </div>
      <nav aria-label="Semua modul" class="flex-1 overflow-y-auto px-2 py-3">
        <%- include('../admin/_ui/shell-nav', { groups, currentPath, collapsible: false }) %>
      </nav>
      <div class="border-t border-line p-2 pb-[max(0.5rem,env(safe-area-inset-bottom))]">
        <a href="/" class="flex h-11 items-center gap-2.5 rounded-control px-2 text-sm font-medium text-muted no-underline hover:bg-sunken hover:text-ink">
          <%- icon('arrow_back', 'size-5') %>Kembali ke situs
        </a>
      </div>
    </div>
  </dialog>

  <div class="lg:pl-60 lg:collapsed:pl-16">
    <header class="sticky top-0 z-20 flex h-14 items-center gap-2 border-b border-line bg-surface px-4 lg:h-12 lg:px-6">
      <button type="button" x-on:click="openDrawer" aria-haspopup="dialog" aria-label="Buka menu"
              class="-ml-2 inline-flex size-11 shrink-0 items-center justify-center rounded-control text-muted hover:bg-sunken hover:text-ink lg:hidden">
        <%- icon('menu', 'size-6') %>
      </button>
      <nav aria-label="Breadcrumb" class="min-w-0 flex-1">
        <ol class="flex min-w-0 items-center gap-1.5 text-sm">
          <% crumbs.forEach((crumb, i) => { const last = i === crumbs.length - 1; %>
            <li class="<%= last ? 'min-w-0' : 'hidden shrink-0 items-center gap-1.5 text-muted lg:flex' %>">
              <% if (last) { %>
                <span aria-current="page" class="block truncate font-medium"><%= crumb.label %></span>
              <% } else { %>
                <% if (crumb.href) { %><a href="<%= crumb.href %>" class="text-muted no-underline hover:text-ink"><%= crumb.label %></a><% } else { %><%= crumb.label %><% } %>
                <%- icon('chevron_right', 'size-4') %>
              <% } %>
            </li>
          <% }) %>
        </ol>
      </nav>
      <%- include('../admin/_ui/module-search', { groups }) %>
      <%- include('../admin/_ui/shell-account', { me, theme }) %>
    </header>

    <% if (locals.alertSuccess || locals.alertError) { %>
      <%- include('../admin/_ui/toast', { success: locals.alertSuccess, error: locals.alertError }) %>
    <% } %>

    <main id="konten" tabindex="-1" class="px-4 pt-4 pb-24 focus:outline-none lg:px-6 lg:py-6">
      <%- body %>
    </main>
  </div>

  <%- include('../admin/_ui/shell-bottom-nav', { currentPath }) %>
</body>
</html>
