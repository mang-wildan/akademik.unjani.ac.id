<%
  const s = locals.siteSetting || {};
  const pageTitle = locals.title ? `${locals.title} | Bidang Akademik UNJANI` : 'Bidang Akademik UNJANI';
  const pageDescription = locals.description || 'Kalender akademik, kurikulum, dokumen, akreditasi, dan informasi akademik resmi Universitas Jenderal Achmad Yani.';
  const currentPath = locals.path || '/';
  const phone = s.kontakTelepon || '+62 (022) 6656190';
  const email = s.kontakEmail || 'akademik@unjani.ac.id';
  const phoneTo = phoneLink(phone); // "(Chat Only)"/WhatsApp → wa.me, selain itu tel:
  const phoneIcon = phoneTo.whatsapp ? 'brand-whatsapp' : 'call';
  const waLabel = `${phone} — chat WhatsApp (membuka tab baru)`;
  const hours = s.jamLayanan || 'Senin–Jumat, 08.00–15.30 WIB';
  const socials = [
    { label: 'Facebook', url: s.socialFacebook, icon: 'brand-facebook' },
    { label: 'Instagram', url: s.socialInstagram, icon: 'brand-instagram' },
    { label: 'YouTube', url: s.socialYoutube, icon: 'brand-youtube' },
    { label: 'TikTok', url: s.socialTiktok, icon: 'brand-tiktok' },
    { label: 'X', url: s.socialTwitter, icon: 'brand-x' },
    { label: 'LinkedIn', url: s.socialLinkedin, icon: 'public' },
  ].filter(item => /^https?:\/\//i.test(item.url || '')); // validator enforces http(s) too; this also covers values saved before it did
%>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %></title>
  <% if (locals.noindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
  <meta name="description" content="<%= pageDescription %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Bidang Akademik UNJANI">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageDescription %>">
  <meta property="og:image" content="/img/lambang-unjani.png">
  <% if (locals.canonicalUrl) { %>
  <meta property="og:url" content="<%= canonicalUrl %>">
  <link rel="canonical" href="<%= canonicalUrl %>">
  <% } %>
  <% if (currentPath === '/') { %>
  <link rel="preload" href="/img/hero-kampus.webp" imagesrcset="/img/hero-kampus-800.webp 800w, /img/hero-kampus.webp 1600w" imagesizes="(min-width: 1024px) 50vw, 100vw" as="image" fetchpriority="high">
  <% } %>
  <link rel="icon" href="<%= s.favicon || '/assets/landing-page/images/favicon.ico' %>">
  <link rel="preload" href="/fonts/plus-jakarta-sans/plus-jakarta-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/source-serif-4/source-serif-4-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="<%= assetUrl('/css/app.css') %>">
  <script src="<%= assetUrl('/js/shared.js') %>" defer></script>
  <script src="<%= assetUrl('/js/app.js') %>" defer></script>
  <script src="/js/vendor/alpine-csp.min.js" defer></script>
</head>
<body class="flex min-h-screen flex-col">
  <a class="skip-link" href="#konten">Langsung ke konten utama</a>

  <%# Top bar (F7 R1): ikut tergulung, hanya navbar di bawahnya yang sticky. Desktop saja — di HP/tablet kontak ada di menu dan footer. %>
  <aside class="on-dark hidden bg-brand text-sm text-on-dark-muted lg:block" aria-label="Kontak dan media sosial">
    <div class="container-content flex h-11 items-center justify-between gap-6">
      <ul class="flex min-w-0 items-center gap-x-6">
        <li class="shrink-0"><a href="<%= phoneTo.href %>"<% if (phoneTo.whatsapp) { %> target="_blank" rel="noopener noreferrer" aria-label="<%= waLabel %>"<% } %> class="flex min-h-6 items-center gap-2 whitespace-nowrap text-white no-underline hover:underline"><%- icon(phoneIcon, 'size-4 text-on-dark-accent') %><%= phone %></a></li>
        <li class="min-w-0"><a href="mailto:<%= email %>" class="flex min-h-6 min-w-0 items-center gap-2 text-white no-underline hover:underline"><%- icon('mail', 'size-4 text-on-dark-accent') %><span class="truncate" title="<%= email %>"><%= email %></span></a></li>
        <li class="hidden min-w-0 items-center gap-2 xl:flex"><%- icon('schedule', 'size-4 text-on-dark-accent') %><span class="truncate" title="<%= hours %>"><%= hours %></span></li>
      </ul>
      <% if (socials.length) { %>
        <ul class="flex shrink-0 items-center" aria-label="Media sosial">
          <% socials.forEach(item => { %>
            <li><a href="<%= item.url %>" class="inline-flex size-11 items-center justify-center rounded-control text-white hover:bg-white/10" target="_blank" rel="noopener noreferrer" title="<%= item.label %>" aria-label="<%= item.label %> (membuka tab baru)"><%- icon(item.icon, 'size-4') %></a></li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </aside>

  <header class="sticky top-0 z-40 border-b border-line bg-canvas" x-data="disclosure" x-on:keydown.escape.window="closeAndFocus">
    <div class="container-content flex h-18 items-center justify-between gap-4">
      <a href="/" class="flex min-w-0 items-center gap-2 no-underline sm:gap-3">
        <img src="/img/lambang-unjani.png" alt="" width="44" height="42" class="size-11 object-contain">
        <span class="leading-tight">
          <span class="block font-serif text-lg font-bold text-brand">Bidang Akademik</span>
          <span class="hidden text-xs font-medium tracking-wide text-muted uppercase sm:block">Universitas Jenderal Achmad Yani</span>
        </span>
      </a>

      <nav class="hidden lg:block" aria-label="Menu utama">
        <ul class="flex items-center gap-1">
          <% publicNav.forEach(item => { %>
            <% if (item.children) { const groupActive = item.children.some(c => isActive(c.href, currentPath)); %>
              <li class="relative" x-data="disclosure" x-on:click.outside="close" x-on:keydown.escape="closeAndFocus">
                <button type="button" x-ref="trigger" x-on:click="toggle" x-bind:aria-expanded="open" aria-haspopup="true"
                        class="btn btn-tertiary px-3 <%= groupActive ? 'nav-active' : 'text-ink' %>">
                  <%= item.label %> <%- icon('keyboard_arrow_down', 'size-5') %>
                </button>
                <ul x-show="open" x-cloak class="menu-enter absolute left-0 mt-1 min-w-64 rounded-card border border-line bg-surface p-2 shadow-raised">
                  <% item.children.forEach(child => { %>
                    <li><a href="<%= child.href %>" class="flex min-h-11 items-center rounded-control px-3 text-sm font-medium no-underline hover:bg-sunken <%= isActive(child.href, currentPath) ? 'bg-primary-soft text-primary' : 'text-ink' %>"<%- isActive(child.href, currentPath) ? ' aria-current="page"' : '' %>><%= child.label %></a></li>
                  <% }) %>
                </ul>
              </li>
            <% } else { %>
              <li><a href="<%= item.href %>" class="btn btn-tertiary px-3 <%= isActive(item.href, currentPath) ? 'nav-active' : 'text-ink' %>"<%- isActive(item.href, currentPath) ? ' aria-current="page"' : '' %>><%= item.label %></a></li>
            <% } %>
          <% }) %>
        </ul>
      </nav>

      <div class="flex items-center gap-1">
        <a href="/cari" class="btn-icon" aria-label="Cari"><%- icon('search', 'size-6') %></a>
        <%# CTA hanya di ≥1280px: di 1024px logo + 5 menu + CTA tidak muat satu baris. %>
        <a href="<%= publicCta.href %>" class="btn btn-documents ml-2 hidden xl:inline-flex"><span class="flex size-8 shrink-0 items-center justify-center rounded bg-white/10"><%- icon(publicCta.icon) %></span><%= publicCta.label %></a>
        <button type="button" class="btn-icon lg:hidden" x-ref="trigger" x-on:click="toggle" x-bind:aria-expanded="open" aria-controls="menu-hp" aria-label="Buka menu">
          <%- icon('menu', 'size-6') %>
        </button>
      </div>
    </div>

    <!-- Menu HP: panel penuh di bawah header (FR-G-02) -->
    <nav id="menu-hp" x-show="open" x-cloak class="menu-enter max-h-[calc(100dvh-4.5rem)] overflow-y-auto border-t border-line bg-surface lg:hidden" aria-label="Menu utama">
      <ul class="container-content py-3">
        <% publicNav.forEach(item => { %>
          <% if (item.children) { %>
            <li class="pt-3">
              <p class="px-3 pb-1 text-xs font-semibold tracking-wide text-muted uppercase"><%= item.label %></p>
              <ul>
                <% item.children.forEach(child => { %>
                  <li><a href="<%= child.href %>" class="flex min-h-11 items-center rounded-control px-3 font-medium no-underline <%= isActive(child.href, currentPath) ? 'bg-primary-soft text-primary' : 'text-ink' %>"<%- isActive(child.href, currentPath) ? ' aria-current="page"' : '' %>><%= child.label %></a></li>
                <% }) %>
              </ul>
            </li>
          <% } else { %>
            <li><a href="<%= item.href %>" class="flex min-h-11 items-center rounded-control px-3 font-semibold no-underline <%= isActive(item.href, currentPath) ? 'bg-primary-soft text-primary' : 'text-ink' %>"<%- isActive(item.href, currentPath) ? ' aria-current="page"' : '' %>><%= item.label %></a></li>
          <% } %>
        <% }) %>
      </ul>
      <div class="container-content border-t border-line py-4">
        <a href="<%= publicCta.href %>" class="btn btn-documents w-full"><span class="flex size-8 shrink-0 items-center justify-center rounded bg-white/10"><%- icon(publicCta.icon) %></span><%= publicCta.label %></a>
        <ul class="mt-3 text-sm">
          <li><a href="<%= phoneTo.href %>"<% if (phoneTo.whatsapp) { %> target="_blank" rel="noopener noreferrer" aria-label="<%= waLabel %>"<% } %> class="flex min-h-11 items-center gap-3 px-3 font-medium text-ink no-underline"><%- icon(phoneIcon, 'size-5 text-primary') %><%= phone %></a></li>
          <li><a href="mailto:<%= email %>" class="flex min-h-11 items-center gap-3 px-3 font-medium text-ink no-underline"><%- icon('mail', 'size-5 text-primary') %><%= email %></a></li>
          <li class="flex min-h-11 items-center gap-3 px-3 text-muted"><%- icon('schedule', 'size-5 text-primary') %><%= hours %></li>
        </ul>
      </div>
    </nav>
  </header>

  <% if (locals.alertSuccess || locals.alertError) { %>
    <%- include('../components/toast', { success: locals.alertSuccess, error: locals.alertError }) %>
  <% } %>

  <main id="konten" class="flex-1" tabindex="-1">
    <%- body %>
  </main>

  <%
    // Tautan cepat dari Pengaturan Situs: hanya http(s) atau path internal (validator kini memaksa http(s); ini menyaring nilai lama di DB).
    // Cadangan dipakai setelah penyaringan, agar kolomnya tidak kosong bila semua tautan lama di DB tidak valid.
    const quickLinksValid = (s.quickLinks || []).filter(link => link && link.label && /^(https?:\/\/|\/(?!\/))/i.test(link.url || ''));
    const quickLinks = quickLinksValid.length ? quickLinksValid : [{ label: 'Portal UNJANI', url: 'https://unjani.ac.id', target: '_blank' }];
    // Hanya 6 tujuan yang paling sering dicari; halaman lain tetap lewat menu header. 12 tautan membuat kolom ini
    // jauh lebih panjang dari kolom lain (target sentuh 44 px per tautan).
    const jelajahi = [
      { label: 'Kalender Akademik', href: '/kalender-akademik' },
      { label: 'Dokumen Akademik', href: '/dokumen-akademik' },
      { label: 'Kurikulum', href: '/kurikulum' },
      { label: 'Akreditasi', href: '/akreditasi' },
      { label: 'Pengumuman', href: '/pengumuman' },
      { label: 'Berita', href: '/berita' },
    ];
  %>
  <%# Footer (F7 R4). Band CTA berada di dalam <footer> agar tetap di landmark contentinfo. Tanpa margin atas:
      setiap halaman sudah diakhiri padding/seksinya sendiri, sehingga tidak ada celah canvas di bawah pita berwarna. %>
  <footer class="on-dark bg-black text-white">
    <section class="border-b border-white/20" aria-labelledby="cta-layanan">
      <div class="container-content flex flex-col gap-6 py-10 md:flex-row md:items-center md:justify-between">
        <div>
          <h2 id="cta-layanan" class="text-3xl font-bold tracking-tight text-white md:text-4xl">Ada pertanyaan akademik?</h2>
          <p class="mt-3 max-w-xl text-on-dark-muted">Hubungi Bidang Akademik pada jam layanan: <%= hours.replace(/[.\s]+$/, '') %>.</p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-3">
          <a href="mailto:<%= email %>" class="btn btn-light"><%- icon('mail') %>Kirim Email</a>
          <a href="<%= phoneTo.href %>" class="btn btn-outline-light"<% if (phoneTo.whatsapp) { %> target="_blank" rel="noopener noreferrer"<% } %>><%- icon(phoneIcon) %><%= phoneTo.whatsapp ? 'Chat WhatsApp' : 'Telepon' %><% if (phoneTo.whatsapp) { %><span class="sr-only"> (membuka tab baru)</span><% } %></a>
        </div>
      </div>
    </section>

    <div class="container-content grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1.3fr_1fr]">
      <div>
        <a href="/" class="inline-flex items-center gap-3 text-white no-underline">
          <img src="/img/lambang-unjani.png" alt="" width="44" height="42" class="size-12 object-contain">
          <span class="leading-tight">
            <span class="block font-serif text-lg font-bold">Bidang Akademik</span>
            <span class="block text-xs font-medium tracking-wide text-on-dark-muted uppercase">Universitas Jenderal Achmad Yani</span>
          </span>
        </a>
        <p class="mt-5 text-sm leading-relaxed text-on-dark-muted"><%= s.landingFooterDescription || 'Mengelola kurikulum, kalender akademik, dan layanan administrasi akademik agar proses belajar berjalan tertib dan bermutu.' %></p>
        <% if (socials.length) { %>
          <ul class="mt-5 flex flex-wrap gap-2" aria-label="Media sosial">
            <% socials.forEach(item => { %>
              <li><a href="<%= item.url %>" class="inline-flex size-11 items-center justify-center rounded-full border border-white/25 text-white hover:border-on-dark-accent hover:text-on-dark-accent" target="_blank" rel="noopener noreferrer" title="<%= item.label %>" aria-label="<%= item.label %> (membuka tab baru)"><%- icon(item.icon, 'size-5') %></a></li>
            <% }) %>
          </ul>
        <% } %>
      </div>

      <nav aria-labelledby="footer-jelajahi">
        <h2 id="footer-jelajahi" class="footer-title">Jelajahi</h2>
        <ul class="columns-2 gap-x-4 lg:columns-1">
          <% jelajahi.forEach(link => { %>
            <li class="break-inside-avoid"><a href="<%= link.href %>" class="flex min-h-11 items-center gap-2 text-sm text-white no-underline hover:text-on-dark-accent hover:underline"><%- icon('chevron_right', 'size-4 text-on-dark-accent') %><%= link.label %></a></li>
          <% }) %>
        </ul>
      </nav>

      <div>
        <h2 class="footer-title">Kontak &amp; Jam Layanan</h2>
        <ul class="space-y-3 text-sm text-on-dark-muted">
          <li class="flex gap-3"><%- icon('location_on', 'size-5 shrink-0 text-on-dark-accent') %><span><%= s.alamat || 'Jl. Terusan Jend. Sudirman, Cibeber, Cimahi Selatan, Kota Cimahi, Jawa Barat' %></span></li>
          <li class="flex items-center gap-3"><%- icon(phoneIcon, 'size-5 text-on-dark-accent') %><a class="-my-3 inline-flex min-h-11 items-center text-white" href="<%= phoneTo.href %>"<% if (phoneTo.whatsapp) { %> target="_blank" rel="noopener noreferrer" aria-label="<%= waLabel %>"<% } %>><%= phone %></a></li>
          <li class="flex items-center gap-3"><%- icon('mail', 'size-5 text-on-dark-accent') %><a class="-my-3 inline-flex min-h-11 min-w-0 items-center break-all text-white" href="mailto:<%= email %>"><%= email %></a></li>
          <li class="flex gap-3"><%- icon('schedule', 'size-5 shrink-0 text-on-dark-accent') %><span><%= hours %></span></li>
        </ul>
      </div>

      <% if (quickLinks.length) { %>
      <nav aria-labelledby="footer-tautan">
        <h2 id="footer-tautan" class="footer-title">Tautan Cepat</h2>
        <ul>
          <% quickLinks.forEach(link => { %>
            <li><a href="<%= link.url %>" class="flex min-h-11 items-center gap-2 text-sm text-white no-underline hover:text-on-dark-accent hover:underline"<%- link.target === '_blank' ? ' target="_blank" rel="noopener noreferrer"' : '' %>><%- icon(link.target === '_blank' ? 'open_in_new' : 'chevron_right', 'size-4 text-on-dark-accent') %><%= link.label %><% if (link.target === '_blank') { %><span class="sr-only"> (membuka tab baru)</span><% } %></a></li>
          <% }) %>
        </ul>
      </nav>
      <% } %>
    </div>
    <div class="border-t border-white/15">
      <p class="container-content py-5 text-sm text-on-dark-muted">© <%= new Date().getFullYear() %> Bidang Akademik Universitas Jenderal Achmad Yani</p>
    </div>
  </footer>

  <% if (chatEnabled) { %>
    <%- include('../components/chat-widget', { phoneTo, phoneIcon, email, phone }) %>
  <% } %>
</body>
</html>
