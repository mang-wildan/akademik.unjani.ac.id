<%
  const s = locals.siteSetting || {};
  const pageTitle = locals.title ? `${locals.title} | Bidang Akademik UNJANI` : 'Bidang Akademik UNJANI';
  const pageDescription = locals.description || 'Kalender akademik, kurikulum, dokumen, akreditasi, dan informasi akademik resmi Universitas Jenderal Achmad Yani.';
  const currentPath = locals.path || '/';
  const phone = s.kontakTelepon || '+62 (022) 6656190';
  const email = s.kontakEmail || 'akademik@unjani.ac.id';
  const phoneTo = phoneLink(phone); // "(Chat Only)"/WhatsApp → wa.me, selain itu tel:
  const phoneIcon = phoneTo.whatsapp ? 'brand-whatsapp' : 'call';
  const waLabel = `${phone} - chat WhatsApp (membuka tab baru)`;
  const hours = s.jamLayanan || 'Senin-Jumat, 08.00-15.30 WIB';
  const socials = [
    { label: 'Facebook', url: s.socialFacebook, icon: 'brand-facebook' },
    { label: 'Instagram', url: s.socialInstagram, icon: 'brand-instagram' },
    { label: 'YouTube', url: s.socialYoutube, icon: 'brand-youtube' },
    { label: 'TikTok', url: s.socialTiktok, icon: 'brand-tiktok' },
    { label: 'X', url: s.socialTwitter, icon: 'brand-x' },
    { label: 'LinkedIn', url: s.socialLinkedin, icon: 'public' },
  ].filter(item => /^https?:\/\//i.test(item.url || '')); // validator enforces http(s) too; this also covers values saved before it did
%>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %></title>
  <% if (locals.noindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
  <meta name="description" content="<%= pageDescription %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Bidang Akademik UNJANI">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageDescription %>">
  <meta property="og:image" content="/img/lambang-unjani.png">
  <% if (locals.canonicalUrl) { %>
  <meta property="og:url" content="<%= canonicalUrl %>">
  <link rel="canonical" href="<%= canonicalUrl %>">
  <% } %>
  <% if (currentPath === '/') { %>
  <link rel="preload" href="/img/hero-kampus.webp" imagesrcset="/img/hero-kampus-800.webp 800w, /img/hero-kampus.webp 1600w" imagesizes="(min-width: 1024px) 50vw, 100vw" as="image" fetchpriority="high">
  <% } %>
  <link rel="icon" href="<%= s.favicon || '/assets/landing-page/images/favicon.ico' %>">
  <link rel="preload" href="/fonts/inter/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/crimson-text/crimson-text-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/ubuntu-mono/ubuntu-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="<%= assetUrl('/css/app.css') %>">
  <script src="<%= assetUrl('/js/shared.js') %>" defer></script>
  <script src="<%= assetUrl('/js/app.js') %>" defer></script>
  <script src="/js/vendor/alpine-csp.min.js" defer></script>
</head>
<body class="flex min-h-screen flex-col">
  <a class="skip-link" href="#konten">Langsung ke konten utama</a>

  <%# Baris utilitas: ikut tergulung, hanya navbar di bawahnya yang sticky. Desktop saja; di HP kontak ada di menu dan footer.
      Kanan menampilkan jam layanan (data Pengaturan Situs), bukan label semester: layout tidak memuat kalender akademik. %>
  <aside class="hidden border-b border-line lg:block" aria-label="Kontak layanan">
    <div class="container-content flex h-11 items-center justify-between gap-6 font-mono text-xs">
      <ul class="flex min-w-0 items-center gap-x-3 tracking-[0.05em] text-muted">
        <li class="min-w-0"><a href="mailto:<%= email %>" class="flex min-h-11 min-w-0 items-center text-muted no-underline hover:text-ink"><span class="truncate" title="<%= email %>"><%= email %></span></a></li>
        <li aria-hidden="true">/</li>
        <li class="shrink-0"><a href="<%= phoneTo.href %>"<% if (phoneTo.whatsapp) { %> target="_blank" rel="noopener noreferrer" aria-label="<%= waLabel %>"<% } %> class="flex min-h-11 items-center whitespace-nowrap text-muted no-underline hover:text-ink"><%= phoneTo.whatsapp ? 'WhatsApp layanan akademik' : phone %></a></li>
      </ul>
      <p class="shrink-0 tracking-[0.08em] text-primary uppercase">Layanan <%= hours %></p>
    </div>
  </aside>

  <header class="sticky top-0 z-40 border-b border-line bg-canvas" x-data="disclosure" x-on:keydown.escape.window="closeAndFocus">
    <div class="container-content flex h-20 items-center justify-between gap-2 lg:gap-6">
      <a href="/" class="flex min-w-0 shrink-0 items-center gap-3 no-underline">
        <img src="/img/lambang-unjani.png" alt="" width="44" height="42" class="h-[42px] w-11 object-contain">
        <span>
          <span class="block font-serif text-[1.4375rem] leading-[1.625rem] font-bold text-ink">Bidang Akademik</span>
          <span class="mt-px hidden text-xs leading-4 tracking-[0.015em] text-muted sm:block">Universitas Jenderal Achmad Yani</span>
        </span>
      </a>

      <div class="flex items-center gap-6 xl:gap-8">
        <nav class="hidden lg:block" aria-label="Menu utama">
          <ul class="flex items-center gap-6 xl:gap-7">
            <% publicNav.forEach(item => { %>
              <% if (item.children) { const groupActive = item.children.some(c => isActive(c.href, currentPath)); %>
                <li class="relative" x-data="disclosure" x-on:click.outside="close" x-on:keydown.escape="closeAndFocus">
                  <button type="button" x-ref="trigger" x-on:click="toggle" x-bind:aria-expanded="open" aria-haspopup="true"
                          class="nav-link cursor-pointer <%= groupActive ? 'nav-active' : '' %>">
                    <%= item.label %><%- icon('keyboard_arrow_down', 'size-4 text-muted') %>
                  </button>
                  <ul x-show="open" x-cloak class="menu-enter absolute top-full -left-3 min-w-64 rounded-b-card border border-t-0 border-line bg-surface p-2 shadow-raised">
                    <% item.children.forEach(child => { %>
                      <li><a href="<%= child.href %>" class="flex min-h-11 items-center rounded-control px-3 text-[0.9375rem] no-underline hover:bg-sunken <%= isActive(child.href, currentPath) ? 'bg-sunken font-bold text-ink' : 'text-ink' %>"<%- isActive(child.href, currentPath) ? ' aria-current="page"' : '' %>><%= child.label %></a></li>
                    <% }) %>
                  </ul>
                </li>
              <% } else { %>
                <li><a href="<%= item.href %>" class="nav-link <%= isActive(item.href, currentPath) ? 'nav-active' : '' %>"<%- isActive(item.href, currentPath) ? ' aria-current="page"' : '' %>><%= item.label %></a></li>
              <% } %>
            <% }) %>
          </ul>
        </nav>

        <div class="flex items-center gap-2 lg:gap-5">
          <%# Pintasan "/" ditangani di public/js/app.js; tanda tombolnya disembunyikan dari pembaca layar. %>
          <a href="/cari" class="hidden min-h-11 items-center gap-2 text-[0.9375rem] text-muted no-underline hover:text-ink lg:inline-flex" aria-keyshortcuts="/">Cari<kbd class="flex size-[22px] items-center justify-center rounded-[3px] border border-control font-mono text-[0.8125rem] leading-none" aria-hidden="true">/</kbd></a>
          <a href="/cari" class="btn-icon lg:hidden" aria-label="Cari"><%- icon('search', 'size-6') %></a>
          <%# CTA hanya di ≥1280px: di 1024px logo + 5 menu + cari + CTA tidak muat satu baris. %>
          <a href="<%= publicCta.href %>" class="btn btn-dark hidden xl:inline-flex"><%= publicCta.label %></a>
          <button type="button" class="btn-icon lg:hidden" x-ref="trigger" x-on:click="toggle" x-bind:aria-expanded="open" aria-controls="menu-hp" aria-label="Buka menu">
            <%- icon('menu', 'size-6') %>
          </button>
        </div>
      </div>
    </div>

    <!-- Menu HP: panel penuh di bawah header (FR-G-02) -->
    <nav id="menu-hp" x-show="open" x-cloak class="menu-enter max-h-[calc(100dvh-5rem)] overflow-y-auto border-t border-line bg-canvas lg:hidden" aria-label="Menu utama">
      <ul class="container-content pt-2 pb-4">
        <% publicNav.forEach(item => { %>
          <% if (item.children) { %>
            <li class="border-b border-line py-3">
              <p class="meta py-2"><%= item.label %></p>
              <ul>
                <% item.children.forEach(child => { %>
                  <li><a href="<%= child.href %>" class="flex min-h-11 items-center text-base no-underline <%= isActive(child.href, currentPath) ? 'font-bold text-ink' : 'text-ink' %>"<%- isActive(child.href, currentPath) ? ' aria-current="page"' : '' %>><%= child.label %></a></li>
                <% }) %>
              </ul>
            </li>
          <% } else { %>
            <li class="border-b border-line"><a href="<%= item.href %>" class="flex min-h-13 items-center text-base no-underline <%= isActive(item.href, currentPath) ? 'font-bold text-ink' : 'text-ink' %>"<%- isActive(item.href, currentPath) ? ' aria-current="page"' : '' %>><%= item.label %></a></li>
          <% } %>
        <% }) %>
      </ul>
      <div class="container-content pb-6">
        <a href="<%= publicCta.href %>" class="btn btn-dark btn-lg w-full"><%= publicCta.label %></a>
        <ul class="mt-4 font-mono text-[0.8125rem] tracking-[0.03em] text-muted">
          <li><a href="<%= phoneTo.href %>"<% if (phoneTo.whatsapp) { %> target="_blank" rel="noopener noreferrer" aria-label="<%= waLabel %>"<% } %> class="flex min-h-11 items-center text-muted no-underline"><%= phone %></a></li>
          <li><a href="mailto:<%= email %>" class="flex min-h-11 items-center text-muted no-underline"><%= email %></a></li>
          <li class="flex min-h-11 items-center text-primary uppercase">Layanan <%= hours %></li>
        </ul>
      </div>
    </nav>
  </header>

  <% if (locals.alertSuccess || locals.alertError) { %>
    <%- include('../components/toast', { success: locals.alertSuccess, error: locals.alertError }) %>
  <% } %>

  <main id="konten" class="flex-1" tabindex="-1">
    <%- body %>
  </main>

  <%
    // Tautan cepat dari Pengaturan Situs: hanya http(s) atau path internal (validator kini memaksa http(s); ini menyaring nilai lama di DB).
    // Cadangan dipakai setelah penyaringan, agar kolomnya tidak kosong bila semua tautan lama di DB tidak valid.
    const quickLinksValid = (s.quickLinks || []).filter(link => link && link.label && /^(https?:\/\/|\/(?!\/))/i.test(link.url || ''));
    const quickLinks = quickLinksValid.length ? quickLinksValid : [{ label: 'unjani.ac.id', url: 'https://unjani.ac.id', target: '_blank' }];
    // Delapan tujuan dalam dua kolom, sesuai mockup; halaman lain tetap lewat menu header.
    const jelajahi = [
      { label: 'Profil', href: '/profil' },
      { label: 'Pimpinan & staf', href: '/pimpinan-dan-staff' },
      { label: 'Struktur organisasi', href: '/struktur-organisasi' },
      { label: 'Kalender akademik', href: '/kalender-akademik' },
      { label: 'Kurikulum', href: '/kurikulum' },
      { label: 'Akreditasi', href: '/akreditasi' },
      { label: 'Dokumen akademik', href: '/dokumen-akademik' },
      { label: 'Buku wisuda', href: '/buku-wisuda' },
    ];
    // 44px di layar sentuh; di perangkat berpenunjuk halus baris dirapatkan mengikuti ritme mockup.
    const footerLink = 'flex min-h-11 items-center text-sm text-on-ink no-underline hover:underline pointer-fine:min-h-[30px]';
  %>
  <%# Footer gelap. Band CTA berada di dalam <footer> agar tetap di landmark contentinfo. Tanpa margin atas:
      setiap halaman sudah diakhiri padding/seksinya sendiri. %>
  <footer class="on-dark bg-ink text-on-ink">
    <div class="container-content">
      <section class="flex flex-col gap-8 py-16 md:flex-row md:items-center md:justify-between" aria-labelledby="cta-layanan">
        <div>
          <h2 id="cta-layanan" class="section-title text-on-ink">Ada pertanyaan akademik?</h2>
          <p class="mt-3 text-base text-on-ink-muted">Layanan loket <%= hours.replace(/[.\s]+$/, '') %>.</p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-4">
          <a href="<%= phoneTo.href %>" class="btn btn-light btn-lg min-w-44"<% if (phoneTo.whatsapp) { %> target="_blank" rel="noopener noreferrer"<% } %>><%= phoneTo.whatsapp ? 'Chat WhatsApp' : 'Telepon' %><% if (phoneTo.whatsapp) { %><span class="sr-only"> (membuka tab baru)</span><% } %></a>
          <a href="mailto:<%= email %>" class="btn btn-outline-light btn-lg min-w-44">Kirim email</a>
        </div>
      </section>

      <div class="grid gap-10 border-t border-white/15 py-9 md:grid-cols-2 lg:grid-cols-[11fr_12fr_7fr] lg:gap-8">
        <div>
          <a href="/" class="inline-flex items-center gap-3 text-on-ink no-underline">
            <img src="/img/lambang-unjani.png" alt="" width="40" height="39" class="h-[39px] w-10 object-contain">
            <span>
              <span class="block font-serif text-[1.3125rem] leading-6 font-bold">Bidang Akademik</span>
              <span class="block text-xs leading-4 text-on-ink-muted">Universitas Jenderal Achmad Yani</span>
            </span>
          </a>
          <p class="mt-6 max-w-xs text-sm leading-[1.375rem] text-on-ink-muted"><%= s.alamat || 'Jl. Terusan Jenderal Sudirman, Cimahi, Jawa Barat 40531' %></p>
          <% if (socials.length) { %>
            <ul class="mt-4 -ml-3 flex flex-wrap" aria-label="Media sosial">
              <% socials.forEach(item => { %>
                <li><a href="<%= item.url %>" class="inline-flex size-11 items-center justify-center rounded-control text-on-ink-muted hover:text-on-ink" target="_blank" rel="noopener noreferrer" title="<%= item.label %>" aria-label="<%= item.label %> (membuka tab baru)"><%- icon(item.icon, 'size-[18px]') %></a></li>
              <% }) %>
            </ul>
          <% } %>
        </div>

        <nav aria-labelledby="footer-jelajahi">
          <h2 id="footer-jelajahi" class="footer-title">Jelajahi</h2>
          <%# Mengisi kolom dulu: empat tautan per kolom. %>
          <ul class="grid grid-flow-col grid-rows-4 gap-x-8">
            <% jelajahi.forEach(link => { %>
              <li><a href="<%= link.href %>" class="<%= footerLink %>"><%= link.label %></a></li>
            <% }) %>
          </ul>
        </nav>

        <nav aria-labelledby="footer-tautan">
          <h2 id="footer-tautan" class="footer-title">Tautan</h2>
          <ul>
            <% quickLinks.forEach(link => { %>
              <li><a href="<%= link.url %>" class="<%= footerLink %>"<%- link.target === '_blank' ? ' target="_blank" rel="noopener noreferrer"' : '' %>><%= link.label %><% if (link.target === '_blank') { %><span class="sr-only"> (membuka tab baru)</span><% } %></a></li>
            <% }) %>
          </ul>
        </nav>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-x-6 border-t border-white/15 py-3 font-mono text-[0.6875rem] tracking-[0.11em] text-on-ink-muted uppercase">
        <p>© <%= new Date().getFullYear() %> Universitas Jenderal Achmad Yani</p>
        <a href="/login" class="inline-flex min-h-11 items-center text-on-ink-muted no-underline hover:text-on-ink">Masuk admin</a>
      </div>
    </div>
  </footer>

  <% if (chatEnabled) { %>
    <%- include('../components/chat-widget', { phoneTo, phoneIcon, email, phone }) %>
  <% } %>
</body>
</html>
