<%#
  Judul seksi: judul serif + pengantar + tautan "lihat semua" (mockup v0.0.1). Selalu <h2>.
  include('../components/section-heading', {
    sectionEyebrow: 'Disematkan',   // opsional dan jarang: maksimal satu per tiga seksi
    sectionHeading: 'Kegiatan akademik',
    sectionLead: 'Tonggak penting semester berjalan.',
    sectionLink: { label: 'Semua berita', href: '/berita' },
    sectionId: 'kegiatan-judul',    // pasangkan dengan <section aria-labelledby="kegiatan-judul">
  })
  Warna menyesuaikan sendiri di dalam .section-dark.
%>
<div class="mb-9 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
  <div class="min-w-0">
    <% if (locals.sectionEyebrow) { %><p class="eyebrow mb-3"><%= locals.sectionEyebrow %></p><% } %>
    <h2<% if (locals.sectionId) { %> id="<%= locals.sectionId %>"<% } %> class="section-title"><%= locals.sectionHeading %></h2>
    <% if (locals.sectionLead) { %><p class="section-lead"><%= locals.sectionLead %></p><% } %>
  </div>
  <% if (locals.sectionLink) { %>
    <a href="<%= locals.sectionLink.href %>" class="section-link"><%= locals.sectionLink.label %><%- icon('arrow_right_alt') %></a>
  <% } %>
</div>
