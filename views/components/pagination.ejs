<%#
  include('../components/pagination', {
    page: 2, totalPages: 5, total: 48, from: 11, to: 20, noun: 'pengumuman',
    path: '/pengumuman', query: { kategori: 'wisuda' },   // query lain dipertahankan
  })
%>
<%
  const current = Number(locals.page) || 1;
  const last = Number(locals.totalPages) || 1;
  const hrefFor = p => `${locals.path}?${new URLSearchParams({ ...(locals.query || {}), page: p })}`;
  // First, last, and current ±1, with gaps marked by null.
  const pages = [];
  for (let p = 1; p <= last; p += 1) {
    if (p === 1 || p === last || Math.abs(p - current) <= 1) pages.push(p);
    else if (pages[pages.length - 1] !== null) pages.push(null);
  }
  const cell = 'inline-flex size-11 items-center justify-center rounded-control border font-mono text-[0.8125rem] no-underline';
%>
<div class="mt-10 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
  <p class="meta">Menampilkan <%= formatAngka(locals.from) %>-<%= formatAngka(locals.to) %> dari <%= formatAngka(locals.total) %> <%= locals.noun || 'data' %></p>
  <% if (last > 1) { %>
    <nav aria-label="Halaman">
      <ul class="flex items-center gap-1">
        <li>
          <% if (current > 1) { %><a href="<%= hrefFor(current - 1) %>" class="<%= cell %> border-line text-ink hover:border-ink" aria-label="Halaman sebelumnya"><%- icon('arrow_left_alt') %></a>
          <% } else { %><span class="<%= cell %> border-line text-control" aria-hidden="true"><%- icon('arrow_left_alt') %></span><% } %>
        </li>
        <% pages.forEach(p => { %>
          <li>
            <% if (p === null) { %><span class="inline-flex size-11 items-center justify-center font-mono text-[0.8125rem] text-ink" aria-hidden="true">…</span>
            <% } else if (p === current) { %><span class="<%= cell %> border-ink bg-ink text-white" aria-current="page"><%= p %></span>
            <% } else { %><a href="<%= hrefFor(p) %>" class="<%= cell %> border-line text-ink hover:border-ink"><span class="sr-only">Halaman </span><%= p %></a><% } %>
          </li>
        <% }) %>
        <li>
          <% if (current < last) { %><a href="<%= hrefFor(current + 1) %>" class="<%= cell %> border-line text-ink hover:border-ink" aria-label="Halaman berikutnya"><%- icon('arrow_right_alt') %></a>
          <% } else { %><span class="<%= cell %> border-line text-control" aria-hidden="true"><%- icon('arrow_right_alt') %></span><% } %>
        </li>
      </ul>
    </nav>
  <% } %>
</div>
