<%#
  Pesan sukses/gagal setelah aksi (dari ?success= / ?error=).
  include('../components/toast', { success, error })
%>
<% const isError = Boolean(locals.error); const message = locals.error || locals.success; %>
<div x-data="toast" x-show="visible" class="fixed inset-x-4 bottom-4 z-50 sm:left-auto sm:w-96"
     role="<%= isError ? 'alert' : 'status' %>">
  <div class="flex items-start gap-3 rounded-card border p-4 shadow-modal <%= isError ? 'border-danger-solid bg-danger-soft text-danger' : 'border-primary bg-success-soft text-success' %>">
    <%- icon(isError ? 'error' : 'check_circle', 'size-6 mt-0.5') %>
    <p class="flex-1 text-sm font-medium"><%= message %></p>
    <button type="button" class="-m-2 inline-flex size-11 items-center justify-center rounded-control hover:bg-white/60" x-on:click="dismiss" aria-label="Tutup pesan">
      <%- icon('close', 'size-5') %>
    </button>
  </div>
</div>
