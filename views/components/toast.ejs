<%#
  Pesan sukses/gagal setelah aksi (dari ?success= / ?error=).
  include('../components/toast', { success, error })
%>
<% const isError = Boolean(locals.error); const message = locals.error || locals.success; %>
<div x-data="toast" x-show="visible" class="fixed inset-x-4 bottom-4 z-50 sm:left-auto sm:w-96"
     role="<%= isError ? 'alert' : 'status' %>">
  <div class="fade-in-up flex items-start gap-3 rounded-card border-l-[3px] bg-surface p-4 shadow-modal <%= isError ? 'border-danger text-danger' : 'border-success text-success' %>">
    <p class="flex-1 pt-0.5 text-sm font-medium"><%= message %></p>
    <button type="button" class="-m-2 inline-flex size-11 items-center justify-center rounded-control text-ink hover:bg-sunken" x-on:click="dismiss" aria-label="Tutup pesan">
      <%- icon('close', 'size-5') %>
    </button>
  </div>
</div>
