<%#
  Judul halaman + breadcrumb + aksi (FR-G-07).
  include('../components/page-header', {
    heading: 'Kalender Akademik',
    lead: 'Tahun Ajaran 2025/2026',
    breadcrumb: [{ label: 'Akademik' }, { label: 'Kalender Akademik' }],   // Beranda ditambahkan otomatis
    actions: [{ label: 'Unduh PDF resmi', href: '/x.pdf', icon: 'download', variant: 'secondary' }],
    admin: false,                                                          // true: breadcrumb mulai dari Dasbor
    eyebrow: 'Konten',                                                     // opsional, hanya admin: label kecil di atas h1
  })
  Publik (F7 R3): banner hijau tua selebar layar dengan kontainernya sendiri — sertakan di level atas view,
  bukan di dalam .container-content. Varian aksi dipetakan ke tombol latar gelap (primary → accent, lainnya → garis terang).
  Admin: judul polos tanpa banner, seperti sebelumnya.
%>
<% const crumbs = [locals.admin ? { label: 'Dasbor', href: '/admin/dashboard' } : { label: 'Beranda', href: '/' }, ...(locals.breadcrumb || [])]; %>
<% if (locals.admin) { %>
<div class="flex flex-col gap-4 pb-6 md:flex-row md:items-end md:justify-between">
  <div>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-1 text-sm text-muted">
        <% crumbs.forEach((crumb, i) => { const last = i === crumbs.length - 1; %>
          <li class="flex items-center gap-1">
            <% if (i > 0) { %><%- icon('chevron_right', 'size-4') %><% } %>
            <% if (crumb.href && !last) { %>
              <a href="<%= crumb.href %>" class="inline-flex min-h-6 items-center"><%= crumb.label %></a>
            <% } else { %>
              <span<%- last ? ' aria-current="page"' : '' %>><%= crumb.label %></span>
            <% } %>
          </li>
        <% }) %>
      </ol>
    </nav>
    <%_ if (locals.eyebrow) { _%>
    <p class="eyebrow mt-3"><%= locals.eyebrow %></p>
    <%_ } _%>
    <h1 class="mt-2 text-3xl font-bold md:text-4xl"><%= locals.heading %></h1>
    <% if (locals.lead) { %><p class="mt-2 max-w-3xl text-muted"><%= locals.lead %></p><% } %>
  </div>
  <% if (locals.actions && locals.actions.length) { %>
    <div class="flex flex-wrap gap-2">
      <% locals.actions.forEach(action => { %>
        <a href="<%= action.href %>" class="btn btn-<%= action.variant || 'primary' %>"><% if (action.icon) { %><%- icon(action.icon) %><% } %><%= action.label %></a>
      <% }) %>
    </div>
  <% } %>
</div>
<% } else { %>
<div class="section-dark relative isolate mb-10 overflow-hidden border-b-4 border-accent">
  <img src="/img/lambang-unjani.png" alt="" width="44" height="42" class="pointer-events-none absolute top-1/2 right-[-3rem] -z-10 hidden size-72 -translate-y-1/2 opacity-[0.07] brightness-0 invert md:block" aria-hidden="true">
  <div class="container-content flex flex-col gap-6 py-10 md:flex-row md:items-end md:justify-between lg:py-14">
    <div class="min-w-0">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-1 text-sm text-on-dark-muted">
          <% crumbs.forEach((crumb, i) => { const last = i === crumbs.length - 1; %>
            <li class="flex min-w-0 items-center gap-1">
              <% if (i > 0) { %><%- icon('chevron_right', 'size-4 text-on-dark-accent') %><% } %>
              <% if (crumb.href && !last) { %>
                <a href="<%= crumb.href %>" class="inline-flex min-h-6 items-center text-on-dark-muted underline underline-offset-2 hover:text-white"><%= crumb.label %></a>
              <% } else { %>
                <span class="<%= last ? 'line-clamp-1 font-medium text-white' : '' %>"<%- last ? ' aria-current="page"' : '' %>><%= crumb.label %></span>
              <% } %>
            </li>
          <% }) %>
        </ol>
      </nav>
      <%# Judul panjang (detail berita/pengumuman) tidak dibesarkan ke 5xl agar tidak memenuhi layar. %>
      <h1 class="mt-3 text-3xl font-bold md:text-4xl <%= String(locals.heading || '').length <= 60 ? 'lg:text-5xl' : '' %>"><%= locals.heading %></h1>
      <% if (locals.lead) { %><p class="mt-3 max-w-3xl text-lg text-on-dark-muted"><%= locals.lead %></p><% } %>
    </div>
    <% if (locals.actions && locals.actions.length) { %>
      <div class="flex shrink-0 flex-wrap gap-2">
        <% locals.actions.forEach(action => { %>
          <a href="<%= action.href %>" class="btn <%= (action.variant || 'primary') === 'primary' ? 'btn-accent' : 'btn-outline-light' %>"><% if (action.icon) { %><%- icon(action.icon) %><% } %><%= action.label %></a>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>
<% } %>
