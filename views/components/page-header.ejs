<%#
  Judul halaman + breadcrumb + aksi (FR-G-07).
  include('../components/page-header', {
    heading: 'Kalender Akademik',
    lead: 'Tahun Ajaran 2025/2026',
    breadcrumb: [{ label: 'Akademik' }, { label: 'Kalender Akademik' }],   // Beranda ditambahkan otomatis
    actions: [{ label: 'Unduh PDF resmi', href: '/x.pdf', icon: 'download', variant: 'secondary' }],
    admin: false,                                                          // true: breadcrumb mulai dari Dasbor
    eyebrow: 'Konten',                                                     // opsional, hanya admin: label kecil di atas h1
  })
  Publik: judul editorial di canvas dengan kontainernya sendiri; sertakan di level atas view,
  bukan di dalam .container-content. Opsi tambahan publik:
    headingLines: ['Kalender', 'akademik'],   // judul bertumpuk; heading tetap dipakai untuk <title>/aksesibilitas
    metaLine: '43 program studi · 9 fakultas', // baris mono hijau di bawah pengantar
    article: true,                             // judul panjang: lebih kecil, satu kolom
  Aksi publik memakai tombol gelap (btn-dark) dengan panah; blank: true membuka tab baru.
  Admin: judul polos tanpa banner, seperti sebelumnya.
%>
<% const crumbs = [locals.admin ? { label: 'Dasbor', href: '/admin/dashboard' } : { label: 'Beranda', href: '/' }, ...(locals.breadcrumb || [])]; %>
<% if (locals.admin) { %>
<div class="flex flex-col gap-4 pb-6 md:flex-row md:items-end md:justify-between">
  <div>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-1 text-sm text-muted">
        <% crumbs.forEach((crumb, i) => { const last = i === crumbs.length - 1; %>
          <li class="flex items-center gap-1">
            <% if (i > 0) { %><%- icon('chevron_right', 'size-4') %><% } %>
            <% if (crumb.href && !last) { %>
              <a href="<%= crumb.href %>" class="inline-flex min-h-11 items-center"><%= crumb.label %></a>
            <% } else { %>
              <span<%- last ? ' aria-current="page"' : '' %>><%= crumb.label %></span>
            <% } %>
          </li>
        <% }) %>
      </ol>
    </nav>
    <%_ if (locals.eyebrow) { _%>
    <p class="eyebrow mt-3"><%= locals.eyebrow %></p>
    <%_ } _%>
    <h1 class="mt-2 text-2xl font-bold md:text-3xl"><%= locals.heading %></h1>
    <% if (locals.lead) { %><p class="mt-2 max-w-3xl text-muted"><%= locals.lead %></p><% } %>
  </div>
  <% if (locals.actions && locals.actions.length) { %>
    <div class="flex flex-wrap gap-2">
      <% locals.actions.forEach(action => { %>
        <a href="<%= action.href %>" class="btn btn-<%= action.variant || 'primary' %>"><% if (action.icon) { %><%- icon(action.icon) %><% } %><%= action.label %></a>
      <% }) %>
    </div>
  <% } %>
</div>
<% } else { %>
<%# Publik (mockup v0.0.1): breadcrumb mono, judul serif besar di kiri, pengantar + meta + aksi di kanan, garis tebal penutup.
    headingLines memecah judul pendek menjadi baris bertumpuk; article dipakai untuk judul panjang (detail berita/pengumuman). %>
<% const article = Boolean(locals.article); %>
<header class="container-content bg-canvas pt-8 md:pt-10">
  <nav aria-label="Breadcrumb">
    <ol class="meta flex flex-wrap items-center gap-x-3">
      <% crumbs.forEach((crumb, i) => { const last = i === crumbs.length - 1; %>
        <li class="flex min-w-0 items-center gap-x-3">
          <% if (i > 0) { %><span aria-hidden="true">/</span><% } %>
          <% if (crumb.href && !last) { %>
            <a href="<%= crumb.href %>" class="inline-flex min-h-11 items-center text-muted no-underline hover:text-ink"><%= crumb.label %></a>
          <% } else { %>
            <span class="<%= last ? 'line-clamp-1 max-w-[60ch]' : '' %>"<%- last ? ' aria-current="page"' : '' %>><%= crumb.label %></span>
          <% } %>
        </li>
      <% }) %>
    </ol>
  </nav>
  <div class="mt-1 grid gap-x-10 gap-y-6 border-b border-ink pb-11 <%= article ? '' : 'lg:grid-cols-[minmax(0,40rem)_minmax(0,31.25rem)] lg:gap-x-10' %>">
    <h1 class="<%= article ? 'subsection-title max-w-4xl md:text-[2.875rem]' : 'display' %>"><% if (locals.headingLines) { %><% locals.headingLines.forEach((line, i) => { %><span class="block"><%= line %><% if (i < locals.headingLines.length - 1) { %> <% } %></span><% }) %><% } else { %><%= locals.heading %><% } %></h1>
    <% if (locals.lead || locals.metaLine || (locals.actions && locals.actions.length)) { %>
    <div class="<%= article ? '' : 'lg:pt-3.5' %>">
      <% if (locals.lead) { %><p class="text-[1.0625rem] leading-[1.6875rem] text-muted"><%= locals.lead %></p><% } %>
      <% if (locals.metaLine) { %><p class="meta text-primary <%= locals.lead ? 'mt-4' : '' %>"><%= locals.metaLine %></p><% } %>
      <% if (locals.actions && locals.actions.length) { %>
        <div class="mt-5 flex flex-wrap gap-3">
          <% locals.actions.forEach(action => { %>
            <a href="<%= action.href %>" class="btn btn-<%= action.variant || 'dark' %>"<%- action.blank ? ' target="_blank" rel="noopener"' : '' %>><%= action.label %><%- icon(action.icon || 'arrow_right_alt', 'size-5') %><% if (action.blank) { %><span class="sr-only"> (tab baru)</span><% } %></a>
          <% }) %>
        </div>
      <% } %>
    </div>
    <% } %>
  </div>
</header>
<% } %>
