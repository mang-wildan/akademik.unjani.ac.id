<%#
  Judul halaman + breadcrumb + aksi (FR-G-07).
  include('../components/page-header', {
    heading: 'Kalender Akademik',
    lead: 'Tahun Ajaran 2025/2026',
    breadcrumb: [{ label: 'Akademik' }, { label: 'Kalender Akademik' }],   // Beranda ditambahkan otomatis
    actions: [{ label: 'Unduh PDF resmi', href: '/x.pdf', icon: 'download', variant: 'secondary' }],
    admin: false,                                                          // true: breadcrumb mulai dari Dasbor
    eyebrow: 'Konten',                                                     // opsional, hanya admin: label kecil di atas h1
  })
  Publik: judul editorial di canvas dengan kontainernya sendiri; sertakan di level atas view,
  bukan di dalam .container-content. Varian aksi memakai tombol terang standar.
  Admin: judul polos tanpa banner, seperti sebelumnya.
%>
<% const crumbs = [locals.admin ? { label: 'Dasbor', href: '/admin/dashboard' } : { label: 'Beranda', href: '/' }, ...(locals.breadcrumb || [])]; %>
<% if (locals.admin) { %>
<div class="flex flex-col gap-4 pb-6 md:flex-row md:items-end md:justify-between">
  <div>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-1 text-sm text-muted">
        <% crumbs.forEach((crumb, i) => { const last = i === crumbs.length - 1; %>
          <li class="flex items-center gap-1">
            <% if (i > 0) { %><%- icon('chevron_right', 'size-4') %><% } %>
            <% if (crumb.href && !last) { %>
              <a href="<%= crumb.href %>" class="inline-flex min-h-11 items-center"><%= crumb.label %></a>
            <% } else { %>
              <span<%- last ? ' aria-current="page"' : '' %>><%= crumb.label %></span>
            <% } %>
          </li>
        <% }) %>
      </ol>
    </nav>
    <%_ if (locals.eyebrow) { _%>
    <p class="eyebrow mt-3"><%= locals.eyebrow %></p>
    <%_ } _%>
    <h1 class="mt-2 text-2xl font-bold md:text-3xl"><%= locals.heading %></h1>
    <% if (locals.lead) { %><p class="mt-2 max-w-3xl text-muted"><%= locals.lead %></p><% } %>
  </div>
  <% if (locals.actions && locals.actions.length) { %>
    <div class="flex flex-wrap gap-2">
      <% locals.actions.forEach(action => { %>
        <a href="<%= action.href %>" class="btn btn-<%= action.variant || 'primary' %>"><% if (action.icon) { %><%- icon(action.icon) %><% } %><%= action.label %></a>
      <% }) %>
    </div>
  <% } %>
</div>
<% } else { %>
<div class="mb-10 border-b border-line bg-canvas">
  <div class="container-content flex flex-col gap-6 <%= locals.compact ? 'py-6 lg:py-8' : 'py-10 lg:py-14' %> md:flex-row md:items-end md:justify-between">
    <div class="min-w-0">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-1 text-sm text-muted">
          <% crumbs.forEach((crumb, i) => { const last = i === crumbs.length - 1; %>
            <li class="flex min-w-0 items-center gap-1">
              <% if (i > 0) { %><%- icon('chevron_right', 'size-4 text-muted') %><% } %>
              <% if (crumb.href && !last) { %>
                <a href="<%= crumb.href %>" class="inline-flex min-h-11 items-center text-muted hover:text-ink hover:underline"><%= crumb.label %></a>
              <% } else { %>
                <span class="<%= last ? 'line-clamp-1 font-medium text-ink' : '' %>"<%- last ? ' aria-current="page"' : '' %>><%= crumb.label %></span>
              <% } %>
            </li>
          <% }) %>
        </ol>
      </nav>
      <%# Judul panjang (detail berita/pengumuman) tidak dibesarkan ke 5xl agar tidak memenuhi layar. %>
      <h1 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl <%= String(locals.heading || '').length <= 60 && !locals.compact ? 'lg:text-5xl' : '' %>"><%= locals.heading %></h1>
      <% if (locals.lead) { %><p class="mt-3 max-w-3xl text-lg text-muted"><%= locals.lead %></p><% } %>
    </div>
    <% if (locals.actions && locals.actions.length) { %>
      <div class="flex shrink-0 flex-wrap gap-2">
        <% locals.actions.forEach(action => { %>
          <a href="<%= action.href %>" class="btn btn-<%= action.variant || 'primary' %>"><% if (action.icon) { %><%- icon(action.icon) %><% } %><%= action.label %></a>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>
<% } %>
