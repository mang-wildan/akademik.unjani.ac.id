<%#
  Sidebar halaman detail berita/pengumuman: "<Jenis> lainnya" + "Kategori" sebagai daftar bergaris (mockup v0.0.1).
  include('../components/content-sidebar', {
    sideBase: '/berita', sideNoun: 'Berita',
    sideItems: lainnya,          // { title, slug, createdAt, featuredImage? }
    sideKategori: kategoriList,  // { _id, nama, total }: hanya kategori yang punya isi terbit
    sideImages: true,            // berita: gambar kecil; pengumuman: teks saja
  })
%>
<%# Sticky di ≥1024 px; tinggi dibatasi + gulir sendiri agar daftar Kategori tidak tertahan di luar layar pendek.
    -m-1/p-1 memberi ruang agar ring fokus tidak terpotong oleh overflow. %>
<aside class="space-y-10 lg:sticky lg:top-28 lg:-m-1 lg:max-h-[calc(100dvh-8rem)] lg:self-start lg:overflow-y-auto lg:p-1" aria-label="<%= locals.sideNoun %> terkait">
  <section aria-labelledby="sisi-lainnya">
    <h2 id="sisi-lainnya" class="sidebar-title"><%= locals.sideNoun %> lainnya</h2>
    <% if (!locals.sideItems || !locals.sideItems.length) { %>
      <p class="pt-3 text-sm text-muted">Belum ada <%= String(locals.sideNoun).toLowerCase() %> lain.</p>
    <% } else { %>
    <ul class="divide-y divide-line border-b border-line">
      <% locals.sideItems.forEach(l => { %>
        <li><a href="<%= locals.sideBase %>/<%= l.slug %>" class="group flex gap-4 py-4 no-underline">
          <% if (locals.sideImages) { %>
          <span class="photo aspect-[4/3] w-20 shrink-0">
            <% if (l.featuredImage) { %><img src="<%= l.featuredImage %>" alt="" class="size-full object-cover" loading="lazy"><% } %>
          </span>
          <% } %>
          <span class="min-w-0">
            <span class="meta-sm block"><%= formatTanggal(l.createdAt) %></span>
            <span class="mt-1.5 block line-clamp-3 text-[0.9375rem] leading-5 font-bold text-ink group-hover:text-primary"><%= l.title %></span>
          </span>
        </a></li>
      <% }) %>
    </ul>
    <% } %>
  </section>

  <% if (locals.sideKategori && locals.sideKategori.length) { %>
  <section aria-labelledby="sisi-kategori">
    <h2 id="sisi-kategori" class="sidebar-title">Kategori</h2>
    <ul class="divide-y divide-line border-b border-line">
      <% locals.sideKategori.forEach(k => { %>
        <li><a href="<%= locals.sideBase %>?kategori=<%= k._id %>" class="flex min-h-13 items-center justify-between gap-3 text-base text-muted no-underline hover:text-ink">
          <span class="truncate"><%= k.nama %></span>
          <span class="font-mono text-[0.8125rem] tracking-[0.03em]"><%= k.total %><span class="sr-only"> <%= String(locals.sideNoun).toLowerCase() %></span></span>
        </a></li>
      <% }) %>
    </ul>
  </section>
  <% } %>
</aside>
