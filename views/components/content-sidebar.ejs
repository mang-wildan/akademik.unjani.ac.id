<%#
  Sidebar halaman detail berita/pengumuman (F7 R3): "<Jenis> Lainnya" + "Kategori".
  include('../components/content-sidebar', {
    sideBase: '/berita', sideNoun: 'Berita',
    sideItems: lainnya,          // { title, slug, createdAt, featuredImage? }
    sideKategori: kategoriList,  // { _id, nama, total } — hanya kategori yang punya isi terbit
    sideImages: true,            // berita: gambar kecil; pengumuman: teks saja
  })
%>
<%# Sticky di ≥1024 px; tinggi dibatasi + gulir sendiri agar kartu Kategori tidak tertahan di luar layar pendek.
    -m-1/p-1 memberi ruang agar ring fokus & bayangan kartu tidak terpotong oleh overflow. %>
<aside class="space-y-6 lg:sticky lg:top-24 lg:-m-1 lg:max-h-[calc(100dvh-7rem)] lg:self-start lg:overflow-y-auto lg:p-1" aria-label="<%= locals.sideNoun %> terkait">
  <section class="card card-body" aria-labelledby="sisi-lainnya">
    <h2 id="sisi-lainnya" class="sidebar-title"><%= locals.sideNoun %> Lainnya</h2>
    <% if (!locals.sideItems || !locals.sideItems.length) { %>
      <p class="text-sm text-muted">Belum ada <%= String(locals.sideNoun).toLowerCase() %> lain.</p>
    <% } else { %>
    <ul class="space-y-4">
      <% locals.sideItems.forEach(l => { %>
        <li><a href="<%= locals.sideBase %>/<%= l.slug %>" class="-m-2 flex gap-3 rounded-control p-2 no-underline hover:bg-sunken">
          <% if (locals.sideImages) { %>
          <span class="aspect-square w-16 shrink-0 overflow-hidden rounded-control bg-sunken">
            <% if (l.featuredImage) { %><img src="<%= l.featuredImage %>" alt="" class="size-full object-cover" loading="lazy"><% } %>
          </span>
          <% } %>
          <span class="min-w-0">
            <span class="block text-xs font-semibold tracking-wide text-primary uppercase"><%= formatTanggal(l.createdAt) %></span>
            <span class="mt-0.5 block line-clamp-2 text-sm font-medium text-ink"><%= l.title %></span>
          </span>
        </a></li>
      <% }) %>
    </ul>
    <% } %>
  </section>

  <% if (locals.sideKategori && locals.sideKategori.length) { %>
  <section class="card card-body" aria-labelledby="sisi-kategori">
    <h2 id="sisi-kategori" class="sidebar-title">Kategori</h2>
    <ul class="-my-1">
      <% locals.sideKategori.forEach(k => { %>
        <li><a href="<%= locals.sideBase %>?kategori=<%= k._id %>" class="flex min-h-11 items-center justify-between gap-3 text-sm font-medium text-ink no-underline hover:text-primary">
          <span class="flex min-w-0 items-center gap-2"><%- icon('chevron_right', 'size-4 text-accent') %><span class="truncate"><%= k.nama %></span></span>
          <span class="badge badge-neutral"><%= k.total %><span class="sr-only"> <%= String(locals.sideNoun).toLowerCase() %></span></span>
        </a></li>
      <% }) %>
    </ul>
  </section>
  <% } %>
</aside>
