<%#
  Tanggal tipografis untuk daftar pengumuman & agenda (v0.0.1).
  include('../components/date-block', { date: item.createdAt })
%>
<% const block = tanggalBlok(locals.date); %>
<% if (block) { %>
  <time datetime="<%= block.iso %>" class="flex shrink-0 flex-col items-start leading-none">
    <span class="text-xs font-semibold tracking-wider text-muted uppercase"><%= block.month %></span>
    <span class="mt-1 font-serif text-2xl font-bold tracking-tight text-ink"><%= block.day %></span>
    <span class="mt-1 text-xs text-muted"><%= block.year %></span>
  </time>
<% } %>
