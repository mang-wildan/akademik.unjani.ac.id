<%#
  Blok tanggal untuk daftar pengumuman & agenda.
  include('../components/date-block', { date: item.createdAt })
%>
<% const block = tanggalBlok(locals.date); %>
<% if (block) { %>
  <time datetime="<%= block.iso %>" class="flex w-16 shrink-0 flex-col items-center rounded-control border border-line bg-surface py-2 leading-none">
    <span class="text-xs font-semibold tracking-wide text-primary"><%= block.month %></span>
    <span class="mt-1 text-2xl font-bold text-ink"><%= block.day %></span>
    <span class="mt-1 text-xs text-muted"><%= block.year %></span>
  </time>
<% } %>
