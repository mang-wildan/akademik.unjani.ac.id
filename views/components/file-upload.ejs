<%#
  Unggah file dengan batas ukuran yang terlihat (FR-AD-07).
  include('../components/file-upload', {
    name: 'sertifikat', label: 'Sertifikat (PDF)', accept: 'application/pdf',
    limitText: 'PDF, maks. 10 MB', required: true, error: errors.sertifikat,
    current: { label: 'sertifikat-2021.pdf', href: '/uploads/...' },   // file yang sudah ada (form ubah)
  })
%>
<%
  const id = `f-${locals.name}`;
  // Batas ukuran di klien (FR-AD-13), sama dengan batas server: gambar 5 MB, PDF 10 MB; CSV tidak dicek.
  const accept = locals.accept || '';
  const maxMb = locals.maxMb || (/pdf/.test(accept) ? 10 : /image/.test(accept) ? 5 : 0);
%>
<div data-file-field>
  <label for="<%= id %>" class="field-label">
    <%= locals.label %><% if (locals.required) { %> <span class="text-danger" aria-hidden="true">*</span><span class="sr-only">(wajib)</span><% } %>
  </label>
  <% if (locals.current) { %>
    <p class="mb-2 flex items-center gap-2 text-sm text-muted"><%- icon('description', 'size-5') %>File saat ini:
      <a href="<%= locals.current.href %>" target="_blank" rel="noopener" class="inline-flex min-h-6 items-center"><%= locals.current.label %></a></p>
  <% } %>
  <input type="file" id="<%= id %>" name="<%= locals.name %>"<% if (locals.accept) { %> accept="<%= locals.accept %>"<% } %><% if (maxMb) { %> data-max-mb="<%= maxMb %>"<% } %><%= locals.required && !locals.current ? ' required' : '' %>
         aria-describedby="<%= id %>-help<%= locals.error ? ` ${id}-error` : '' %>"<%- locals.error ? ' aria-invalid="true"' : '' %>
         class="block w-full rounded-control border border-dashed border-control bg-surface p-2 text-sm text-muted file:mr-3 file:min-h-10 file:cursor-pointer file:rounded-control file:border-0 file:bg-primary-soft file:px-4 file:font-semibold file:text-primary hover:file:bg-success-soft">
  <p id="<%= id %>-help" class="field-help"><%= locals.limitText || 'Gambar maks. 5 MB, PDF maks. 10 MB' %><%= locals.current ? '. Biarkan kosong jika tidak diganti.' : '' %></p>
  <p class="field-error" data-file-error role="alert" hidden></p>
  <% if (/image/.test(accept)) { %><img data-file-preview alt="Pratinjau gambar yang dipilih" class="mt-2 max-h-40 rounded-control border border-line" hidden><% } %>
  <% if (locals.error) { %><p id="<%= id %>-error" class="field-error"><%= locals.error %></p><% } %>
</div>
