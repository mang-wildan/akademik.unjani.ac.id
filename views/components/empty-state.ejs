<%#
  Keadaan kosong: menjelaskan dan memberi langkah berikutnya, rata kiri di bawah garis tebal (mockup v0.0.1).
  include('../components/empty-state', {
    emptyTitle: 'Dokumen tidak ditemukan',
    emptyText: 'Coba kata kunci lain.', emptyAction: { label: 'Hapus pencarian', href: '/dokumen-akademik' },
  })
  emptyIcon dari pemanggil lama diabaikan: ikon dekoratif tidak dipakai lagi.
%>
<div class="border-t border-ink pt-8 pb-4">
  <h2 class="font-serif text-[1.75rem] leading-8 font-bold tracking-[-0.01em] text-ink"><%= locals.emptyTitle %></h2>
  <% if (locals.emptyText) { %><p class="mt-2 max-w-xl text-[0.9375rem] leading-6 text-muted"><%= locals.emptyText %></p><% } %>
  <% if (locals.emptyAction) { %>
    <a href="<%= locals.emptyAction.href %>" class="link-arrow mt-3"><%= locals.emptyAction.label %><%- icon('arrow_right_alt') %></a>
  <% } %>
</div>
