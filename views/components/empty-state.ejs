<%#
  Keadaan kosong selalu menjelaskan dan memberi langkah berikutnya (v0.0.1).
  include('../components/empty-state', {
    emptyIcon: 'search', emptyTitle: 'Dokumen tidak ditemukan',
    emptyText: 'Coba kata kunci lain.', emptyAction: { label: 'Hapus pencarian', href: '/dokumen-akademik' },
  })
%>
<div class="flex flex-col items-center rounded-card border border-line bg-surface px-6 py-12 text-center">
  <span class="text-muted"><%- icon(locals.emptyIcon || 'info', 'size-8') %></span>
  <h2 class="mt-3 font-serif text-xl font-bold text-ink"><%= locals.emptyTitle %></h2>
  <% if (locals.emptyText) { %><p class="mt-1 max-w-md text-sm text-muted"><%= locals.emptyText %></p><% } %>
  <% if (locals.emptyAction) { %>
    <a href="<%= locals.emptyAction.href %>" class="btn btn-secondary mt-5"><%= locals.emptyAction.label %></a>
  <% } %>
</div>
