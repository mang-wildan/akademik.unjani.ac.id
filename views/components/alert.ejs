<%#
  Kotak catatan dengan aksen kiri 3px (mockup v0.0.1, "Alert gagal masuk").
  include('../components/alert', { alertTone: 'warning', alertTitle: 'Perpanjangan sedang diproses', alertText: '...' })
  alertTone: info | warning | danger | success
%>
<% const tone = locals.alertTone || 'info'; %>
<div class="rounded-r-control border-l-[3px] px-4 py-3.5 <%= { info: 'border-ink bg-sunken text-ink', warning: 'border-warning bg-warning-soft text-warning', danger: 'border-danger bg-danger-soft text-danger', success: 'border-success bg-success-soft text-success' }[tone] %>"
     role="<%= tone === 'danger' ? 'alert' : 'note' %>">
  <% if (locals.alertTitle) { %><p class="text-sm leading-5 font-bold"><%= locals.alertTitle %></p><% } %>
  <% if (locals.alertText) { %><p class="text-[0.8125rem] leading-[1.125rem] <%= locals.alertTitle ? 'mt-1' : '' %>"><%= locals.alertText %></p><% } %>
</div>
