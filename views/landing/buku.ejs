<%# Buku (FR-L-01): grid cover rata kiri, judul di bawah gambar. %>
<%- include('../components/page-header', {
  heading: 'Buku',
  lead: 'Koleksi buku panduan dan referensi.',
  metaLine: `${pagination.total} JUDUL${tahunList.length ? ' · ' + tahunList[tahunList.length - 1] + ' sampai ' + tahunList[0] : ''}`,
  breadcrumb: [{ label: 'Publikasi' }, { label: 'Buku' }],
}) %>

<div class="container-content pt-10 pb-20 lg:pt-12 lg:pb-28">
  <% if (tahunList.length > 1) { %>
  <nav class="mb-12 flex flex-wrap gap-8 border-b border-line pb-4" aria-label="Filter tahun buku">
    <a href="/buku" class="tab"<%- !filters.tahun ? ' aria-current="true"' : '' %>>Semua tahun</a>
    <% tahunList.forEach(y => { %><a href="/buku?tahun=<%= y %>" class="tab"<%- filters.tahun === String(y) ? ' aria-current="true"' : '' %>><%= y %></a><% }) %>
  </nav>
  <% } %>

  <% if (!books.length) { %>
    <%- include('../components/empty-state', { emptyIcon: 'menu_book', emptyTitle: 'Belum ada buku', emptyAction: filters.tahun ? { label: 'Lihat semua tahun', href: '/buku' } : null }) %>
  <% } else { %>
  <div class="grid grid-cols-2 gap-x-6 gap-y-12 sm:grid-cols-3 lg:grid-cols-5">
    <% books.forEach(b => { %>
      <article class="min-w-0">
        <a href="<%= b.src %>" target="_blank" rel="noopener" class="group block no-underline">
          <div class="book-cover">
            <img src="<%= b.cover %>" alt="" class="size-full object-cover" loading="lazy">
          </div>
          <h2 class="mt-4 font-sans text-base font-bold leading-snug text-ink transition-colors group-hover:text-primary"><%= b.title %></h2>
        </a>
        <p class="meta-sm mt-2 text-muted"><% if (b.year) { %>Tahun <%= b.year %> · <% } %>PDF</p>
      </article>
    <% }) %>
  </div>
  <%- include('../components/pagination', { ...pagination, noun: 'buku', path: '/buku', query: filters }) %>
  <% } %>
</div>
