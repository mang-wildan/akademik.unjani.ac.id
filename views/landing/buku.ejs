<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buku - BAA</title>
    <link rel="stylesheet" href="/assets/landing-page/css/main.css">
    <link rel="stylesheet" href="/assets/landing-page/css/responsive.css">
    <link rel="web icon" href="/assets/landing-page/images/favicon.ico">
</head>
<body>
    <!-- Header Section -->
    <%- include("../partials/landing-header") %>

    <!-- Sidebar Section -->
    <%- include("../partials/landing-aside") %>

    <!-- Main Section -->
    <main>
        <!-- Banner Inner Section -->
        <div class="section-wrapper pb-0">
            <div class="section-banner-inner banner-inner-service" style="background-image: url('<%= (siteSetting && siteSetting.bannerRpl) ? siteSetting.bannerRpl : '/assets/landing-page/images/hero-bg.jpg' %>'); background-size: cover; background-position: center;">
                <div class="hero-container">
                    <div class="d-flex flex-column gspace-2 text-center justify-content-center">
                        <h1 class="secondary-accent">Buku Panduan</h1>
                        <nav class="breadcrumb">
                            <a href="/" class="breadcrumb-item">Home</a>
                            <span class="breadcrumb-icon">/</span>
                            <span class="breadcrumb-item recent">Buku</span>
                        </nav>
                    </div>
                </div>
            </div>
        </div>

        <!-- Buku Section -->
        <div class="section">
            <div class="hero-container">
                <div class="d-flex flex-column gspace-4">
                    <div class="service-title-container">
                        <div class="row row-cols-md-1 row-cols-1 grid-spacer-2">
                            <div class="col">
                                <div class="d-flex flex-column gspace-2 justify-content-center text-md-start text-center">
                                    <div class="sub-heading col-2">
                                        <i class="fa-solid fa-circle accent-color-2"></i>
                                        <span class="sub-heading-title">Koleksi Buku</span>
                                    </div>
                                    <h2>Buku Panduan & Referensi</h2>
                                    <p class="text-muted">Jelajahi buku PDF lengkap dengan cover, judul, dan tahun terbit.</p>
                                </div>
                            </div>
                            <div class="col d-flex justify-content-center justify-content-md-end align-items-center">
                                <div class="badge accent-bg text-white px-3 py-2">
                                    Total: <%= (pagination && pagination.totalBooks) ? pagination.totalBooks : (books ? books.length : 0) %> buku
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center gap-3">
                        <div class="w-100 w-md-50">
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                                <input type="search" id="bookSearch" class="form-control" placeholder="Cari judul buku..." aria-label="Cari buku">
                            </div>
                        </div>
                        <div class="text-muted small">Ketik judul untuk memfilter buku secara langsung.</div>
                    </div>

                    <div class="row row-cols-xl-4 row-cols-md-3 row-cols-2 grid-spacer-2 w-100" id="bookGrid">
                        <% if (books && books.length) { %>
                          <% books.forEach(function(book, idx){ %>
                            <div class="col" data-title="<%= (book.title || '').toLowerCase() %>">
                              <div class="card card-service animate-box" data-animate="animate__fadeInUp">
                                <div class="image-container">
                                  <div class="service-icon-container">
                                    <div class="service-icon">
                                      <img src="/assets/landing-page/images/Icon-5.png" alt="Book" class="img-fluid">
                                    </div>
                                  </div>
                                  <div class="position-absolute top-0 start-0 m-3">
                                    <span class="badge accent-bg text-white px-3 py-2 shadow-sm">#<%= idx + 1 %></span>
                                  </div>
                                  <img src="<%= book.cover || '/assets/landing-page/images/dummy-img-600x800.jpg' %>" alt="<%= book.title %>" class="service-img">
                                </div>
                                <div class="card-body text-center d-flex flex-column gspace-2">
                                  <h5 class="primary-accent mb-0"><%= book.title %></h5>
                                  <div class="text-muted">Tahun: <%= book.year || '-' %></div>
                                  <% if (book.src) { %>
                                    <a href="<%= book.src %>" target="_blank" class="btn btn-outline-accent w-100">
                                      <span class="btn-title">Buka PDF</span>
                                      <span class="icon-circle"><i class="fa-solid fa-arrow-up-right-from-square"></i></span>
                                    </a>
                                  <% } %>
                                </div>
                              </div>
                            </div>
                          <% }); %>
                        <% } else { %>
                          <div class="col-12">
                            <div class="alert alert-warning text-center">Belum ada buku yang dapat ditampilkan.</div>
                          </div>
                        <% } %>
                    </div>

                    <% if (pagination && pagination.totalPages && pagination.totalPages > 1) { %>
                      <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-2 mt-3">
                        <div class="text-muted small">
                          Menampilkan <%= pagination.start %> - <%= pagination.end %> dari <%= pagination.totalBooks %> buku
                        </div>
                        <nav aria-label="Pagination buku">
                          <ul class="pagination justify-content-center mb-0">
                            <li class="page-item <%= pagination.currentPage === 1 ? 'disabled' : '' %>">
                              <a class="page-link" href="/buku?page=<%= pagination.currentPage - 1 %>" aria-label="Sebelumnya">&laquo;</a>
                            </li>
                            <% for (let p = 1; p <= pagination.totalPages; p++) { %>
                              <li class="page-item <%= p === pagination.currentPage ? 'active' : '' %>">
                                <a class="page-link" href="/buku?page=<%= p %>"><%= p %></a>
                              </li>
                            <% } %>
                            <li class="page-item <%= pagination.currentPage === pagination.totalPages ? 'disabled' : '' %>">
                              <a class="page-link" href="/buku?page=<%= pagination.currentPage + 1 %>" aria-label="Berikutnya">&raquo;</a>
                            </li>
                          </ul>
                        </nav>
                      </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer Section -->
    <%- include("../partials/landing-footer") %>

    <script src="/assets/landing-page/js/vendor/jquery.min.js"></script>
    <script src="/assets/landing-page/js/vendor/bootstrap.bundle.min.js"></script>
    <script src="/assets/landing-page/js/vendor/swiper-bundle.min.js"></script>
    <script src="/assets/landing-page/js/vendor/isotope.pkgd.min.js"></script>
    <script src="/assets/landing-page/js/vendor/flatpickr.min.js"></script>
    <script src="/assets/landing-page/js/script.js"></script>
    <script src="/assets/landing-page/js/submit-form.js"></script>
    <script src="/assets/landing-page/js/swiper-script.js"></script>
    <script>
      // Client-side search filter for buku
      (function () {
        const input = document.getElementById('bookSearch');
        const grid = document.getElementById('bookGrid');
        if (!input || !grid) return;
        const cards = Array.from(grid.querySelectorAll('.col[data-title]'));
        input.addEventListener('input', () => {
          const term = input.value.trim().toLowerCase();
          let visible = 0;
          cards.forEach(card => {
            const title = card.getAttribute('data-title') || '';
            const match = !term || title.includes(term);
            card.style.display = match ? '' : 'none';
            if (match) visible++;
          });
          // When no match, show simple message
          let empty = grid.querySelector('.no-match');
          if (visible === 0) {
            if (!empty) {
              empty = document.createElement('div');
              empty.className = 'col-12 no-match';
              empty.innerHTML = '<div class="alert alert-info text-center mb-0">Tidak ada buku yang cocok.</div>';
              grid.appendChild(empty);
            }
          } else if (empty) {
            empty.remove();
          }
        });
      })();
    </script>
</body>
</html>
