<%# Buku (FR-L-01): grid cover rata kiri, judul di bawah gambar. %>
<%- include('../components/page-header', {
  heading: 'Buku',
  lead: 'Koleksi buku panduan dan referensi.',
  breadcrumb: [{ label: 'Publikasi' }, { label: 'Buku' }],
}) %>

<div class="container-content pb-16">
  <% if (tahunList.length > 1) { %>
  <div class="mb-6 flex flex-wrap gap-2">
    <a href="/buku" class="badge <%= !filters.tahun ? 'badge-success' : 'badge-neutral' %>">Semua tahun</a>
    <% tahunList.forEach(y => { %><a href="/buku?tahun=<%= y %>" class="badge <%= filters.tahun === String(y) ? 'badge-success' : 'badge-neutral' %>"><%= y %></a><% }) %>
  </div>
  <% } %>

  <% if (!books.length) { %>
    <%- include('../components/empty-state', { emptyIcon: 'menu_book', emptyTitle: 'Belum ada buku', emptyAction: filters.tahun ? { label: 'Lihat semua tahun', href: '/buku' } : null }) %>
  <% } else { %>
  <div class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-5">
    <% books.forEach(b => { %>
      <article>
        <%# Dekoratif: judul di bawah membawa tautan yang sama dan bisa diakses. %>
        <a href="<%= b.src %>" target="_blank" rel="noopener" class="block overflow-hidden rounded-card border border-line bg-sunken shadow-card" aria-hidden="true" tabindex="-1">
          <img src="<%= b.cover %>" alt="" class="aspect-[3/4] w-full object-cover">
        </a>
        <a href="<%= b.src %>" target="_blank" rel="noopener" class="mt-2 inline-block line-clamp-2 py-1 text-sm font-semibold text-ink hover:text-primary"><%= b.title %></a>
        <% if (b.year) { %><p class="text-xs text-muted">Tahun <%= b.year %></p><% } %>
      </article>
    <% }) %>
  </div>
  <%- include('../components/pagination', { ...pagination, noun: 'buku', path: '/buku', query: filters }) %>
  <% } %>
</div>
