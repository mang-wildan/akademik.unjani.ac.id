<%# Pimpinan & Staf (FR-L-03): satu blok per tingkat dari atas ke bawah (utils/staffTingkat.js), kartu makin kecil ke bawah. NIP tidak pernah dikirim ke view ini (K-05). %>
<%- include('../components/page-header', {
  heading: 'Pimpinan & Staf',
  lead: 'Struktur kepemimpinan dan staf yang mendukung layanan akademik.',
  breadcrumb: [{ label: 'Profil' }, { label: 'Pimpinan & Staf' }],
}) %>
<%
  // Per tingkat: lebar kartu, ukuran foto, ukuran nama. Kunci = nilai tingkat. Baris flex terpusat: sisa kartu di baris terakhir tetap di tengah.
  const dua = 'w-[calc(50%-0.625rem)]'; // dua kartu per baris di HP
  const gaya = {
    'wakil-rektor': { kartu: 'w-full max-w-md', foto: 'size-32', nama: 'text-xl' },
    'kepala-biro': { kartu: 'w-full sm:w-80', foto: 'size-24', nama: 'text-lg' },
    'kepala-bagian': { kartu: `${dua} sm:w-56`, foto: 'size-20', nama: 'text-base' },
    'kepala-urusan': { kartu: `${dua} sm:w-52`, foto: 'size-16', nama: 'text-base' },
    'anggota': { kartu: `${dua} sm:w-44`, foto: 'size-14', nama: 'text-sm' },
  };
%>

<div class="container-content pb-16">
  <% if (!grup.length) { %>
    <%- include('../components/empty-state', { emptyIcon: 'groups', emptyTitle: 'Belum ada data pimpinan dan staf' }) %>
  <% } else { %>
    <% grup.forEach((g, i) => { const s = gaya[g.value]; %>
    <section aria-labelledby="tingkat-<%= g.value %>" class="relative <%= i ? 'pt-12' : '' %>">
      <%# Garis penghubung antartingkat: hanya hiasan. %>
      <% if (i) { %><span class="absolute top-0 left-1/2 h-8 w-px bg-accent" aria-hidden="true"></span><% } %>
      <h2 id="tingkat-<%= g.value %>" class="mb-6 text-center text-xl font-semibold"><span class="eyebrow"><%= g.label %></span></h2>
      <ul class="flex flex-wrap justify-center gap-5">
        <% g.items.forEach(p => { %>
          <li class="card card-body flex flex-col items-center text-center <%= s.kartu %>">
            <img src="<%= p.foto %>" alt="" class="<%= s.foto %> rounded-full object-cover" loading="lazy">
            <p class="mt-3 font-semibold text-ink <%= s.nama %>"><%= p.gelar ? `${p.gelar} ` : '' %><%= p.nama %></p>
            <p class="text-sm text-muted"><%= p.jabatan %></p>
          </li>
        <% }) %>
      </ul>
    </section>
    <% }) %>
  <% } %>
</div>
