<%# Pimpinan & Staf (FR-L-03): pimpinan kartu besar, staf grid kecil. NIP tidak pernah dikirim ke view ini (K-05). %>
<%- include('../components/page-header', {
  heading: 'Pimpinan & Staf',
  lead: 'Struktur kepemimpinan dan staf yang mendukung layanan akademik.',
  breadcrumb: [{ label: 'Profil' }, { label: 'Pimpinan & Staf' }],
}) %>

<div class="container-content pb-16">
  <% if (!pimpinan.length && !staf.length) { %>
    <%- include('../components/empty-state', { emptyIcon: 'groups', emptyTitle: 'Belum ada data pimpinan dan staf' }) %>
  <% } else { %>

  <% if (pimpinan.length) { %>
  <h2 class="mb-4 text-xl font-semibold">Pimpinan</h2>
  <div class="mb-10 grid gap-5 sm:grid-cols-2">
    <% pimpinan.forEach(p => { %>
      <div class="card card-body flex items-center gap-4">
        <img src="<%= p.foto %>" alt="" class="size-20 shrink-0 rounded-full object-cover">
        <div>
          <p class="font-semibold text-ink"><%= p.gelar ? `${p.gelar} ` : '' %><%= p.nama %></p>
          <p class="text-sm text-muted"><%= p.jabatan %></p>
        </div>
      </div>
    <% }) %>
  </div>
  <% } %>

  <% if (staf.length) { %>
  <h2 class="mb-4 text-xl font-semibold">Staf</h2>
  <div class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4">
    <% staf.forEach(s => { %>
      <div class="card card-body text-center">
        <img src="<%= s.foto %>" alt="" class="mx-auto size-20 rounded-full object-cover">
        <p class="mt-3 font-semibold text-ink"><%= s.gelar ? `${s.gelar} ` : '' %><%= s.nama %></p>
        <p class="text-sm text-muted"><%= s.jabatan %></p>
      </div>
    <% }) %>
  </div>
  <% } %>

  <% } %>
</div>
