<%# Struktur Organisasi (FR-L-04): gambar bagan + versi teks (daftar unit) untuk aksesibilitas. %>
<%- include('../components/page-header', {
  heading: 'Struktur Organisasi',
  lead: siteSetting && siteSetting.strukturOrganisasiUpdatedAt ? `Diperbarui ${formatTanggal(siteSetting.strukturOrganisasiUpdatedAt, { long: true })}.` : 'Struktur organisasi Bidang Akademik.',
  breadcrumb: [{ label: 'Profil' }, { label: 'Struktur Organisasi' }],
}) %>

<div class="container-content pb-16">
  <% if (siteSetting && siteSetting.strukturOrganisasiImage) { %>
    <div class="mb-8 rounded-card border border-line bg-surface p-4 sm:p-8">
      <img src="<%= siteSetting.strukturOrganisasiImage %>" alt="Bagan struktur organisasi Bidang Akademik Universitas Jenderal Achmad Yani" class="mx-auto max-w-full">
    </div>
  <% } else { %>
    <%- include('../components/empty-state', { emptyIcon: 'apartment', emptyTitle: 'Bagan struktur organisasi belum diunggah' }) %>
  <% } %>

  <% if (units.length) { %>
  <div class="max-w-3xl">
  <h2 class="mb-2 text-2xl">Unit di Bidang Akademik</h2>
  <p class="mb-4 text-sm text-muted">Versi teks dari bagan di atas, untuk pembaca layar dan pencarian.</p>
  <ul class="divide-y divide-line border-y border-line">
    <% units.forEach(u => { %>
      <li class="py-4">
        <p class="font-semibold text-ink"><%= u.nama %></p>
        <% if (u.deskripsi) { %><p class="mt-1 text-sm text-muted"><%= u.deskripsi %></p><% } %>
        <% if (u.link) { %><a href="<%= u.link %>" target="_blank" rel="noopener" class="mt-1 inline-flex min-h-11 items-center gap-1 text-sm font-semibold"><%- icon('open_in_new', 'size-4') %><%= u.link %></a><% } %>
      </li>
    <% }) %>
  </ul>
  </div>
  <% } %>
</div>
