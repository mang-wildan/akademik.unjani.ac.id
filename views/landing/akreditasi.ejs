<%# Akreditasi (FR-A-01..07). Status dihitung dari tanggal, tidak pernah disimpan. %>
<%- include('../components/page-header', {
  heading: 'Akreditasi',
  lead: 'Status akreditasi institusi dan program studi, dihitung otomatis dari tanggal berlaku sertifikat.',
  breadcrumb: [{ label: 'Akreditasi' }],
}) %>

<div class="container-content pt-10 pb-20 lg:pt-12 lg:pb-28">
  <% if (institusi.length) { %>
  <div class="mb-14 space-y-10">
    <% institusi.forEach(a => { %>
      <section class="grid gap-8 lg:grid-cols-2 lg:gap-16">
        <div>
          <h2 class="eyebrow">Akreditasi Institusi</h2>
          <p class="mt-3 font-serif text-7xl font-bold leading-none tracking-tight text-primary sm:text-[7.5rem]"><%= a.peringkat %></p>
        </div>
        <div>
          <dl class="divide-y divide-line border-t border-ink text-sm">
            <div class="flex items-center justify-between py-3"><dt class="text-xs text-muted uppercase">Lembaga</dt><dd class="font-semibold"><%= a.lembaga ? a.lembaga.singkatan : 'Belum diisi' %></dd></div>
            <% if (a.nomorSK) { %><div class="flex items-center justify-between py-3"><dt class="text-xs text-muted uppercase">Nomor SK</dt><dd class="font-semibold"><%= a.nomorSK %></dd></div><% } %>
            <div class="flex items-center justify-between py-3"><dt class="text-xs text-muted uppercase">Berlaku Sampai</dt><dd class="font-semibold"><%= formatTanggal(a.berlakuSampai) %></dd></div>
            <div class="flex items-center justify-between gap-4 py-3"><dt class="text-xs text-muted uppercase">Status</dt><dd class="font-semibold"><%= a.status.label %></dd></div>
          </dl>
          <% if (a.catatanPerpanjangan) { %><p class="mt-3 text-sm text-muted"><%= a.catatanPerpanjangan %></p><% } %>
          <% if (a.sertifikat) { %>
          <div class="mt-4">
            <a href="<%= a.sertifikat %>" target="_blank" rel="noopener" class="link-arrow">Lihat sertifikat (PDF)<%- icon('arrow_forward', 'size-4') %><span class="sr-only"> (tab baru)</span></a>
          </div>
          <% } %>
        </div>
      </section>
    <% }) %>
  </div>
  <% } %>

  <% if (peringkatStats.length) { %>
  <section class="mb-12 border-t border-ink pt-8">
    <p class="eyebrow">Sebaran Peringkat Akreditasi</p>
    <div class="mt-6 grid grid-cols-2 gap-6 sm:grid-cols-4">
      <% peringkatStats.forEach(p => { %>
        <div>
          <p class="font-serif text-4xl font-bold tracking-tight text-ink"><%= p.total %></p>
          <p class="mt-1 text-sm text-muted"><%= p.peringkat %></p>
        </div>
      <% }) %>
    </div>
  </section>
  <% } %>

  <form method="get" class="mb-8 grid gap-4 border-t border-ink pt-8 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <label for="q" class="field-label">Cari</label>
      <input id="q" name="q" type="search" class="field-control" placeholder="Nama program studi atau unit…" value="<%= filters.q %>">
    </div>
    <div>
      <label for="fakultas" class="field-label">Fakultas</label>
      <select id="fakultas" name="fakultas" class="field-control">
        <option value="">Semua fakultas</option>
        <% fakultasList.forEach(f => { %><option value="<%= f._id %>"<%= filters.fakultas === String(f._id) ? ' selected' : '' %>><%= f.nama %></option><% }) %>
      </select>
    </div>
    <div>
      <label for="status" class="field-label">Status</label>
      <select id="status" name="status" class="field-control">
        <option value="">Semua status</option>
        <option value="berlaku"<%= filters.status === 'berlaku' ? ' selected' : '' %>>Berlaku</option>
        <option value="segera-berakhir"<%= filters.status === 'segera-berakhir' ? ' selected' : '' %>>Segera berakhir</option>
        <option value="kedaluwarsa"<%= filters.status === 'kedaluwarsa' ? ' selected' : '' %>>Kedaluwarsa</option>
      </select>
    </div>
    <div class="flex items-end gap-2 lg:col-span-4">
      <button type="submit" class="btn btn-primary"><%- icon('filter_list') %>Terapkan</button>
      <% if (filters.q || filters.status || filters.fakultas) { %><a href="/akreditasi" class="btn btn-secondary">Reset</a><% } %>
    </div>
  </form>

  <% if (!rows.length) { %>
    <%- include('../components/empty-state', {
      emptyIcon: 'search', emptyTitle: 'Tidak ada data yang cocok',
      emptyText: 'Coba ubah kata kunci atau filter.', emptyAction: { label: 'Hapus filter', href: '/akreditasi' },
    }) %>
  <% } else { %>
  <div class="overflow-hidden border-t border-ink">
    <table class="data-table data-table--stack">
      <caption class="sr-only">Daftar akreditasi program studi dan unit</caption>
      <thead>
        <tr>
          <th scope="col">Unit / Program Studi</th>
          <th scope="col">Fakultas</th>
          <th scope="col">Peringkat</th>
          <th scope="col">Lembaga</th>
          <th scope="col">Berlaku s.d.</th>
          <th scope="col">Status</th>
          <th scope="col">Sertifikat</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(r => { %>
          <tr>
            <td data-label="Unit / Program Studi" class="font-medium"><%= r.label %></td>
            <td data-label="Fakultas" class="text-muted"><%= r.programStudi?.fakultas?.nama || 'Belum diisi' %></td>
            <td data-label="Peringkat"><span class="font-semibold text-ink"><%= r.peringkat %></span></td>
            <td data-label="Lembaga" class="text-muted"><%= r.lembaga?.singkatan || 'Belum diisi' %></td>
            <td data-label="Berlaku s.d."><%= formatTanggal(r.berlakuSampai) %></td>
            <td data-label="Status"><%- include('../components/badge', { text: r.status.label, tone: r.status.tone }) %></td>
            <td data-label="Sertifikat"><a href="<%= r.sertifikat %>" target="_blank" rel="noopener" class="inline-flex min-h-11 min-w-11 items-center gap-1 text-sm font-semibold"><%- icon('download', 'size-4') %><span class="max-md:inline md:sr-only">Unduh sertifikat <%= r.label %></span></a></td>
          </tr>
          <% if (r.history.length) { %>
          <tr>
            <td colspan="7" class="!py-0 max-md:!block">
              <details class="py-2">
                <summary class="cursor-pointer py-2 text-sm font-semibold text-primary">Riwayat (<%= r.history.length %>)</summary>
                <ul class="mb-2 divide-y divide-line md:hidden">
                  <% r.history.forEach(h => { %>
                    <li class="flex flex-wrap items-center gap-x-3 gap-y-1 py-3 text-sm">
                      <span class="font-semibold text-ink"><%= h.peringkat %></span>
                      <%- include('../components/badge', { text: accreditationStatus(h.berlakuSampai).label, tone: accreditationStatus(h.berlakuSampai).tone }) %>
                      <span class="w-full text-muted"><%= formatRentangTanggal(h.tanggalBerlaku, h.berlakuSampai) %></span>
                      <a href="<%= h.sertifikat %>" target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-1 font-semibold"><%- icon('download', 'size-4') %>Lihat sertifikat<span class="sr-only"> <%= h.peringkat %> (tab baru)</span></a>
                    </li>
                  <% }) %>
                </ul>
                <table class="data-table mb-2 max-md:hidden">
                  <caption class="sr-only">Riwayat akreditasi <%= r.label %></caption>
                  <thead><tr><th scope="col">Peringkat</th><th scope="col">Berlaku</th><th scope="col">Status</th><th scope="col">Sertifikat</th></tr></thead>
                  <tbody>
                    <% r.history.forEach(h => { %>
                      <tr>
                        <td data-label="Peringkat"><span class="font-semibold text-ink"><%= h.peringkat %></span></td>
                        <td data-label="Berlaku"><%= formatRentangTanggal(h.tanggalBerlaku, h.berlakuSampai) %></td>
                        <td data-label="Status"><%- include('../components/badge', { text: accreditationStatus(h.berlakuSampai).label, tone: accreditationStatus(h.berlakuSampai).tone }) %></td>
                        <td data-label="Sertifikat"><a href="<%= h.sertifikat %>" target="_blank" rel="noopener" class="inline-flex min-h-11 min-w-11 items-center text-sm font-semibold">Lihat</a></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </details>
            </td>
          </tr>
          <% } %>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%- include('../components/pagination', { ...pagination, noun: 'data', path: '/akreditasi', query: filters }) %>
  <% } %>
</div>
