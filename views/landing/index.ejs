<%# Beranda editorial v0.0.1 mengikuti preview: hero krem, foto kampus, agenda mengambang.
    Setiap seksi data hilang bila kosong; latar unit/video mengikuti seksi sebelumnya. %>
<%
  const aksesCepat = [
    { label: 'Kalender Akademik', desc: 'Jadwal kegiatan & masa perkuliahan', href: '/kalender-akademik', icon: 'event' },
    { label: 'Dokumen & Formulir', desc: 'Unduh berkas dan formulir resmi', href: '/dokumen-akademik', icon: 'description' },
    { label: 'Kurikulum', desc: 'Struktur kurikulum program studi', href: '/kurikulum', icon: 'menu_book' },
    { label: 'Akreditasi', desc: 'Status akreditasi BAN-PT & LAM', href: '/akreditasi', icon: 'workspace_premium' },
  ];
  const adaMutu = institusiAcc.length || peringkatStats.length;
  const adaPita = adaMutu || lulusan;
  // Validator hanya menerima http(s); cek ulang di sini untuk nilai yang tersimpan sebelum itu.
  const videoUrl = setting && /^https?:\/\//i.test(setting.landingVideoUrl || '') ? videoEmbedUrl(setting.landingVideoUrl) : '';
  const sesudahBerita = kegiatanTerbaru.length && !adaPita && !pengumumanTerbaru.length; // pita sebelumnya = berita (hijau muda)
  const unitBand = sesudahBerita ? 'section-surface' : 'section-soft';
  const videoBand = units.length ? (unitBand === 'section-soft' ? 'section-surface' : 'section-soft') : sesudahBerita ? 'section-surface' : 'section-soft';
%>

<section class="home-hero" data-enter aria-labelledby="hero-judul">
  <div class="container-content home-hero-grid">
    <div class="home-hero-frame">
      <%# Foto asli kampus; ukuran sumber disamakan dengan preload layout. %>
      <div class="home-hero-photo photo">
        <img src="/img/hero-kampus.webp" srcset="/img/hero-kampus-800.webp 800w, /img/hero-kampus.webp 1600w" sizes="100vw" alt="Kampus Universitas Jenderal Achmad Yani" class="size-full object-cover" width="1600" height="903" fetchpriority="high">
      </div>
      <div class="home-hero-copy">
        <p class="kicker">Portal resmi layanan akademik</p>
        <h1 id="hero-judul" class="display mt-4">Layanan akademik Universitas Jenderal Achmad Yani.</h1>
        <p class="mt-6 max-w-md text-base text-muted">Kalender, kurikulum, dokumen, dan informasi akademik resmi dalam satu tempat.</p>
        <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href="/pengumuman" class="btn btn-primary btn-lg">Pengumuman terbaru<%- icon('arrow_right_alt') %></a>
          <a href="/profil" class="link inline-flex min-h-11 items-center text-sm">Profil Bidang Akademik</a>
        </div>
      </div>
    </div>
    <% if (agendaItems.length) { %>
    <section class="home-agenda border border-line bg-surface p-5 shadow-raised sm:p-6" aria-labelledby="agenda-judul">
      <div class="flex items-center justify-between gap-4 border-b border-line pb-2">
        <h2 id="agenda-judul" class="kicker font-normal">Agenda terdekat</h2>
        <a href="/kalender-akademik" class="link-arrow text-sm">Kalender<%- icon('arrow_right_alt', 'size-5') %></a>
      </div>
      <ul class="divide-y divide-line">
        <% agendaItems.forEach(e => { const tanggal = tanggalBlok(e.mulai); %>
          <li class="grid grid-cols-[3.5rem_1fr] gap-4 py-3">
            <% if (tanggal) { %><time datetime="<%= tanggal.iso %>" class="date-mono pt-0.5 text-xs"><%= String(tanggal.day).padStart(2, '0') %> <%= tanggal.month %></time><% } else { %><span>-</span><% } %>
            <div class="min-w-0">
              <h3 class="font-sans text-sm leading-5 font-bold"><%= e.nama %></h3>
              <p class="mt-1 text-xs text-muted"><%= formatRentangTanggal(e.mulai, e.selesai) %> · <%= e.status.label %></p>
            </div>
          </li>
        <% }) %>
      </ul>
    </section>
    <% } %>
  </div>
</section>

<div class="container-content pb-14 lg:pb-20">

  <section class="pb-16" aria-labelledby="akses-judul">
    <h2 id="akses-judul" class="sr-only">Akses cepat</h2>
    <ul class="home-shortcuts grid border-t border-ink sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <% aksesCepat.forEach((a, i) => { %>
        <li class="border-b border-line sm:not-last:border-r <%= i === 0 ? 'on-brand bg-brand text-white' : '' %>">
          <a href="<%= a.href %>" class="group block h-full p-6 no-underline <%= i === 0 ? 'hover:bg-primary-hover' : 'text-ink hover:bg-sunken' %>">
            <span class="flex items-center justify-between font-mono text-xs <%= i === 0 ? 'text-on-brand-muted' : 'text-muted' %>"><span>0<%= i + 1 %></span><%- icon('arrow_right_alt', 'row-arrow size-5 ' + (i === 0 ? 'text-white' : '')) %></span>
            <span class="mt-4 block font-serif text-2xl font-bold"><%= a.label %></span>
            <span class="mt-2 block text-sm <%= i === 0 ? 'text-on-brand-muted' : 'text-muted' %>"><%= a.desc %></span>
          </a>
        </li>
      <% }) %>
    </ul>
  </section>
  <% if (informasiPenting.length) { %>
  <section class="grid gap-8 py-4 lg:grid-cols-[18rem_1fr] lg:gap-12" aria-labelledby="info-penting">
    <div>
      <p class="eyebrow">Disematkan</p>
      <h2 id="info-penting" class="section-title mt-4">Informasi<br class="hidden lg:block"> penting</h2>
      <p class="mt-2 text-sm text-muted">Pengumuman, dokumen, dan berita yang disematkan Bidang Akademik.</p>
    </div>

    <ul class="divide-y divide-line border-y border-line">
      <% informasiPenting.forEach(i => { const pdf = i.jenis === 'Dokumen'; %>
        <li class="group relative flex flex-wrap items-center justify-between gap-4 py-4">
          <div class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-5 gap-y-1">
            <time datetime="<%= new Date(i.tanggal).toISOString() %>" class="meta-sm shrink-0"><%= formatTanggal(i.tanggal) %></time>
            <span class="meta-sm text-primary"><%= pdf ? 'Dokumen · PDF' : i.jenis %></span>
            <a href="<%= i.href %>" class="min-w-0 flex-1 font-semibold text-ink no-underline after:absolute after:inset-0 group-hover:text-primary"<%- pdf ? ' target="_blank" rel="noopener"' : '' %>><%= i.judul %><% if (pdf) { %><span class="sr-only"> (PDF, tab baru)</span><% } %></a>
          </div>
          <%- icon(pdf ? 'open_in_new' : 'arrow_forward', 'size-4 shrink-0 text-muted group-hover:text-primary') %>
        </li>
      <% }) %>
    </ul>
  </section>
  <% } %>
</div>

<% if (kegiatanTerbaru.length) { %>
<section class="section" aria-labelledby="kegiatan-judul">
  <div class="container-content">
    <%- include('../components/section-heading', { sectionHeading: 'Kegiatan Akademik', sectionLink: { label: 'Lihat semua berita', href: '/berita' }, sectionId: 'kegiatan-judul' }) %>
    <% const [beritaUtama, ...beritaLain] = kegiatanTerbaru; %>
    <div class="grid gap-8 <%= beritaLain.length ? 'lg:grid-cols-[1.5fr_1fr]' : '' %>">
      <article class="group relative flex flex-col">
        <div class="photo aspect-[72/43] border border-line"><% if (beritaUtama.featuredImage) { %><img src="<%= beritaUtama.featuredImage %>" alt="" class="size-full object-cover" loading="lazy"><% } else { %><span class="flex size-full items-center justify-center text-muted"><%- icon('newspaper', 'size-10') %></span><% } %></div>
        <p class="meta mt-5">
          <% if (beritaUtama.kategori) { %><span class="text-primary"><%= beritaUtama.kategori.nama %></span> · <% } %><time datetime="<%= new Date(beritaUtama.createdAt).toISOString() %>"><%= formatTanggal(beritaUtama.createdAt, { long: true }) %></time>
        </p>
        <h3 class="subsection-title mt-3">
          <a href="/berita/<%= beritaUtama.slug %>" class="text-ink no-underline after:absolute after:inset-0 group-hover:text-primary"><%= beritaUtama.title %></a>
        </h3>
        <% if (beritaUtama.excerpt) { %><p class="mt-3 line-clamp-3 text-[0.9375rem] leading-6 text-muted"><%= beritaUtama.excerpt %></p><% } %>
      </article>

      <% if (beritaLain.length) { %>
      <div class="divide-y divide-line border-t border-ink">
        <% beritaLain.forEach(n => { %>
          <article class="group relative flex items-start justify-between gap-4 py-6">
            <div class="min-w-0 flex-1">
              <p class="meta-sm">
                <% if (n.kategori) { %><span class="text-primary"><%= n.kategori.nama %></span> · <% } %><time datetime="<%= new Date(n.createdAt).toISOString() %>"><%= formatTanggal(n.createdAt) %></time>
              </p>
              <h3 class="mt-2 font-sans text-lg leading-snug font-bold">
                <a href="/berita/<%= n.slug %>" class="line-clamp-2 text-ink no-underline after:absolute after:inset-0 group-hover:text-primary"><%= n.title %></a>
              </h3>
            </div>
            <% if (n.featuredImage) { %><img src="<%= n.featuredImage %>" alt="" class="photo h-[100px] w-[132px] shrink-0 object-cover" loading="lazy"><% } %>
          </article>
        <% }) %>
      </div>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<% if (adaPita) { %>
<%# Satu pita, dua wilayah berlabel sendiri (mutu & lulusan) agar pembaca layar tidak mengumumkan statistik lulusan di bawah judul "Status Mutu". %>
<div class="section section-dark">
  <div class="container-content grid gap-12 <%= adaMutu && lulusan ? 'lg:grid-cols-2 lg:items-start' : '' %>">
    <% if (adaMutu) { %>
    <section aria-labelledby="mutu-judul">
      <h2 id="mutu-judul" class="kicker font-normal text-on-brand-label">Penjaminan mutu</h2>
      <% if (institusiAcc.length) { %>
      <ul class="mt-2 space-y-6">
        <% institusiAcc.forEach(a => { %>
          <li>
            <p class="font-serif text-[clamp(4rem,8vw,8.5rem)] leading-none font-bold tracking-tight text-white"><%= a.peringkat %></p>
            <p class="mt-6 text-sm text-on-brand-muted">Akreditasi institusi · <%= a.lembaga ? a.lembaga.singkatan : 'Belum diisi' %> · berlaku s.d. <%= formatTanggal(a.berlakuSampai) %></p>
            <p class="mt-1 text-xs text-on-brand-muted"><%= a.status.label %></p>
          </li>
        <% }) %>
      </ul>
      <% } %>
      <% if (peringkatStats.length) { %>
      <div class="mt-6">
        <p class="text-sm font-semibold text-white">Akreditasi program studi yang berlaku</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          <% peringkatStats.forEach(p => { %>
            <li class="border-t border-white/25 px-3 py-2 text-sm text-on-brand-muted"><span class="font-serif text-lg font-bold text-white"><%= p.total %></span> prodi <%= p.peringkat %></li>
          <% }) %>
        </ul>
      </div>
      <% } %>
      <a href="/akreditasi" class="link-arrow mt-5 text-white">Lihat data akreditasi<%- icon('arrow_right_alt') %></a>
    </section>
    <% } %>

    <% if (lulusan) { %>
    <%
      const persen = lulusan.persenPerubahan;
      const arah = persen === null ? null : persen > 0 ? 'naik' : persen < 0 ? 'turun' : 'tetap';
      const persenTeks = persen === null ? '' : `${persen > 0 ? '+' : persen < 0 ? '−' : ''}${String(Math.abs(persen)).replace('.', ',')}%`;
      const sel = 'flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-white/25 py-4';
      const nilai = 'font-serif text-4xl leading-none font-bold tabular-nums sm:text-5xl xl:text-6xl';
    %>
    <section aria-labelledby="lulusan-judul">
      <h2 id="lulusan-judul" class="kicker mb-8 font-normal text-on-brand-label">Lulusan</h2>
      <dl class="border-t border-white/25">
        <div class="<%= sel %>">
          <dt class="text-sm text-on-brand-muted">Lulusan tahun <%= lulusan.tahun %></dt>
          <dd class="<%= nilai %> text-white"><%= formatAngka(lulusan.total) %></dd>
        </div>
        <div class="<%= sel %>">
          <dt class="text-sm text-on-brand-muted">Total lulusan tercatat</dt>
          <dd class="<%= nilai %> text-white"><%= formatAngka(lulusan.totalSemua) %></dd>
        </div>
        <% if (persen !== null) { %>
        <div class="<%= sel %>">
          <dt class="text-sm text-on-brand-muted">Dibanding tahun sebelumnya</dt>
          <dd class="flex items-center gap-2 <%= nilai %> <%= arah === 'naik' ? 'text-on-brand-muted' : 'text-white' %>">
            <%- icon(arah === 'naik' ? 'trending_up' : arah === 'turun' ? 'trending_down' : 'trending_flat', 'size-7') %><span><span class="sr-only"><%= arah %> </span><%= persenTeks %></span>
          </dd>
        </div>
        <% } %>
      </dl>
    </section>
    <% } %>
  </div>
</div>
<% } %>

<% if (pengumumanTerbaru.length) { %>
<section class="section" aria-labelledby="pengumuman-judul">
  <div class="container-content">
    <%- include('../components/section-heading', { sectionHeading: 'Pengumuman Terbaru', sectionLead: 'Informasi resmi seputar administrasi dan layanan akademik.', sectionLink: { label: 'Lihat semua pengumuman', href: '/pengumuman' }, sectionId: 'pengumuman-judul' }) %>
    <% const [utama, ...lain] = pengumumanTerbaru; %>
    <div class="grid gap-10 <%= lain.length ? 'lg:grid-cols-2' : '' %>">
      <article class="group relative border-t border-ink pt-5">
        <p class="text-xs font-semibold text-primary uppercase"><% if (utama.pinned) { %>Disematkan<% } %><% if (utama.pinned && utama.kategori) { %> · <% } %><% if (utama.kategori) { %><%= utama.kategori.nama %><% } %></p>
        <div class="mt-4 flex items-start gap-5">
          <%- include('../components/date-block', { date: utama.createdAt, accent: true }) %>
        </div>
        <div class="mt-5">
          <h3 class="subsection-title min-w-0"><a href="/pengumuman/<%= utama.slug %>" class="text-ink no-underline after:absolute after:inset-0 group-hover:text-primary"><%= utama.title %></a></h3>
        </div>
        <% if (utama.excerpt) { %><p class="mt-4 text-muted"><%= utama.excerpt %></p><% } %>
        <p class="mt-5 flex items-center gap-2 text-sm font-semibold text-primary" aria-hidden="true">Baca selengkapnya<%- icon('arrow_forward', 'size-4') %></p>
      </article>
      <% if (lain.length) { %>
      <ul class="divide-y divide-line border-t border-ink">
        <% lain.forEach(p => { %>
          <li class="group relative flex items-start gap-5 py-5">
            <%- include('../components/date-block', { date: p.createdAt }) %>
            <div class="min-w-0 flex-1">
              <h3 class="font-sans text-base leading-snug font-semibold"><a href="/pengumuman/<%= p.slug %>" class="text-ink no-underline after:absolute after:inset-0 group-hover:text-primary"><%= p.title %></a></h3>
              <% if (p.kategori) { %><p class="mt-1 text-xs text-muted"><%= p.kategori.nama %></p><% } %>
            </div>
            <%- icon('arrow_forward', 'size-4 shrink-0 text-muted') %>
          </li>
        <% }) %>
      </ul>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<% if (units.length) { %>
<section class="section <%= unitBand %>" aria-labelledby="unit-judul" aria-roledescription="carousel" x-data="carousel">
  <div class="container-content">
    <%- include('../components/section-heading', { sectionHeading: 'Unit Kerja Bidang Akademik', sectionLead: 'Unit yang melayani kebutuhan akademik sivitas akademika.', sectionId: 'unit-judul' }) %>
    <div class="-mt-4 mb-4 flex justify-end gap-2" x-show="canScroll" x-cloak>
      <button type="button" class="btn-icon border border-line bg-surface" @click="prev" aria-label="Unit sebelumnya"><%- icon('chevron_left') %></button>
      <button type="button" class="btn-icon border border-line bg-surface" @click="toggle" :aria-label="toggleLabel">
        <span x-show="playing"><%- icon('pause') %></span><span x-show="!playing"><%- icon('play_arrow') %></span>
      </button>
      <button type="button" class="btn-icon border border-line bg-surface" @click="next" aria-label="Unit berikutnya"><%- icon('chevron_right') %></button>
    </div>
    <%# Jalur gulir CSS (scroll-snap): sentuhan/geser native, tombol hanya memanggil scrollBy. Jeda otomatis saat kursor/fokus di dalam. %>
    <ul x-ref="track" :class="centerClass" class="-mx-1 flex snap-x snap-mandatory gap-5 overflow-x-auto px-1 pb-4 [scrollbar-width:none] motion-safe:scroll-smooth [&::-webkit-scrollbar]:hidden"
        @mouseenter="hold" @mouseleave="release" @focusin="hold" @focusout="release">
      <% units.forEach(u => { %>
        <li class="group relative shrink-0 basis-[85%] snap-start overflow-hidden sm:basis-[calc((100%-1.25rem)/2)] lg:basis-[calc((100%-2.5rem)/3)]">
          <img src="<%= u.img %>" alt="" class="aspect-[4/3] w-full rounded-card object-cover" loading="lazy" width="900" height="675">
          <div class="pt-4">
            <h3 class="font-sans text-base leading-snug font-semibold text-ink"><%= u.nama %></h3>
            <% if (u.link) { %><a href="<%= u.link %>" target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-primary">Kunjungi unit<span class="sr-only"> <%= u.nama %> (tab baru)</span><%- icon('open_in_new', 'size-4') %></a><% } %>
          </div>
        </li>
      <% }) %>
    </ul>
  </div>
</section>
<% } %>

<% if (videoUrl) { %>
<section class="section <%= videoBand %>" aria-labelledby="video-judul">
  <div class="container-content max-w-5xl">
    <%- include('../components/section-heading', { sectionHeading: 'Video Profil', sectionAlign: 'center', sectionId: 'video-judul' }) %>
    <div class="aspect-video overflow-hidden rounded-card border border-line">
      <iframe src="<%= videoUrl %>" title="Video Profil Bidang Akademik" class="size-full" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
  </div>
</section>
<% } %>
