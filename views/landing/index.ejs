    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        window.LANDING_SLIDES = <%- JSON.stringify((setting && setting.slideshowImages && setting.slideshowImages.length) ? setting.slideshowImages : []) %>;
        window.AKREDITASI_DATA = <%- JSON.stringify(typeof accreditationChart !== 'undefined' ? accreditationChart : []) %>;
        window.LULUSAN_DATA = <%- JSON.stringify(typeof lulusanChart !== 'undefined' ? lulusanChart : { labels: [], datasets: [], total: 0 }) %>;
    </script>
    <script src="/assets/landing-page/js/banner.js"></script>
    <script src="/assets/landing-page/js/script.js"></script>
    <script src="/assets/landing-page/js/submit-form.js"></script>
    <script src="/assets/landing-page/js/swiper-script.js"></script>
    <script src="/assets/landing-page/js/video_embedded.js"></script>
    <script>
      (function(){
        const canvas = document.getElementById('akreditasiChart');
        if(!canvas || !window.Chart) return;
        const section = document.getElementById('akreditasi-section');
        const source = Array.isArray(window.AKREDITASI_DATA) ? window.AKREDITASI_DATA : [];
        const palette = ['#0ea5e9', '#22c55e', '#f59e0b', '#8b5cf6', '#ef4444', '#14b8a6', '#f97316', '#6366f1'];
        const activeCategories = source
          .map((item, idx) => ({
            label: String(item && item.label ? item.label : '').trim(),
            value: Number(item && item.value ? item.value : 0) || 0,
            color: palette[idx % palette.length]
          }))
          .filter((item) => item.label && item.value > 0);
        const chartCategories = activeCategories.length
          ? activeCategories
          : [{ label: 'Belum Ada Data', value: 0, color: '#94a3b8' }];
        const labels = chartCategories.map((item) => item.label);
        const targetValues = chartCategories.map((item) => item.value);
        const backgroundColor = chartCategories.map((item) => item.color);
        const maxValue = targetValues.length ? Math.max(...targetValues) : 0;

        let chart = null;
        let hasAnimated = false;
        const hexToRgba = function(hex, alpha) {
          const fallback = `rgba(148, 163, 184, ${alpha})`;
          const raw = String(hex || '').replace('#', '').trim();
          if (!raw) return fallback;
          const normalized = raw.length === 3
            ? raw.split('').map((ch) => ch + ch).join('')
            : raw;
          if (!/^[0-9a-f]{6}$/i.test(normalized)) return fallback;
          const intValue = parseInt(normalized, 16);
          const r = (intValue >> 16) & 255;
          const g = (intValue >> 8) & 255;
          const b = intValue & 255;
          return `rgba(${r}, ${g}, ${b}, ${alpha})`;
        };
        const barShadowPlugin = {
          id: 'akreditasiBarShadow',
          beforeDatasetDraw: function(chartInstance, args) {
            if (args.index !== 0) return;
            const ctx = chartInstance.ctx;
            ctx.save();
            ctx.shadowColor = 'rgba(15, 23, 42, 0.18)';
            ctx.shadowBlur = 16;
            ctx.shadowOffsetY = 8;
          },
          afterDatasetDraw: function(chartInstance, args) {
            if (args.index !== 0) return;
            chartInstance.ctx.restore();
          }
        };
        const valueLabelPlugin = {
          id: 'akreditasiValueLabel',
          afterDatasetsDraw: function(chartInstance) {
            const dataset = chartInstance.data && chartInstance.data.datasets && chartInstance.data.datasets[0];
            const meta = chartInstance.getDatasetMeta(0);
            if (!dataset || !meta || !meta.data) return;

            const ctx = chartInstance.ctx;
            ctx.save();
            ctx.font = '600 11px sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';

            meta.data.forEach(function(bar, idx) {
              const value = Number(dataset.data[idx]);
              if (!Number.isFinite(value) || value <= 0) return;
              const barHeight = Math.abs(bar.base - bar.y);
              if (barHeight < 16) return;
              const x = bar.x;
              const y = bar.y + ((bar.base - bar.y) / 2);
              ctx.fillStyle = '#ffffff';
              ctx.shadowColor = 'rgba(15, 23, 42, 0.45)';
              ctx.shadowBlur = 2;
              ctx.fillText(String(value), x, y);
              ctx.shadowBlur = 0;
            });

            ctx.restore();
          }
        };

        const renderAndAnimate = function() {
          if (hasAnimated) return;
          hasAnimated = true;

          chart = new Chart(canvas, {
            type: 'bar',
            plugins: [barShadowPlugin, valueLabelPlugin],
            data: {
              labels,
              datasets: [{
                label: 'Jumlah Data',
                data: targetValues.map(() => 0),
                backgroundColor: function(context) {
                  const idx = context.dataIndex;
                  const baseColor = backgroundColor[idx] || '#94a3b8';
                  const chartArea = context.chart && context.chart.chartArea;
                  if (!chartArea) return baseColor;

                  const gradient = context.chart.ctx.createLinearGradient(0, chartArea.top, 0, chartArea.bottom);
                  gradient.addColorStop(0, hexToRgba(baseColor, 0.96));
                  gradient.addColorStop(1, hexToRgba(baseColor, 0.46));
                  return gradient;
                },
                borderColor: function(context) {
                  return backgroundColor[context.dataIndex] || '#94a3b8';
                },
                borderWidth: 1.5,
                borderRadius: 0,
                borderSkipped: false,
                hoverBorderWidth: 2.2,
                hoverBackgroundColor: function(context) {
                  const baseColor = backgroundColor[context.dataIndex] || '#94a3b8';
                  return hexToRgba(baseColor, 0.98);
                }
              }]
            },
            options: {
              responsive: true,
              animation: {
                duration: 2400,
                easing: 'easeOutCubic',
                delay: function(context) {
                  if (context.type !== 'data' || context.mode !== 'default') return 0;
                  return context.dataIndex * 140;
                }
              },
              interaction: {
                mode: 'index',
                intersect: false
              },
              scales: {
                y: {
                  beginAtZero: true,
                  suggestedMax: Math.max(maxValue + 1, 2),
                  grace: '18%',
                  ticks: {
                    stepSize: 1,
                    color: '#cbd5e1',
                    font: { weight: '600' },
                    callback: function(value) {
                      return Number.isInteger(value) ? value : '';
                    }
                  },
                  grid: { drawBorder: false, color: '#ffffff' }
                },
                x: {
                  ticks: { color: '#e2e8f0', font: { weight: '700' } },
                  grid: { drawBorder: false, color: '#ffffff' }
                }
              },
              plugins: {
                legend: { display: false },
                tooltip: {
                  displayColors: false,
                  backgroundColor: 'rgba(15, 23, 42, 0.96)',
                  titleColor: '#ffffff',
                  bodyColor: '#e2e8f0',
                  borderColor: 'rgba(148,163,184,0.35)',
                  borderWidth: 1,
                  padding: 10,
                  callbacks: {
                    title: function(items) {
                      return items && items[0] ? `Akreditasi ${items[0].label}` : 'Akreditasi';
                    },
                    label: function(ctx) {
                      return `Jumlah: ${ctx.raw} data`;
                    }
                  }
                }
              }
            }
          });

          requestAnimationFrame(function() {
            if (!chart) return;
            chart.data.datasets[0].data = targetValues;
            chart.update();
          });
        };

        if (!section) {
          renderAndAnimate();
          return;
        }

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
              if (!entry.isIntersecting) return;
              renderAndAnimate();
              observer.disconnect();
            });
          }, { threshold: 0.35 });
          observer.observe(section);
          return;
        }

        const onScroll = function() {
          const rect = section.getBoundingClientRect();
          const viewport = window.innerHeight || document.documentElement.clientHeight || 0;
          const isVisible = rect.top <= viewport * 0.75 && rect.bottom >= viewport * 0.25;
          if (!isVisible) return;

          renderAndAnimate();
          window.removeEventListener('scroll', onScroll);
          window.removeEventListener('resize', onScroll);
        };

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        onScroll();
      })();

      (function(){
        const ctx = document.getElementById('lulusanChart');
        if(!ctx || !window.Chart) return;
        const source = window.LULUSAN_DATA || { labels: [], datasets: [] };
        const lulusanValueLabelPlugin = {
          id: 'lulusanValueLabel',
          afterDatasetsDraw: function(chartInstance) {
            const chartCtx = chartInstance.ctx;
            chartCtx.save();
            chartCtx.font = '700 10px sans-serif';
            chartCtx.textAlign = 'center';
            chartCtx.textBaseline = 'middle';

            chartInstance.data.datasets.forEach(function(dataset, datasetIndex){
              const meta = chartInstance.getDatasetMeta(datasetIndex);
              if (!meta || !meta.data) return;

              meta.data.forEach(function(bar, dataIndex){
                const value = Number(dataset.data && dataset.data[dataIndex]);
                if (!Number.isFinite(value) || value <= 0) return;
                const segmentHeight = Math.abs(bar.base - bar.y);
                if (segmentHeight < 16) return;

                const x = bar.x;
                const y = bar.y + ((bar.base - bar.y) / 2);
                chartCtx.fillStyle = 'rgba(255,255,255,0.95)';
                chartCtx.fillText(String(value), x, y);
              });
            });

            chartCtx.restore();
          }
        };
        new Chart(ctx, {
          type: 'bar',
          plugins: [lulusanValueLabelPlugin],
          data: {
            labels: source.labels || [],
            datasets: (source.datasets || []).map(ds => ({
              ...ds,
              borderSkipped: false,
              borderRadius: 0,
              stack: 'periode'
            }))
          },
          options: {
            responsive: true,
            animation: { duration: 900, easing: 'easeOutQuart' },
            plugins: {
              legend: {
                position: 'bottom',
                labels: { boxWidth: 12, boxHeight: 12, color: '#e2e8f0' }
              },
              tooltip: {
                callbacks: {
                  label: (ctx) => `${ctx.dataset.label}: ${ctx.parsed.y || 0} lulusan`
                }
              }
            },
            scales: {
              y: {
                beginAtZero: true,
                ticks: { color: '#cbd5e1', font: { weight: '600' } },
                grid: { drawBorder: false, color: '#ffffff' }
              },
              x: {
                stacked: true,
                ticks: { color: '#e2e8f0', font: { weight: '600' } },
                grid: { drawBorder: false, color: '#ffffff' }
              }
            }
          }
        });
      })();
    </script>
</body>

