<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Akademik UNJANI</title>
    <link rel="stylesheet" href="/assets/landing-page/css/main.css">
    <link rel="stylesheet" href="/assets/landing-page/css/responsive.css">
    <link rel="web icon"
        href="<%= (siteSetting && siteSetting.favicon) ? siteSetting.favicon : '/assets/landing-page/images/favicon.ico' %>">
</head>

<body>
    <!-- Header Section -->
    <%- include("../partials/landing-header") %>

    <!-- Sidebar Section -->
    <%- include("../partials/landing-aside") %>

    <!-- Main Section -->
    <main>
        <!-- Banner Home Section -->
        <div class="section-wrapper pb-0">
            <div class="banner-home-container" id="banner-slideshow">
                <div class="slideshow-container">
                </div>
                <div class="hero-container">
                    <div class="banner-content-container">
                        <div class="banner-home-top">
                            <div class="banner-home-title animate-box animate__animated animated"
                                data-animate="animate__fadeInLeft">
                                <div>
                                    <div class="sub-heading sub-heading-banner">
                                        <span class="sub-heading-title">Universitas Jenderal Achmad Yani</span>
                                    </div>
                                </div>
                                <h1 class="secondary-accent">BIDANG AKADEMIK </h1>
                            </div>

                            <div class="banner-home-network animate-box animate__animated animated"
                                data-animate="animate__fadeInRight">

                                <div class="banner-home-social">
                                    <div class="social-container">
                                        <i class="fa-brands fa-facebook"></i>
                                        <a href="#" class="social-link-banner">Facebook</a>
                                    </div>
                                    <div class="social-container">
                                        <i class="fa-brands fa-instagram"></i>
                                        <a href="#" class="social-link-banner">Instagram</a>
                                    </div>
                                    <div class="social-container">
                                        <i class="fa-brands fa-x-twitter"></i>
                                        <a href="#" class="social-link-banner">X Twitter</a>
                                    </div>
                                    <div class="social-container">
                                        <i class="fa-brands fa-tiktok"></i>
                                        <a href="#" class="social-link-banner">Tiktok</a>
                                    </div>
                                </div>

                                <div class="card card-banner-reviewer">
                                    <h4 class="secondary-accent">Unlock Your Full Potential</h4>
                                    <div class="banner-reviewer-container">
                                        <img src="/assets/landing-page/images/dummy-img-400x400.jpg" alt="Reviewer"
                                            class="banner-avatar">
                                        <img src="/assets/landing-page/images/dummy-img-400x400.jpg" alt="Reviewer"
                                            class="banner-avatar">
                                        <img src="/assets/landing-page/images/dummy-img-400x400.jpg" alt="Reviewer"
                                            class="banner-avatar">
                                        <img src="/assets/landing-page/images/dummy-img-400x400.jpg" alt="Reviewer"
                                            class="banner-avatar">
                                    </div>
                                    <span class="reviewer-card-description">With expert Padel tips, gear
                                        recommendations, and pro level training.</span>
                                </div>
                            </div>
                        </div>

                        <div class="banner-home-bottom">
                            <div class="banner-home-community-container animate-box animate__animated animated"
                                data-animate="animate__fadeInLeft">
                                <div class="card banner-home-community">
                                    <div class="home-community-img">
                                        <img src="/assets/landing-page/images/dummy-img-600x500.jpg"
                                            alt="Banner Home Community">
                                    </div>
                                    <div class="home-community-content">
                                        <div class="d-flex flex-row align-items-center gspace-1">
                                            <h3 class="home-community-highlight">25+</h3>
                                            <div class="banner-reviewer-container">
                                                <img src="/assets/landing-page/images/dummy-img-400x400.jpg"
                                                    alt="Reviewer" class="banner-avatar">
                                                <img src="/assets/landing-page/images/dummy-img-400x400.jpg"
                                                    alt="Reviewer" class="banner-avatar">
                                                <img src="/assets/landing-page/images/dummy-img-400x400.jpg"
                                                    alt="Reviewer" class="banner-avatar">
                                                <img src="/assets/landing-page/images/Gp-1.png" alt="Reviewer"
                                                    class="banner-avatar banner-avatar-plus">
                                            </div>
                                        </div>
                                        <div class="d-flex flex-column">
                                            <h5 class="secondary-accent mb-0">Padel Enthusiasts. One Club</h5>
                                            <p class="secondary-accent mb-0">Enjoy World-Class Facilities and a Thriving
                                                Community adipiscing elit ut elit.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="banner-home-cta-container animate-box animate__animated animated-delay-slow"
                                data-animate="animate__fadeInRight">
                                <div class="banner-home-cta">
                                    <h3 class="secondary-accent">Active Members and Unlock Premium Padel Facilities</h3>
                                    <p class="secondary-accent">Experience professional training, top-notch facilities,
                                        and a vibrant community at Adelux your premier padel destination. Lorem ipsum
                                        dolor sit amet consectetur adipiscing elit ut elit.</p>
                                    <!-- <div class="d-flex flex-row align-items-center gspace-2 gspace-xl-4">
                                        <div>
                                            <a href="./booking.html" class="btn btn-accent">
                                                <span class="btn-title">Book a Court</span>
                                                <span class="icon-circle">
                                                    <i class="fa-solid fa-arrow-right"></i>
                                                </span>
                                            </a>
                                        </div>
                                        <button class="request-loader" data-video="https://www.youtube.com/embed/VhBl3dHT5SY?autoplay=1">
                                            <i class="fa-solid fa-play"></i>
                                        </button>
                                    </div> -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pinned Section -->
        <div class="section">
            <div class="hero-container">
                <div class="d-flex flex-column gspace-5">
                    <div class="blog-title-container">
                        <div class="row row-cols-md-1 row-cols-1 grid-spacer-2">
                            <div class="col">
                                <div class="d-flex flex-column gspace-2 justify-content-center justify-content-md-start text-center text-md-start animate-box animate__animated animated"
                                    data-animate="animate__fadeInLeft">
                                    <div>
                                        <div class="sub-heading">
                                            <i class="fa-solid fa-thumbtack accent-color-2"></i>
                                            <span class="sub-heading-title">Pinned</span>
                                        </div>
                                    </div>
                                    <h2>Konten Prioritas</h2>
                                    <p class="mb-0">Berita, pengumuman, dan dokumen yang diprioritaskan.</p>
                                </div>
                            </div>
                            <div class="col">
                                <div class="d-flex flex-column h-100 align-items-center justify-content-center align-items-md-end justify-content-md-end animate-box animate__animated animated"
                                    data-animate="animate__fadeInRight">
                                    <a href="/berita" class="btn btn-accent">
                                        <span class="btn-title">
                                            <span>Lihat Semua Konten</span>
                                        </span>
                                        <span class="icon-circle">
                                            <i class="fa-solid fa-arrow-right"></i>
                                        </span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <%
                        const pinnedItems = [];
                        (pinnedNews || []).forEach(function(item){
                            pinnedItems.push({
                                type: 'Berita',
                                typeColor: '#0d6efd',
                                title: item.title,
                                href: '/berita/' + item.slug,
                                image: item.featuredImage || '/assets/landing-page/images/dummy-img-600x600.jpg',
                                createdAt: item.createdAt,
                                summary: (item.body || '').replace(/<[^>]*>/g, '').trim(),
                                external: false,
                            });
                        });
                        (pinnedPengumumans || []).forEach(function(item){
                            pinnedItems.push({
                                type: 'Pengumuman',
                                typeColor: '#f59e0b',
                                title: item.title,
                                href: '/pengumuman/' + item.slug,
                                image: item.featuredImage || '/assets/landing-page/images/dummy-img-600x600.jpg',
                                createdAt: item.createdAt,
                                summary: (item.body || '').replace(/<[^>]*>/g, '').trim(),
                                external: false,
                            });
                        });
                        (pinnedDocs || []).forEach(function(item){
                            pinnedItems.push({
                                type: 'Dokumen Akademik',
                                typeColor: '#16a34a',
                                title: item.name,
                                href: item.file || '/dokumen-akademik',
                                image: item.cover || '/assets/landing-page/images/dummy-img-600x800.jpg',
                                createdAt: item.createdAt,
                                summary: (item.keterangan || 'Dokumen akademik resmi.').trim(),
                                external: !!item.file,
                            });
                        });
                        pinnedItems.sort(function(a, b) {
                            return new Date(b.createdAt || 0) - new Date(a.createdAt || 0);
                        });
                    %>
                    <div class="row row-cols-xl-3 row-cols-md-2 row-cols-1 grid-spacer-2">
                        <% if (pinnedItems.length) { %>
                            <% pinnedItems.forEach(function(item){ %>
                            <div class="col">
                                <div class="card card-blog animate-box animate__animated animated" data-animate="animate__fadeInUp">
                                    <a href="<%= item.href %>" <% if (item.external) { %>target="_blank" rel="noopener"<% } %>>
                                        <div class="image-container blog-image">
                                            <img src="<%= item.image %>" alt="<%= item.title %>">
                                            <div class="blog-content">
                                                <div class="d-flex flex-row align-items-center justify-content-between gspace-2 mb-2">
                                                    <div class="meta-data">
                                                        <i class="fa-solid fa-thumbtack"></i>
                                                        <span>Pinned</span>
                                                    </div>
                                                    <span class="badge text-white px-2 py-1" style="background:<%= item.typeColor %>; border-radius: 999px;"><%= item.type %></span>
                                                </div>
                                                <h4 class="secondary-accent mb-1"><%= item.title %></h4>
                                                <div class="meta-data mb-2">
                                                    <i class="fa-solid fa-calendar"></i>
                                                    <span><%= item.createdAt ? item.createdAt.toLocaleDateString() : '-' %></span>
                                                </div>
                                                <p class="secondary-accent mb-0" style="font-size:.9rem;line-height:1.45;">
                                                    <%= item.summary ? item.summary.slice(0, 110) : '-' %><%= item.summary && item.summary.length > 110 ? '...' : '' %>
                                                </p>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            </div>
                            <% }); %>
                        <% } else { %>
                            <div class="col-12">
                                <div class="alert alert-warning text-center">Belum ada konten yang di-pin.</div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>>

        <!-- Chart Akreditasi Section -->
        <div class="section-wrapper py-0">
            <div class="section section-academy" id="akreditasi-section">
                <div class="hero-container">
                    <div class="d-flex flex-column flex-lg-row gspace-4 align-items-center">
                        <div class="flex-grow-1">
                            <div class="sub-heading mb-2">
                                <i class="fa-solid fa-circle accent-color-2"></i>
                                <span class="sub-heading-title">Akreditasi</span>
                            </div>
                            <h3 class="secondary-accent mb-2">Capaian Akreditasi Kampus</h3>
                            <p class="text-white mb-3">Distribusi peringkat akreditasi program berdasarkan data terkini.</p>
                            <%
                                const akreditasiPalette = ['#0ea5e9', '#22c55e', '#f59e0b', '#8b5cf6', '#ef4444', '#14b8a6', '#f97316', '#6366f1'];
                                const akreditasiLegend = Array.isArray(accreditationChart)
                                    ? accreditationChart.filter(function(item){ return item && Number(item.value) > 0; })
                                    : [];
                            %>
                            <ul class="list-unstyled d-flex flex-wrap gap-3 mb-0 text-white">
                                <% if (akreditasiLegend.length) { %>
                                    <% akreditasiLegend.forEach(function(item, idx){ %>
                                    <li class="d-flex align-items-center gap-2">
                                        <span class="badge rounded-circle" style="width:14px; height:14px; background:<%= akreditasiPalette[idx % akreditasiPalette.length] %>;"></span>
                                        <span><%= item.label %> (<%= item.value %>)</span>
                                    </li>
                                    <% }); %>
                                <% } else { %>
                                    <li class="d-flex align-items-center gap-2">
                                        <span class="badge rounded-circle" style="width:14px; height:14px; background:#94a3b8;"></span>
                                        <span>Belum Ada Data</span>
                                    </li>
                                <% } %>
                            </ul>
                        </div>
                        <div class="flex-grow-1 w-100">
                            <div class="card shadow-sm border-0 bg-dark" style="border-radius:16px;">
                                <div class="card-body">
                                    <%
                                        const akreditasiTotal = akreditasiLegend.reduce(function(sum, item){
                                            return sum + (Number(item && item.value) || 0);
                                        }, 0);
                                        const akreditasiTerbanyak = akreditasiLegend.reduce(function(top, item){
                                            const current = Number(item && item.value) || 0;
                                            if (!top || current > top.value) return { label: item.label, value: current };
                                            return top;
                                        }, null);
                                    %>
                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                        <span class="badge px-3 py-2" style="border-radius:999px; background:#0ea5e91a; color:#0369a1;">
                                            Total Data: <strong><%= akreditasiTotal %></strong>
                                        </span>
                                        <span class="badge px-3 py-2" style="border-radius:999px; background:#22c55e1a; color:#166534;">
                                            Jumlah Kategori: <strong><%= akreditasiLegend.length %></strong>
                                        </span>
                                        <span class="badge px-3 py-2" style="border-radius:999px; background:#f59e0b1a; color:#92400e;">
                                            Terbanyak:
                                            <strong><%= akreditasiTerbanyak ? (akreditasiTerbanyak.label + ' (' + akreditasiTerbanyak.value + ')') : '-' %></strong>
                                        </span>
                                    </div>
                                    <div style="border-radius:14px; background:linear-gradient(160deg,#212529 0%, #212529 100%); padding:14px 14px 6px; box-shadow: inset 0 0 0 1px rgba(148,163,184,0.22);">
                                        <canvas id="akreditasiChart" height="240"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pengumuman Section -->
        <div class="section">
            <div class="hero-container">
                <div class="d-flex flex-column gspace-5">
                    <div class="blog-title-container">
                        <div class="row row-cols-md-1 row-cols-1 grid-spacer-2">
                            <div class="col">
                                <div class="d-flex flex-column gspace-2 justify-content-center justify-content-md-start text-center text-md-start animate-box animate__animated animated"
                                    data-animate="animate__fadeInLeft">
                                    <div>
                                        <div class="sub-heading">
                                            <i class="fa-solid fa-circle accent-color-2"></i>
                                            <span class="sub-heading-title">Pengumuman</span>
                                        </div>
                                    </div>
                                    <h2>Pengumuman Akademik</h2>
                                </div>
                            </div>
                            <div class="col">
                                <div class="d-flex flex-column h-100 align-items-center justify-content-center align-items-md-end justify-content-md-end animate-box animate__animated animated"
                                    data-animate="animate__fadeInRight">
                                    <a href="/pengumuman" class="btn btn-accent">
                                        <span class="btn-title">
                                            <span>Read More</span>
                                        </span>
                                        <span class="icon-circle">
                                            <i class="fa-solid fa-arrow-right"></i>
                                        </span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row row-cols-xl-3 row-cols-md-2 row-cols-1 grid-spacer-2">
                        <% if (pengumumans && pengumumans.length) { %>
                        <% pengumumans.forEach(function(item){ %>
                        <div class="col">
                            <div class="card card-blog animate-box animate__animated animated"
                                data-animate="animate__fadeInUp">
                                <a href="/pengumuman/<%= item.slug %>">
                                    <div class="image-container blog-image">
                                        <img src="<%= item.featuredImage || '/assets/landing-page/images/dummy-img-600x600.jpg' %>"
                                            alt="<%= item.title %>">
                                        <div class="blog-content">
                                            <div
                                                class="d-flex flex-row align-items-center justify-content-start gspace-2">
                                                <div class="meta-data">
                                                    <i class="fa-solid fa-calendar"></i>
                                                    <span><%= item.createdAt ? item.createdAt.toLocaleDateString() : '-' %></span>
                                                </div>
                                                <div class="meta-data">
                                                    <i class="fa-solid fa-folder"></i>
                                                    <span>Pengumuman</span>
                                                </div>
                                            </div>
                                            <h4 class="secondary-accent"><%= item.title %></h4>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <% }); %>
                        <% } else { %>
                        <div class="col-12">
                            <div class="alert alert-warning text-center">Belum ada pengumuman.</div>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chart Lulusan Section -->
        <div class="section-wrapper py-0">
            <div class="section section-academy">
                <div class="hero-container">
                    <div class="d-flex flex-column flex-lg-row gspace-4 align-items-center">
                        <div class="flex-grow-1">
                            <div class="sub-heading mb-2">
                                <i class="fa-solid fa-circle accent-color-2"></i>
                                <span class="sub-heading-title">Lulusan</span>
                            </div>
                            <h3 class="secondary-accent mb-2">Tren Kelulusan per Periode</h3>
                            <p class="mb-3 text-white">Perbandingan jumlah lulusan per tahun dengan pemisahan periode I, II, dan III.</p>
                            <div class="d-flex flex-wrap gap-3">
                                <div class="pill d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm" style="border-radius:999px; background:#0ea5e91a;">
                                    <span class="badge rounded-circle" style="width:12px; height:12px; background:#0ea5e9;"></span>
                                    <span class="fw-semibold">Periode I</span>
                                </div>
                                <div class="pill d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm" style="border-radius:999px; background:#22c55e1a;">
                                    <span class="badge rounded-circle" style="width:12px; height:12px; background:#22c55e;"></span>
                                    <span class="fw-semibold">Periode II</span>
                                </div>
                                <div class="pill d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm" style="border-radius:999px; background:#f973161a;">
                                    <span class="badge rounded-circle" style="width:12px; height:12px; background:#f97316;"></span>
                                    <span class="fw-semibold">Periode III</span>
                                </div>
                            </div>
                            <div class="mt-3">
                                <span class="badge accent-bg text-white px-3 py-2 shadow-sm">Total lulusan: <%= lulusanChart ? lulusanChart.total : 0 %></span>
                            </div>
                        </div>
                        <div class="flex-grow-1 w-100">
                            <div class="card shadow-sm border-0 bg-dark" style="border-radius:16px;">
                                <div class="card-body">
                                    <%
                                        const lulusanLabels = lulusanChart && Array.isArray(lulusanChart.labels) ? lulusanChart.labels : [];
                                        const lulusanDatasets = lulusanChart && Array.isArray(lulusanChart.datasets) ? lulusanChart.datasets : [];
                                        const lulusanTotal = lulusanChart ? (Number(lulusanChart.total) || 0) : 0;
                                        const lulusanYearsCount = lulusanLabels.length;
                                        const lulusanYearRange = lulusanYearsCount
                                            ? (lulusanYearsCount === 1 ? String(lulusanLabels[0]) : `${lulusanLabels[0]} - ${lulusanLabels[lulusanYearsCount - 1]}`)
                                            : '-';
                                        const lulusanPeriodeTotals = lulusanDatasets.map(function(ds){
                                            const sum = Array.isArray(ds.data)
                                                ? ds.data.reduce(function(acc, n){ return acc + (Number(n) || 0); }, 0)
                                                : 0;
                                            return { label: ds.label || '-', value: sum };
                                        });
                                        const lulusanTopPeriode = lulusanPeriodeTotals.reduce(function(top, item){
                                            if (!top || item.value > top.value) return item;
                                            return top;
                                        }, null);
                                    %>
                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                        <span class="badge px-3 py-2" style="border-radius:999px; background:#0ea5e91a; color:#0369a1;">
                                            Rentang Tahun: <strong><%= lulusanYearRange %></strong>
                                        </span>
                                        <span class="badge px-3 py-2" style="border-radius:999px; background:#22c55e1a; color:#166534;">
                                            Total Lulusan: <strong><%= lulusanTotal %></strong>
                                        </span>
                                        <span class="badge px-3 py-2" style="border-radius:999px; background:#f973161a; color:#9a3412;">
                                            Periode Tertinggi:
                                            <strong><%= lulusanTopPeriode ? `${lulusanTopPeriode.label} (${lulusanTopPeriode.value})` : '-' %></strong>
                                        </span>
                                    </div>
                                    <div style="border-radius:14px; background:linear-gradient(160deg,#212529 0%, #212529 100%); padding:14px 14px 6px; box-shadow: inset 0 0 0 1px rgba(148,163,184,0.22);">
                                        <canvas id="lulusanChart" height="260"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Dokumen Section -->
        <div class="section">
            <div class="hero-container">
                <div class="d-flex flex-column gspace-5">
                    <div class="service-title-container">
                        <div class="row row-cols-md-1 row-cols-1 grid-spacer-2">
                            <div class="col">
                                <div class="d-flex flex-column gspace-2 justify-content-center text-md-start text-center animate-box animate__animated animated"
                                    data-animate="animate__fadeInLeft">
                                    <div>
                                        <div class="sub-heading">
                                            <i class="fa-solid fa-circle accent-color-2"></i>
                                            <span class="sub-heading-title">Dokumen</span>
                                        </div>
                                    </div>
                                    <h2>Dokumen Akademik</h2>
                                </div>
                            </div>
                            <div class="col">
                                <div class="d-flex flex-column h-100 align-items-center align-items-md-end justify-content-center justify-content-md-end animate-box animate__animated animated"
                                    data-animate="animate__fadeInRight">
                                    <a href="/dokumen-akademik" class="btn btn-accent">
                                        <span class="btn-title">Lihat Semua</span>
                                        <span class="icon-circle"><i class="fa-solid fa-arrow-right"></i></span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row row-cols-xl-4 row-cols-md-2 row-cols-1 grid-spacer-2 w-100">
                        <% if (latestDocs && latestDocs.length) { %>
                        <% latestDocs.forEach(function(doc, idx){ %>
                        <div class="col">
                            <div class="card card-service animate-box animate__animated animated"
                                data-animate="animate__fadeInRight">
                                <div class="image-container">
                                    <div class="service-icon-container">
                                        <div class="service-icon">
                                            <img src="/assets/landing-page/images/Icon-5.png" alt="Dokumen"
                                                class="img-fluid">
                                        </div>
                                    </div>
                                    <div class="position-absolute top-0 start-0 m-3">
                                        <span class="badge accent-bg text-white px-3 py-2 shadow-sm">Dokumen
                                            #<%= idx + 1 %></span>
                                    </div>
