<%# Beranda (FR-B-01..08). Setiap bagian hilang dengan rapi bila datanya kosong — tidak ada konten isian. %>

<section class="border-b border-line bg-surface">
  <div class="container-content grid gap-8 py-10 lg:grid-cols-2 lg:items-center lg:py-16">
    <div>
      <h1 class="text-4xl font-bold text-ink lg:text-5xl">Layanan Akademik Universitas Jenderal Achmad Yani</h1>
      <p class="mt-4 max-w-xl text-lg text-muted">Kalender, kurikulum, dokumen, dan informasi akademik resmi dalam satu tempat.</p>
      <div class="mt-6 grid grid-cols-2 gap-3 sm:w-fit sm:grid-cols-4">
        <a href="/kalender-akademik" class="flex flex-col items-center gap-2 rounded-card border border-line bg-surface p-4 text-center hover:bg-sunken"><%- icon('event', 'size-6 text-primary') %><span class="text-sm font-medium">Kalender Akademik</span></a>
        <a href="/dokumen-akademik" class="flex flex-col items-center gap-2 rounded-card border border-line bg-surface p-4 text-center hover:bg-sunken"><%- icon('description', 'size-6 text-primary') %><span class="text-sm font-medium">Dokumen &amp; Formulir</span></a>
        <a href="/kurikulum" class="flex flex-col items-center gap-2 rounded-card border border-line bg-surface p-4 text-center hover:bg-sunken"><%- icon('menu_book', 'size-6 text-primary') %><span class="text-sm font-medium">Kurikulum</span></a>
        <a href="/akreditasi" class="flex flex-col items-center gap-2 rounded-card border border-line bg-surface p-4 text-center hover:bg-sunken"><%- icon('workspace_premium', 'size-6 text-primary') %><span class="text-sm font-medium">Akreditasi</span></a>
      </div>
    </div>
    <img src="/img/hero-kampus.webp" alt="Kampus Universitas Jenderal Achmad Yani" class="aspect-[4/3] w-full rounded-card object-cover lg:aspect-video" width="1600" height="903" fetchpriority="high">
  </div>
</section>

<div class="container-content py-10">

  <% if (informasiPenting.length) { %>
  <section class="card card-body mb-10">
    <h2 class="mb-3 flex items-center gap-2 text-lg font-semibold"><%- icon('info', 'size-5 text-primary') %>Informasi Penting</h2>
    <ul class="divide-y divide-line">
      <% informasiPenting.forEach(i => { %>
        <li class="flex flex-wrap items-center justify-between gap-2 py-3 first:pt-0 last:pb-0">
          <a href="<%= i.href %>" class="flex items-center gap-2 font-medium text-ink hover:text-primary" <%= i.jenis === 'Dokumen' ? 'target="_blank" rel="noopener"' : '' %>>
            <%- include('../components/badge', { text: i.jenis, tone: 'info' }) %><%= i.judul %>
          </a>
          <span class="text-sm text-muted"><%= formatTanggal(i.tanggal) %></span>
        </li>
      <% }) %>
    </ul>
  </section>
  <% } %>

  <% if (agendaItems.length) { %>
  <section class="mb-10">
    <div class="mb-4 flex items-end justify-between">
      <h2 class="text-xl font-semibold">Agenda Akademik Terdekat</h2>
      <a href="/kalender-akademik" class="text-sm font-semibold text-primary">Lihat kalender lengkap →</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <% agendaItems.forEach(e => { %>
        <div class="card card-body">
          <%- include('../components/badge', { text: e.status.label, tone: e.status.tone }) %>
          <p class="mt-2 font-semibold text-ink"><%= e.nama %></p>
          <p class="mt-1 text-sm text-muted"><%= formatRentangTanggal(e.mulai, e.selesai) %></p>
        </div>
      <% }) %>
    </div>
  </section>
  <% } %>

  <div class="grid gap-10 lg:grid-cols-2">
    <% if (pengumumanTerbaru.length) { %>
    <section>
      <div class="mb-4 flex items-end justify-between">
        <h2 class="text-xl font-semibold">Pengumuman Terbaru</h2>
        <a href="/pengumuman" class="text-sm font-semibold text-primary">Lihat semua →</a>
      </div>
      <ul class="card divide-y divide-line">
        <% pengumumanTerbaru.forEach(p => { %>
          <li class="flex gap-4 p-4">
            <%- include('../components/date-block', { date: p.createdAt }) %>
            <a href="/pengumuman/<%= p.slug %>" class="min-w-0 flex-1 font-medium text-ink hover:text-primary"><%= p.title %></a>
          </li>
        <% }) %>
      </ul>
    </section>
    <% } %>

    <% if (institusiAcc.length || peringkatStats.length) { %>
    <section>
      <h2 class="mb-4 text-xl font-semibold">Status Mutu Institusi</h2>
      <div class="card card-body">
        <% institusiAcc.forEach(a => { %>
          <div class="flex items-center justify-between gap-3 border-b border-line pb-4 last:border-0 last:pb-0">
            <div>
              <span class="text-2xl font-bold text-primary"><%= a.peringkat %></span>
              <p class="text-xs text-muted"><%= a.lembaga ? a.lembaga.singkatan : '—' %> · s.d. <%= formatTanggal(a.berlakuSampai) %></p>
            </div>
            <%- include('../components/badge', { text: a.status.label, tone: a.status.tone }) %>
          </div>
        <% }) %>
        <% if (peringkatStats.length) { %>
        <div class="mt-4 flex flex-wrap gap-2 border-t border-line pt-4">
          <% peringkatStats.forEach(p => { %><span class="badge badge-neutral"><%= p.peringkat %> <%= p.total %></span><% }) %>
        </div>
        <% } %>
        <a href="/akreditasi" class="mt-4 inline-flex min-h-6 items-center text-sm font-semibold text-primary">Lihat semua akreditasi →</a>
      </div>
    </section>
    <% } %>
  </div>

  <% if (kegiatanTerbaru.length) { %>
  <section class="mt-10">
    <div class="mb-4 flex items-end justify-between">
      <h2 class="text-xl font-semibold">Kegiatan Akademik</h2>
      <a href="/berita" class="text-sm font-semibold text-primary">Lihat semua →</a>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% kegiatanTerbaru.forEach(n => { %>
        <article class="card overflow-hidden">
          <a href="/berita/<%= n.slug %>" class="block aspect-video bg-sunken" aria-hidden="true" tabindex="-1">
            <% if (n.featuredImage) { %><img src="<%= n.featuredImage %>" alt="" class="size-full object-cover" loading="lazy"><% } %>
          </a>
          <div class="card-body">
            <p class="text-xs text-muted"><%= formatTanggal(n.createdAt) %></p>
            <a href="/berita/<%= n.slug %>" class="mt-1 block line-clamp-2 font-semibold text-ink hover:text-primary"><%= n.title %></a>
          </div>
        </article>
      <% }) %>
    </div>
  </section>
  <% } %>

  <% if (lulusan) { %>
  <section class="mt-10 grid gap-4 sm:grid-cols-3">
    <div class="card card-body text-center">
      <p class="text-3xl font-bold tabular-nums text-primary"><%= formatAngka(lulusan.total) %></p>
      <p class="text-sm text-muted">Lulusan tahun <%= lulusan.tahun %></p>
    </div>
    <div class="card card-body text-center">
      <p class="text-3xl font-bold tabular-nums text-ink"><%= formatAngka(lulusan.totalSemua) %></p>
      <p class="text-sm text-muted">Total lulusan tercatat</p>
    </div>
    <% if (lulusan.persenPerubahan !== null) { %>
    <div class="card card-body text-center">
      <p class="text-3xl font-bold tabular-nums <%= lulusan.persenPerubahan >= 0 ? 'text-success' : 'text-danger' %>"><%= lulusan.persenPerubahan >= 0 ? '+' : '' %><%= lulusan.persenPerubahan %>%</p>
      <p class="text-sm text-muted">Dibanding tahun sebelumnya</p>
    </div>
    <% } %>
  </section>
  <% } %>

  <% if (setting && setting.landingVideoUrl) { %>
  <section class="mt-10">
    <h2 class="mb-4 text-xl font-semibold">Video Profil</h2>
    <div class="aspect-video overflow-hidden rounded-card border border-line">
      <iframe src="<%= setting.landingVideoUrl %>" title="Video Profil Bidang Akademik" class="size-full" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
  </section>
  <% } %>

</div>
