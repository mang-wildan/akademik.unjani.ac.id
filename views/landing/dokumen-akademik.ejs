<%# Dokumen Akademik (FR-D-01..02): daftar, bukan kartu. %>
<%- include('../components/page-header', {
  heading: 'Dokumen Akademik',
  lead: 'Formulir, pedoman, dan peraturan akademik resmi.',
  breadcrumb: [{ label: 'Akademik' }, { label: 'Dokumen Akademik' }],
}) %>

<div class="container-content grid gap-6 pb-16 lg:grid-cols-[16rem_1fr]">
  <aside class="min-w-0">
    <h2 class="mb-2 text-sm font-semibold tracking-wide text-muted uppercase">Kategori</h2>
    <ul class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-2 md:-mx-6 md:px-6 lg:mx-0 lg:block lg:space-y-1 lg:overflow-visible lg:px-0 lg:pb-0">
      <li class="shrink-0"><a href="/dokumen-akademik<%= filters.q ? '?q=' + encodeURIComponent(filters.q) : '' %>" class="flex min-h-11 items-center justify-between gap-2 rounded-control border px-3 text-sm font-medium whitespace-nowrap lg:border-transparent lg:whitespace-normal <%= !filters.kategori ? 'border-primary bg-primary-soft text-primary' : 'border-line text-ink hover:bg-sunken' %>"<%- !filters.kategori ? ' aria-current="true"' : '' %>>Semua <span><%= totalDocsAll %></span></a></li>
      <% kategoriOptions.forEach(k => { %>
        <li class="shrink-0"><a href="/dokumen-akademik?kategori=<%= k._id %><%= filters.q ? '&q=' + encodeURIComponent(filters.q) : '' %>" class="flex min-h-11 items-center justify-between gap-2 rounded-control border px-3 text-sm font-medium whitespace-nowrap lg:border-transparent lg:whitespace-normal <%= filters.kategori === String(k._id) ? 'border-primary bg-primary-soft text-primary' : 'border-line text-ink hover:bg-sunken' %>"<%- filters.kategori === String(k._id) ? ' aria-current="true"' : '' %>><%= k.nama %> <span><%= k.total %></span></a></li>
      <% }) %>
    </ul>
  </aside>

  <div class="min-w-0">
    <form method="get" role="search" class="mb-5 flex gap-2">
      <% if (filters.kategori) { %><input type="hidden" name="kategori" value="<%= filters.kategori %>"><% } %>
      <label for="q" class="sr-only">Cari dokumen</label>
      <input id="q" name="q" type="search" class="field-control" placeholder="Cari judul dokumen…" value="<%= filters.q %>">
      <button type="submit" class="btn btn-secondary" aria-label="Cari"><%- icon('search') %><span class="hidden sm:inline" aria-hidden="true">Cari</span></button>
    </form>

    <% if (!documents.length) { %>
      <%- include('../components/empty-state', {
        emptyIcon: 'search', emptyTitle: filters.q || filters.kategori ? 'Dokumen tidak ditemukan' : 'Belum ada dokumen',
        emptyText: filters.q ? `Tidak ada dokumen yang cocok dengan "${filters.q}".` : 'Dokumen akan muncul di sini setelah diunggah admin.',
        emptyAction: (filters.q || filters.kategori) ? { label: 'Hapus pencarian', href: '/dokumen-akademik' } : null,
      }) %>
    <% } else { %>
    <ul class="divide-y divide-line border-y border-line-strong">
      <% documents.forEach(d => { %>
        <li class="flex items-start gap-4 py-5">
          <span class="flex h-14 w-10 shrink-0 items-center justify-center border border-line-strong text-xs text-muted max-sm:hidden">PDF</span>
          <div class="min-w-0 flex-1">
            <a href="<%= d.file %>" target="_blank" rel="noopener" class="inline-flex min-h-11 items-center py-1.5 font-semibold text-ink hover:text-primary"><%= d.name %><span class="sr-only"> (PDF, tab baru)</span></a>
            <% if (d.keterangan) { %><p class="mt-1 line-clamp-2 text-sm text-muted"><%= d.keterangan %></p><% } %>
            <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted">
              <% if (d.kategori) { %><span class="font-semibold uppercase"><%= d.kategori.nama %></span><% } %>
              <span>Diperbarui <%= formatTanggal(d.updatedAt || d.createdAt) %></span>
              <% if (d.fileSize) { %><span>· <%= formatUkuranFile(d.fileSize) %></span><% } %>
            </p>
          </div>
          <a href="<%= d.file %>" class="btn btn-secondary shrink-0" target="_blank" rel="noopener" download aria-label="Unduh <%= d.name %>"><%- icon('download') %><span class="hidden sm:inline" aria-hidden="true">Unduh</span></a>
        </li>
      <% }) %>
    </ul>
    <%- include('../components/pagination', { ...pagination, noun: 'dokumen', path: '/dokumen-akademik', query: filters }) %>
    <% } %>
  </div>
</div>
