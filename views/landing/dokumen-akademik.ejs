<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dokumen Akademik - BAA</title>
  <link rel="stylesheet" href="/assets/landing-page/css/main.css">
  <link rel="stylesheet" href="/assets/landing-page/css/responsive.css">
  <link rel="web icon" href="/assets/landing-page/images/favicon.ico">
</head>

<body>
  <%- include("../partials/landing-header") %>
  <%- include("../partials/landing-aside") %>

  <main>
    <div class="section-wrapper pb-0">
      <div class="section-banner-inner banner-inner-service" style="background-image: url('<%= (siteSetting && siteSetting.bannerRpl) ? siteSetting.bannerRpl : '/assets/landing-page/images/hero-bg.jpg' %>'); background-size: cover; background-position: center;">
        <div class="hero-container">
          <div class="d-flex flex-column gspace-2 text-center justify-content-center">
            <h1 class="secondary-accent">Dokumen Akademik</h1>
            <nav class="breadcrumb">
              <a href="/" class="breadcrumb-item">Home</a>
              <span class="breadcrumb-icon">/</span>
              <span class="breadcrumb-item recent">Dokumen Akademik</span>
            </nav>
          </div>
        </div>
      </div>
    </div>

    <div class="section">
      <div class="hero-container">
        <div class="d-flex flex-column gspace-4">
          <div class="service-title-container">
            <div class="row row-cols-md-1 row-cols-1 grid-spacer-2 align-items-center">
              <div class="col">
                <div class="d-flex flex-column gspace-2 justify-content-center text-md-start text-center">
                  <div class="sub-heading col-2">
                    <i class="fa-solid fa-circle accent-color-2"></i>
                    <span class="sub-heading-title">Arsip Akademik</span>
                  </div>
                  <h2 class="mb-1">Dokumen Akademik Resmi</h2>
                  <p class="text-muted mb-0">Cari berdasarkan judul dokumen lalu klik untuk membuka PDF.</p>
                </div>
              </div>

            </div>
          </div>
          <div class="col">
            <div class="d-flex flex-column flex-md-row align-items-center justify-content-md-end gap-2">
              <div class="input-group"
                style="max-width: 420px; border: 2px solid var(--accent-color, #0D9394); border-radius: 999px; overflow: hidden;">
                <span class="input-group-text bg-white border-0"><i
                    class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input id="doc-search" type="search" class="form-control border-0" placeholder="Cari judul dokumen..."
                  aria-label="Cari dokumen">
              </div>
              <div class="badge accent-bg text-white px-3 py-2">
                <span id="doc-count"
                  data-total="<%= (pagination && pagination.totalDocs) ? pagination.totalDocs : (documents ? documents.length : 0) %>">Total:
                  <%= (pagination && pagination.totalDocs) ? pagination.totalDocs : (documents ? documents.length : 0) %></span>
              </div>
            </div>
          </div>
          <div class="row row-cols-xl-3 row-cols-md-2 row-cols-1 grid-spacer-3">
            <% if (documents && documents.length) { %>
            <% documents.forEach(function(item, idx){ %>
            <div class="col doc-card" data-title="<%= (item.name || '').toLowerCase() %>">
              <div class="card card-service animate-box" data-animate="animate__fadeInUp">
                <div class="image-container">
                  <div class="service-icon-container">
                    <div class="service-icon">
                      <img src="/assets/landing-page/images/Icon-4.png" alt="Dokumen" class="img-fluid">
                    </div>
                  </div>
                  <div class="position-absolute top-0 start-0 m-3">
                    <span class="badge accent-bg text-white px-3 py-2 shadow-sm">
                      Dokumen #<%= idx + 1 %>
                    </span>
                  </div>
                  <img src="<%= item.cover || '/assets/landing-page/images/dummy-img-600x800.jpg' %>"
                    alt="Dokumen <%= item.name %>" class="service-img">
                  <div class="service-detail-container">
                    <div class="service-detail">
                      <div>
                        <h4 class="secondary-accent mb-1"><%= item.name %></h4>
                        <p class="text-muted mb-1"><%= item.keterangan || 'Tidak ada keterangan.' %></p>
                        <% if (item.file) { %>
                        <span class="badge bg-white text-dark">PDF</span>
                        <% } %>
                      </div>
                      <div>
                        <% if (item.file) { %>
                        <a href="<%= item.file %>" class="service-btn" target="_blank" rel="noopener">
                          <span class="icon-circle">
                            <i class="fa-solid fa-arrow-up-right-from-square"></i>
                          </span>
                        </a>
                        <% } %>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="card-body">
                  <div class="small text-muted">
                    Diunggah <%= item.createdAt ? item.createdAt.toLocaleDateString() : '-' %>
                    <% const uploader = item.createdBy ? (item.createdBy.name || item.createdBy.email) : null; %>
                    <% if (uploader) { %> oleh <%= uploader %><% } %>
                  </div>
                  <% if (item.updatedAt && item.updatedAt.getTime() !== item.createdAt.getTime()) { %>
                  <div class="text-muted small">Pembaruan terakhir: <%= item.updatedAt.toLocaleDateString() %></div>
                  <% } %>
                </div>
              </div>
            </div>
            <% }); %>
            <% } else { %>
            <div class="col-12">
              <div class="alert alert-warning text-center">Belum ada dokumen akademik.</div>
            </div>
            <% } %>
          </div>

          <% if (pagination && pagination.totalPages && pagination.totalPages > 1) { %>
          <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-2 mt-3">
            <div class="text-muted small">
              Menampilkan <%= pagination.start %> - <%= pagination.end %> dari <%= pagination.totalDocs %> dokumen
            </div>
            <nav aria-label="Pagination dokumen">
              <ul class="pagination justify-content-center mb-0">
                <li class="page-item <%= pagination.currentPage === 1 ? 'disabled' : '' %>">
                  <a class="page-link" href="/dokumen-akademik?page=<%= pagination.currentPage - 1 %>"
                    aria-label="Sebelumnya">&laquo;</a>
                </li>
                <% for (let p = 1; p <= pagination.totalPages; p++) { %>
                <li class="page-item <%= p === pagination.currentPage ? 'active' : '' %>">
                  <a class="page-link" href="/dokumen-akademik?page=<%= p %>"><%= p %></a>
                </li>
                <% } %>
                <li class="page-item <%= pagination.currentPage === pagination.totalPages ? 'disabled' : '' %>">
                  <a class="page-link" href="/dokumen-akademik?page=<%= pagination.currentPage + 1 %>"
                    aria-label="Berikutnya">&raquo;</a>
                </li>
              </ul>
            </nav>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>

  <%- include("../partials/landing-footer") %>

  <script src="/assets/landing-page/js/vendor/jquery.min.js"></script>
  <script src="/assets/landing-page/js/vendor/bootstrap.bundle.min.js"></script>
  <script src="/assets/landing-page/js/vendor/swiper-bundle.min.js"></script>
  <script src="/assets/landing-page/js/vendor/isotope.pkgd.min.js"></script>
  <script src="/assets/landing-page/js/vendor/flatpickr.min.js"></script>
  <script src="/assets/landing-page/js/script.js"></script>
  <script src="/assets/landing-page/js/submit-form.js"></script>
  <script src="/assets/landing-page/js/swiper-script.js"></script>
  <script>
    (function () {
      const input = document.getElementById('doc-search');
      const cards = Array.from(document.querySelectorAll('.doc-card'));
      const counter = document.getElementById('doc-count');
      if (!input) return;
      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        let visible = 0;
        cards.forEach(card => {
          const title = card.dataset.title || '';
          const match = !q || title.includes(q);
          card.classList.toggle('d-none', !match);
          if (match) visible += 1;
        });
        if (counter) counter.textContent = q ? `Hasil: ${visible}` :
          `Total: ${counter.dataset.total || cards.length}`;
      });
    })();
  </script>
</body>

</html>
