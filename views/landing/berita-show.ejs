<%# Detail berita (FR-P-03/04): kolom baca ~720px, berita lainnya sebagai kartu bergambar. %>
<%- include('../components/page-header', {
  heading: item.title,
  breadcrumb: [{ label: 'Berita', href: '/berita' }, { label: item.title }],
}) %>

<div class="container-content pb-16">
  <div class="grid gap-10 lg:grid-cols-[1fr_20rem]">
    <article>
      <div class="mb-6 flex flex-wrap items-center gap-2 text-sm text-muted">
        <% if (item.kategori) { %><%- include('../components/badge', { text: item.kategori.nama, tone: 'info' }) %><% } %>
        <time datetime="<%= new Date(item.createdAt).toISOString() %>"><%= formatTanggal(item.createdAt, { long: true }) %></time>
        <% if (item.createdBy) { %><span>· <%= item.createdBy.name %></span><% } %>
      </div>
      <% if (item.featuredImage) { %>
        <img src="<%= item.featuredImage %>" alt="" class="mb-6 aspect-video w-full rounded-card object-cover">
      <% } %>
      <div class="prose-content"><%- item.body %></div>

      <% if (item.attachments && item.attachments.length) { %>
      <div class="mt-8">
        <h2 class="mb-3 text-lg font-semibold">Lampiran</h2>
        <ul class="card divide-y divide-line">
          <% item.attachments.forEach(a => { %>
            <li class="flex items-center gap-3 p-3">
              <%- icon('picture_as_pdf', 'size-6 shrink-0 text-primary') %>
              <span class="min-w-0 flex-1 truncate text-sm font-medium"><%= a.judul %></span>
              <a href="<%= a.file %>" target="_blank" rel="noopener" class="btn btn-secondary shrink-0 px-3 py-1.5 text-sm"><%- icon('download', 'size-4') %>Unduh</a>
            </li>
          <% }) %>
        </ul>
      </div>
      <% } %>
    </article>

    <aside>
      <h2 class="mb-3 text-sm font-semibold tracking-wide text-muted uppercase">Berita Lainnya</h2>
      <% if (!lainnya.length) { %>
        <p class="text-sm text-muted">Belum ada berita lain.</p>
      <% } else { %>
      <ul class="space-y-4">
        <% lainnya.forEach(l => { %>
          <li><a href="/berita/<%= l.slug %>" class="flex gap-3 rounded-control p-2 -m-2 hover:bg-sunken">
            <span class="aspect-square w-16 shrink-0 overflow-hidden rounded-control bg-sunken">
              <% if (l.featuredImage) { %><img src="<%= l.featuredImage %>" alt="" class="size-full object-cover"><% } %>
            </span>
            <span>
              <span class="block text-xs text-muted"><%= formatTanggal(l.createdAt) %></span>
              <span class="block line-clamp-2 text-sm font-medium text-ink"><%= l.title %></span>
            </span>
          </a></li>
        <% }) %>
      </ul>
      <% } %>
    </aside>
  </div>
</div>
