<%# Buku Wisuda (FR-L-01): grid cover, filter tahun & periode. %>
<%- include('../components/page-header', {
  heading: 'Buku Wisuda',
  lead: 'Arsip buku wisuda per periode.',
  breadcrumb: [{ label: 'Publikasi' }, { label: 'Buku Wisuda' }],
}) %>

<div class="container-content pb-16">
  <form method="get" class="mb-8 flex flex-wrap items-end gap-3 border-b border-line pb-6">
    <div>
      <label for="tahun" class="field-label">Tahun</label>
      <select id="tahun" name="tahun" class="field-control">
        <option value="">Semua tahun</option>
        <% tahunList.forEach(y => { %><option value="<%= y %>"<%= filters.tahun === String(y) ? ' selected' : '' %>><%= y %></option><% }) %>
      </select>
    </div>
    <div>
      <label for="periode" class="field-label">Periode</label>
      <select id="periode" name="periode" class="field-control">
        <option value="">Semua periode</option>
        <% ['I', 'II', 'III'].forEach(p => { %><option value="<%= p %>"<%= filters.periode === p ? ' selected' : '' %>>Periode <%= p %></option><% }) %>
      </select>
    </div>
    <button type="submit" class="btn btn-primary"><%- icon('filter_list') %>Terapkan</button>
    <% if (filters.tahun || filters.periode) { %><a href="/buku-wisuda" class="btn btn-secondary">Reset</a><% } %>
  </form>

  <% if (!gradBooks.length) { %>
    <%- include('../components/empty-state', { emptyIcon: 'school', emptyTitle: 'Tidak ada buku wisuda yang cocok', emptyAction: (filters.tahun || filters.periode) ? { label: 'Hapus filter', href: '/buku-wisuda' } : null }) %>
  <% } else { %>
  <div class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-5">
    <% gradBooks.forEach(b => { %>
      <article class="min-w-0">
        <a href="<%= b.src %>" target="_blank" rel="noopener" class="block no-underline">
          <img src="<%= b.cover %>" alt="" class="aspect-[3/4] w-full rounded-card border border-line object-cover" loading="lazy">
          <h2 class="mt-4 min-h-11 font-sans text-base font-semibold leading-snug text-ink"><%= b.title %></h2>
          <span class="mt-2 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-primary">Baca PDF<%- icon('arrow_forward', 'size-4') %><span class="sr-only"> (tab baru)</span></span>
        </a>
        <p class="text-xs text-muted">Periode <%= b.periode %> · Tahun <%= b.year %></p>
      </article>
    <% }) %>
  </div>
  <%- include('../components/pagination', { ...pagination, noun: 'buku wisuda', path: '/buku-wisuda', query: filters }) %>
  <% } %>
</div>
