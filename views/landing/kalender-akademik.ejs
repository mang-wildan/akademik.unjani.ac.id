<%# Kalender Akademik (FR-K-01..06). Tabel per semester; <768px otomatis jadi kartu (.data-table--stack). %>
<%- include('../components/page-header', {
  heading: 'Kalender Akademik',
  lead: calendar ? `Tahun Ajaran ${calendar.tahunAjaran}${calendar.nomorSK ? ' · Ditetapkan dengan SK Rektor No. ' + calendar.nomorSK : ''}` : 'Jadwal kegiatan akademik resmi.',
  breadcrumb: [{ label: 'Akademik' }, { label: 'Kalender Akademik' }],
  actions: calendar ? [{ label: 'Unduh PDF Resmi', href: calendar.file, icon: 'download', variant: 'secondary' }] : [],
}) %>

<div class="container-content pb-16">
  <% if (!calendar) { %>
    <%- include('../components/empty-state', {
      emptyIcon: 'event', emptyTitle: 'Kalender akademik belum tersedia',
      emptyText: 'Admin belum mengunggah kalender akademik.',
    }) %>
  <% } else { %>

  <% if (calendars.length > 1) { %>
  <form method="get" class="mb-6 flex flex-wrap items-center gap-3">
    <label for="tahun" class="text-sm font-medium text-muted">Tahun Ajaran</label>
    <select id="tahun" name="tahun" class="field-control w-auto">
      <% calendars.forEach(c => { %>
        <option value="<%= c.tahunAjaran %>"<%= c.tahunAjaran === calendar.tahunAjaran ? ' selected' : '' %>><%= c.tahunAjaran %></option>
      <% }) %>
    </select>
    <button type="submit" class="btn btn-secondary">Tampilkan</button>
  </form>
  <% } %>

  <% if (berlangsung.length || berikutnya.length) { %>
  <div class="mb-8 grid gap-4 md:grid-cols-2">
    <% berlangsung.forEach(e => { %>
      <div class="section-dark rounded-card p-6">
        <p class="eyebrow">Sedang berlangsung</p>
        <h2 class="mt-2 text-2xl"><%= e.nama %></h2>
        <p class="mt-2 text-sm text-on-dark-muted"><%= formatRentangTanggal(e.mulai, e.selesai) %></p>
      </div>
    <% }) %>
    <% berikutnya.forEach(e => { %>
      <div class="rounded-card border border-line bg-surface p-6">
        <p class="text-xs font-semibold text-primary uppercase">Berikutnya</p>
        <h2 class="mt-2 text-2xl"><%= e.nama %></h2>
        <p class="mt-2 text-sm text-muted"><%= formatRentangTanggal(e.mulai, e.selesai) %></p>
      </div>
    <% }) %>
  </div>
  <% } %>

  <div x-data="tabs" data-active="<%= Math.max(bySemester.findIndex(s => s.events.length), 0) %>">
    <div role="tablist" aria-label="Semester" class="flex gap-2 overflow-x-auto border-b border-line-strong">
      <% bySemester.forEach((s, i) => { %>
        <button type="button" role="tab" id="tab-<%= i %>" aria-controls="panel-<%= i %>" data-index="<%= i %>"
                x-on:click="select" x-on:keydown="move" x-bind:aria-selected="isActive" x-bind:tabindex="tabIndex"
                class="min-h-11 border-b-2 border-transparent px-3 text-sm font-semibold whitespace-nowrap text-muted hover:text-ink aria-selected:border-primary aria-selected:text-ink">
          <%= s.label %><% if (s.events.length) { %> <span class="ml-1 text-xs">(<%= s.events.length %>)</span><% } %>
        </button>
      <% }) %>
    </div>
    <% bySemester.forEach((s, i) => { %>
      <div role="tabpanel" id="panel-<%= i %>" aria-labelledby="tab-<%= i %>" data-index="<%= i %>" x-show="isActive" tabindex="0" class="panel-enter">
        <% if (!s.events.length) { %>
          <div class="p-6">
            <%- include('../components/empty-state', { emptyIcon: 'event', emptyTitle: `Belum ada kegiatan ${s.label.toLowerCase()}` }) %>
          </div>
        <% } else { %>
        <table class="data-table data-table--stack">
          <caption class="sr-only">Kegiatan <%= s.label %></caption>
          <thead><tr><th scope="col" class="w-12">No</th><th scope="col">Kegiatan</th><th scope="col">Waktu</th><th scope="col">Status</th></tr></thead>
          <tbody>
            <% s.events.forEach((e, idx) => { %>
              <tr<%= e.status.key === 'berlangsung' ? ' class="bg-primary-soft"' : '' %>>
                <td data-label="No"><%= idx + 1 %></td>
                <td data-label="Kegiatan" class="font-medium"><%= e.nama %></td>
                <td data-label="Waktu"><%= formatRentangTanggal(e.mulai, e.selesai) %></td>
                <td data-label="Status"><%- include('../components/badge', { text: e.status.label, tone: e.status.tone }) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <% } %>
      </div>
    <% }) %>
  </div>

  <% if (calendar.lampiran && calendar.lampiran.length) { %>
  <div class="mt-8">
    <h2 class="mb-3 text-2xl">Surat Edaran Terkait</h2>
    <ul class="divide-y divide-line border-y border-line">
      <% calendar.lampiran.forEach(l => { %>
        <li class="flex items-center gap-4 py-4">
          <div class="min-w-0 flex-1">
            <p class="truncate font-medium"><%= l.judul %></p>
            <p class="text-sm text-muted"><% if (l.nomorSurat) { %><%= l.nomorSurat %> · <% } %><%= formatTanggal(l.tanggal) %></p>
          </div>
          <a href="<%= l.file %>" class="btn btn-secondary shrink-0" target="_blank" rel="noopener"><%- icon('download') %>Unduh</a>
        </li>
      <% }) %>
    </ul>
  </div>
  <% } %>

  <% } %>
</div>
