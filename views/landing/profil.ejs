<%- include('../components/page-header', {
  heading: profileContent.judulHalaman,
  lead: 'Visi, misi, tugas, dan layanan Bidang Akademik Universitas Jenderal Achmad Yani.',
  breadcrumb: [{ label: 'Profil' }],
}) %>

<div class="container-content pb-16">
  <div class="max-w-3xl">
    <p class="mb-10 text-lg leading-relaxed"><%= profileContent.ringkasan %></p>
    <section class="border-t border-line py-8">
      <h2 class="mb-4 text-3xl">Visi</h2>
      <p class="leading-relaxed text-muted"><%= profileContent.visi %></p>
    </section>
    <% ['misi', 'tugas', 'fungsi'].forEach(key => { if (!profileContent[key].length) return; %>
    <section class="border-t border-line py-8">
      <h2 class="mb-4 text-3xl capitalize"><%= key %></h2>
      <ol class="list-decimal space-y-4 pl-5 leading-relaxed text-muted">
        <% profileContent[key].forEach(teks => { %><li class="pl-2"><%= teks %></li><% }) %>
      </ol>
    </section>
    <% }) %>
  </div>

  <% if (units.length) { %>
  <section class="mt-10 border-t border-line pt-8">
    <h2 class="mb-6 text-3xl">Unit Pendukung Akademik</h2>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <% units.forEach(u => { %>
      <article class="min-w-0">
        <% if (u.img) { %><img src="<%= u.img %>" alt="" class="mb-4 aspect-video w-full rounded-card object-cover" loading="lazy"><% } %>
        <h3 class="font-sans text-lg font-semibold"><%= u.nama %></h3>
        <% if (u.deskripsi) { %><p class="mt-2 text-sm leading-relaxed text-muted"><%= u.deskripsi %></p><% } %>
        <% if (u.link) { %><a href="<%= u.link %>" target="_blank" rel="noopener" class="mt-2 inline-flex min-h-11 items-center gap-2 text-sm font-semibold">Kunjungi<%- icon('open_in_new', 'size-4') %><span class="sr-only"> <%= u.nama %> (tab baru)</span></a><% } %>
      </article>
      <% }) %>
    </div>
  </section>
  <% } %>

  <section class="mt-10 border-t border-line pt-8">
    <h2 class="mb-6 text-3xl">Informasi Kontak</h2>
    <dl class="grid gap-6 sm:grid-cols-3">
      <% if (profileContent.kontakEmail) { %><div class="min-w-0"><dt class="text-sm text-muted">Email</dt><dd class="mt-1 break-words"><a href="mailto:<%= profileContent.kontakEmail %>" class="inline-flex min-h-11 items-center font-medium"><%= profileContent.kontakEmail %></a></dd></div><% } %>
      <% if (profileContent.kontakTelepon) { %><div><dt class="text-sm text-muted">Telepon</dt><dd class="mt-1 font-medium"><%= profileContent.kontakTelepon %></dd></div><% } %>
      <% if (profileContent.jamLayanan) { %><div><dt class="text-sm text-muted">Jam Layanan</dt><dd class="mt-1 font-medium"><%= profileContent.jamLayanan %></dd></div><% } %>
    </dl>
    <% if (profileContent.alamatLayanan) { %><p class="mt-4 text-sm text-muted"><%= profileContent.alamatLayanan %></p><% } %>
  </section>
</div>
