<%- include('../components/page-header', {
  heading: profileContent.judulHalaman,
  lead: 'Visi, misi, tugas, dan layanan Bidang Akademik Universitas Jenderal Achmad Yani.',
  breadcrumb: [{ label: 'Profil' }],
}) %>

<div class="container-content pt-12 pb-20 lg:pt-16 lg:pb-28">
  <div class="mb-12 grid items-start gap-10 lg:mb-16 lg:grid-cols-[minmax(0,1fr)_22.5rem] lg:gap-24">
    <p class="max-w-3xl font-serif text-[1.875rem] leading-[1.3] font-normal tracking-[-0.01em]"><%= profileContent.ringkasan %></p>
    <aside aria-labelledby="kontak-layanan">
      <h2 id="kontak-layanan" class="sidebar-title">Kontak layanan</h2>
      <dl class="divide-y divide-line">
        <% if (profileContent.kontakEmail) { %><div class="py-3"><dt class="meta-sm">Email</dt><dd class="mt-1 break-words text-sm font-bold"><a href="mailto:<%= profileContent.kontakEmail %>" class="inline-flex min-h-11 items-center"><%= profileContent.kontakEmail %></a></dd></div><% } %>
        <% if (profileContent.kontakTelepon) { %><div class="py-3"><dt class="meta-sm">Telepon</dt><dd class="mt-1 text-sm font-bold"><%= profileContent.kontakTelepon %></dd></div><% } %>
        <% if (profileContent.jamLayanan) { %><div class="py-3"><dt class="meta-sm">Jam layanan</dt><dd class="mt-1 text-sm leading-6"><%= profileContent.jamLayanan %></dd></div><% } %>
        <% if (profileContent.alamatLayanan) { %><div class="py-3"><dt class="meta-sm">Alamat</dt><dd class="mt-1 text-sm leading-6"><%= profileContent.alamatLayanan %></dd></div><% } %>
      </dl>
    </aside>
  </div>

  <div class="divide-y divide-line border-t border-ink border-b border-b-line">
    <section class="grid gap-6 py-8 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-10 lg:pb-12">
      <h2 class="flex items-start gap-10"><span class="meta-sm pt-3">01</span><span class="subsection-title">Visi</span></h2>
      <p class="font-serif text-2xl leading-[1.4]"><%= profileContent.visi %></p>
    </section>
    <% ['misi', 'tugas', 'fungsi'].forEach((key, index) => { if (!profileContent[key].length) return; %>
    <section class="grid gap-6 py-8 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-10 lg:pb-12">
      <h2 class="flex items-start gap-10"><span class="meta-sm pt-3">0<%= index + 2 %></span><span class="subsection-title capitalize"><%= key %></span></h2>
      <ol class="space-y-5 pt-1">
        <% profileContent[key].forEach((teks, i) => { %><li class="grid grid-cols-[1.25rem_minmax(0,1fr)] gap-6 text-base leading-6"><span class="meta-sm pt-1 text-primary" aria-hidden="true"><%= String(i + 1).padStart(2, '0') %></span><span><%= teks %></span></li><% }) %>
      </ol>
    </section>
    <% }) %>
  </div>

  <% if (units.length) { %>
  <section class="grid gap-8 pt-16 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-10 lg:pt-20">
    <div><p class="kicker mb-3">Unit pendukung</p><h2 class="subsection-title">Unit pendukung akademik</h2></div>
    <ol class="divide-y divide-line border-t border-ink border-b border-b-line">
      <% units.forEach((u, index) => { %>
      <li class="flex items-start gap-6 py-5">
        <span class="meta-sm pt-2" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span>
        <div class="min-w-0 flex-1">
          <h3 class="font-sans text-lg leading-6 font-bold"><%= u.nama %></h3>
          <% if (u.deskripsi) { %><p class="mt-1 text-sm leading-6 text-muted"><%= u.deskripsi %></p><% } %>
        </div>
        <% if (u.link) { %><a href="<%= u.link %>" target="_blank" rel="noopener" class="link-arrow shrink-0"><span class="hidden sm:inline">Kunjungi</span><%- icon('arrow_right_alt', 'size-5') %><span class="sr-only"> <%= u.nama %> (tab baru)</span></a><% } %>
      </li>
      <% }) %>
    </ol>
  </section>
  <% } %>
</div>
