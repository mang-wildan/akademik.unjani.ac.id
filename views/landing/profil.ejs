<%# Profil Bidang Akademik (FR-L-02). %>
<%- include('../components/page-header', {
  heading: profileContent.judulHalaman,
  lead: 'Visi, misi, tugas, dan layanan Bidang Akademik Universitas Jenderal Achmad Yani.',
  breadcrumb: [{ label: 'Profil' }],
}) %>

<div class="container-content pb-16">
  <%# Ringkasan 300–1200 karakter: terlalu panjang untuk lead di banner (F7 R3), jadi paragraf pembuka di sini. %>
  <p class="mb-8 max-w-3xl text-lg leading-relaxed text-ink"><%= profileContent.ringkasan %></p>
  <div class="grid gap-6 md:grid-cols-2">
    <div class="card card-body">
      <h2 class="mb-2 text-lg font-semibold">Visi</h2>
      <p class="text-muted"><%= profileContent.visi %></p>
    </div>
    <div class="card card-body">
      <h2 class="mb-2 text-lg font-semibold">Misi</h2>
      <ul class="list-disc space-y-1 pl-5 text-muted">
        <% profileContent.misi.forEach(m => { %><li><%= m %></li><% }) %>
      </ul>
    </div>
    <div class="card card-body">
      <h2 class="mb-2 text-lg font-semibold">Tugas</h2>
      <ul class="list-disc space-y-1 pl-5 text-muted">
        <% profileContent.tugas.forEach(t => { %><li><%= t %></li><% }) %>
      </ul>
    </div>
    <div class="card card-body">
      <h2 class="mb-2 text-lg font-semibold">Fungsi</h2>
      <ul class="list-disc space-y-1 pl-5 text-muted">
        <% profileContent.fungsi.forEach(f => { %><li><%= f %></li><% }) %>
      </ul>
    </div>
  </div>

  <% if (units.length) { %>
  <div class="mt-10">
    <h2 class="mb-4 text-xl font-semibold">Unit Pendukung Akademik</h2>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <% units.forEach(u => { %>
        <div class="card overflow-hidden">
          <% if (u.img) { %><img src="<%= u.img %>" alt="" class="aspect-video w-full object-cover"><% } %>
          <div class="card-body">
            <p class="font-semibold text-ink"><%= u.nama %></p>
            <% if (u.deskripsi) { %><p class="mt-1 line-clamp-2 text-sm text-muted"><%= u.deskripsi %></p><% } %>
            <% if (u.link) { %><a href="<%= u.link %>" target="_blank" rel="noopener" class="mt-2 inline-flex min-h-6 items-center gap-1 text-sm font-semibold"><%- icon('open_in_new', 'size-4') %>Kunjungi</a><% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
  <% } %>

  <div class="card card-body mt-10">
    <h2 class="mb-3 text-lg font-semibold">Informasi Kontak</h2>
    <dl class="grid gap-4 sm:grid-cols-3">
      <% if (profileContent.kontakEmail) { %><div><dt class="text-xs font-semibold tracking-wide text-muted uppercase">Email</dt><dd class="mt-1"><a href="mailto:<%= profileContent.kontakEmail %>" class="font-medium"><%= profileContent.kontakEmail %></a></dd></div><% } %>
      <% if (profileContent.kontakTelepon) { %><div><dt class="text-xs font-semibold tracking-wide text-muted uppercase">Telepon</dt><dd class="mt-1 font-medium"><%= profileContent.kontakTelepon %></dd></div><% } %>
      <% if (profileContent.jamLayanan) { %><div><dt class="text-xs font-semibold tracking-wide text-muted uppercase">Jam Layanan</dt><dd class="mt-1 font-medium"><%= profileContent.jamLayanan %></dd></div><% } %>
    </dl>
    <% if (profileContent.alamatLayanan) { %><p class="mt-4 text-sm text-muted"><%- icon('location_on', 'size-4 inline -mt-0.5') %> <%= profileContent.alamatLayanan %></p><% } %>
  </div>
</div>
