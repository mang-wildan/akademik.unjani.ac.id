<%# Kurikulum (FR-KU-01..03): tabel dikelompokkan per fakultas. %>
<%- include('../components/page-header', {
  heading: 'Kurikulum',
  lead: 'Dokumen kurikulum per program studi dan fakultas.',
  breadcrumb: [{ label: 'Akademik' }, { label: 'Kurikulum' }],
}) %>

<div class="container-content pt-10 pb-20 lg:pt-12 lg:pb-28">
  <form method="get" class="mb-12 flex flex-wrap items-end gap-6 pb-4">
    <div>
      <label for="fakultas" class="field-label">Fakultas</label>
      <select id="fakultas" name="fakultas" class="field-control">
        <option value="">Semua fakultas</option>
        <% fakultasList.forEach(f => { %><option value="<%= f %>"<%= filters.fakultas === f ? ' selected' : '' %>><%= f %></option><% }) %>
      </select>
    </div>
    <div>
      <label for="jenjang" class="field-label">Jenjang</label>
      <select id="jenjang" name="jenjang" class="field-control">
        <option value="">Semua jenjang</option>
        <% jenjangList.forEach(j => { %><option value="<%= j %>"<%= filters.jenjang === j ? ' selected' : '' %>><%= j %></option><% }) %>
      </select>
    </div>
    <button type="submit" class="btn btn-primary"><%- icon('filter_list') %>Terapkan</button>
    <% if (filters.fakultas || filters.jenjang) { %><a href="/kurikulum" class="btn btn-secondary">Reset</a><% } %>
  </form>

  <% if (!groups.length) { %>
    <%- include('../components/empty-state', {
      emptyIcon: 'menu_book', emptyTitle: 'Tidak ada kurikulum yang cocok',
      emptyAction: (filters.fakultas || filters.jenjang) ? { label: 'Hapus filter', href: '/kurikulum' } : null,
    }) %>
  <% } else { %>
  <div class="space-y-12">
    <% groups.forEach(g => { %>
      <section class="grid gap-6 border-t border-ink pt-5 lg:grid-cols-[20rem_1fr] lg:gap-10">
        <div>
          <h2 class="subsection-title max-w-[14rem]"><%= g.fakultas %></h2>
          <p class="meta-sm mt-3"><%= g.items.length %> program studi</p>
        </div>
        <table class="data-table data-table--stack">
          <caption class="sr-only">Kurikulum <%= g.fakultas %></caption>
          <thead><tr><th scope="col">Program Studi</th><th scope="col">Jenjang</th><th scope="col">Tahun Kurikulum</th><th scope="col"><span class="sr-only">Unduh</span></th></tr></thead>
          <tbody>
            <% g.items.forEach(k => { %>
              <tr>
                <td data-label="Program Studi" class="font-medium"><%= k.namaProdi %></td>
                <td data-label="Jenjang"><%= k.jenjang %></td>
                <td data-label="Tahun Kurikulum"><%= k.tahun %></td>
                <td data-label="Unduh"><a href="<%= k.file %>" target="_blank" rel="noopener" class="link-arrow"><%- icon('download', 'size-4') %>Unduh<span class="sr-only"> kurikulum <%= k.namaProdi %> (PDF, tab baru)</span></a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </section>
    <% }) %>
  </div>
  <% } %>
</div>
