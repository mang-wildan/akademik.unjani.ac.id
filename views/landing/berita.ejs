<%- include('../components/page-header', {
  heading: 'Berita',
  lead: 'Berita dan kegiatan akademik Universitas Jenderal Achmad Yani.',
  breadcrumb: [{ label: 'Publikasi' }, { label: 'Berita' }],
}) %>

<div class="container-content pt-6 pb-20 lg:pb-28">
  <div class="flex flex-col gap-4 border-b border-line pb-2 lg:flex-row lg:items-center lg:justify-between">
    <nav aria-label="Filter kategori berita" class="flex flex-wrap gap-x-8 gap-y-2">
      <a href="<%= basePath %><%= filters.q ? '?q=' + encodeURIComponent(filters.q) : '' %>" class="tab"<%- !filters.kategori ? ' aria-current="true"' : '' %>>Semua</a>
      <% kategoriList.forEach(k => { %>
      <a href="<%= basePath %>?kategori=<%= k._id %><%= filters.q ? '&q=' + encodeURIComponent(filters.q) : '' %>" class="tab"<%- filters.kategori === String(k._id) ? ' aria-current="true"' : '' %>><%= k.nama %></a>
      <% }) %>
    </nav>
    <form method="get" role="search" aria-label="Cari berita" class="flex gap-2">
      <% if (filters.kategori) { %><input type="hidden" name="kategori" value="<%= filters.kategori %>"><% } %>
      <label for="q" class="sr-only">Cari berita</label>
      <input id="q" name="q" type="search" class="field-control sm:w-80" placeholder="Cari berita…" value="<%= filters.q %>">
      <button type="submit" class="btn btn-dark px-3" aria-label="Cari"><%- icon('arrow_right_alt', 'size-5') %></button>
    </form>
  </div>

  <% if (!items.length) { %>
    <%- include('../components/empty-state', {
      emptyIcon: 'newspaper', emptyTitle: filters.q || filters.kategori ? 'Berita tidak ditemukan' : 'Belum ada berita',
      emptyText: filters.q ? `Tidak ada berita yang cocok dengan "${filters.q}".` : null,
      emptyAction: (filters.q || filters.kategori) ? { label: 'Hapus pencarian', href: basePath } : null,
    }) %>
  <% } else { %>
  <% const featured = items[0]; const rest = items.slice(1); %>
  <article data-featured class="grid items-start gap-8 py-9 lg:grid-cols-[minmax(0,45rem)_minmax(0,1fr)] lg:gap-12 lg:pt-12 lg:pb-16">
    <a href="<%= basePath %>/<%= featured.slug %>" class="photo block aspect-[12/7]" aria-hidden="true" tabindex="-1">
      <% if (featured.featuredImage) { %><img src="<%= featured.featuredImage %>" alt="" class="size-full object-cover"><% } %>
    </a>
    <div class="min-w-0 lg:pt-2">
      <p class="meta flex flex-wrap gap-x-2">
        <% if (featured.kategori) { %><span class="text-primary"><%= featured.kategori.nama %></span><span>·</span><% } %>
        <time datetime="<%= new Date(featured.createdAt).toISOString() %>"><%= formatTanggal(featured.createdAt, { long: true }) %></time>
      </p>
      <h2 class="subsection-title mt-3"><a href="<%= basePath %>/<%= featured.slug %>" class="text-ink no-underline hover:text-primary"><%= featured.title %></a></h2>
      <% if (featured.excerpt) { %><p class="mt-5 line-clamp-3 text-[1.0625rem] leading-[1.6875rem] text-muted"><%= featured.excerpt %></p><% } %>
      <p class="mt-6"><a href="<%= basePath %>/<%= featured.slug %>" class="link-arrow">Baca berita<%- icon('arrow_right_alt', 'size-5') %></a></p>
    </div>
  </article>

  <% if (rest.length) { %>
  <div data-reveal-group class="grid border-t border-ink border-b border-b-line lg:grid-cols-2">
    <% rest.forEach((item, index) => { %>
    <article class="grid min-w-0 grid-cols-[6.5rem_minmax(0,1fr)] items-start gap-5 border-line py-7 sm:grid-cols-[11rem_minmax(0,1fr)] sm:gap-6 <%= index >= 1 ? 'border-t' : '' %> <%= index === 1 ? 'lg:border-t-0' : '' %> <%= index % 2 === 0 ? 'lg:border-r lg:pr-8' : 'lg:pl-8' %>">
      <a href="<%= basePath %>/<%= item.slug %>" class="photo block aspect-[11/7]" aria-hidden="true" tabindex="-1">
        <% if (item.featuredImage) { %><img src="<%= item.featuredImage %>" alt="" class="size-full object-cover" loading="lazy"><% } %>
      </a>
      <div class="min-w-0">
        <p class="meta-sm">
          <% if (item.kategori) { %><%= item.kategori.nama %> · <% } %><time datetime="<%= new Date(item.createdAt).toISOString() %>"><%= formatTanggal(item.createdAt) %></time>
        </p>
        <h3 class="mt-1.5 font-sans text-lg leading-6 font-bold"><a href="<%= basePath %>/<%= item.slug %>" class="text-ink no-underline hover:text-primary"><%= item.title %></a></h3>
        <% if (item.excerpt) { %><p class="mt-2 line-clamp-2 text-sm leading-5 text-muted"><%= item.excerpt %></p><% } %>
      </div>
    </article>
    <% }) %>
  </div>
  <% } %>
  <%- include('../components/pagination', { ...pagination, noun, path: basePath, query: filters }) %>
  <% } %>
</div>
