<%# Berita (FR-P-04): kartu dengan gambar di atas, teks di bawah. Tanpa sidebar (FR-P-06). %>
<%- include('../components/page-header', {
  heading: 'Berita',
  lead: 'Berita dan kegiatan akademik Universitas Jenderal Achmad Yani.',
  breadcrumb: [{ label: 'Publikasi' }, { label: 'Berita' }],
}) %>

<div class="container-content pb-16">
  <div class="mb-5 flex flex-col gap-4 border-b border-line pb-4 sm:flex-row sm:items-center sm:justify-between">
    <% if (kategoriList.length) { %>
    <div class="flex flex-wrap gap-2">
      <a href="<%= basePath %><%= filters.q ? '?q=' + encodeURIComponent(filters.q) : '' %>" class="inline-flex min-h-11 items-center px-3 text-sm font-semibold no-underline <%= !filters.kategori ? 'border-b-2 border-primary text-primary' : 'text-muted hover:text-ink' %>"<%- !filters.kategori ? ' aria-current="true"' : '' %>>Semua</a>
      <% kategoriList.forEach(k => { %>
        <a href="<%= basePath %>?kategori=<%= k._id %><%= filters.q ? '&q=' + encodeURIComponent(filters.q) : '' %>" class="inline-flex min-h-11 items-center px-3 text-sm font-semibold no-underline <%= filters.kategori === String(k._id) ? 'border-b-2 border-primary text-primary' : 'text-muted hover:text-ink' %>"<%- filters.kategori === String(k._id) ? ' aria-current="true"' : '' %>><%= k.nama %></a>
      <% }) %>
    </div>
    <% } %>
    <form method="get" role="search" class="flex gap-2">
      <% if (filters.kategori) { %><input type="hidden" name="kategori" value="<%= filters.kategori %>"><% } %>
      <label for="q" class="sr-only">Cari berita</label>
      <input id="q" name="q" type="search" class="field-control sm:w-64" placeholder="Cari berita…" value="<%= filters.q %>">
      <button type="submit" class="btn btn-secondary" aria-label="Cari"><%- icon('search') %></button>
    </form>
  </div>

  <% if (!items.length) { %>
    <%- include('../components/empty-state', {
      emptyIcon: 'newspaper', emptyTitle: filters.q || filters.kategori ? 'Berita tidak ditemukan' : 'Belum ada berita',
      emptyText: filters.q ? `Tidak ada berita yang cocok dengan "${filters.q}".` : null,
      emptyAction: (filters.q || filters.kategori) ? { label: 'Hapus pencarian', href: basePath } : null,
    }) %>
  <% } else { %>
  <div data-reveal-group class="grid gap-x-10 sm:grid-cols-2">
    <% items.forEach((item, index) => { %>
      <article <%- index === 0 ? 'data-featured' : '' %> class="grid min-w-0 gap-5 border-t border-line py-6 <%= index === 0 ? 'sm:col-span-2 lg:grid-cols-[1.5fr_1fr] lg:gap-12 lg:py-10' : 'sm:grid-cols-[8rem_minmax(0,1fr)]' %>">
        <%# Dekoratif: judul di bawah membawa tautan yang sama dan bisa diakses, menghindari tab stop ganda ke tujuan yang sama. %>
        <a href="<%= basePath %>/<%= item.slug %>" class="block aspect-video overflow-hidden rounded-card bg-sunken" aria-hidden="true" tabindex="-1">
          <% if (item.featuredImage) { %>
            <img src="<%= item.featuredImage %>" alt="" class="size-full object-cover" loading="lazy">
          <% } else { %>
            <span class="flex size-full items-center justify-center text-muted"><%- icon('newspaper', 'size-10') %></span>
          <% } %>
        </a>
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <% if (item.pinned) { %><%- include('../components/badge', { text: 'Disematkan', tone: 'gold', badgeIcon: 'keep' }) %><% } %>
            <% if (item.kategori) { %><span class="font-semibold text-primary uppercase"><%= item.kategori.nama %></span><% } %>
            <% if (item.isBaru) { %><%- include('../components/badge', { text: 'Baru', tone: 'success' }) %><% } %>
            <span class="text-muted"><%= formatTanggal(item.createdAt) %></span>
          </div>
          <h2 class="mt-3 <%= index === 0 ? 'text-2xl sm:text-3xl lg:text-4xl' : 'font-sans text-lg' %>"><a href="<%= basePath %>/<%= item.slug %>" class="block min-h-11 font-semibold text-ink no-underline hover:text-primary"><%= item.title %></a></h2>
          <% if (item.excerpt) { %><p class="mt-1 line-clamp-2 text-sm text-muted"><%= item.excerpt %></p><% } %>
        </div>
      </article>
    <% }) %>
  </div>
  <%- include('../components/pagination', { ...pagination, noun, path: basePath, query: filters }) %>
  <% } %>
</div>
