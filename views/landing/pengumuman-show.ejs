<%# Detail pengumuman (FR-P-03): kolom baca ~720px, lampiran, pengumuman lainnya. %>
<%- include('../components/page-header', {
  heading: item.title,
  breadcrumb: [{ label: 'Pengumuman', href: '/pengumuman' }, { label: item.title }],
  article: true,
}) %>

<div class="container-content pt-10 pb-20 lg:pt-12 lg:pb-28">
  <div class="grid items-start gap-12 lg:grid-cols-[minmax(0,45rem)_minmax(0,22.5rem)] lg:justify-between">
    <article class="min-w-0">
      <p class="meta mb-6 flex flex-wrap items-center gap-x-3 gap-y-1 border-b border-line pb-5">
        <% if (item.pinned) { %><span class="text-primary">Disematkan</span><span>·</span><% } %>
        <% if (item.kategori) { %><span class="text-primary"><%= item.kategori.nama %></span><span>·</span><% } %>
        <time datetime="<%= new Date(item.createdAt).toISOString() %>"><%= formatTanggal(item.createdAt, { long: true }) %></time>
        <% if (item.createdBy) { %><span>· <%= item.createdBy.name %></span><% } %>
      </p>
      <div class="prose-content break-words"><%- item.body %></div>

      <% if (item.attachments && item.attachments.length) { %>
      <section class="mt-10 border-t border-ink pt-6" aria-labelledby="lampiran-judul">
        <h2 id="lampiran-judul" class="kicker mb-4">Lampiran (<%= item.attachments.length %>)</h2>
        <ul class="divide-y divide-line border-y border-line">
          <% item.attachments.forEach(a => { %>
            <li class="flex items-center gap-4 py-4">
              <%- icon('description', 'size-6 shrink-0 text-primary') %>
              <div class="min-w-0 flex-1">
                <p class="truncate text-base font-bold"><%= a.judul %></p>
                <% if (a.fileSize > 0) { %><p class="meta-sm mt-0.5"><%= formatUkuranFile(a.fileSize) %></p><% } %>
              </div>
              <a href="<%= a.file %>" target="_blank" rel="noopener noreferrer" aria-label="Buka lampiran: <%= a.judul %> (membuka tab baru)" class="link-arrow shrink-0">Buka<%- icon('arrow_right_alt', 'size-5') %></a>
            </li>
          <% }) %>
        </ul>
      </section>
      <% } %>
      <div class="mt-10 border-t border-line pt-6">
        <a href="<%= basePath %>" class="link-arrow"><%- icon('arrow_left_alt', 'size-5') %>Kembali ke pengumuman</a>
      </div>
    </article>

    <%- include('../components/content-sidebar', { sideBase: '/pengumuman', sideNoun: 'Pengumuman', sideItems: lainnya, sideKategori: kategoriList, sideImages: false }) %>
  </div>
</div>
