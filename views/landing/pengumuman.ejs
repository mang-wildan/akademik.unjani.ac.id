<%# Pengumuman (FR-P-01..02): daftar dengan blok tanggal, tanpa gambar, tanpa sidebar. %>
<%- include('../components/page-header', {
  heading: 'Pengumuman',
  lead: 'Pengumuman resmi akademik.',
  breadcrumb: [{ label: 'Publikasi' }, { label: 'Pengumuman' }],
}) %>

<div class="container-content pb-16">
  <div class="mb-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <% if (kategoriList.length) { %>
    <div class="flex flex-wrap gap-2">
      <a href="<%= basePath %><%= filters.q ? '?q=' + encodeURIComponent(filters.q) : '' %>" class="badge <%= !filters.kategori ? 'badge-success' : 'badge-neutral' %>">Semua</a>
      <% kategoriList.forEach(k => { %>
        <a href="<%= basePath %>?kategori=<%= k._id %><%= filters.q ? '&q=' + encodeURIComponent(filters.q) : '' %>" class="badge <%= filters.kategori === String(k._id) ? 'badge-success' : 'badge-neutral' %>"><%= k.nama %></a>
      <% }) %>
    </div>
    <% } %>
    <form method="get" role="search" class="flex gap-2">
      <% if (filters.kategori) { %><input type="hidden" name="kategori" value="<%= filters.kategori %>"><% } %>
      <label for="q" class="sr-only">Cari pengumuman</label>
      <input id="q" name="q" type="search" class="field-control sm:w-64" placeholder="Cari pengumuman…" value="<%= filters.q %>">
      <button type="submit" class="btn btn-secondary" aria-label="Cari"><%- icon('search') %></button>
    </form>
  </div>

  <% if (!items.length) { %>
    <%- include('../components/empty-state', {
      emptyIcon: 'campaign', emptyTitle: filters.q || filters.kategori ? 'Pengumuman tidak ditemukan' : 'Belum ada pengumuman',
      emptyText: filters.q ? `Tidak ada pengumuman yang cocok dengan "${filters.q}".` : null,
      emptyAction: (filters.q || filters.kategori) ? { label: 'Hapus pencarian', href: basePath } : null,
    }) %>
  <% } else { %>
  <ul class="card divide-y divide-line">
    <% items.forEach(item => { %>
      <li class="flex gap-4 p-4">
        <%- include('../components/date-block', { date: item.createdAt }) %>
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <% if (item.pinned) { %><%- include('../components/badge', { text: 'Disematkan', tone: 'gold', badgeIcon: 'keep' }) %><% } %>
            <% if (item.kategori) { %><%- include('../components/badge', { text: item.kategori.nama, tone: 'info' }) %><% } %>
            <% if (item.isBaru) { %><%- include('../components/badge', { text: 'Baru', tone: 'success' }) %><% } %>
          </div>
          <a href="<%= basePath %>/<%= item.slug %>" class="mt-1 block font-semibold text-ink hover:text-primary"><%= item.title %></a>
          <% if (item.excerpt) { %><p class="mt-1 line-clamp-2 text-sm text-muted"><%= item.excerpt %></p><% } %>
        </div>
      </li>
    <% }) %>
  </ul>
  <%- include('../components/pagination', { ...pagination, noun, path: basePath, query: filters }) %>
  <% } %>
</div>
