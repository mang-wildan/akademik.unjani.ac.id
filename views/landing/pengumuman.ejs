<%- include('../components/page-header', {
  heading: 'Pengumuman',
  lead: 'Informasi resmi tentang perkuliahan, administrasi, dan layanan akademik.',
  breadcrumb: [{ label: 'Publikasi' }, { label: 'Pengumuman' }],
}) %>

<div class="container-content pt-10 pb-20 lg:pt-12 lg:pb-28">
  <form method="get" role="search" aria-label="Cari pengumuman" class="flex max-w-4xl flex-wrap items-end gap-3">
    <% if (filters.kategori) { %><input type="hidden" name="kategori" value="<%= filters.kategori %>"><% } %>
    <div class="min-w-0 flex-1">
      <label for="q" class="field-label">Cari pengumuman</label>
      <input id="q" name="q" type="search" class="field-control" placeholder="Ketik judul atau kata kunci…" value="<%= filters.q %>">
    </div>
    <button type="submit" class="btn btn-dark shrink-0 px-10">Cari</button>
    <% if (filters.q || filters.kategori) { %><a href="<%= basePath %>" class="link-arrow w-full sm:w-auto">Hapus filter</a><% } %>
  </form>

  <div class="mt-7 flex flex-col gap-4 border-b border-ink pb-4 lg:flex-row lg:items-center lg:justify-between">
    <nav aria-label="Filter kategori pengumuman" class="flex flex-wrap gap-x-8 gap-y-2">
      <a href="<%= basePath %><%= filters.q ? '?q=' + encodeURIComponent(filters.q) : '' %>" class="tab"<%- !filters.kategori ? ' aria-current="true"' : '' %>>Semua</a>
      <% kategoriList.forEach(k => { %>
      <a href="<%= basePath %>?kategori=<%= k._id %><%= filters.q ? '&q=' + encodeURIComponent(filters.q) : '' %>" class="tab"<%- filters.kategori === String(k._id) ? ' aria-current="true"' : '' %>><%= k.nama %></a>
      <% }) %>
    </nav>
    <p id="daftar-pengumuman" class="meta-sm"><%= formatAngka(pagination.total) %> pengumuman · Disematkan dahulu<% if (filters.q) { %> · “<%= filters.q %>”<% } %></p>
  </div>

  <% if (!items.length) { %>
    <%- include('../components/empty-state', {
      emptyIcon: 'campaign', emptyTitle: filters.q || filters.kategori ? 'Pengumuman tidak ditemukan' : 'Belum ada pengumuman',
      emptyText: filters.q || filters.kategori ? 'Coba kata kunci lain atau hapus filter untuk melihat semua pengumuman.' : 'Pengumuman resmi akan ditampilkan di sini setelah diterbitkan.',
      emptyAction: (filters.q || filters.kategori) ? { label: 'Hapus filter', href: basePath } : null,
    }) %>
  <% } else { %>
  <ul class="divide-y divide-line border-b border-line" aria-labelledby="daftar-pengumuman">
    <% items.forEach((item, index) => { %>
    <li<%- index === 0 ? ' data-featured' : '' %> class="<%= item.pinned ? 'bg-primary-soft' : '' %>">
      <a href="<%= basePath %>/<%= item.slug %>" aria-labelledby="pengumuman-judul-<%= index %>" class="group grid grid-cols-[4.5rem_minmax(0,1fr)_auto] items-center gap-4 py-7 text-ink no-underline sm:grid-cols-[9rem_minmax(0,1fr)_auto] sm:gap-8 <%= item.pinned ? 'px-4 sm:px-6' : '' %>">
        <%- include('../components/date-block', { date: item.createdAt, accent: item.pinned }) %>
        <div class="min-w-0">
          <% if (item.pinned || item.kategori || item.isBaru) { %>
          <p class="meta-sm mb-2 flex flex-wrap gap-x-3 gap-y-1 <%= item.pinned ? 'text-primary' : '' %>">
            <% if (item.pinned) { %><span>Disematkan</span><% } %>
            <% if (item.kategori) { %><span><%= item.kategori.nama %></span><% } %>
            <% if (item.isBaru) { %><span>Baru</span><% } %>
          </p>
          <% } %>
          <h2 id="pengumuman-judul-<%= index %>" class="break-words font-sans text-lg leading-snug font-bold group-hover:text-primary sm:text-[1.375rem]"><%= item.title %></h2>
          <% if (item.excerpt) { %><p class="mt-2 line-clamp-2 break-words text-[0.9375rem] leading-6 text-muted"><%= item.excerpt %></p><% } %>
        </div>
        <span class="flex flex-col items-end gap-2"><%- icon('arrow_right_alt', 'row-arrow size-6') %><span class="text-xs font-bold max-sm:sr-only">Baca selengkapnya</span></span>
      </a>
    </li>
    <% }) %>
  </ul>
  <%- include('../components/pagination', { ...pagination, noun, path: basePath, query: filters }) %>
  <% } %>
</div>
