<%# Contoh halaman daftar admin dengan layout admin (hanya di development). Data fiktif. %>
<%- include('../components/page-header', {
  admin: true,
  heading: 'Kelola Pengumuman',
  lead: 'Contoh pola daftar admin: tab status, pencarian, aksi berlabel, hapus lewat konfirmasi.',
  breadcrumb: [{ label: 'Konten' }, { label: 'Pengumuman' }],
  actions: [{ label: 'Tambah Pengumuman', href: '#', icon: 'add' }],
}) %>

<div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <%- include('../components/stat-tile', { statLabel: 'Terbit', statValue: 38, statIcon: 'check_circle' }) %>
  <%- include('../components/stat-tile', { statLabel: 'Draf', statValue: 6, statIcon: 'edit' }) %>
  <%- include('../components/stat-tile', { statLabel: 'Disematkan', statValue: 1, statIcon: 'keep' }) %>
  <%- include('../components/stat-tile', { statLabel: 'Akreditasi kedaluwarsa', statValue: 4, statTone: 'danger', statIcon: 'warning', statHref: '#', statLinkLabel: 'Perbarui' }) %>
</div>

<div class="card">
  <form class="flex flex-col gap-3 border-b border-line p-4 md:flex-row" role="search" action="/dev/admin" method="get">
    <label for="cari" class="sr-only">Cari pengumuman</label>
    <input id="cari" name="q" type="search" class="field-control md:max-w-sm" placeholder="Cari judul pengumuman…">
    <label for="status" class="sr-only">Status</label>
    <select id="status" name="status" class="field-control md:w-48"><option>Semua status</option><option>Terbit</option><option>Draf</option></select>
    <button type="submit" class="btn btn-secondary"><%- icon('filter_list') %>Terapkan</button>
  </form>

  <table class="data-table data-table--stack">
    <caption class="sr-only">Daftar pengumuman</caption>
    <thead><tr><th scope="col">Judul</th><th scope="col">Kategori</th><th scope="col">Status</th><th scope="col">Diperbarui</th><th scope="col"><span class="sr-only">Aksi</span></th></tr></thead>
    <tbody>
      <% [
        { id: 'a1', t: 'Pendaftaran Wisuda Periode I Tahun 2026', cat: 'Wisuda', status: 'Terbit', d: '2026-02-03' },
        { id: 'a2', t: 'Panduan Pengajuan Cuti Akademik', cat: 'Administrasi', status: 'Draf', d: '2026-01-20' },
      ].forEach(row => { %>
        <tr>
          <td data-label="Judul" class="font-semibold"><%= row.t %></td>
          <td data-label="Kategori"><%- include('../components/badge', { text: row.cat, tone: 'info' }) %></td>
          <td data-label="Status"><%- include('../components/badge', { text: row.status, tone: row.status === 'Terbit' ? 'success' : 'neutral' }) %></td>
          <td data-label="Diperbarui"><%= formatTanggal(row.d) %></td>
          <td data-label="Aksi">
            <div class="flex items-center gap-1 md:justify-end">
              <a href="#" class="btn btn-secondary px-3" aria-label="Ubah <%= row.t %>"><%- icon('edit') %>Ubah</a>
              <div class="relative" x-data="disclosure" x-on:click.outside="close" x-on:keydown.escape="closeAndFocus">
                <button type="button" class="btn-icon" x-ref="trigger" x-on:click="toggle" x-bind:aria-expanded="open" aria-haspopup="true" aria-label="Aksi lain untuk <%= row.t %>"><%- icon('more_vert') %></button>
                <div x-show="open" x-cloak class="absolute right-0 z-10 mt-1 w-44 rounded-card border border-line bg-surface p-2 shadow-raised">
                  <button type="button" class="flex min-h-11 w-full items-center gap-2 rounded-control px-3 text-sm font-medium text-danger hover:bg-danger-soft" data-dialog-open="hapus-<%= row.id %>"><%- icon('delete') %>Hapus</button>
                </div>
              </div>
            </div>
            <%- include('../components/confirm-dialog', { dialogId: `hapus-${row.id}`, dialogTitle: 'Hapus pengumuman?', dialogText: `"${row.t}" akan dihapus permanen.`, action: '/dev/admin', confirmLabel: 'Hapus' }) %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <div class="px-4 pb-4">
    <%- include('../components/pagination', { page: 1, totalPages: 5, total: 48, from: 1, to: 10, noun: 'pengumuman', path: '/dev/admin', query: {} }) %>
  </div>
</div>
