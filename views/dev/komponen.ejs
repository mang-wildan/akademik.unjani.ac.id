<%# Katalog komponen publik (hanya di development). Data contoh di sini fiktif. %>
<%- include('../components/page-header', {
  heading: 'Katalog Komponen',
  lead: 'Semua komponen design system dalam satu halaman, untuk diuji kontras, fokus, dan tampilan HP.',
  breadcrumb: [{ label: 'Pengembangan' }, { label: 'Komponen' }],
  actions: [{ label: 'Unduh PDF resmi', href: '#tombol', icon: 'download', variant: 'secondary' }, { label: 'Contoh admin', href: '/dev/admin', icon: 'dashboard' }],
}) %>

<div class="container-content pb-8">

  <section class="space-y-10">
    <div id="tombol">
      <h2 class="mb-3 text-xl">Tombol</h2>
      <div class="flex flex-wrap items-center gap-3">
        <button type="button" class="btn btn-primary"><%- icon('add') %>Tambah Pengumuman</button>
        <button type="button" class="btn btn-secondary">Batal</button>
        <button type="button" class="btn btn-tertiary">Selengkapnya <%- icon('arrow_forward') %></button>
        <button type="button" class="btn btn-danger"><%- icon('delete') %>Hapus</button>
        <button type="button" class="btn btn-primary" disabled>Nonaktif</button>
        <button type="button" class="btn-icon" aria-label="Tutup"><%- icon('close', 'size-6') %></button>
      </div>
    </div>

    <div>
      <h2 class="mb-3 text-xl">Badge status</h2>
      <div class="flex flex-wrap gap-2">
        <%- include('../components/badge', { text: 'Berlaku', tone: 'success', badgeIcon: 'check_circle' }) %>
        <%- include('../components/badge', { text: 'Segera berakhir', tone: 'warning' }) %>
        <%- include('../components/badge', { text: 'Kedaluwarsa', tone: 'danger' }) %>
        <%- include('../components/badge', { text: 'Unggul', tone: 'gold', badgeIcon: 'workspace_premium' }) %>
        <%- include('../components/badge', { text: 'Pengumuman', tone: 'info' }) %>
        <%- include('../components/badge', { text: 'Selesai', tone: 'neutral' }) %>
      </div>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      <%- include('../components/alert', { alertTone: 'info', alertTitle: 'Informasi', alertText: 'Kalender ditetapkan dengan SK Rektor No. 179/2025.' }) %>
      <%- include('../components/alert', { alertTone: 'warning', alertTitle: 'Perpanjangan sedang diproses', alertText: 'Sertifikat akreditasi sedang dalam proses perpanjangan.' }) %>
      <%- include('../components/alert', { alertTone: 'danger', alertTitle: 'Gagal menyimpan', alertText: 'Ukuran file melebihi batas 10 MB.' }) %>
      <%- include('../components/alert', { alertTone: 'success', alertTitle: 'Tersimpan', alertText: 'Pengumuman berhasil diterbitkan.' }) %>
    </div>

    <div>
      <h2 class="mb-3 text-xl">Angka ringkas</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <%- include('../components/stat-tile', { statLabel: 'Lulusan tahun 2025', statValue: formatAngka(6289), statHint: '+14,8% dibanding 2024', statIcon: 'school' }) %>
        <%- include('../components/stat-tile', { statLabel: 'Lulusan 2024–2025', statValue: formatAngka(11769), statIcon: 'groups' }) %>
        <%- include('../components/stat-tile', { statLabel: 'Akreditasi kedaluwarsa', statValue: 4, statTone: 'danger', statIcon: 'warning', statHref: '#', statLinkLabel: 'Perbarui' }) %>
      </div>
    </div>

    <div>
      <h2 class="mb-3 text-xl">Daftar dengan blok tanggal</h2>
      <ul class="card divide-y divide-line">
        <% [
          { d: '2026-02-03', cat: 'Wisuda', t: 'Pendaftaran Wisuda Periode I Tahun 2026 dibuka', fresh: true },
          { d: '2026-01-28', cat: 'Perkuliahan', t: 'Jadwal Perwalian dan Heregistrasi Semester Genap 2025/2026' },
        ].forEach(item => { %>
          <li class="flex gap-4 p-4">
            <%- include('../components/date-block', { date: item.d }) %>
            <div>
              <div class="flex flex-wrap gap-2">
                <%- include('../components/badge', { text: item.cat, tone: 'info' }) %>
                <% if (item.fresh) { %><%- include('../components/badge', { text: 'Baru', tone: 'success' }) %><% } %>
              </div>
              <a href="#" class="mt-1 block font-semibold text-ink hover:text-primary"><%= item.t %></a>
              <p class="mt-1 text-sm text-muted"><%= formatTanggal(item.d, { long: true }) %></p>
            </div>
          </li>
        <% }) %>
      </ul>
      <p class="mt-4 mb-2 text-sm font-semibold text-muted">Varian <code>dateTone: 'solid'</code> (agenda di Beranda)</p>
      <div class="card card-body flex max-w-sm gap-4">
        <%- include('../components/date-block', { date: '2026-06-29', dateTone: 'solid' }) %>
        <div class="min-w-0">
          <%- include('../components/badge', { text: 'Akan datang', tone: 'warning' }) %>
          <p class="mt-2 font-semibold text-ink">Ujian Akhir Semester (UAS)</p>
          <p class="mt-1 text-sm text-muted"><%= formatRentangTanggal('2026-06-29', '2026-07-10') %></p>
        </div>
      </div>
    </div>

    <div>
      <h2 class="mb-3 text-xl">Tab + tabel (berubah jadi kartu di HP)</h2>
      <div x-data="tabs" data-active="1" class="card">
        <div role="tablist" aria-label="Semester" class="flex gap-1 overflow-x-auto border-b border-line p-2">
          <% ['Semester Ganjil', 'Semester Genap', 'Semester Pendek'].forEach((label, i) => { %>
            <button type="button" role="tab" id="tab-<%= i %>" aria-controls="panel-<%= i %>" data-index="<%= i %>"
                    x-on:click="select" x-on:keydown="move" x-bind:aria-selected="isActive" x-bind:tabindex="tabIndex"
                    class="btn whitespace-nowrap text-muted hover:bg-sunken aria-selected:bg-primary aria-selected:text-white"><%= label %></button>
          <% }) %>
        </div>
        <% ['Semester Ganjil', 'Semester Genap', 'Semester Pendek'].forEach((label, i) => { %>
          <div role="tabpanel" id="panel-<%= i %>" aria-labelledby="tab-<%= i %>" data-index="<%= i %>" x-show="isActive" tabindex="0">
            <table class="data-table data-table--stack">
              <caption class="sr-only">Kegiatan <%= label %></caption>
              <thead><tr><th scope="col">No</th><th scope="col">Kegiatan</th><th scope="col">Waktu</th><th scope="col">Status</th></tr></thead>
              <tbody>
                <tr>
                  <td data-label="No">1</td>
                  <td data-label="Kegiatan">Ujian Tengah Semester (UTS)</td>
                  <td data-label="Waktu"><%= formatRentangTanggal('2026-04-27', '2026-05-08') %></td>
                  <td data-label="Status"><%- include('../components/badge', { text: 'Selesai', tone: 'neutral' }) %></td>
                </tr>
                <tr class="bg-primary-soft">
                  <td data-label="No">2</td>
                  <td data-label="Kegiatan" class="font-semibold">Ujian Akhir Semester (UAS)</td>
                  <td data-label="Waktu"><%= formatRentangTanggal('2026-06-29', '2026-07-10') %></td>
                  <td data-label="Status"><%- include('../components/badge', { text: 'Berlangsung', tone: 'success' }) %></td>
                </tr>
                <tr>
                  <td data-label="No">3</td>
                  <td data-label="Kegiatan">Batas Akhir Pengumuman Nilai</td>
                  <td data-label="Waktu"><%= formatRentangTanggal('2026-07-17') %></td>
                  <td data-label="Status"><%- include('../components/badge', { text: 'Akan datang', tone: 'warning' }) %></td>
                </tr>
              </tbody>
            </table>
          </div>
        <% }) %>
      </div>
      <%- include('../components/pagination', { page: 2, totalPages: 5, total: 48, from: 11, to: 20, noun: 'kegiatan', path: '/dev/komponen', query: {} }) %>
    </div>

    <div>
      <h2 class="mb-3 text-xl">Keadaan kosong</h2>
      <%- include('../components/empty-state', { emptyIcon: 'search', emptyTitle: 'Dokumen tidak ditemukan', emptyText: 'Tidak ada dokumen yang cocok dengan "transkrip". Coba kata kunci lain.', emptyAction: { label: 'Hapus pencarian', href: '/dev/komponen' } }) %>
    </div>

    <div>
      <h2 class="mb-3 text-xl">Formulir</h2>
      <form class="card card-body grid gap-5 md:grid-cols-2" action="#" method="get" novalidate>
        <%- include('../components/form-field', { name: 'judul', label: 'Judul pengumuman', required: true, help: 'Maksimal 150 karakter.', value: 'Pendaftaran Wisuda Periode I' }) %>
        <%- include('../components/form-field', { name: 'email', label: 'Email', type: 'email', required: true, value: 'akademik@', error: 'Format email tidak valid.', autocomplete: 'email' }) %>
        <%- include('../components/form-field', { name: 'peringkat', label: 'Peringkat', type: 'select', required: true, placeholder: 'Pilih peringkat', options: ['Unggul', 'Baik Sekali', 'Baik', 'A', 'B', 'C'].map(v => ({ value: v, label: v })) }) %>
        <%- include('../components/form-field', { name: 'berlaku', label: 'Berlaku sampai', type: 'date', required: true }) %>
        <div class="md:col-span-2">
          <%- include('../components/form-field', { name: 'isi', label: 'Isi', type: 'textarea', rows: 4, placeholder: 'Tulis isi pengumuman…' }) %>
        </div>
        <div class="md:col-span-2">
          <%- include('../components/file-upload', { name: 'sertifikat', label: 'Sertifikat (PDF)', accept: 'application/pdf', limitText: 'PDF, maks. 10 MB', required: true }) %>
        </div>
        <div class="flex justify-end gap-2 md:col-span-2">
          <a href="/dev/komponen" class="btn btn-secondary">Batal</a>
          <button type="button" class="btn btn-danger" data-dialog-open="hapus-contoh"><%- icon('delete') %>Hapus</button>
          <button type="submit" class="btn btn-primary">Simpan</button>
        </div>
      </form>
      <%- include('../components/confirm-dialog', { dialogId: 'hapus-contoh', dialogTitle: 'Hapus pengumuman?', dialogText: '"Pendaftaran Wisuda Periode I" akan dihapus permanen.', action: '/dev/komponen', confirmLabel: 'Hapus' }) %>
      <p class="mt-3 text-sm text-muted">Pesan toast: <a href="/dev/komponen?success=Pengumuman%20berhasil%20disimpan">sukses</a> · <a href="/dev/komponen?error=Ukuran%20file%20terlalu%20besar">gagal</a></p>
    </div>
  </section>
</div>

<%# Seksi selebar layar (F7): .section + satu latar. Judul memakai components/section-heading. %>
<section class="section section-surface" aria-labelledby="seksi-terang">
  <div class="container-content">
    <%- include('../components/section-heading', { sectionEyebrow: 'Seksi terang', sectionHeading: 'Pengumuman Terbaru', sectionLead: 'Rata kiri, dengan tautan "lihat semua" di kanan pada layar lebar.', sectionLink: { label: 'Lihat semua pengumuman', href: '#seksi-terang' }, sectionId: 'seksi-terang' }) %>
    <p class="max-w-3xl text-muted">Teks isi tetap Plus Jakarta Sans; hanya h1–h3 yang memakai Source Serif 4.</p>
  </div>
</section>

<section class="section section-soft" aria-labelledby="seksi-hijau">
  <div class="container-content">
    <%- include('../components/section-heading', { sectionEyebrow: 'Seksi hijau muda', sectionHeading: 'Layanan Akademik', sectionLead: 'Rata tengah. Kartu putih tetap terbaca di atas latar berwarna.', sectionAlign: 'center', sectionId: 'seksi-hijau' }) %>
    <div class="grid gap-4 sm:grid-cols-3">
      <% ['Kalender Akademik', 'Dokumen & Formulir', 'Kurikulum'].forEach(label => { %>
        <a href="#seksi-hijau" class="card card-body font-semibold text-ink no-underline hover:text-primary"><%= label %></a>
      <% }) %>
    </div>
    <p class="mt-6 text-center"><a href="#seksi-hijau">Tautan biasa di latar hijau muda</a></p>
  </div>
</section>

<section class="section section-dark" aria-labelledby="seksi-gelap">
  <div class="container-content grid gap-10 lg:grid-cols-2 lg:items-center">
    <div>
      <%- include('../components/section-heading', { sectionEyebrow: 'Seksi hijau tua', sectionHeading: 'Status Mutu Institusi', sectionLead: 'Judul, eyebrow, pengantar, dan tautan berganti warna sendiri di dalam .section-dark.', sectionLink: { label: 'Lihat semua akreditasi', href: '#seksi-gelap' }, sectionId: 'seksi-gelap' }) %>
      <p class="text-on-dark-muted">Teks sekunder memakai <code>text-on-dark-muted</code>, bukan <code>text-muted</code>. <a href="#seksi-gelap">Tautan biasa</a> otomatis putih.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="#seksi-gelap" class="btn btn-accent">Tombol aksen<%- icon('arrow_forward') %></a>
        <a href="#seksi-gelap" class="btn btn-light">Tombol terang</a>
        <a href="#seksi-gelap" class="btn btn-outline-light">Tombol garis</a>
      </div>
    </div>
    <div class="card card-body">
      <h3 class="text-xl">Kartu di dalam seksi gelap</h3>
      <p class="mt-2 text-muted">Warna kartu kembali normal: judul gelap, teks sekunder abu, <a href="#seksi-gelap">tautan hijau</a>.</p>
      <div class="mt-3"><%- include('../components/badge', { text: 'Unggul', tone: 'gold', badgeIcon: 'workspace_premium' }) %></div>
    </div>
  </div>
</section>

<%# Gerak & umpan balik (F9, SRS §6.7). Halaman uji untuk R4: aktifkan prefers-reduced-motion di DevTools untuk memastikan semuanya diam. %>
<section class="section section-surface" aria-labelledby="seksi-gerak">
  <div class="container-content space-y-10">
    <h2 id="seksi-gerak" class="text-2xl">Gerak &amp; umpan balik</h2>

    <div>
      <h3 class="mb-3 text-lg">Reveal saat gulir (<code>data-reveal-group</code>, stagger 60 ms)</h3>
      <p class="mb-3 text-muted">Kartu di bawah muncul bertahap saat masuk layar. Tanpa JavaScript atau dengan reduced-motion, semuanya langsung terlihat.</p>
      <ul data-reveal-group class="grid gap-4 sm:grid-cols-3">
        <% for (let i = 1; i <= 6; i += 1) { %><li class="card card-body lift">Kartu <%= i %> (<code>.lift</code>: terangkat 2 px saat hover/fokus)</li><% } %>
      </ul>
    </div>

    <div>
      <h3 class="mb-3 text-lg">Masuk saat dimuat (<code>.fade-in-up</code>) dan menu (<code>.menu-enter</code>)</h3>
      <div class="fade-in-up card card-body max-w-md">Panel ini memudar naik sekali saat halaman dimuat.</div>
      <div class="mt-4 max-w-xs" x-data="disclosure">
        <button type="button" class="btn btn-secondary" x-on:click="toggle" x-bind:aria-expanded="open">Buka menu contoh</button>
        <ul x-show="open" x-cloak class="menu-enter mt-2 rounded-card border border-line bg-surface p-2 shadow-raised">
          <li class="flex min-h-11 items-center px-3 text-sm">Menu masuk dengan fade + geser 4 px</li>
        </ul>
      </div>
    </div>

    <div>
      <h3 class="mb-3 text-lg">Kirim form (<code>busy</code>), dialog, dan sorotan baris</h3>
      <form method="post" action="/dev/komponen" class="flex flex-wrap items-center gap-3" data-no-dirty>
        <button type="submit" class="btn btn-primary">Simpan (spinner + "Memproses…")</button>
        <button type="button" class="btn btn-secondary" data-dialog-open="dialog-contoh">Buka dialog</button>
        <button type="button" class="btn btn-secondary">Tekan saya (<code>:active</code> turun 1 px)</button>
      </form>
      <%- include('../components/confirm-dialog', { dialogId: 'dialog-contoh', dialogTitle: 'Dialog contoh?', dialogText: 'Dialog memudar + skala 0,98 → 1; latar ikut memudar.', action: '/dev/komponen', confirmLabel: 'Hapus' }) %>
      <div class="mt-4 max-w-md overflow-hidden rounded-card border border-line">
        <table class="data-table"><tbody>
          <tr class="row-flash"><td>Baris dengan <code>.row-flash</code> (menyala 1,8 dtk lalu memudar)</td></tr>
        </tbody></table>
      </div>
    </div>

    <div data-file-field>
      <h3 class="mb-3 text-lg">Unggah: pemeriksaan klien, pratinjau, seret-lepas</h3>
      <input type="file" id="f-uji" accept="image/png,image/jpeg,image/webp" data-max-mb="5" class="block w-full max-w-md rounded-control border border-dashed border-control bg-surface p-2 text-sm text-muted file:mr-3 file:min-h-10 file:cursor-pointer file:rounded-control file:border-0 file:bg-primary-soft file:px-4 file:font-semibold file:text-primary" aria-label="Gambar uji">
      <p class="field-help">JPG/PNG/WEBP, maks. 5 MB. Bisa juga diseret ke kolom ini.</p>
      <p class="field-error" data-file-error role="alert" hidden></p>
      <img data-file-preview alt="Pratinjau gambar yang dipilih" class="mt-2 max-h-40 rounded-control border border-line" hidden>
    </div>
  </div>
</section>
