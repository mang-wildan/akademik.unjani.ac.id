        <span class="app-brand-text demo text-heading fw-semibold">BAA UNJANI</span>
      </a>

      <div class="authentication-inner row m-0">
        <div class="d-none d-lg-flex col-lg-3 align-items-center justify-content-center p-12 mt-12 mt-xxl-0">
          <img
            alt="register-multi-steps-illustration"
            src="/assets/img/illustrations/auth-register-multi-steps-illustration.png"
            class="h-auto mh-100 w-px-200" />
        </div>

        <div class="d-flex col-lg-9 align-items-center justify-content-center authentication-bg p-5">
          <div class="w-px-700 mt-12 mt-lg-0 pt-lg-0 pt-4">
            <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger" role="alert"><%= error %></div>
            <% } %>

            <div id="multiStepsValidation" class="bs-stepper wizard-numbered shadow-none">
              <div class="bs-stepper-header border-bottom-0 mb-2">
                <div class="step active" data-target="#accountStep">
                  <button type="button" class="step-trigger ps-0">
                    <span class="bs-stepper-circle"><i class="icon-base ri ri-check-line"></i></span>
                    <span class="bs-stepper-label">
                      <span class="bs-stepper-number">01</span>
                      <span class="d-flex flex-column ms-2">
                        <span class="bs-stepper-title">Account</span>
                        <span class="bs-stepper-subtitle">Data akun</span>
                      </span>
                    </span>
                  </button>
                </div>
                <div class="line"></div>
                <div class="step" data-target="#securityStep">
                  <button type="button" class="step-trigger">
                    <span class="bs-stepper-circle"><i class="icon-base ri ri-check-line"></i></span>
                    <span class="bs-stepper-label">
                      <span class="bs-stepper-number">02</span>
                      <span class="d-flex flex-column ms-2">
                        <span class="bs-stepper-title">Security</span>
                        <span class="bs-stepper-subtitle">Verifikasi</span>
                      </span>
                    </span>
                  </button>
                </div>
              </div>

              <div class="bs-stepper-content">
                <form id="multiStepsForm" action="/register" method="POST" novalidate>
                  <div id="accountStep" class="content active dstepper-block">
                    <div class="content-header mb-5">
                      <h4 class="mb-1">Informasi Akun</h4>
                      <span>Isi sesuai model user (nama opsional).</span>
                    </div>
                    <div class="row gx-5">
                      <div class="col-sm-6 mb-5 form-control-validation">
                        <div class="form-floating form-floating-outline">
                          <input
                            type="text"
                            name="name"
                            id="name"
                            class="form-control"
                            placeholder="Nama lengkap"
                            value="<%= typeof values !== 'undefined' && values ? values.name || '' : '' %>" />
                          <label for="name">Nama (opsional)</label>
                        </div>
                      </div>
                      <div class="col-sm-6 mb-5 form-control-validation">
                        <div class="form-floating form-floating-outline">
                          <input
                            type="email"
                            name="email"
                            id="email"
                            class="form-control"
                            placeholder="you@example.com"
                            aria-label="email"
                            value="<%= typeof values !== 'undefined' && values ? values.email || '' : '' %>"
                            required />
                          <label for="email">Email</label>
                        </div>
                      </div>
                      <div class="col-sm-6 form-password-toggle mb-5 form-control-validation">
                        <div class="input-group input-group-merge">
                          <div class="form-floating form-floating-outline">
                            <input
                              type="password"
                              id="password"
                              name="password"
                              class="form-control"
                              placeholder="••••••"
                              aria-describedby="passwordHelp"
                              required />
                            <label for="password">Password</label>
                          </div>
                          <span class="input-group-text cursor-pointer" id="passwordHelp"
                            ><i class="icon-base ri ri-eye-off-line ri-20px"></i
                          ></span>
                        </div>
                      </div>
                      <div class="col-sm-6 form-password-toggle mb-5 form-control-validation">
                        <div class="input-group input-group-merge">
                          <div class="form-floating form-floating-outline">
                            <input
                              type="password"
                              id="confirmPassword"
                              name="confirmPassword"
                              class="form-control"
                              placeholder="••••••"
                              aria-describedby="confirmPasswordHelp"
                              required />
                            <label for="confirmPassword">Konfirmasi Password</label>
                          </div>
                          <span class="input-group-text cursor-pointer" id="confirmPasswordHelp"
                            ><i class="icon-base ri ri-eye-off-line ri-20px"></i
                          ></span>
                        </div>
                      </div>

                      <div class="col-12 d-flex justify-content-between">
                        <button class="btn btn-outline-secondary btn-prev" type="button" disabled>
                          <i class="icon-base ri ri-arrow-left-line icon-16px me-sm-1_5 me-0"></i>
                          <span class="align-middle d-sm-inline-block d-none">Previous</span>
                        </button>
                        <button class="btn btn-primary btn-next" type="button">
                          <span class="align-middle d-sm-inline-block d-none me-sm-1_5 me-0">Next</span>
                          <i class="icon-base ri ri-arrow-right-line icon-16px"></i>
                        </button>
                      </div>
                    </div>
                  </div>

                  <div id="securityStep" class="content">
                    <div class="content-header mb-5">
                      <h4 class="mb-1">Verifikasi Keamanan</h4>
                      <span>Lengkapi reCAPTCHA lalu kirim.</span>
                    </div>
                    <input
                      type="hidden"
                      name="role"
                      value="<%= typeof values !== 'undefined' && values.role ? values.role : 'user' %>" />
                    <div class="row gx-5">
                      <div class="col-md-12 mb-5 form-control-validation">
                        <input type="hidden" id="recaptchaResponse" name="recaptcha_token" />
                        <div
                          class="g-recaptcha"
                          data-sitekey="<%= recaptchaSiteKey %>"
                          data-callback="onRecaptchaSuccess"
                          data-expired-callback="onRecaptchaExpired"></div>
                      </div>
                      <div class="col-12 d-flex justify-content-between form-control-validation">
                        <button class="btn btn-outline-secondary btn-prev" type="button">
                          <i class="icon-base ri ri-arrow-left-line icon-16px me-sm-1_5 me-0"></i>
                          <span class="align-middle d-sm-inline-block d-none">Previous</span>
                        </button>
                        <button type="submit" class="btn btn-success btn-submit">
                          Submit <i class="icon-base ri ri-check-line icon-16px ms-1_5"></i>
                        </button>
                      </div>
                    </div>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      function onRecaptchaSuccess(token) {
        const input = document.getElementById('recaptchaResponse');
        if (input) {
          input.value = token;
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
        if (window.__fvStep2Instance) {
          window.__fvStep2Instance.revalidateField('recaptcha_token');
        }
      }
      function onRecaptchaExpired() {
        const input = document.getElementById('recaptchaResponse');
        if (input) {
          input.value = '';
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
        if (window.__fvStep2Instance) {
          window.__fvStep2Instance.revalidateField('recaptcha_token');
        }
      }
    </script>

