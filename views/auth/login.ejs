<%# Login admin (FR-AD-01). Halaman mandiri (bukan renderPage): tidak memakai layout publik/admin.
    ≥1024 px: layar terbagi — panel hijau berfoto di kiri, kartu formulir di kanan. Di bawah itu hanya kolom formulir. %>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Masuk | Bidang Akademik UNJANI</title>
  <meta name="description" content="Masuk ke panel admin Bidang Akademik UNJANI">
  <link rel="icon" href="/assets/landing-page/images/favicon.ico">
  <link rel="stylesheet" href="<%= assetUrl('/css/app.css') %>">
  <script src="<%= assetUrl('/js/app.js') %>" defer></script>
  <script src="/js/vendor/alpine-csp.min.js" defer></script>
</head>
<body class="min-h-dvh bg-canvas lg:grid lg:grid-cols-2">
  <%# Panel identitas (hanya ≥1024 px). display:none di layar kecil + loading="lazy" → foto tidak diunduh di ponsel.
      Judulnya <p>, bukan h1/h2: satu-satunya h1 adalah judul kartu, dan h2 yang mendahului h1 merusak urutan heading.
      Overlay tak pernah di bawah 90 % hijau: teks redup/emas tetap ≥4,5:1 sekalipun piksel foto putih. %>
  <header class="section-dark relative isolate hidden min-h-dvh flex-col overflow-hidden border-r-4 border-accent p-12 lg:flex xl:p-16">
    <img src="/img/hero-kampus.webp" alt="" width="1600" height="903" loading="lazy" decoding="async" class="absolute inset-0 -z-20 size-full object-cover">
    <div class="absolute inset-0 -z-10 bg-linear-to-b from-brand/90 via-brand/90 to-brand" aria-hidden="true"></div>

    <img src="/img/lambang-unjani.png" alt="" width="56" height="54" class="size-16 object-contain">

    <div class="my-auto max-w-lg py-12">
      <p class="eyebrow">Panel admin</p>
      <p class="mt-4 font-serif text-4xl leading-tight font-bold text-balance text-white xl:text-5xl">Bidang Akademik Universitas Jenderal Achmad Yani</p>
      <p class="mt-5 text-lg text-on-dark-muted">Kelola konten dan layanan informasi akademik resmi UNJANI.</p>
    </div>

    <p class="text-sm text-on-dark-muted">© <%= new Date().getFullYear() %> Universitas Jenderal Achmad Yani</p>
  </header>

  <main class="flex min-h-dvh items-center justify-center px-4 py-8 sm:py-12 lg:px-12">
    <div class="w-full max-w-md">
      <a href="/" class="mb-6 flex flex-col items-center gap-2 no-underline lg:hidden">
        <img src="/img/lambang-unjani.png" alt="" width="56" height="54" class="size-14 object-contain">
        <span class="text-center font-bold text-brand">Bidang Akademik<br><span class="text-sm font-medium text-muted">Universitas Jenderal Achmad Yani</span></span>
      </a>

      <div class="card border-t-4 border-t-primary p-4 sm:p-8">
        <h1 id="login-heading" class="text-2xl font-bold sm:text-3xl">Masuk ke akun Anda</h1>
        <p class="mt-2 text-sm leading-relaxed text-muted">Gunakan akun pengelola untuk mengakses panel admin Bidang Akademik.</p>

        <% if (typeof error !== 'undefined' && error) { %>
          <div id="login-error" class="mt-6 flex gap-3 rounded-control border-l-4 border-danger-solid bg-danger-soft p-4 text-sm text-danger" role="alert">
            <%- icon('error', 'size-5') %>
            <div class="min-w-0 break-words">
              <p class="font-semibold">Masuk belum berhasil</p>
              <p class="mt-1"><%= error %></p>
            </div>
          </div>
        <% } %>

        <form action="/login" method="POST" class="mt-6 space-y-5" aria-labelledby="login-heading"<% if (typeof error !== 'undefined' && error) { %> aria-describedby="login-error"<% } %> data-no-dirty x-data="disclosure">
          <%- include('../components/form-field', {
            name: 'email', label: 'Email', type: 'email', required: true,
            value: typeof values !== 'undefined' && values ? values.email : '',
            autocomplete: 'username', placeholder: 'nama@unjani.ac.id',
            /* include mewarisi locals halaman: tanpa ini pesan gagal login tampil dua kali (juga di bawah field email). */
            error: null,
          }) %>

          <div>
            <label for="f-password" class="field-label">Password <span class="text-danger" aria-hidden="true">*</span><span class="sr-only">(wajib)</span></label>
            <div class="relative">
              <%# Ternary ini aman: parser @alpinejs/csp 3.17 mendukung ConditionalExpression dan literal string. %>
              <input type="password" :type="open ? 'text' : 'password'" id="f-password" name="password" required autocomplete="current-password"
                     placeholder="Masukkan password Anda" aria-describedby="f-password-help" class="field-control pr-12">
              <button type="button" x-on:click="toggle" x-bind:aria-pressed="open" aria-pressed="false" aria-label="Tampilkan password" x-bind:aria-label="open ? 'Sembunyikan password' : 'Tampilkan password'" aria-controls="f-password" x-cloak
                      class="absolute inset-y-0 right-0 flex w-11 items-center justify-center rounded-r-control text-muted hover:bg-primary-soft hover:text-primary">
                <span x-show="!open"><%- icon('visibility', 'size-5') %></span>
                <span x-show="open" x-cloak><%- icon('visibility_off', 'size-5') %></span>
              </button>
            </div>
            <p id="f-password-help" class="field-help text-sm">Password membedakan huruf besar dan kecil.</p>
          </div>

          <% if (requireCaptcha) { %>
            <div class="border-t border-line pt-4">
              <p class="text-sm font-semibold">Verifikasi keamanan</p>
              <p class="mt-1 text-sm text-muted">Verifikasi tambahan setelah dua kali gagal masuk.</p>
              <div data-login-captcha data-sitekey="<%= recaptchaSiteKey %>" class="mt-3 flex justify-center text-sm text-muted">
                Memuat verifikasi…
              </div>
            </div>
          <% } %>

          <button type="submit" class="btn btn-primary min-h-12 w-full" data-busy-label="Sedang masuk…"<% if (locals.loginBlocked) { %> disabled<% } %>><%= locals.loginBlocked ? 'Masuk diblokir sementara' : 'Masuk ke panel admin' %><%- icon('arrow_forward', 'size-5') %></button>
          <% if (locals.loginBlocked) { %>
            <p class="text-sm text-muted">Setelah waktu tunggu berakhir, periksa kembali untuk melanjutkan masuk.</p>
            <a href="/login" class="btn btn-secondary w-full">Periksa kembali</a>
          <% } %>
        </form>

        <div class="mt-6 border-t border-line pt-5">
          <p class="text-sm font-semibold text-ink">Lupa password?</p>
          <p class="mt-1 text-sm leading-relaxed text-muted">Hubungi Super Admin Bidang Akademik untuk mengatur ulang password akun Anda.</p>
        </div>
      </div>
      <a href="/" class="mt-4 flex min-h-11 items-center justify-center gap-2 rounded-control text-center text-sm font-medium text-muted no-underline hover:text-primary"><%- icon('arrow_back', 'size-4') %>Kembali ke beranda</a>

      <p class="mt-6 text-center text-xs text-muted lg:hidden">© <%= new Date().getFullYear() %> Universitas Jenderal Achmad Yani</p>
    </div>
  </main>

</body>
</html>
