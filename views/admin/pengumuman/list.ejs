<%# Pola acuan daftar admin (docs/POLA-ADMIN.md): tab status, filter, pencarian, thumbnail, Edit berlabel, ⋯ → Hapus. %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold"><%= listLabel %></h1>
    <p class="text-muted">Kelola <%= listLabel.toLowerCase() %> yang tampil di situs publik.</p>
  </div>
  <a href="/admin/<%= basePath %>/new" class="btn btn-primary"><%- icon('add') %>Tambah <%= singularLabel %></a>
</div>

<div class="mb-4 grid grid-cols-3 gap-3">
  <%- include('../../components/stat-tile', { statLabel: 'Terbit', statValue: formatAngka(counts.totalPublished), statIcon: 'check_circle' }) %>
  <%- include('../../components/stat-tile', { statLabel: 'Draf', statValue: formatAngka(counts.totalDraft), statIcon: 'edit' }) %>
  <%- include('../../components/stat-tile', { statLabel: 'Disematkan', statValue: formatAngka(counts.totalPinned), statIcon: 'keep' }) %>
</div>

<div class="card">
  <form method="get" class="flex flex-col gap-3 border-b border-line p-4 md:flex-row md:items-center">
    <nav aria-label="Status" class="flex gap-1">
      <% [['', 'Semua'], ['published', 'Terbit'], ['draft', 'Draf']].forEach(([val, label]) => { %>
        <a href="?status=<%= val %><%= filters.kategori ? '&kategori=' + filters.kategori : '' %><%= filters.q ? '&q=' + encodeURIComponent(filters.q) : '' %>"
           class="btn <%= filters.status === val ? 'btn-primary' : 'btn-secondary' %>"<%- filters.status === val ? ' aria-current="page"' : '' %>><%= label %></a>
      <% }) %>
    </nav>
    <% if (kategoriList.length) { %>
    <select name="kategori" class="field-control md:w-48">
      <option value="">Semua kategori</option>
      <% kategoriList.forEach(k => { %><option value="<%= k._id %>"<%= filters.kategori === String(k._id) ? ' selected' : '' %>><%= k.nama %></option><% }) %>
    </select>
    <% } %>
    <% if (filters.status) { %><input type="hidden" name="status" value="<%= filters.status %>"><% } %>
    <label for="q" class="sr-only">Cari judul</label>
    <input id="q" name="q" type="search" class="field-control md:ml-auto md:w-64" placeholder="Cari judul <%= listLabel.toLowerCase() %>…" value="<%= filters.q %>">
    <button type="submit" class="btn btn-secondary"><%- icon('filter_list') %>Terapkan</button>
  </form>

  <% if (!items.length) { %>
    <div class="p-6">
      <%- include('../../components/empty-state', {
        emptyIcon: 'campaign', emptyTitle: filters.q || filters.status || filters.kategori ? 'Tidak ada yang cocok' : `Belum ada ${listLabel.toLowerCase()}`,
        emptyAction: (filters.q || filters.status || filters.kategori) ? { label: 'Hapus filter', href: `/admin/${basePath}` } : { label: `Tambah ${singularLabel}`, href: `/admin/${basePath}/new` },
      }) %>
    </div>
  <% } else { %>
  <table class="data-table data-table--stack">
    <caption class="sr-only">Daftar <%= listLabel.toLowerCase() %></caption>
    <thead><tr><th scope="col">Judul</th><th scope="col">Kategori</th><th scope="col">Status</th><th scope="col">Diperbarui</th><th scope="col"><span class="sr-only">Aksi</span></th></tr></thead>
    <tbody>
      <% items.forEach(item => { %>
        <tr>
          <td data-label="Judul">
            <div class="flex items-center gap-3">
              <% if (item.featuredImage) { %><img src="<%= item.featuredImage %>" alt="" class="size-10 shrink-0 rounded-control object-cover"><% } %>
              <span class="flex items-center gap-1 font-medium">
                <% if (item.pinned) { %><%- icon('keep', 'size-4 text-accent shrink-0') %><% } %>
                <span class="line-clamp-1"><%= item.title %></span>
              </span>
            </div>
          </td>
          <td data-label="Kategori"><% if (item.kategori) { %><span class="badge badge-info"><%= item.kategori.nama %></span><% } else { %><span class="text-muted">—</span><% } %></td>
          <td data-label="Status"><%- include('../../components/badge', { text: item.status === 'published' ? 'Terbit' : 'Draf', tone: item.status === 'published' ? 'success' : 'neutral' }) %></td>
          <td data-label="Diperbarui"><%= formatTanggal(item.updatedAt) %></td>
          <td data-label="Aksi">
            <div class="flex items-center gap-1 md:justify-end">
              <a href="/admin/<%= basePath %>/<%= item._id %>/edit" class="btn btn-secondary px-3" aria-label="Ubah <%= item.title %>"><%- icon('edit') %>Ubah</a>
              <div class="relative" x-data="disclosure" x-on:click.outside="close" x-on:keydown.escape="closeAndFocus">
                <button type="button" class="btn-icon" x-ref="trigger" x-on:click="toggle" x-bind:aria-expanded="open" aria-haspopup="true" aria-label="Aksi lain untuk <%= item.title %>"><%- icon('more_vert') %></button>
                <div x-show="open" x-cloak class="menu-enter absolute right-0 z-10 mt-1 w-48 rounded-card border border-line bg-surface p-2 shadow-raised">
                  <form action="/admin/<%= basePath %>/<%= item._id %>/pin" method="POST">
                    <button type="submit" class="flex min-h-11 w-full items-center gap-2 rounded-control px-3 text-left text-sm font-medium text-ink hover:bg-sunken"><%- icon('keep', 'size-5') %><%= item.pinned ? 'Lepas sematan' : 'Sematkan' %></button>
                  </form>
                  <button type="button" class="flex min-h-11 w-full items-center gap-2 rounded-control px-3 text-sm font-medium text-danger hover:bg-danger-soft" data-dialog-open="hapus-<%= item._id %>"><%- icon('delete', 'size-5') %>Hapus</button>
                </div>
              </div>
            </div>
            <%- include('../../components/confirm-dialog', {
              dialogId: `hapus-${item._id}`, dialogTitle: `Hapus ${singularLabel.toLowerCase()}?`,
              dialogText: `"${item.title}" akan dihapus permanen dan tidak bisa dikembalikan.`,
              action: `/admin/${basePath}/${item._id}/delete`, confirmLabel: 'Hapus',
            }) %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <div class="px-4 pb-4">
    <%- include('../../components/pagination', { ...pagination, noun: listLabel.toLowerCase(), path: `/admin/${basePath}`, query: filters }) %>
  </div>
  <% } %>
</div>
