<%# Akun Admin — superadmin-only. FR-M-13. %>
<%- include('../../components/page-header', { admin: true, heading: 'Akun Admin', lead: 'Kelola akun Super Admin dan Editor.', breadcrumb: [{ label: 'Akun Admin' }], actions: [{ label: 'Tambah Akun', href: '/admin/users/new', icon: 'add' }] }) %>

<div class="card">
  <form method="get" role="search" class="flex gap-2 border-b border-line p-4">
    <label for="q" class="sr-only">Cari nama atau email</label>
    <input id="q" name="q" type="search" class="field-control md:w-72" placeholder="Cari nama atau email…" value="<%= locals.q || '' %>">
    <button type="submit" class="btn btn-secondary"><%- icon('search') %>Cari</button>
    <% if (locals.q) { %><a href="/admin/users" class="btn btn-secondary">Reset</a><% } %>
  </form>
  <% if (!items.length) { %>
    <div class="p-6"><%- include('../../components/empty-state', { emptyIcon: 'search', emptyTitle: 'Akun tidak ditemukan', emptyText: 'Coba kata kunci lain.', emptyAction: { label: 'Hapus pencarian', href: '/admin/users' } }) %></div>
  <% } else { %>
  <table class="data-table data-table--stack">
    <caption class="sr-only">Daftar akun admin</caption>
    <thead><tr><th scope="col">Nama</th><th scope="col">Email</th><th scope="col">Peran</th><th scope="col">Status</th><th scope="col">Masuk Terakhir</th><th scope="col"><span class="sr-only">Aksi</span></th></tr></thead>
    <tbody>
      <% items.forEach(item => { %>
        <% const self = String(item._id) === currentUserId; %>
        <tr data-updated="<%= item.updatedAt ? new Date(item.updatedAt).toISOString() : '' %>">
          <td data-label="Nama"><span class="line-clamp-1 font-medium"><%= item.name || '—' %></span><% if (self) { %> <span class="badge badge-info">Anda</span><% } %></td>
          <td data-label="Email"><%= item.email %></td>
          <td data-label="Peran"><span class="badge badge-neutral"><%= roleLabel(item) %></span></td>
          <td data-label="Status"><%- include('../../components/badge', { text: item.isActive ? 'Aktif' : 'Nonaktif', tone: item.isActive ? 'success' : 'neutral' }) %></td>
          <td data-label="Masuk Terakhir"><%= item.lastLoginAt ? formatTanggal(item.lastLoginAt) : 'Belum pernah' %></td>
          <td data-label="Aksi">
            <div class="flex items-center gap-1 md:justify-end">
              <a href="/admin/users/<%= item._id %>/edit" class="btn btn-secondary px-3" aria-label="Ubah akun <%= item.email %>"><%- icon('edit') %>Ubah</a>
              <div class="relative" x-data="disclosure" x-on:click.outside="close" x-on:keydown.escape="closeAndFocus">
                <button type="button" class="btn-icon" x-ref="trigger" x-on:click="toggle" x-bind:aria-expanded="open" aria-haspopup="true" aria-label="Aksi lain untuk akun <%= item.email %>"><%- icon('more_vert') %></button>
                <div x-show="open" x-cloak class="menu-enter absolute right-0 z-10 mt-1 w-48 rounded-card border border-line bg-surface p-2 shadow-raised">
                  <a href="/admin/users/<%= item._id %>/reset-password" class="flex min-h-11 w-full items-center gap-2 rounded-control px-3 text-left text-sm font-medium text-ink hover:bg-sunken"><%- icon('settings', 'size-5') %>Reset Password</a>
                  <% if (!self) { %>
                    <button type="button" class="flex min-h-11 w-full items-center gap-2 rounded-control px-3 text-sm font-medium text-danger hover:bg-danger-soft" data-dialog-open="hapus-<%= item._id %>"><%- icon('delete', 'size-5') %>Hapus</button>
                  <% } %>
                </div>
              </div>
            </div>
            <% if (!self) { %>
              <%- include('../../components/confirm-dialog', {
                dialogId: `hapus-${item._id}`, dialogTitle: `Hapus akun ${item.email}?`,
                dialogText: 'Akun ini akan dihapus permanen dan tidak bisa dikembalikan.',
                action: `/admin/users/${item._id}/delete`, confirmLabel: 'Hapus',
              }) %>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
