<div data-list-region>
  <%- include('../_ui/page-header', { heading: title, count: pagination.total, actions: [{ label: 'Tambah Akun', href: '/admin/users/new', buttonIcon: 'add', slideOver: true, shortcut: 'new' }] }) %>
  <div data-bulk-list x-data="bulkBar" x-on:table-selection="selection" x-bind:data-bulk-active="active" class="rounded-card border border-line bg-surface">
    <%- include('../_ui/bulk-bar', { id: 'bulk-users', action: '/admin/users/bulk', noun: 'akun', total: pagination.total, state, actions: [{ value: 'deactivate', label: 'Nonaktifkan' }] }) %>
    <p class="px-4 pt-3 text-xs text-muted">Akun yang sedang Anda gunakan dilewati saat aksi massal.</p>
    <%- include('../_ui/filter-bar', { state, searchLabel: 'Cari nama atau email', filters: [
      { name: 'role', label: 'Peran', options: [{ value: 'superadmin', label: 'Super Admin' }, { value: 'admin', label: 'Super Admin (lama)' }, { value: 'editor', label: 'Editor' }] },
      { name: 'isActive', label: 'Status', options: [{ value: 'true', label: 'Aktif' }, { value: 'false', label: 'Nonaktif' }] },
    ] }) %>
    <% if (items.length) { %>
      <%- include('../_ui/data-table', { caption: title, items, state, bulkForm: 'bulk-users', slideOver: true,
        rowHref: item => `/admin/users/${item._id}/edit`, actions: item => include('actions', { item, currentUserId, state }), columns: [
          { key: 'name', label: 'Nama', sortable: true, cell: item => include('../_ui/text', { text: `${item.name || item.email}${String(item._id) === currentUserId ? ' (Anda)' : ''}` }) },
          { key: 'email', label: 'Email', sortable: true },
          { key: 'role', label: 'Peran', cell: item => include('../_ui/text', { text: roleLabel(item) }) },
          { key: 'isActive', label: 'Status', cell: item => include('../_ui/badge', { text: item.isActive ? 'Aktif' : 'Nonaktif', tone: item.isActive ? 'success' : 'neutral' }) },
          { key: 'lastLoginAt', label: 'Masuk Terakhir', sortable: true, cell: item => include('../_ui/text', { text: item.lastLoginAt ? formatTanggal(item.lastLoginAt) : 'Belum pernah' }) },
        ] }) %>
    <% } else { %><%- include('../_ui/empty-state', { text: 'Akun tidak ditemukan.', emptyIcon: 'search', action: { label: 'Hapus filter', href: '/admin/users' } }) %><% } %>
    <%- include('../_ui/pagination', { ...pagination, state, noun: 'akun' }) %>
  </div>
</div>
<%- include('../_ui/slide-over', { editUrl: '/admin/users/:id/edit', newUrl: '/admin/users/new' }) %>
