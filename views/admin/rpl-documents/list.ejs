<%# Daftar dokumen RPL — status Aktif/Arsip, bukan visibilitas publik (keduanya tampil di halaman publik). %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold">Dokumen RPL</h1>
    <p class="text-muted">Kelola dokumen &amp; panduan Rekognisi Pembelajaran Lampau.</p>
  </div>
  <a href="/admin/rpl-documents/new" class="btn btn-primary"><%- icon('add') %>Tambah Dokumen</a>
</div>

<div class="card">
  <% if (!items.length) { %>
    <div class="p-6">
      <%- include('../../components/empty-state', { emptyIcon: 'verified', emptyTitle: 'Belum ada dokumen RPL', emptyAction: { label: 'Tambah Dokumen', href: '/admin/rpl-documents/new' } }) %>
    </div>
  <% } else { %>
  <table class="data-table data-table--stack">
    <caption class="sr-only">Daftar dokumen RPL</caption>
    <thead><tr><th scope="col">Judul</th><th scope="col">Tahun</th><th scope="col">Ukuran</th><th scope="col">Status</th><th scope="col"><span class="sr-only">Aksi</span></th></tr></thead>
    <tbody>
      <% items.forEach(item => { %>
        <tr>
          <td data-label="Judul"><span class="line-clamp-1 font-medium"><%= item.judul %></span></td>
          <td data-label="Tahun"><%= item.tahun %></td>
          <td data-label="Ukuran"><%= item.fileSize ? formatUkuranFile(item.fileSize) : '—' %></td>
          <td data-label="Status"><%- include('../../components/badge', { text: item.status ? 'Aktif' : 'Arsip', tone: item.status ? 'success' : 'neutral' }) %></td>
          <td data-label="Aksi">
            <div class="flex items-center gap-1 md:justify-end">
              <a href="/admin/rpl-documents/<%= item._id %>/edit" class="btn btn-secondary px-3" aria-label="Ubah <%= item.judul %>"><%- icon('edit') %>Ubah</a>
              <button type="button" class="btn-icon text-danger hover:bg-danger-soft" data-dialog-open="hapus-<%= item._id %>" aria-label="Hapus <%= item.judul %>"><%- icon('delete') %></button>
            </div>
            <%- include('../../components/confirm-dialog', {
              dialogId: `hapus-${item._id}`, dialogTitle: `Hapus dokumen RPL?`,
              dialogText: `"${item.judul}" akan dihapus permanen dan tidak bisa dikembalikan.`,
              action: `/admin/rpl-documents/${item._id}/delete`, confirmLabel: 'Hapus',
            }) %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
