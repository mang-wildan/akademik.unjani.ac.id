<% const heading = mode === 'edit' ? 'Ubah Dokumen RPL' : 'Tambah Dokumen RPL'; %>
<% if (!locals.partial) { %><%- include('../_ui/page-header', { heading }) %><% } %>
<form method="POST" action="/admin/rpl-documents<%= mode === 'edit' ? `/${item._id}` : '' %>" enctype="multipart/form-data" data-save-form data-panel-title="<%= heading %>" x-data="dirtyGuard" x-on:input="mark" x-on:change="mark" x-on:submit="submitted" x-on:beforeunload.window="beforeUnload" class="<%= locals.partial ? '' : 'max-w-form space-y-6' %>">
<section class="form-panel space-y-5">
  <h2 class="font-serif text-lg">Data dokumen RPL</h2>
<%- include('../_ui/error-summary', { errors }) %>
  <div class="min-w-0">
    <%- include('../_ui/field', { name: 'judul', label: 'Judul', required: true, value: values.judul, error: errors.judul }) %>
  </div>
  <%- include('../_ui/field', { name: 'tahun', label: 'Tahun', type: 'number', required: true, value: values.tahun, error: errors.tahun, min: 2000, max: 2100 }) %>
  <%- include('../_ui/field', { name:'status',label:'Aktif (nonaktifkan untuk arsip)',type:'checkbox',checked:values.status === true || values.status === 'on' }) %>
  <div class="min-w-0">
    <%- include('../_ui/field', { name: 'deskripsi', label: 'Deskripsi', type: 'textarea', value: values.deskripsi, error: errors.deskripsi, help: 'Opsional, maks. 500 karakter.' }) %>
  </div>
</section>
<section class="form-panel space-y-5">
  <h2 class="font-serif text-lg">Berkas</h2>
  <div class="min-w-0">
    <%- include('../_ui/upload-field', {
      name: 'file', label: 'File (PDF)', accept: 'application/pdf', error: errors.file,
      limitText: 'PDF, maks. 10 MB.', current: (mode === 'edit' && item.file) ? { label: 'File saat ini', href: item.file } : null,
    }) %>
  </div>
</section>
  <div class="form-actions<%= locals.partial ? '' : ' max-lg:bottom-[calc(4rem+env(safe-area-inset-bottom))]' %>">
    <a href="/admin/rpl-documents" data-slide-close class="btn btn-secondary">Batal</a>
    <%- include('../_ui/button', { label: 'Simpan', type: 'submit', buttonIcon: 'check' }) %>
  </div>
</form>
