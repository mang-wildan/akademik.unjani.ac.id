<%- include('../../components/page-header', { admin: true, heading: mode === 'edit' ? 'Ubah Dokumen RPL' : 'Tambah Dokumen RPL', breadcrumb: [{ label: 'Dokumen RPL', href: '/admin/rpl-documents' }, { label: mode === 'edit' ? 'Ubah Dokumen RPL' : 'Tambah Dokumen RPL' }] }) %>

<form method="POST" action="/admin/rpl-documents<%= mode === 'edit' ? `/${item._id}` : '' %>" enctype="multipart/form-data" class="card card-body grid gap-5 md:grid-cols-2">
  <div class="md:col-span-2">
    <%- include('../../components/form-field', { name: 'judul', label: 'Judul', required: true, value: values.judul, error: errors.judul }) %>
  </div>
  <%- include('../../components/form-field', { name: 'tahun', label: 'Tahun', type: 'number', required: true, value: values.tahun, error: errors.tahun, min: 2000, max: 2100 }) %>
  <div class="flex min-h-11 items-center gap-2">
    <input type="checkbox" id="f-status" name="status" value="on" <%= values.status === undefined || values.status ? 'checked' : '' %> class="size-6 shrink-0 rounded border-control text-primary focus:ring-primary">
    <label for="f-status" class="text-sm font-medium">Aktif <span class="text-muted">(nonaktifkan untuk menandai sebagai arsip)</span></label>
  </div>
  <div class="md:col-span-2">
    <%- include('../../components/form-field', { name: 'deskripsi', label: 'Deskripsi', type: 'textarea', value: values.deskripsi, error: errors.deskripsi, help: 'Opsional, maks. 500 karakter.' }) %>
  </div>
  <div class="md:col-span-2">
    <%- include('../../components/file-upload', {
      name: 'file', label: 'File (PDF)', accept: 'application/pdf', error: errors.file,
      limitText: 'PDF, maks. 10 MB.', current: (mode === 'edit' && item.file) ? { label: 'File saat ini', href: item.file } : null,
    }) %>
  </div>
  <div class="flex justify-end gap-2 border-t border-line pt-5 md:col-span-2">
    <a href="/admin/rpl-documents" class="btn btn-secondary">Batal</a>
    <button type="submit" class="btn btn-primary">Simpan</button>
  </div>
</form>
