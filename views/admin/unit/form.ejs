<%- include('../../components/page-header', { admin: true, heading: mode === 'edit' ? 'Ubah Unit' : 'Tambah Unit', breadcrumb: [{ label: 'Unit', href: '/admin/unit' }, { label: mode === 'edit' ? 'Ubah Unit' : 'Tambah Unit' }] }) %>

<form method="POST" action="/admin/unit<%= mode === 'edit' ? `/${item._id}` : '' %>" enctype="multipart/form-data" class="card card-body grid max-w-xl gap-5">
  <%- include('../../components/form-field', { name: 'nama', label: 'Nama Unit', required: true, value: values.nama, error: errors.nama }) %>
  <%- include('../../components/form-field', { name: 'deskripsi', label: 'Deskripsi', type: 'textarea', value: values.deskripsi, error: errors.deskripsi, help: 'Opsional.' }) %>
  <%- include('../../components/form-field', { name: 'link', label: 'Tautan', type: 'url', value: values.link, error: errors.link, help: 'Opsional, mis. tautan ke situs unit.' }) %>
  <%- include('../../components/file-upload', {
    name: 'img', label: 'Gambar', accept: 'image/png,image/jpeg,image/webp', error: errors.img,
    limitText: 'JPG/PNG/WEBP, maks. 5 MB.', current: (mode === 'edit' && item.img) ? { label: 'Gambar saat ini', href: item.img } : null,
  }) %>
  <div class="flex justify-end gap-2 border-t border-line pt-5">
    <a href="/admin/unit" class="btn btn-secondary">Batal</a>
    <button type="submit" class="btn btn-primary">Simpan</button>
  </div>
</form>
