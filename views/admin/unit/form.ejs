<% const heading=mode==='edit'?'Ubah Unit':'Tambah Unit'; %>
<% if(!locals.partial){ %><%- include('../_ui/page-header',{heading}) %><% } %>
<form method="POST" action="/admin/unit<%= mode === 'edit' ? `/${item._id}` : '' %>" enctype="multipart/form-data" data-save-form data-panel-title="<%= heading %>" x-data="dirtyGuard" x-on:input="mark" x-on:change="mark" x-on:submit="submitted" x-on:beforeunload.window="beforeUnload" class="<%= locals.partial?'':'max-w-form space-y-6' %>">
<section class="form-panel space-y-5">
  <h2 class="font-serif text-lg">Data unit</h2>
<%- include('../_ui/error-summary',{errors}) %>
  <%- include('../_ui/field', { name: 'nama', label: 'Nama Unit', required: true, value: values.nama, error: errors.nama }) %>
  <%- include('../_ui/field', { name: 'deskripsi', label: 'Deskripsi', type: 'textarea', value: values.deskripsi, error: errors.deskripsi, help: 'Opsional.' }) %>
  <%- include('../_ui/field', { name: 'link', label: 'Tautan', type: 'url', value: values.link, error: errors.link, help: 'Opsional, mis. tautan ke situs unit.' }) %>
</section>
<section class="form-panel space-y-5">
  <h2 class="font-serif text-lg">Gambar unit</h2>
  <%- include('../_ui/upload-field', {
    name: 'img', label: 'Gambar', accept: 'image/png,image/jpeg,image/webp', error: errors.img,
    limitText: 'JPG/PNG/WEBP, maks. 5 MB.', current: (mode === 'edit' && item.img) ? { label: 'Gambar saat ini', href: item.img } : null,
  }) %>
  <% if (mode === 'edit' && item.img) { %><img src="<%= item.img %>" alt="Gambar saat ini" class="h-32 max-w-full rounded-control object-contain"><% } %>
</section>
<div class="form-actions<%= locals.partial?'':' max-lg:bottom-[calc(4rem+env(safe-area-inset-bottom))]' %>"><a href="/admin/unit" data-slide-close class="btn btn-secondary">Batal</a><%- include('../_ui/button',{label:'Simpan',type:'submit',buttonIcon:'check'}) %></div>
</form>
