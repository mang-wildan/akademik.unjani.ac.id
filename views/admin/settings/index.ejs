<!doctype html>
<html
  lang="en"
  class="layout-navbar-fixed layout-menu-fixed layout-compact"
  dir="ltr"
  data-skin="default"
  data-bs-theme="light"
  data-assets-path="/assets/"
  data-template="vertical-menu-template">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || 'Pengaturan Situs' %></title>
  <link rel="icon" type="image/x-icon" href="/assets/img/favicon/favicon.ico" />
  <link rel="stylesheet" href="/assets/vendor/fonts/iconify-icons.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/node-waves/node-waves.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
  <link rel="stylesheet" href="/assets/vendor/css/core.css" />
  <link rel="stylesheet" href="/assets/css/demo.css" />
  <script src="/assets/vendor/js/helpers.js"></script>
  <script src="/assets/js/config.js"></script>
  <style>
    :root {
      --sky: #0ea5e9;
      --navy: #0f172a;
      --sand: #e2e8f0;
      --mint: #d9f3ff;
    }
    body {
      background: linear-gradient(180deg, #f8fafc 0%, #eef2ff 100%);
    }
    .hero-card {
      background: linear-gradient(135deg, #07a250 0%, #0a763d 55%, #0f2a12 100%);
      color: #e8f5ff;
      border: none;
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.22);
      position: relative;
      overflow: hidden;
    }
    .hero-card::after {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 25% 18%, rgba(255,255,255,0.14), transparent 40%),
                  radial-gradient(circle at 78% 0%, rgba(255,255,255,0.1), transparent 32%);
      pointer-events: none;
    }
    .hero-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(255,255,255,0.12);
      backdrop-filter: blur(4px);
      color: #f8fafc;
      font-weight: 600;
      border: 1px solid rgba(255,255,255,0.22);
    }
    .stat-card {
      background: #fff;
      border: 1px solid var(--bs-border-color);
      border-radius: 16px;
      padding: 14px 16px;
      height: 100%;
      box-shadow: 0 10px 22px rgba(15, 23, 42, 0.06);
    }
    .stat-icon {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #e0f2fe;
      color: #25eb71;
      font-size: 20px;
    }
    .stat-value {
      font-size: 1.05rem;
      font-weight: 700;
      color: #0f172a;
    }
    .data-card {
      border-radius: 18px;
      border: 1px solid var(--bs-border-color);
      box-shadow: 0 12px 24px rgba(15, 42, 26, 0.08);
    }
    .data-row {
      display: grid;
      grid-template-columns: 160px 1fr;
      gap: 14px;
      padding: 12px 0;
      border-bottom: 1px dashed var(--bs-border-color);
    }
    .data-row:last-child { border-bottom: 0; }
    .data-label {
      color: #475569;
      font-weight: 600;
    }
    .data-value {
      color: #0f172a;
      font-weight: 700;
    }
    .muted {
      color: #64748b;
      font-weight: 500;
    }
    .media-thumb {
      border: 1px dashed #d0d7e2;
      border-radius: 12px;
      background: #f7fbff;
      padding: 10px;
      min-height: 86px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .media-thumb img {
      max-height: 70px;
      max-width: 100%;
      object-fit: contain;
    }
    .quick-table tbody tr:nth-child(odd) { background: #f8fafc; }
    .quick-table td { vertical-align: middle; }
    .badge-soft {
      background: #e7f1ff;
      color: #25eb50;
      border-radius: 999px;
      padding: 4px 10px;
      font-weight: 700;
      font-size: 12px;
    }
    .missing-pill {
      background: #fff7ed;
      color: #c2410c;
      border: 1px solid #fed7aa;
      border-radius: 12px;
      padding: 6px 10px;
      font-weight: 600;
    }
    .text-soft-light { color: rgba(255,255,255,0.78); }
    @media (max-width: 767px) {
      .data-row { grid-template-columns: 1fr; }
    }
  </style>
</head>

<body>
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <%- include("../../partials/menu") %>
      <div class="layout-page">
        <%- include("../../partials/navbar") %>
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">

            <%
              const essentials = [
                { key: 'namaSitus', label: 'Nama situs' },
                { key: 'kontakEmail', label: 'Email kontak' },
                { key: 'kontakTelepon', label: 'Telepon' },
                { key: 'alamat', label: 'Alamat' },
                { key: 'siteLogo', label: 'Logo situs' },
                { key: 'favicon', label: 'Favicon' }
              ];
              const missing = essentials.filter(item => !(values && values[item.key]));
              const completion = Math.round(((essentials.length - missing.length) / essentials.length) * 100);
              const updater = (values && values.updatedBy && (values.updatedBy.name || values.updatedBy.email)) ?
                (values.updatedBy.name || values.updatedBy.email) :
                (values && values.createdBy && (values.createdBy.name || values.createdBy.email)) ?
                  (values.createdBy.name || values.createdBy.email) : 'Tidak diketahui';
            %>

            <div class="card hero-card mb-4">
              <div class="card-body position-relative d-flex flex-column flex-lg-row align-items-start align-items-lg-center gap-3">
                <div class="flex-grow-1 position-relative">
                  <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="hero-chip">
                      <span class="iconify" data-icon="ri:global-line"></span> Global setting
                    </span>
                    <span class="hero-chip">
                      <span class="iconify" data-icon="ri:time-line"></span> <%= lastUpdatedLabel || '-' %>
                    </span>
                    <span class="hero-chip">
                      <span class="iconify" data-icon="ri:user-3-line"></span> <%= updater %>
                    </span>
                  </div>
                  <h3 class="fw-bold mt-3 mb-1 text-white">Pengaturan Situs</h3>
                  <p class="mb-0 text-soft-light">Ringkasan identitas, kontak, branding, dan tautan cepat. Pastikan data inti terisi agar tampilan publik konsisten.</p>
                </div>
                <div class="d-flex flex-column align-items-start gap-2 position-relative">
                  <div class="text-soft-light small fw-semibold">Kelengkapan data</div>
                  <div class="d-flex align-items-center gap-2 w-100">
                    <div class="progress flex-grow-1" style="height: 8px; width: 220px; background: rgba(255,255,255,0.32);">
                      <div class="progress-bar bg-warning" role="progressbar" style="width: <%= completion %>%;" aria-valuenow="<%= completion %>" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <span class="fw-bold fs-6"><%= completion %>%</span>
                  </div>
                  <div class="d-flex flex-wrap gap-2">
                    <a href="/admin/settings/edit" class="btn btn-light text-primary fw-semibold">
                      <span class="iconify me-1" data-icon="ri:edit-2-line"></span>
                      Edit Pengaturan
                    </a>
                    <a href="/admin/settings/edit#general-section" class="btn btn-outline-light text-white">
                      <span class="iconify me-1" data-icon="ri:checkbox-circle-line"></span>
                      Lengkapi Data
                    </a>
                  </div>
                </div>
              </div>
            </div>

            <% if (success) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
              <div class="d-flex align-items-center">
                <span class="iconify me-2 fs-4" data-icon="ri:checkbox-circle-line"></span>
                <span><%= success %></span>
              </div>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <% } %>

            <div class="row g-3 mb-4">
              <div class="col-sm-6 col-lg-3">
                <div class="stat-card">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">Identitas</span>
                    <span class="stat-icon"><span class="iconify" data-icon="ri:global-line"></span></span>
                  </div>
                  <div class="stat-value"><%= values && values.namaSitus ? values.namaSitus : 'Belum diatur' %></div>
                  <div class="text-muted small">Tagline: <%= values && values.tagline ? values.tagline : 'Belum diatur' %></div>
                </div>
              </div>
              <div class="col-sm-6 col-lg-3">
                <div class="stat-card">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">Kontak</span>
                    <span class="stat-icon"><span class="iconify" data-icon="ri:phone-line"></span></span>
                  </div>
                  <div class="stat-value text-truncate" title="<%= values && values.kontakTelepon ? values.kontakTelepon : '' %>">
                    <%= values && values.kontakTelepon ? values.kontakTelepon : 'Belum diatur' %>
                  </div>
                  <div class="text-muted small text-truncate" title="<%= values && values.kontakEmail ? values.kontakEmail : '' %>">
                    <%= values && values.kontakEmail ? values.kontakEmail : 'Email belum diatur' %>
                  </div>
                </div>
              </div>
              <div class="col-sm-6 col-lg-3">
                <div class="stat-card">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">Branding</span>
                    <span class="stat-icon"><span class="iconify" data-icon="ri:brush-line"></span></span>
                  </div>
                  <div class="stat-value">
                    <%= values && values.siteLogo ? 'Logo tersedia' : 'Logo belum diatur' %>
                  </div>
                  <div class="text-muted small">
                    Favicon: <%= values && values.favicon ? 'Ada' : 'Belum ada' %> · Banner RPL: <%= values && values.bannerRpl ? 'Ada' : 'Default' %>
                  </div>
                </div>
              </div>
              <div class="col-sm-6 col-lg-3">
                <div class="stat-card">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">Log Aktivitas</span>
                    <span class="stat-icon"><span class="iconify" data-icon="ri:time-line"></span></span>
                  </div>
                  <div class="stat-value text-truncate" title="<%= lastUpdatedLabel || '-' %>"><%= lastUpdatedLabel || '-' %></div>
                  <div class="text-muted small">Oleh: <%= updater %></div>
                </div>
              </div>
            </div>

            <div class="row g-4">
              <div class="col-lg-7">
                <div class="card data-card h-100">
                  <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center pb-0">
                    <div>
                      <p class="text-muted mb-1">Profil & Kontak</p>
                      <h5 class="card-title mb-0">Identitas Situs</h5>
                    </div>
                    <a href="/admin/settings/edit#general-section" class="btn btn-sm btn-outline-primary">
                      <span class="iconify me-1" data-icon="ri:edit-box-line"></span>
                      Perbarui
                    </a>
                  </div>
                  <div class="card-body pt-2">
                    <div class="data-row">
                      <div class="data-label">Nama Situs</div>
                      <div class="data-value">
                        <%- values && values.namaSitus ? values.namaSitus : '<span class="badge bg-label-warning">Belum diatur</span>' %>
                      </div>
                    </div>
                    <div class="data-row">
                      <div class="data-label">Tagline</div>
                      <div class="muted">
                        <%= values && values.tagline ? values.tagline : 'Belum diatur' %>
                      </div>
                    </div>
                    <div class="data-row">
                      <div class="data-label">Email Kontak</div>
                      <div class="data-value text-truncate" title="<%= values && values.kontakEmail ? values.kontakEmail : '' %>">
                        <%- values && values.kontakEmail ? values.kontakEmail : '<span class="badge bg-label-warning">Belum diatur</span>' %>
                      </div>
                    </div>
                    <div class="data-row">
                      <div class="data-label">Telepon</div>
                      <div class="muted">
                        <%- values && values.kontakTelepon ? values.kontakTelepon : '<span class="badge bg-label-warning">Belum diatur</span>' %>
                      </div>
                    </div>
                    <div class="data-row">
                      <div class="data-label">Alamat</div>
                      <div class="muted">
                        <%- values && values.alamat ? values.alamat : '<span class="badge bg-label-warning">Belum diatur</span>' %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-lg-5">
                <div class="card data-card h-100">
                  <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center pb-0">
                    <div>
                      <p class="text-muted mb-1">Branding & Media</p>
                      <h5 class="card-title mb-0">Pratinjau Visual</h5>
                    </div>
                    <a href="/admin/settings/edit#media-section" class="btn btn-sm btn-outline-primary">
                      <span class="iconify me-1" data-icon="ri:edit-box-line"></span>
                      Edit Media
                    </a>
                  </div>
                  <div class="card-body pt-2">
                    <div class="row g-3 mb-1">
                      <div class="col-sm-6">
                        <p class="text-muted mb-1 small">Logo Situs</p>
                        <% if (values && values.siteLogo) { %>
                          <div class="media-thumb">
                            <img src="<%= values.siteLogo %>" alt="Logo">
                          </div>
                        <% } else { %>
                          <span class="badge bg-label-warning">Belum diatur</span>
                        <% } %>
                      </div>
                      <div class="col-sm-6">
                        <p class="text-muted mb-1 small">Favicon</p>
                        <% if (values && values.favicon) { %>
                          <div class="media-thumb" style="width: 74px; height: 74px;">
                            <img src="<%= values.favicon %>" alt="Favicon" style="height:28px; width:28px;">
                          </div>
                        <% } else { %>
                          <span class="badge bg-label-warning">Belum diatur</span>
                        <% } %>
                      </div>
                    </div>

                    <div class="mb-3">
                      <p class="text-muted mb-1 small">Landing Video (YouTube embed)</p>
                      <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="iconify text-primary" data-icon="ri:movie-2-line"></span>
                        <span class="fw-semibold text-truncate" style="max-width: 240px;" title="<%= values && values.landingVideoUrl ? values.landingVideoUrl : '' %>">
                          <%= values && values.landingVideoUrl ? values.landingVideoUrl : 'Belum diatur' %>
                        </span>
                        <% if (values && values.landingVideoUrl) { %>
                          <button type="button" class="btn btn-sm btn-outline-secondary copy-url-btn" data-url="<%= values.landingVideoUrl %>" data-bs-toggle="tooltip" title="Salin URL">
                            <span class="iconify" data-icon="ri:file-copy-line"></span>
                          </button>
                          <a href="<%= values.landingVideoUrl %>" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip" title="Buka di tab baru">
                            <span class="iconify" data-icon="ri:external-link-line"></span>
                          </a>
                        <% } %>
                      </div>
                      <% if (!(values && values.landingVideoUrl)) { %>
                        <div class="text-muted small mt-1">Gunakan URL embed YouTube (https://www.youtube.com/embed/ID).</div>
                      <% } %>
                    </div>

                    <div class="mb-3">
                      <p class="text-muted mb-1 small d-flex align-items-center gap-2">
                        <span class="iconify text-primary" data-icon="ri:slideshow-line"></span> Slideshow Landing
                      </p>
                      <% if (values && values.slideshowImages && values.slideshowImages.length) { %>
                        <div class="d-flex flex-wrap gap-2">
                          <% values.slideshowImages.slice(0,6).forEach(function(img){ %>
                            <div class="border rounded p-1 bg-light" style="width: 96px; height: 60px; overflow: hidden;">
                              <img src="<%= img %>" alt="Slide" class="img-fluid" style="width: 100%; height: 100%; object-fit: cover;">
                            </div>
                          <% }); %>
                        </div>
                        <% if (values.slideshowImages.length > 6) { %>
                          <div class="text-muted small mt-1">+<%= values.slideshowImages.length - 6 %> gambar lainnya</div>
                        <% } %>
                      <% } else { %>
                        <span class="badge bg-label-warning">Belum diatur</span>
                      <% } %>
                    </div>

                    <div>
                      <p class="text-muted mb-2 small">Banner RPL</p>
                      <div class="border rounded p-2 bg-light">
                        <img src="<%= values && values.bannerRpl ? values.bannerRpl : '/assets/landing-page/images/hero-bg.jpg' %>" alt="Banner RPL" class="img-fluid rounded" style="max-height: 220px; object-fit: cover; width: 100%;">
                        <div class="d-flex justify-content-between align-items-center mt-2">
                          <small class="text-muted">Format JPG/PNG · Maks 3MB</small>
                          <% if (values && values.bannerRpl) { %>
                            <a href="<%= values.bannerRpl %>" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary">
                              <span class="iconify me-1" data-icon="ri:external-link-line"></span>
                              Buka
                            </a>
                          <% } else { %>
                            <span class="badge bg-label-warning">Belum diatur</span>
                          <% } %>
                        </div>
                      </div>
                    </div>

                    <div class="mt-3 mb-12">
                      <p class="text-muted mb-1 small d-flex align-items-center gap-2">
                        <span class="iconify text-primary" data-icon="ri:organization-chart"></span> Struktur Organisasi
                      </p>
                      <% if (values && values.strukturOrganisasiImage) { %>
                        <div class="border rounded p-2 bg-light">
                          <img src="<%= values.strukturOrganisasiImage %>" alt="Struktur Organisasi" class="img-fluid rounded" style="max-height: 260px; object-fit: contain; width: 100%;">
                          <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="text-muted">Diperbarui: <%= strukturUpdatedLabel || '-' %></small>
                            <a href="<%= values.strukturOrganisasiImage %>" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary">
                              <span class="iconify me-1" data-icon="ri:external-link-line"></span>
                              Buka
                            </a>
                          </div>
                        </div>
                      <% } else { %>
                        <span class="badge bg-label-warning">Belum diatur</span>
                        <div class="text-muted small mt-1">Tambah melalui Edit Media.</div>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="row g-4 mt-1">
              <div class="col-lg-7">
                <div class="card data-card h-100">
                  <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center pb-0">
                    <div>
                      <p class="text-muted mb-1">Footer & Navigasi</p>
                      <h5 class="card-title mb-0">Quick Links & Sosial Footer</h5>
                    </div>
                    <a href="/admin/settings/edit" class="btn btn-sm btn-outline-primary">
                      <span class="iconify me-1" data-icon="ri:link-m"></span>
                      Kelola
                    </a>
                  </div>
                  <div class="card-body pt-2">
                    <%
                      const defaultFooterDescription = 'Bidang Akademik mengatur kurikulum, jadwal perkuliahan, dan layanan administrasi mahasiswa agar proses belajar berjalan tertib dan bermutu.';
                      const footerDescription = (values && values.landingFooterDescription) ? values.landingFooterDescription : defaultFooterDescription;
                      const socialItems = [
                        { label: 'Facebook', url: values && values.socialFacebook },
                        { label: 'Twitter/X', url: values && values.socialTwitter },
                        { label: 'YouTube', url: values && values.socialYoutube },
                        { label: 'TikTok', url: values && values.socialTiktok },
                        { label: 'LinkedIn', url: values && values.socialLinkedin }
                      ];
                      const activeSocials = socialItems.filter(item => item.url);
                    %>
                    <% if (values && values.quickLinks && values.quickLinks.length) { %>
                      <div class="table-responsive">
                        <table class="table table-sm align-middle quick-table mb-0">
                          <thead>
                            <tr>
                              <th>Nama</th>
                              <th>URL</th>
                              <th class="text-end">Target</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% values.quickLinks.forEach(function(q){ %>
                              <tr>
                                <td class="fw-semibold"><%= q.label %></td>
                                <td class="text-truncate" style="max-width:240px;" title="<%= q.url %>"><%= q.url %></td>
                                <td class="text-end">
                                  <span class="badge-soft"><%= q.target === '_blank' ? 'Tab baru' : 'Halaman sama' %></span>
                                </td>
                              </tr>
                            <% }); %>
                          </tbody>
                        </table>
                      </div>
                    <% } else { %>
                      <span class="badge bg-label-warning">Belum diatur</span>
                    <% } %>

                    <div class="mt-3 pt-3 border-top">
                      <p class="text-muted mb-1 small">Deskripsi Footer Landing</p>
                      <div class="small"><%= footerDescription %></div>
                    </div>

                    <div class="mt-3">
                      <p class="text-muted mb-1 small">Sosial Media Footer</p>
                      <% if (activeSocials.length) { %>
                        <div class="d-flex flex-wrap gap-2">
                          <% activeSocials.forEach(function(social){ %>
                            <a href="<%= social.url %>" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary">
                              <%= social.label %>
                            </a>
                          <% }); %>
                        </div>
                      <% } else { %>
                        <span class="badge bg-label-warning">Belum diatur</span>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-lg-5">
                <div class="card data-card h-100">
                  <div class="card-header bg-transparent border-0 pb-0">
                    <p class="text-muted mb-1">Kelengkapan</p>
                    <h5 class="card-title mb-0">Hal yang belum terisi</h5>
                  </div>
                  <div class="card-body pt-2">
                    <% if (missing.length) { %>
                      <div class="d-flex flex-wrap gap-2 mb-3">
                        <% missing.forEach(function(item){ %>
                          <span class="missing-pill"><span class="iconify me-1" data-icon="ri:alert-line"></span> <%= item.label %></span>
                        <% }); %>
                      </div>
                      <p class="text-muted small mb-2">Isi data di bagian edit agar halaman publik menampilkan identitas lengkap.</p>
                      <a href="/admin/settings/edit" class="btn btn-sm btn-primary">
                        <span class="iconify me-1" data-icon="ri:edit-2-line"></span> Lengkapi sekarang
                      </a>
                    <% } else { %>
                      <div class="alert alert-success mb-0" role="alert">
                        <span class="iconify me-2" data-icon="ri:checkbox-circle-line"></span> Semua data inti sudah terisi rapi.
                      </div>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>

          </div>
          <div class="content-backdrop fade"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="layout-overlay layout-menu-toggle"></div>
  <div class="drag-target"></div>

  <script src="/assets/vendor/libs/jquery/jquery.js"></script>
  <script src="/assets/vendor/libs/popper/popper.js"></script>
  <script src="/assets/vendor/js/bootstrap.js"></script>
  <script src="/assets/vendor/libs/node-waves/node-waves.js"></script>
  <script src="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
  <script src="/assets/vendor/js/menu.js"></script>
  <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
  <script src="/assets/js/main.js"></script>
  <script>
    // Enable tooltips
    const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltipTriggerList.forEach(el => new bootstrap.Tooltip(el));

    // Copy URL buttons
    document.querySelectorAll('.copy-url-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const url = btn.getAttribute('data-url') || '';
        try {
          await navigator.clipboard.writeText(url);
          const original = btn.innerHTML;
          btn.innerHTML = '<span class="iconify" data-icon="ri:check-line"></span>';
          btn.classList.remove('btn-outline-secondary');
          btn.classList.add('btn-success', 'text-white');
          setTimeout(() => {
            btn.innerHTML = original;
            btn.classList.add('btn-outline-secondary');
            btn.classList.remove('btn-success', 'text-white');
          }, 1500);
        } catch (err) {
          alert('Gagal menyalin URL');
        }
      });
    });
  </script>
</body>
</html>
