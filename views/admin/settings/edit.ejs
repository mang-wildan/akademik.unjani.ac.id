<%# Pengaturan Situs -- dokumen singleton, satu halaman lihat+ubah. FR-M-12. %>
<div class="mb-6">
  <h1 class="text-2xl font-bold">Pengaturan Situs</h1>
  <p class="text-muted">Terakhir diperbarui <%= formatTanggal(lastUpdatedAt, { long: true }) %>.</p>
</div>

<form method="POST" action="/admin/settings" enctype="multipart/form-data" class="card card-body mb-6 grid gap-5">
  <h2 class="font-semibold">Kontak &amp; Footer</h2>
  <div class="grid gap-5 md:grid-cols-2">
    <%- include('../../components/form-field', { name: 'kontakEmail', label: 'Email Kontak', type: 'email', value: values.kontakEmail, error: errors.kontakEmail, help: 'Opsional.' }) %>
    <%- include('../../components/form-field', { name: 'kontakTelepon', label: 'Telepon Kontak', value: values.kontakTelepon, error: errors.kontakTelepon, help: 'Opsional.' }) %>
    <%- include('../../components/form-field', { name: 'alamat', label: 'Alamat', value: values.alamat, error: errors.alamat, help: 'Opsional.' }) %>
    <%- include('../../components/form-field', { name: 'jamLayanan', label: 'Jam Layanan', value: values.jamLayanan, error: errors.jamLayanan, placeholder: 'Senin-Jumat, 08.00-15.30 WIB' }) %>
  </div>
  <%- include('../../components/form-field', { name: 'landingFooterDescription', label: 'Deskripsi Footer', type: 'textarea', value: values.landingFooterDescription, error: errors.landingFooterDescription, help: 'Opsional, maks. 300 karakter.' }) %>
  <%- include('../../components/form-field', { name: 'landingVideoUrl', label: 'URL Video Profil (Beranda)', type: 'url', value: values.landingVideoUrl, error: errors.landingVideoUrl, help: 'Opsional. Tempel tautan YouTube biasa (watch, youtu.be, atau shorts); otomatis dijadikan tautan sematan. Kosongkan untuk sembunyikan bagian video.' }) %>

  <h2 class="pt-2 font-semibold">Media Sosial</h2>
  <div class="grid gap-5 md:grid-cols-2">
    <%- include('../../components/form-field', { name: 'socialFacebook', label: 'Facebook', type: 'url', value: values.socialFacebook, error: errors.socialFacebook }) %>
    <%- include('../../components/form-field', { name: 'socialInstagram', label: 'Instagram', type: 'url', value: values.socialInstagram, error: errors.socialInstagram }) %>
    <%- include('../../components/form-field', { name: 'socialYoutube', label: 'YouTube', type: 'url', value: values.socialYoutube, error: errors.socialYoutube }) %>
    <%- include('../../components/form-field', { name: 'socialTiktok', label: 'TikTok', type: 'url', value: values.socialTiktok, error: errors.socialTiktok }) %>
    <%- include('../../components/form-field', { name: 'socialTwitter', label: 'Twitter/X', type: 'url', value: values.socialTwitter, error: errors.socialTwitter }) %>
    <%- include('../../components/form-field', { name: 'socialLinkedin', label: 'LinkedIn', type: 'url', value: values.socialLinkedin, error: errors.socialLinkedin }) %>
  </div>

  <h2 class="pt-2 font-semibold">Gambar</h2>
  <div class="grid gap-5 md:grid-cols-2">
    <%- include('../../components/file-upload', {
      name: 'favicon', label: 'Favicon', accept: 'image/png,image/jpeg,image/webp', error: errors.favicon,
      limitText: 'JPG/PNG/WEBP, maks. 5 MB.', current: item.favicon ? { label: 'Favicon saat ini', href: item.favicon } : null,
    }) %>
    <%- include('../../components/file-upload', {
      name: 'strukturOrganisasiImage', label: 'Gambar Struktur Organisasi', accept: 'image/png,image/jpeg,image/webp', error: errors.strukturOrganisasiImage,
      limitText: 'JPG/PNG/WEBP, maks. 5 MB.', current: item.strukturOrganisasiImage ? { label: 'Gambar saat ini', href: item.strukturOrganisasiImage } : null,
    }) %>
  </div>

  <div class="flex justify-end border-t border-line pt-5">
    <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
  </div>
</form>

<div class="card card-body space-y-4">
  <h2 class="font-semibold">Tautan Cepat (Footer)</h2>
  <% if (item.quickLinks && item.quickLinks.length) { %>
    <ul class="space-y-2">
      <% item.quickLinks.forEach(l => { %>
        <li class="flex items-center gap-3 rounded-control border border-line px-3 py-2">
          <div class="min-w-0 flex-1">
            <p class="truncate font-medium"><%= l.label %></p>
            <p class="truncate text-xs text-muted"><%= l.url %> <% if (l.target === '_blank') { %>· tab baru<% } %></p>
          </div>
          <form method="POST" action="/admin/settings/quick-links/<%= l._id %>/delete">
            <button type="submit" class="btn-icon shrink-0 text-danger hover:bg-danger-soft" aria-label="Hapus tautan <%= l.label %>"><%- icon('delete', 'size-5') %></button>
          </form>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p class="text-sm text-muted">Belum ada tautan cepat. Footer memakai tautan bawaan (Portal UNJANI).</p>
  <% } %>

  <details class="rounded-control border border-line">
    <summary class="min-h-11 cursor-pointer select-none px-4 py-2.5 text-sm font-semibold">+ Tambah tautan cepat</summary>
    <form method="POST" action="/admin/settings/quick-links" class="grid gap-4 border-t border-line p-4 sm:grid-cols-3">
      <%- include('../../components/form-field', { name: 'label', label: 'Label', required: true, value: quickLinkValues.label, error: quickLinkErrors.label }) %>
      <%- include('../../components/form-field', { name: 'url', label: 'URL', type: 'url', required: true, value: quickLinkValues.url, error: quickLinkErrors.url }) %>
      <%- include('../../components/form-field', {
        name: 'target', label: 'Buka di', type: 'select', required: true, value: quickLinkValues.target || '_self', error: quickLinkErrors.target,
        options: [{ value: '_self', label: 'Tab yang sama' }, { value: '_blank', label: 'Tab baru' }],
      }) %>
      <div class="sm:col-span-3 flex justify-end"><button type="submit" class="btn btn-primary">Tambah Tautan</button></div>
    </form>
  </details>
</div>
