<%# Program Studi + impor CSV — FR-M-11. %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold">Program Studi</h1>
    <p class="text-muted">Master data program studi per fakultas.</p>
  </div>
  <a href="/admin/program-studi/new" class="btn btn-primary"><%- icon('add') %>Tambah Program Studi</a>
</div>

<div class="card card-body mb-6 space-y-4">
  <h2 class="font-semibold">Impor dari CSV</h2>
  <% if (importErrors) { %>
    <div class="rounded-control border border-danger-solid bg-danger-soft p-3 text-sm text-danger">
      <p class="font-semibold">Impor gagal, tidak ada yang disimpan:</p>
      <ul class="mt-1 list-disc space-y-0.5 pl-5">
        <% importErrors.forEach(e => { %><li><%= e %></li><% }) %>
      </ul>
    </div>
  <% } %>
  <form method="POST" action="/admin/program-studi/import" enctype="multipart/form-data" class="flex flex-col gap-3 sm:flex-row sm:items-end">
    <div class="flex-1">
      <%- include('../../components/file-upload', { name: 'csv', label: 'File CSV', accept: '.csv,text/csv', required: true, limitText: 'Kolom: nama, singkatan, fakultas.' }) %>
    </div>
    <button type="submit" class="btn btn-secondary">Impor</button>
  </form>
</div>

<div class="card">
  <% if (!items.length) { %>
    <div class="p-6">
      <%- include('../../components/empty-state', { emptyIcon: 'school', emptyTitle: 'Belum ada program studi', emptyAction: { label: 'Tambah Program Studi', href: '/admin/program-studi/new' } }) %>
    </div>
  <% } else { %>
  <table class="data-table data-table--stack">
    <caption class="sr-only">Daftar program studi</caption>
    <thead><tr><th scope="col">Nama</th><th scope="col">Singkatan</th><th scope="col">Fakultas</th><th scope="col"><span class="sr-only">Aksi</span></th></tr></thead>
    <tbody>
      <% items.forEach(item => { %>
        <tr>
          <td data-label="Nama"><span class="line-clamp-1 font-medium"><%= item.nama %></span></td>
          <td data-label="Singkatan"><%= item.singkatan %></td>
          <td data-label="Fakultas"><%= item.fakultas ? item.fakultas.nama : '—' %></td>
          <td data-label="Aksi">
            <div class="flex items-center gap-1 md:justify-end">
              <a href="/admin/program-studi/<%= item._id %>/edit" class="btn btn-secondary px-3" aria-label="Ubah <%= item.nama %>"><%- icon('edit') %>Ubah</a>
              <button type="button" class="btn-icon text-danger hover:bg-danger-soft" data-dialog-open="hapus-<%= item._id %>" aria-label="Hapus <%= item.nama %>"><%- icon('delete') %></button>
            </div>
            <%- include('../../components/confirm-dialog', {
              dialogId: `hapus-${item._id}`, dialogTitle: `Hapus ${item.nama}?`,
              dialogText: 'Data ini akan dihapus permanen dan tidak bisa dikembalikan.',
              action: `/admin/program-studi/${item._id}/delete`, confirmLabel: 'Hapus',
            }) %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
