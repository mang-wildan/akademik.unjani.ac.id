<%# Pola acuan master data sederhana (nama+singkatan[+urutan]) — dipakai Fakultas & Lembaga Akreditasi. FR-M-11. %>
<%- include('../../components/page-header', { admin: true, heading: listLabel, lead: 'Master data — perubahan di sini memengaruhi data yang merujuknya.', breadcrumb: [{ label: listLabel }], actions: [{ label: `Tambah ${singularLabel}`, href: `/admin/${basePath}/new`, icon: 'add' }] }) %>

<div class="card">
  <% if (!items.length) { %>
    <div class="p-6">
      <%- include('../../components/empty-state', { emptyIcon: 'apartment', emptyTitle: `Belum ada ${listLabel.toLowerCase()}`, emptyAction: { label: `Tambah ${singularLabel}`, href: `/admin/${basePath}/new` } }) %>
    </div>
  <% } else { %>
  <table class="data-table data-table--stack">
    <caption class="sr-only">Daftar <%= listLabel.toLowerCase() %></caption>
    <thead><tr><th scope="col">Nama</th><th scope="col">Singkatan</th><% if (hasUrutan) { %><th scope="col">Urutan</th><% } %><th scope="col"><span class="sr-only">Aksi</span></th></tr></thead>
    <tbody>
      <% items.forEach(item => { %>
        <tr data-updated="<%= item.updatedAt ? new Date(item.updatedAt).toISOString() : '' %>">
          <td data-label="Nama"><span class="line-clamp-1 font-medium"><%= item.nama %></span></td>
          <td data-label="Singkatan"><%= item.singkatan %></td>
          <% if (hasUrutan) { %><td data-label="Urutan"><%= item.urutan %></td><% } %>
          <td data-label="Aksi">
            <div class="flex items-center gap-1 md:justify-end">
              <a href="/admin/<%= basePath %>/<%= item._id %>/edit" class="btn btn-secondary px-3" aria-label="Ubah <%= item.nama %>"><%- icon('edit') %>Ubah</a>
              <button type="button" class="btn-icon text-danger hover:bg-danger-soft" data-dialog-open="hapus-<%= item._id %>" aria-label="Hapus <%= item.nama %>"><%- icon('delete') %></button>
            </div>
            <%- include('../../components/confirm-dialog', {
              dialogId: `hapus-${item._id}`, dialogTitle: `Hapus ${item.nama}?`,
              dialogText: 'Data ini akan dihapus permanen dan tidak bisa dikembalikan.',
              action: `/admin/${basePath}/${item._id}/delete`, confirmLabel: 'Hapus',
            }) %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
