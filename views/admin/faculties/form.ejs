<% const heading=mode==='edit'?`Ubah ${singularLabel}`:`Tambah ${singularLabel}`; %>
<% if(!locals.partial){ %><%- include('../_ui/page-header',{heading}) %><% } %>
<form method="POST" action="/admin/<%= basePath %><%= mode === 'edit' ? `/${item._id}` : '' %>" data-save-form data-panel-title="<%= heading %>" x-data="dirtyGuard" x-on:input="mark" x-on:change="mark" x-on:submit="submitted" x-on:beforeunload.window="beforeUnload" class="max-w-form space-y-5 rounded-card border border-line bg-surface p-4">
  <%- include('../_ui/error-summary',{errors}) %>
  <%- include('../_ui/field', { name: 'nama', label: 'Nama', required: true, value: values.nama, error: errors.nama }) %>
  <%- include('../_ui/field', { name: 'singkatan', label: 'Singkatan', required: true, value: values.singkatan, error: errors.singkatan }) %>
  <% if (hasUrutan) { %>
    <%- include('../_ui/field', { name: 'urutan', label: 'Urutan Tampil', type: 'number', value: values.urutan, error: errors.urutan, min: 0, max: 999 }) %>
  <% } %>
  <div class="form-actions<%= locals.partial ? '' : ' max-lg:bottom-[calc(4rem+env(safe-area-inset-bottom))]' %>">
    <a href="/admin/<%= basePath %>" data-slide-close class="btn btn-secondary">Batal</a>
    <%- include('../_ui/button',{label:'Simpan',type:'submit'}) %>
  </div>
</form>
