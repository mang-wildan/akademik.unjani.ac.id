<div class="mb-6">
  <a href="/admin/<%= basePath %>" class="mb-2 inline-flex min-h-6 items-center gap-1 text-sm font-medium text-muted hover:text-ink"><%- icon('arrow_back', 'size-4') %>Kembali</a>
  <h1 class="text-2xl font-bold"><%= mode === 'edit' ? `Ubah ${singularLabel}` : `Tambah ${singularLabel}` %></h1>
</div>

<form method="POST" action="/admin/<%= basePath %><%= mode === 'edit' ? `/${item._id}` : '' %>" class="card card-body grid max-w-xl gap-5">
  <%- include('../../components/form-field', { name: 'nama', label: 'Nama', required: true, value: values.nama, error: errors.nama }) %>
  <%- include('../../components/form-field', { name: 'singkatan', label: 'Singkatan', required: true, value: values.singkatan, error: errors.singkatan }) %>
  <% if (hasUrutan) { %>
    <%- include('../../components/form-field', { name: 'urutan', label: 'Urutan Tampil', type: 'number', value: values.urutan, error: errors.urutan, min: 0, max: 999 }) %>
  <% } %>
  <div class="flex justify-end gap-2 border-t border-line pt-5">
    <a href="/admin/<%= basePath %>" class="btn btn-secondary">Batal</a>
    <button type="submit" class="btn btn-primary">Simpan</button>
  </div>
</form>
