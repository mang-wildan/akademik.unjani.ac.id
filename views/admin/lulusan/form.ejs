<%- include('../../components/page-header', { admin: true, heading: mode === 'edit' ? 'Ubah Data Lulusan' : 'Tambah Data Lulusan', breadcrumb: [{ label: 'Data Lulusan', href: '/admin/lulusan' }, { label: mode === 'edit' ? 'Ubah Data Lulusan' : 'Tambah Data Lulusan' }] }) %>

<form method="POST" action="/admin/lulusan<%= mode === 'edit' ? `/${item._id}` : '' %>" class="card card-body grid gap-5 md:grid-cols-2">
  <%- include('../../components/form-field', {
    name: 'programStudi', label: 'Program Studi', type: 'select', required: true, value: values.programStudi && String(values.programStudi._id || values.programStudi), error: errors.programStudi,
    placeholder: 'Pilih program studi', options: prodiList.map(p => ({ value: p._id, label: p.fakultas ? `${p.nama} (${p.fakultas.nama})` : p.nama })),
  }) %>
  <%- include('../../components/form-field', {
    name: 'fakultas', label: 'Fakultas', type: 'select', required: true, value: values.fakultas && String(values.fakultas._id || values.fakultas), error: errors.fakultas,
    placeholder: 'Pilih fakultas', options: fakultasList.map(f => ({ value: f._id, label: f.nama })),
  }) %>
  <%- include('../../components/form-field', { name: 'periode', label: 'Periode', required: true, value: values.periode, error: errors.periode, placeholder: 'mis. I, II, III' }) %>
  <%- include('../../components/form-field', { name: 'tahun', label: 'Tahun', type: 'number', required: true, value: values.tahun, error: errors.tahun, min: 1950, max: 2100 }) %>
  <div class="md:col-span-2">
    <%- include('../../components/form-field', { name: 'jumlah', label: 'Jumlah Lulusan', type: 'number', required: true, value: values.jumlah, error: errors.jumlah, min: 0 }) %>
  </div>
  <div class="flex justify-end gap-2 border-t border-line pt-5 md:col-span-2">
    <a href="/admin/lulusan" class="btn btn-secondary">Batal</a>
    <button type="submit" class="btn btn-primary">Simpan</button>
  </div>
</form>
