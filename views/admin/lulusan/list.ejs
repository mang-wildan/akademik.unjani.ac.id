<%# Daftar data lulusan + impor CSV — FR-M-08. %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold">Data Lulusan</h1>
    <p class="text-muted">Kelola jumlah lulusan per program studi, fakultas, periode, dan tahun.</p>
  </div>
  <a href="/admin/lulusan/new" class="btn btn-primary"><%- icon('add') %>Tambah Data</a>
</div>

<div class="card card-body mb-6 space-y-4">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 class="font-semibold">Impor dari CSV</h2>
    <a href="/admin/lulusan/template.csv" class="inline-flex min-h-6 items-center gap-1 text-sm font-medium"><%- icon('download', 'size-4') %>Unduh template CSV</a>
  </div>
  <% if (importErrors) { %>
    <div class="rounded-control border border-danger-solid bg-danger-soft p-3 text-sm text-danger">
      <p class="font-semibold">Impor gagal, tidak ada yang disimpan:</p>
      <ul class="mt-1 list-disc space-y-0.5 pl-5">
        <% importErrors.forEach(e => { %><li><%= e %></li><% }) %>
      </ul>
    </div>
  <% } %>
  <form method="POST" action="/admin/lulusan/import" enctype="multipart/form-data" class="flex flex-col gap-3 sm:flex-row sm:items-end">
    <div class="flex-1">
      <%- include('../../components/file-upload', { name: 'csv', label: 'File CSV', accept: '.csv,text/csv', required: true, limitText: 'Kolom: programStudi, fakultas, periode, tahun, jumlah.' }) %>
    </div>
    <button type="submit" class="btn btn-secondary">Impor</button>
  </form>
</div>

<div class="card">
  <% if (!items.length) { %>
    <div class="p-6">
      <%- include('../../components/empty-state', { emptyIcon: 'groups', emptyTitle: 'Belum ada data lulusan', emptyAction: { label: 'Tambah Data', href: '/admin/lulusan/new' } }) %>
    </div>
  <% } else { %>
  <table class="data-table data-table--stack">
    <caption class="sr-only">Daftar data lulusan</caption>
    <thead><tr><th scope="col">Program Studi</th><th scope="col">Fakultas</th><th scope="col">Periode</th><th scope="col">Tahun</th><th scope="col">Jumlah</th><th scope="col"><span class="sr-only">Aksi</span></th></tr></thead>
    <tbody>
      <% items.forEach(item => { %>
        <tr>
          <td data-label="Program Studi"><%= item.programStudi ? item.programStudi.nama : '—' %></td>
          <td data-label="Fakultas"><%= item.fakultas ? item.fakultas.nama : '—' %></td>
          <td data-label="Periode"><%= item.periode %></td>
          <td data-label="Tahun"><%= item.tahun %></td>
          <td data-label="Jumlah"><%= formatAngka(item.jumlah) %></td>
          <td data-label="Aksi">
            <div class="flex items-center gap-1 md:justify-end">
              <a href="/admin/lulusan/<%= item._id %>/edit" class="btn btn-secondary px-3" aria-label="Ubah data lulusan"><%- icon('edit') %>Ubah</a>
              <button type="button" class="btn-icon text-danger hover:bg-danger-soft" data-dialog-open="hapus-<%= item._id %>" aria-label="Hapus data lulusan"><%- icon('delete') %></button>
            </div>
            <%- include('../../components/confirm-dialog', {
              dialogId: `hapus-${item._id}`, dialogTitle: 'Hapus data lulusan?',
              dialogText: 'Data ini akan dihapus permanen dan tidak bisa dikembalikan.',
              action: `/admin/lulusan/${item._id}/delete`, confirmLabel: 'Hapus',
            }) %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
