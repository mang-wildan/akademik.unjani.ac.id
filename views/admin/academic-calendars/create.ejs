<!doctype html>
<html
  lang="en"
  class="layout-navbar-fixed layout-menu-fixed layout-compact"
  dir="ltr"
  data-skin="default"
  data-bs-theme="light"
  data-assets-path="/assets/"
  data-template="vertical-menu-template">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || 'Tambah Kalender Akademik' %></title>
  <link rel="icon" type="image/x-icon" href="/assets/img/favicon/favicon.ico" />
  <link rel="stylesheet" href="/assets/vendor/fonts/iconify-icons.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/node-waves/node-waves.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
  <link rel="stylesheet" href="/assets/vendor/css/core.css" />
  <link rel="stylesheet" href="/assets/css/demo.css" />
  <script src="/assets/vendor/js/helpers.js"></script>
  <script src="/assets/js/config.js"></script>
  <style>
    .calendar-preview {
      width: 100%;
      max-height: 360px;
      object-fit: contain;
      border-radius: 12px;
      background: #f8fafb;
      border: 1px dashed var(--bs-border-color);
      padding: 8px;
    }
    .dropzone {
      border: 2px dashed var(--bs-primary);
      border-radius: 14px;
      background: linear-gradient(135deg, rgba(22,163,74,0.05), rgba(22,163,74,0.02));
      transition: all .25s ease;
      min-height: 260px;
    }
    .dropzone.hover {
      background: rgba(22,163,74,0.08);
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(22,163,74,0.12);
    }
    .badge-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
      margin-right: 6px;
    }
    .dropzone .avatar-initial {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  </style>
</head>

<body>
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <%- include("../../partials/menu") %>
      <div class="layout-page">
        <%- include("../../partials/navbar") %>
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
              <div>
                <h4 class="fw-bold mb-0">Tambah Kalender Akademik</h4>
                <p class="text-muted mb-0">Unggah file kalender akademik (PDF) untuk tahun ajaran tertentu.</p>
              </div>
              <a class="btn btn-label-secondary" href="/admin/academic-calendars">
                <span class="iconify me-1" data-icon="ri:arrow-left-line"></span> Kembali
              </a>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <div class="d-flex align-items-center">
                <span class="iconify me-2 fs-4" data-icon="ri:error-warning-fill"></span>
                <span><%= error %></span>
              </div>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <% } %>

            <form method="POST" action="/admin/academic-calendars" enctype="multipart/form-data" data-disable-submit>
              <div class="row g-4">
                <div class="col-xl-5">
                  <div class="card shadow-sm h-100">
                    <div class="card-header border-0">
                      <div class="d-flex justify-content-between align-items-start">
                        <div>
                          <h5 class="mb-1">Info Kalender</h5>
                          <p class="text-muted mb-0">Pastikan tahun ajaran sesuai dokumen.</p>
                        </div>
                        <span class="badge bg-label-success">Wajib</span>
                      </div>
                    </div>
                    <div class="card-body">
                      <div class="mb-4">
                        <label class="form-label fw-medium" for="tahunAjaranInput">Tahun Ajaran</label>
                        <% const nowY = new Date().getFullYear(); %>
                        <select id="tahunAjaranInput" name="tahunAjaran" class="form-select" required>
                          <% for (let y = nowY + 2; y >= nowY - 6; y--) { const label = `${y}/${y+1}`; %>
                            <option value="<%= label %>"
                              <%= (values && values.tahunAjaran === label) || (!values || !values.tahunAjaran) && y === nowY ? 'selected' : '' %>>
                              <%= label %>
                            </option>
                          <% } %>
                        </select>
                        <div class="form-text">Rentang 6 tahun ke belakang hingga 2 tahun ke depan.</div>
                      </div>
                      <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-label-primary"><span class="badge-dot bg-primary"></span>PDF</span>
                        <span class="badge bg-label-warning"><span class="badge-dot bg-warning"></span>Maks 10MB</span>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="col-xl-7">
                  <div class="card shadow-sm h-100">
                    <div class="card-header border-0">
                      <h5 class="mb-1">Unggah File Kalender (PDF)</h5>
                      <p class="text-muted mb-0">Tarik & jatuhkan atau klik untuk memilih file.</p>
                    </div>
                    <div class="card-body">
                      <div id="dropzone" class="dropzone d-flex align-items-center justify-content-center text-center p-4">
                        <div>
                          <div class="avatar avatar-lg bg-label-primary mb-3">
                            <span class="avatar-initial rounded-circle">
                              <i class="ri ri-upload-2-line"></i>
                            </span>
                          </div>
                          <p class="mb-1 fw-medium">Lepas file di sini atau klik untuk pilih</p>
                          <small class="text-muted d-block mb-2">Format: PDF • Maks 10MB</small>
                          <input type="file" name="file" id="fileInput" accept="application/pdf" class="d-none" required />
                          <button type="button" class="btn btn-outline-primary btn-sm" id="pickFileBtn">
                            Pilih File
                          </button>
                        </div>
                      </div>
                      <div class="mt-3">
                        <label class="form-label fw-medium">Pratinjau</label>
                        <iframe id="filePreview" src="" title="Preview kalender" class="calendar-preview d-none" style="height:420px;border:1px solid #e5e7eb;"></iframe>
                      </div>
                    </div>
                    <div class="card-footer d-flex justify-content-end gap-3">
                      <a href="/admin/academic-calendars" class="btn btn-label-secondary">Batal</a>
                      <button type="submit" class="btn btn-primary px-4">
                        <span class="iconify me-1" data-icon="ri:save-line"></span> Simpan
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </form>

          </div>
          <div class="content-backdrop fade"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="layout-overlay layout-menu-toggle"></div>
  <div class="drag-target"></div>

  <script src="/assets/vendor/libs/jquery/jquery.js"></script>
  <script src="/assets/vendor/libs/popper/popper.js"></script>
  <script src="/assets/vendor/js/bootstrap.js"></script>
  <script src="/assets/vendor/libs/node-waves/node-waves.js"></script>
  <script src="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
  <script src="/assets/vendor/js/menu.js"></script>
  <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
  <script src="/assets/js/main.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const fileInput = document.getElementById('fileInput');
      const preview = document.getElementById('filePreview');
      const dropzone = document.getElementById('dropzone');
      const pickBtn = document.getElementById('pickFileBtn');
      const MAX_SIZE = 10 * 1024 * 1024; // 10MB

      if (fileInput && preview) {
        const setFileInput = (file) => {
          const dt = new DataTransfer();
          dt.items.add(file);
          fileInput.files = dt.files;
          fileInput.dispatchEvent(new Event('change', { bubbles: true }));
        };

        const showPreview = (file) => {
          if (!file) {
            preview.classList.add('d-none');
            preview.src = '';
            return;
          }
          if (file.type !== 'application/pdf') {
            alert('File harus berupa PDF.');
            fileInput.value = '';
            return;
          }
          if (file.size > MAX_SIZE) {
            alert('Ukuran file maksimal 10MB.');
            fileInput.value = '';
            return;
          }
          preview.src = URL.createObjectURL(file);
          preview.classList.remove('d-none');
        };

        fileInput.addEventListener('change', (e) => {
          const [file] = e.target.files;
          showPreview(file);
        });

        if (dropzone) {
          ['dragenter', 'dragover'].forEach(evt => {
            dropzone.addEventListener(evt, (e) => {
              e.preventDefault(); e.stopPropagation();
              dropzone.classList.add('hover');
            });
          });
          ['dragleave', 'drop'].forEach(evt => {
            dropzone.addEventListener(evt, (e) => {
              e.preventDefault(); e.stopPropagation();
              dropzone.classList.remove('hover');
            });
          });
          dropzone.addEventListener('drop', (e) => {
            const file = e.dataTransfer.files[0];
            if (!file) return;
            setFileInput(file);
          });
          dropzone.addEventListener('click', () => fileInput.click());
        }

        pickBtn?.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation(); // cegah bubble ke dropzone yang akan memicu fileInput dua kali
          fileInput.click();
        });
      }
    });
  </script>
</body>

</html>
