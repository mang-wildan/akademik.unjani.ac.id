<%# Kalender akademik — tahap 1: buat tahun ajaran. Kegiatan & lampiran dikelola di halaman ubah setelah tersimpan. %>
<div class="mb-6">
  <a href="/admin/academic-calendars" class="mb-2 inline-flex min-h-6 items-center gap-1 text-sm font-medium text-muted hover:text-ink"><%- icon('arrow_back', 'size-4') %>Kembali ke Kalender Akademik</a>
  <h1 class="text-2xl font-bold">Tambah Tahun Ajaran</h1>
</div>

<% if (errors._form) { %>
  <div class="mb-6"><%- include('../../components/alert', { alertTone: 'danger', alertTitle: 'Gagal menyimpan', alertText: errors._form }) %></div>
<% } %>

<form method="POST" action="/admin/academic-calendars" enctype="multipart/form-data" class="card card-body grid max-w-xl gap-5">
  <%- include('../../components/form-field', {
    name: 'tahunAjaran', label: 'Tahun Ajaran', required: true, value: values.tahunAjaran, error: errors.tahunAjaran,
    placeholder: '2026/2027', help: 'Ditulis seperti 2026/2027.',
  }) %>
  <%- include('../../components/form-field', {
    name: 'nomorSK', label: 'Nomor SK Rektor', value: values.nomorSK, error: errors.nomorSK, placeholder: 'Opsional',
  }) %>
  <%- include('../../components/file-upload', {
    name: 'file', label: 'File SK Rektor (PDF)', accept: 'application/pdf', required: true,
    limitText: 'PDF, maks. 10 MB.', error: errors.file,
  }) %>
  <div class="flex justify-end gap-2 border-t border-line pt-5">
    <a href="/admin/academic-calendars" class="btn btn-secondary">Batal</a>
    <button type="submit" class="btn btn-primary">Simpan &amp; Lanjutkan</button>
  </div>
</form>
