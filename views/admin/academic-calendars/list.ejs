<%# Daftar kalender akademik per tahun ajaran — FR-M-03. %>
<%- include('../../components/page-header', { admin: true, heading: 'Kalender Akademik', lead: 'Kelola kalender per tahun ajaran: SK Rektor, daftar kegiatan, dan lampiran surat edaran.', breadcrumb: [{ label: 'Kalender Akademik' }], actions: [{ label: 'Tambah Tahun Ajaran', href: '/admin/academic-calendars/new', icon: 'add' }] }) %>

<div class="card">
  <% if (!items.length) { %>
    <div class="p-6">
      <%- include('../../components/empty-state', {
        emptyIcon: 'event', emptyTitle: 'Belum ada kalender akademik',
        emptyAction: { label: 'Tambah Tahun Ajaran', href: '/admin/academic-calendars/new' },
      }) %>
    </div>
  <% } else { %>
  <table class="data-table data-table--stack">
    <caption class="sr-only">Daftar kalender akademik</caption>
    <thead><tr><th scope="col">Tahun Ajaran</th><th scope="col">Nomor SK</th><th scope="col">Kegiatan</th><th scope="col">Lampiran</th><th scope="col">Diperbarui</th><th scope="col"><span class="sr-only">Aksi</span></th></tr></thead>
    <tbody>
      <% items.forEach(item => { %>
        <tr data-updated="<%= item.updatedAt ? new Date(item.updatedAt).toISOString() : '' %>">
          <td data-label="Tahun Ajaran"><a href="/admin/academic-calendars/<%= item._id %>/edit" class="inline-flex min-h-6 items-center font-medium"><%= item.tahunAjaran %></a></td>
          <td data-label="Nomor SK"><%= item.nomorSK || '—' %></td>
          <td data-label="Kegiatan"><%= formatAngka(item.events.length) %></td>
          <td data-label="Lampiran"><%= formatAngka(item.lampiran.length) %></td>
          <td data-label="Diperbarui"><%= formatTanggal(item.updatedAt) %></td>
          <td data-label="Aksi">
            <div class="flex items-center gap-1 md:justify-end">
              <a href="/admin/academic-calendars/<%= item._id %>/edit" class="btn btn-secondary px-3" aria-label="Ubah kalender <%= item.tahunAjaran %>"><%- icon('edit') %>Ubah</a>
              <button type="button" class="btn-icon text-danger hover:bg-danger-soft" data-dialog-open="hapus-<%= item._id %>" aria-label="Hapus kalender <%= item.tahunAjaran %>"><%- icon('delete') %></button>
            </div>
            <%- include('../../components/confirm-dialog', {
              dialogId: `hapus-${item._id}`, dialogTitle: `Hapus kalender ${item.tahunAjaran}?`,
              dialogText: `Seluruh kegiatan (${item.events.length}) dan lampiran (${item.lampiran.length}) tahun ini akan dihapus permanen dan tidak bisa dikembalikan.`,
              action: `/admin/academic-calendars/${item._id}/delete`, confirmLabel: 'Hapus',
            }) %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
