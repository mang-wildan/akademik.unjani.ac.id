<%# Kalender akademik — tahap 2: kelola kegiatan (manual/CSV) & lampiran surat edaran untuk satu tahun ajaran. %>
<div class="mb-6">
  <a href="/admin/academic-calendars" class="mb-2 inline-flex min-h-6 items-center gap-1 text-sm font-medium text-muted hover:text-ink"><%- icon('arrow_back', 'size-4') %>Kembali ke Kalender Akademik</a>
  <h1 class="text-2xl font-bold">Kalender <%= item.tahunAjaran %></h1>
</div>

<div class="grid gap-6 lg:grid-cols-3">
  <%# --- Data tahun ajaran --- %>
  <form method="POST" action="/admin/academic-calendars/<%= item._id %>" enctype="multipart/form-data" class="card card-body space-y-5 lg:col-span-1">
    <h2 class="font-semibold">Data Tahun Ajaran</h2>
    <%- include('../../components/form-field', { name: 'tahunAjaran', label: 'Tahun Ajaran', required: true, value: values.tahunAjaran, error: errors.tahunAjaran, help: 'Ditulis seperti 2026/2027.' }) %>
    <%- include('../../components/form-field', { name: 'nomorSK', label: 'Nomor SK Rektor', value: values.nomorSK, error: errors.nomorSK }) %>
    <%- include('../../components/file-upload', {
      name: 'file', label: 'File SK Rektor (PDF)', accept: 'application/pdf', error: errors.file,
      limitText: 'PDF, maks. 10 MB.', current: { label: 'SK saat ini', href: item.file },
    }) %>
    <div class="flex justify-end border-t border-line pt-5">
      <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
    </div>
  </form>

  <div class="space-y-6 lg:col-span-2">
    <%# --- Kegiatan: tabel + tambah manual + impor CSV --- %>
    <div class="card card-body space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="font-semibold">Kegiatan (<%= formatAngka(item.events.length) %>)</h2>
        <a href="/admin/academic-calendars/template.csv" class="inline-flex min-h-6 items-center gap-1 text-sm font-medium"><%- icon('download', 'size-4') %>Unduh template CSV</a>
      </div>

      <% if (importErrors) { %>
        <div class="rounded-control border border-danger-solid bg-danger-soft p-3 text-sm text-danger">
          <p class="font-semibold">Impor gagal, tidak ada yang disimpan:</p>
          <ul class="mt-1 list-disc space-y-0.5 pl-5">
            <% importErrors.forEach(e => { %><li><%= e %></li><% }) %>
          </ul>
        </div>
      <% } %>

      <% if (item.events.length) { %>
      <table class="data-table data-table--stack">
        <caption class="sr-only">Daftar kegiatan</caption>
        <thead><tr><th scope="col">Semester</th><th scope="col">Nama</th><th scope="col">Mulai</th><th scope="col">Selesai</th><th scope="col"><span class="sr-only">Aksi</span></th></tr></thead>
        <tbody>
          <% item.events.slice().sort((a, b) => new Date(a.mulai) - new Date(b.mulai)).forEach(ev => { %>
            <tr>
              <td data-label="Semester"><%= (semesterOptions.find(s => s.value === ev.semester) || {}).label || ev.semester %></td>
              <td data-label="Nama"><%= ev.nama %></td>
              <td data-label="Mulai"><%= formatTanggal(ev.mulai) %></td>
              <td data-label="Selesai"><%= ev.selesai ? formatTanggal(ev.selesai) : '—' %></td>
              <td data-label="Aksi">
                <form method="POST" action="/admin/academic-calendars/<%= item._id %>/events/<%= ev._id %>/delete" data-confirm="Hapus kegiatan &quot;<%= ev.nama %>&quot;?">
                  <button type="submit" class="btn-icon text-danger hover:bg-danger-soft" aria-label="Hapus kegiatan <%= ev.nama %>"><%- icon('delete', 'size-5') %></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% } else { %>
        <p class="text-sm text-muted">Belum ada kegiatan untuk tahun ajaran ini.</p>
      <% } %>

      <details class="rounded-control border border-line">
        <summary class="min-h-11 cursor-pointer select-none px-4 py-2.5 text-sm font-semibold">+ Tambah kegiatan manual</summary>
        <form method="POST" action="/admin/academic-calendars/<%= item._id %>/events" class="grid gap-4 border-t border-line p-4 sm:grid-cols-2">
          <%- include('../../components/form-field', {
            name: 'semester', label: 'Semester', type: 'select', required: true, value: eventValues.semester, error: eventErrors.semester,
            options: semesterOptions,
          }) %>
          <%- include('../../components/form-field', { name: 'nama', label: 'Nama Kegiatan', required: true, value: eventValues.nama, error: eventErrors.nama }) %>
          <%- include('../../components/form-field', { name: 'mulai', label: 'Tanggal Mulai', type: 'date', required: true, value: eventValues.mulai, error: eventErrors.mulai }) %>
          <%- include('../../components/form-field', { name: 'selesai', label: 'Tanggal Selesai', type: 'date', value: eventValues.selesai, error: eventErrors.selesai, help: 'Kosongkan untuk kegiatan satu hari.' }) %>
          <div class="sm:col-span-2 flex justify-end"><button type="submit" class="btn btn-primary">Tambah Kegiatan</button></div>
        </form>
      </details>

      <details class="rounded-control border border-line">
        <summary class="min-h-11 cursor-pointer select-none px-4 py-2.5 text-sm font-semibold">+ Impor dari CSV/Excel</summary>
        <form method="POST" action="/admin/academic-calendars/<%= item._id %>/events/import" enctype="multipart/form-data" class="space-y-4 border-t border-line p-4">
          <p class="field-help">Mengimpor akan <strong>mengganti seluruh daftar kegiatan</strong> yang sudah ada untuk tahun ajaran ini. Gunakan template di atas.</p>
          <%- include('../../components/file-upload', { name: 'csv', label: 'File CSV', accept: '.csv,text/csv', required: true, limitText: 'CSV sesuai template.' }) %>
          <div class="flex justify-end"><button type="submit" class="btn btn-secondary">Impor &amp; Ganti Daftar Kegiatan</button></div>
        </form>
      </details>
    </div>

    <%# --- Lampiran: surat edaran PDF --- %>
    <div class="card card-body space-y-4">
      <h2 class="font-semibold">Lampiran Surat Edaran (<%= formatAngka(item.lampiran.length) %>)</h2>
      <% if (item.lampiran.length) { %>
        <ul class="space-y-2">
          <% item.lampiran.forEach(l => { %>
            <li class="flex items-center gap-3 rounded-control border border-line px-3 py-2">
              <%- icon('picture_as_pdf', 'size-5 shrink-0 text-muted') %>
              <div class="min-w-0 flex-1">
                <a href="<%= l.file %>" target="_blank" rel="noopener" class="inline-flex min-h-6 items-center line-clamp-1 font-medium"><%= l.judul %></a>
                <p class="truncate text-xs text-muted"><%= l.nomorSurat || '—' %><% if (l.tanggal) { %> · <%= formatTanggal(l.tanggal) %><% } %></p>
              </div>
              <form method="POST" action="/admin/academic-calendars/<%= item._id %>/lampiran/<%= l._id %>/delete">
                <button type="submit" class="btn-icon shrink-0 text-danger hover:bg-danger-soft" aria-label="Hapus lampiran <%= l.judul %>"><%- icon('delete', 'size-5') %></button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="text-sm text-muted">Belum ada lampiran surat edaran.</p>
      <% } %>

      <details class="rounded-control border border-line">
        <summary class="min-h-11 cursor-pointer select-none px-4 py-2.5 text-sm font-semibold">+ Tambah lampiran</summary>
        <form method="POST" action="/admin/academic-calendars/<%= item._id %>/lampiran" enctype="multipart/form-data" class="grid gap-4 border-t border-line p-4 sm:grid-cols-2">
          <%- include('../../components/form-field', { name: 'judul', label: 'Judul Surat', required: true, value: lampiranValues.judul, error: lampiranErrors.judul }) %>
          <%- include('../../components/form-field', { name: 'nomorSurat', label: 'Nomor Surat', value: lampiranValues.nomorSurat, error: lampiranErrors.nomorSurat }) %>
          <%- include('../../components/form-field', { name: 'tanggal', label: 'Tanggal Surat', type: 'date', value: lampiranValues.tanggal, error: lampiranErrors.tanggal }) %>
          <div class="sm:col-span-2">
            <%- include('../../components/file-upload', { name: 'lampiran', label: 'File (PDF)', accept: 'application/pdf', required: true, limitText: 'PDF, maks. 10 MB.', error: lampiranErrors.file }) %>
          </div>
          <div class="sm:col-span-2 flex justify-end"><button type="submit" class="btn btn-primary">Tambah Lampiran</button></div>
        </form>
      </details>
    </div>
  </div>
</div>
