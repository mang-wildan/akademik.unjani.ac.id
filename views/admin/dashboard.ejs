<%- include('_ui/page-header', { heading: 'Dasbor' }) %>
<div class="space-y-4">
  <section aria-labelledby="perlu-perhatian" class="rounded-card border border-line bg-surface p-4">
    <h2 id="perlu-perhatian" class="mb-3 text-md font-semibold">Perlu perhatian</h2>
    <% if (issues.length) { %>
      <ul class="divide-y divide-line">
        <% issues.forEach(issue => { %>
          <li class="flex items-start gap-3 py-3 first:pt-0 last:pb-0">
            <%- icon(issue.icon, 'mt-1 size-5 shrink-0 text-warning') %>
            <div class="min-w-0 flex-1"><p class="text-sm font-medium"><%= issue.title %></p><% if (issue.text) { %><p class="mt-1 break-words text-xs text-muted"><%= issue.text %></p><% } %></div>
            <%- include('_ui/button', { label: issue.label, href: issue.href, variant: 'secondary' }) %>
          </li>
        <% }) %>
      </ul>
    <% } else { %><p class="text-sm text-muted">Tidak ada hal yang memerlukan perhatian.</p><% } %>
  </section>
  <section aria-labelledby="buat-cepat" class="rounded-card border border-line bg-surface p-4">
    <h2 id="buat-cepat" class="mb-3 text-md font-semibold">Buat cepat</h2>
    <div class="flex flex-wrap gap-2">
      <%- include('_ui/button', { label: 'Pengumuman', href: '/admin/pengumuman/new', buttonIcon: 'add' }) %>
      <%- include('_ui/button', { label: 'Berita', href: '/admin/news/new', buttonIcon: 'add', variant: 'secondary' }) %>
      <%- include('_ui/button', { label: 'Dokumen', href: '/admin/academic-documents/new', buttonIcon: 'add', variant: 'secondary' }) %>
    </div>
  </section>
  <section aria-labelledby="draf-terakhir" class="rounded-card border border-line bg-surface p-4">
    <h2 id="draf-terakhir" class="mb-3 text-md font-semibold">Draf terakhir</h2>
    <% if (drafts.length) { %><ul class="divide-y divide-line">
      <% drafts.forEach(item => { %><li class="flex flex-wrap items-center gap-2 py-2"><a href="<%= item.href %>" class="min-w-0 flex-1 break-words text-sm font-medium text-ink hover:text-primary"><%= item.title %></a><%- include('_ui/badge', { text: item.label, tone: 'neutral' }) %><span class="text-xs text-muted"><%= formatTanggal(item.updatedAt) %></span></li><% }) %>
    </ul><% } else { %><p class="text-sm text-muted">Belum ada draf.</p><% } %>
  </section>
  <section aria-labelledby="statistik">
    <h2 id="statistik" class="mb-3 text-md font-semibold">Statistik</h2>
    <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
      <% [
        { label: 'Berita terbit', value: stats.beritaTerbit, href: '/admin/news?status=published', icon: 'newspaper' },
        { label: 'Pengumuman terbit', value: stats.pengumumanAktif, href: '/admin/pengumuman?status=published', icon: 'campaign' },
        { label: 'Dokumen akademik', value: stats.dokCount, href: '/admin/academic-documents', icon: 'description' },
        { label: 'Akreditasi kedaluwarsa', value: stats.akreditasiKedaluwarsa, href: '/admin/accreditations?status=kedaluwarsa', icon: 'workspace_premium' },
      ].forEach(stat => { %><a href="<%= stat.href %>" class="rounded-card border border-line bg-surface p-4 text-ink no-underline hover:border-line-strong"><%- icon(stat.icon, 'mb-2 size-5 text-muted') %><p class="text-xl font-semibold tabular-nums"><%= formatAngka(stat.value) %></p><p class="mt-1 text-xs text-muted"><%= stat.label %></p></a><% }) %>
    </div>
  </section>
  <section aria-labelledby="aktivitas-terbaru" class="rounded-card border border-line bg-surface p-4">
    <h2 id="aktivitas-terbaru" class="mb-3 text-md font-semibold">Aktivitas terbaru</h2>
    <% if (recentActivities.length) { %><ul class="divide-y divide-line">
      <% recentActivities.forEach(item => { %><li class="flex items-start gap-3 py-3 first:pt-0 last:pb-0"><%- icon(item.icon, 'mt-1 size-5 shrink-0 text-muted') %><div class="min-w-0"><a href="<%= item.href %>" class="break-words text-sm font-medium text-ink hover:text-primary"><%= item.title %></a><p class="mt-1 text-xs text-muted"><%= item.label %> · <%= formatTanggal(item.date) %></p></div></li><% }) %>
    </ul><% } else { %><p class="text-sm text-muted">Belum ada aktivitas.</p><% } %>
  </section>
</div>
