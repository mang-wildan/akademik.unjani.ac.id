<!doctype html>
<html
  lang="id"
  class="layout-navbar-fixed layout-menu-fixed layout-compact"
  dir="ltr"
  data-skin="default"
  data-bs-theme="light"
  data-assets-path="/assets/"
  data-template="vertical-menu-template">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || 'Profil Saya' %></title>
  <link rel="icon" type="image/x-icon" href="/assets/img/favicon/favicon.ico" />
  <link rel="stylesheet" href="/assets/vendor/fonts/iconify-icons.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/node-waves/node-waves.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
  <link rel="stylesheet" href="/assets/vendor/css/core.css" />
  <link rel="stylesheet" href="/assets/css/demo.css" />
  <style>
    :root {
      --profile-ink: #0f172a;
      --profile-muted: #64748b;
      --profile-soft: #f8fafc;
      --profile-border: #e2e8f0;
    }

    body {
      background: linear-gradient(180deg, #f7fafc 0%, #eef2ff 100%);
    }

    .profile-hero {
      border: 0;
      border-radius: 20px;
      background: linear-gradient(135deg, #07a250 0%, #0a763d 55%, #0f2a12 100%);
      color: #f8fafc;
      position: relative;
      overflow: hidden;
      box-shadow: 0 20px 40px rgba(15, 23, 42, 0.2);
    }

    .profile-hero::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 18% 12%, rgba(255, 255, 255, 0.18), transparent 42%),
        radial-gradient(circle at 82% 0%, rgba(255, 255, 255, 0.12), transparent 35%);
      pointer-events: none;
    }

    .avatar-ring {
      width: 82px;
      height: 82px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.16);
      border: 2px solid rgba(255, 255, 255, 0.34);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.65rem;
      font-weight: 700;
      letter-spacing: 1px;
    }

    .avatar-photo {
      width: 82px;
      height: 82px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(255, 255, 255, 0.34);
      box-shadow: 0 10px 18px rgba(15, 23, 42, 0.22);
      background: rgba(255, 255, 255, 0.2);
    }

    .hero-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
      background: rgba(255, 255, 255, 0.14);
      border: 1px solid rgba(255, 255, 255, 0.24);
      color: #f8fafc;
    }

    .btn-hero-light {
      border-color: rgba(255, 255, 255, 0.6);
      color: #fff;
      background: rgba(255, 255, 255, 0.1);
    }

    .btn-hero-light:hover {
      border-color: #fff;
      color: #0f172a;
      background: #fff;
    }

    .metric-card {
      border: 1px solid var(--profile-border);
      border-radius: 16px;
      background: #fff;
      box-shadow: 0 10px 20px rgba(15, 23, 42, 0.05);
      height: 100%;
    }

    .metric-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }

    .section-card {
      border: 1px solid var(--profile-border);
      border-radius: 18px;
      box-shadow: 0 12px 24px rgba(15, 23, 42, 0.06);
    }

    .section-title {
      color: var(--profile-ink);
      font-weight: 700;
      margin-bottom: 0;
    }

    .section-subtitle {
      color: var(--profile-muted);
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      margin-bottom: 2px;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .info-tile {
      border: 1px dashed #dbe4ef;
      border-radius: 14px;
      padding: 12px 14px;
      background: var(--profile-soft);
    }

    .info-label {
      color: var(--profile-muted);
      font-size: 12px;
      margin-bottom: 4px;
    }

    .info-value {
      color: var(--profile-ink);
      font-weight: 700;
      word-break: break-word;
    }

    .timeline-list {
      display: grid;
      gap: 10px;
    }

    .timeline-item {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      padding: 10px 0;
      border-bottom: 1px dashed var(--profile-border);
    }

    .timeline-item:last-child {
      border-bottom: 0;
      padding-bottom: 0;
    }

    .timeline-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #0ea5e9;
      margin-top: 6px;
      flex-shrink: 0;
    }

    .security-item {
      border: 1px solid var(--profile-border);
      border-radius: 12px;
      padding: 10px 12px;
      background: #fff;
    }

    .profile-progress {
      height: 9px;
      border-radius: 999px;
      background: #e2e8f0;
      overflow: hidden;
    }

    .profile-progress > div {
      height: 100%;
      background: linear-gradient(90deg, #0ea5e9, #22c55e);
      border-radius: 999px;
    }

    @media (max-width: 767px) {
      .info-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
  <script src="/assets/vendor/js/helpers.js"></script>
  <script src="/assets/js/config.js"></script>
</head>

<body>
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <%- include("../../partials/menu") %>
      <div class="layout-page">
        <%- include("../../partials/navbar") %>
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">
            <%
              const data = profile || {};
              const fullName = (data.name || 'Pengguna').trim();
              const email = data.email || '-';
              const role = data.role || 'user';
              const roleLabel = locals.roleLabel(role);
              const initials = fullName
                .split(/\s+/)
                .filter(Boolean)
                .slice(0, 2)
                .map(part => part.charAt(0))
                .join('')
                .toUpperCase() || 'U';
              const joinDateObj = data.createdAt ? new Date(data.createdAt) : null;
              const updateDateObj = data.updatedAt ? new Date(data.updatedAt) : null;
              const joinedDate = joinDateObj
                ? joinDateObj.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
                : '-';
              const updatedDate = updateDateObj
                ? updateDateObj.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
                : '-';
              const now = Date.now();
              const accountAgeDays = joinDateObj ? Math.max(1, Math.floor((now - joinDateObj.getTime()) / 86400000)) : 0;
              const lastUpdatedDays = updateDateObj ? Math.max(0, Math.floor((now - updateDateObj.getTime()) / 86400000)) : 0;
              const completionScore = Math.round(([data.name, data.email, data.role].filter(Boolean).length / 3) * 100);
              const dashboardUrl = isStaff(role) ? '/admin/dashboard' : '/dashboard';
              const roleBadgeClass = isStaff(role) ? 'bg-label-primary' : 'bg-label-secondary';
              const passwordRefreshStatus = lastUpdatedDays > 90 ? 'Perlu pembaruan' : 'Aman';
              const passwordRefreshClass = lastUpdatedDays > 90 ? 'text-warning' : 'text-success';
              const profilePhoto = data && data.profilePhoto ? data.profilePhoto : '';
            %>

            <div class="card profile-hero mb-4">
              <div class="card-body position-relative">
                <div class="row g-4 align-items-center">
                  <div class="col-lg-8">
                    <div class="d-flex align-items-center gap-3 mb-3">
                      <% if (profilePhoto) { %>
                        <img src="<%= profilePhoto %>" alt="Foto Profil" class="avatar-photo">
                      <% } else { %>
                        <div class="avatar-ring"><%= initials %></div>
                      <% } %>
                      <div>
                        <h4 class="mb-1 text-white"><%= fullName %></h4>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                          <span class="badge bg-light text-dark"><%= roleLabel %></span>
                          <span class="text-white-75"><%= email %></span>
                        </div>
                      </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                      <span class="hero-chip">
                        <span class="iconify" data-icon="ri:calendar-check-line"></span> Bergabung: <%= joinedDate %>
                      </span>
                      <span class="hero-chip">
                        <span class="iconify" data-icon="ri:refresh-line"></span> Update terakhir: <%= updatedDate %>
                      </span>
                      <span class="hero-chip">
                        <span class="iconify" data-icon="ri:shield-check-line"></span> Status keamanan: <%= passwordRefreshStatus %>
                      </span>
                    </div>
                  </div>
                  <div class="col-lg-4">
                    <div class="d-grid gap-2">
                      <a href="/profile/edit" class="btn btn-hero-light">
                        <span class="iconify me-1" data-icon="ri:edit-2-line"></span> Edit Profil
                      </a>
                      <a href="/profile/password" class="btn btn-light text-dark">
                        <span class="iconify me-1" data-icon="ri:lock-password-line"></span> Ubah Password
                      </a>
                      <a href="<%= dashboardUrl %>" class="btn btn-outline-light">
                        <span class="iconify me-1" data-icon="ri:dashboard-line"></span> Kembali ke Dashboard
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <% if (success) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
              <%= success %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <% } %>

            <% if (error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <%= error %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <% } %>

            <div class="row g-3 mb-4">
              <div class="col-md-6 col-xl-3">
                <div class="card metric-card">
                  <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <span class="section-subtitle mb-0">Kelengkapan Profil</span>
                      <span class="metric-icon bg-label-primary text-primary">
                        <i class="ri ri-user-settings-line"></i>
                      </span>
                    </div>
                    <h3 class="mb-2"><%= completionScore %>%</h3>
                    <div class="profile-progress mb-2"><div style="width:<%= completionScore %>%"></div></div>
                    <small class="text-muted">Semakin lengkap, semakin mudah pengelolaan akun.</small>
                  </div>
                </div>
              </div>
              <div class="col-md-6 col-xl-3">
                <div class="card metric-card">
                  <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <span class="section-subtitle mb-0">Umur Akun</span>
                      <span class="metric-icon bg-label-success text-success">
                        <i class="ri ri-time-line"></i>
                      </span>
                    </div>
                    <h3 class="mb-1"><%= accountAgeDays %> hari</h3>
                    <small class="text-muted">Sejak <%= joinedDate %></small>
                  </div>
                </div>
              </div>
              <div class="col-md-6 col-xl-3">
                <div class="card metric-card">
                  <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <span class="section-subtitle mb-0">Perubahan Terakhir</span>
                      <span class="metric-icon bg-label-info text-info">
                        <i class="ri ri-history-line"></i>
                      </span>
                    </div>
                    <h3 class="mb-1"><%= lastUpdatedDays %> hari</h3>
                    <small class="text-muted">Terakhir diperbarui <%= updatedDate %></small>
                  </div>
                </div>
              </div>
              <div class="col-md-6 col-xl-3">
                <div class="card metric-card">
                  <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <span class="section-subtitle mb-0">Hak Akses</span>
                      <span class="metric-icon bg-label-warning text-warning">
                        <i class="ri ri-shield-user-line"></i>
                      </span>
                    </div>
                    <h3 class="mb-1"><%= roleLabel %></h3>
                    <small class="text-muted">Role aktif saat ini: <%= role %></small>
                  </div>
                </div>
              </div>
            </div>

            <div class="row g-4">
              <div class="col-lg-8">
                <div class="card section-card h-100">
                  <div class="card-header bg-transparent border-0 pb-0">
                    <p class="section-subtitle">Informasi Utama</p>
                    <h5 class="section-title">Detail Profil</h5>
                  </div>
                  <div class="card-body">
                    <div class="info-grid mb-4">
                      <div class="info-tile">
                        <div class="info-label">Nama Lengkap</div>
                        <div class="info-value"><%= fullName %></div>
                      </div>
                      <div class="info-tile">
                        <div class="info-label">Email</div>
                        <div class="info-value"><%= email %></div>
                      </div>
                      <div class="info-tile">
                        <div class="info-label">Role</div>
                        <div class="info-value">
                          <span class="badge <%= roleBadgeClass %>"><%= roleLabel %></span>
                        </div>
                      </div>
                      <div class="info-tile">
                        <div class="info-label">ID Pengguna</div>
                        <div class="info-value"><%= data && data._id ? String(data._id) : '-' %></div>
                      </div>
                      <div class="info-tile">
                        <div class="info-label">Tanggal Bergabung</div>
                        <div class="info-value"><%= joinedDate %></div>
                      </div>
                      <div class="info-tile">
                        <div class="info-label">Tanggal Update Profil</div>
                        <div class="info-value"><%= updatedDate %></div>
                      </div>
                    </div>

                    <div>
                      <p class="section-subtitle">Jejak Aktivitas Akun</p>
                      <div class="timeline-list">
                        <div class="timeline-item">
                          <span class="timeline-dot"></span>
                          <div>
                            <div class="fw-semibold">Akun dibuat</div>
                            <small class="text-muted">Akun terdaftar pada <%= joinedDate %>.</small>
                          </div>
                        </div>
                        <div class="timeline-item">
                          <span class="timeline-dot"></span>
                          <div>
                            <div class="fw-semibold">Perubahan profil terakhir</div>
                            <small class="text-muted">Terjadi <%= lastUpdatedDays %> hari yang lalu.</small>
                          </div>
                        </div>
                        <div class="timeline-item">
                          <span class="timeline-dot"></span>
                          <div>
                            <div class="fw-semibold">Sesi masuk aktif</div>
                            <small class="text-muted">Anda sedang masuk dan dapat mengelola akun ini.</small>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-lg-4">
                <div class="card section-card mb-4">
                  <div class="card-header bg-transparent border-0 pb-0">
                    <p class="section-subtitle">Keamanan</p>
                    <h5 class="section-title">Status Keamanan Akun</h5>
                  </div>
                  <div class="card-body d-grid gap-2">
                    <div class="security-item">
                      <div class="d-flex justify-content-between align-items-center">
                        <div class="small fw-semibold">Email Terpasang</div>
                        <span class="text-success fw-semibold">Ya</span>
                      </div>
                    </div>
                    <div class="security-item">
                      <div class="d-flex justify-content-between align-items-center">
                        <div class="small fw-semibold">Password Aktif</div>
                        <span class="text-success fw-semibold">Tersimpan</span>
                      </div>
                    </div>
                    <div class="security-item">
                      <div class="d-flex justify-content-between align-items-center">
                        <div class="small fw-semibold">Rekomendasi Refresh Password</div>
                        <span class="<%= passwordRefreshClass %> fw-semibold"><%= passwordRefreshStatus %></span>
                      </div>
                    </div>
                    <a href="/profile/password" class="btn btn-outline-warning mt-2">
                      <span class="iconify me-1" data-icon="ri:lock-password-line"></span> Perbarui Password
                    </a>
                  </div>
                </div>

                <div class="card section-card">
                  <div class="card-header bg-transparent border-0 pb-0">
                    <p class="section-subtitle">Aksi Cepat</p>
                    <h5 class="section-title">Navigasi Profil</h5>
                  </div>
                  <div class="card-body d-grid gap-2">
                    <a href="/profile/edit" class="btn btn-outline-primary">
                      <span class="iconify me-1" data-icon="ri:user-settings-line"></span> Edit Data Profil
                    </a>
                    <a href="/profile/password" class="btn btn-outline-warning">
                      <span class="iconify me-1" data-icon="ri:lock-password-line"></span> Ganti Password
                    </a>
                    <a href="<%= dashboardUrl %>" class="btn btn-outline-secondary">
                      <span class="iconify me-1" data-icon="ri:dashboard-line"></span> Kembali ke Dashboard
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="content-backdrop fade"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="layout-overlay layout-menu-toggle"></div>
  <div class="drag-target"></div>

  <script src="/assets/vendor/libs/jquery/jquery.js"></script>
  <script src="/assets/vendor/libs/popper/popper.js"></script>
  <script src="/assets/vendor/js/bootstrap.js"></script>
  <script src="/assets/vendor/libs/node-waves/node-waves.js"></script>
  <script src="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
  <script src="/assets/vendor/js/menu.js"></script>
  <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
  <script src="/assets/js/main.js"></script>
</body>
</html>
