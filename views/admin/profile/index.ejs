<%# Profil akun sendiri (/profile). Notifikasi ?success=… ditampilkan layout admin sebagai toast. %>
<%
  const nama = profile.name || '';
  const inisial = (nama || profile.email || '?').trim().split(/\s+/).slice(0, 2).map(w => w.charAt(0)).join('').toUpperCase();
  const superadmin = isSuperadmin(profile);
%>
<div class="max-w-3xl">
  <div class="mb-6">
    <p class="eyebrow">Akun</p>
    <h1 class="mt-2 text-2xl font-bold md:text-3xl">Profil Saya</h1>
    <p class="mt-1 text-muted">Data akun yang Anda pakai untuk masuk ke panel admin.</p>
  </div>

  <section class="card" aria-labelledby="profil-nama">
    <div class="card-body flex flex-col gap-5 sm:flex-row sm:items-center">
      <% if (profile.profilePhoto) { %>
        <img src="<%= profile.profilePhoto %>" alt="" width="96" height="96" class="size-24 shrink-0 rounded-full border border-line object-cover">
      <% } else { %>
        <span class="flex size-24 shrink-0 items-center justify-center rounded-full bg-primary-soft text-3xl font-bold text-primary" aria-hidden="true"><%= inisial %></span>
      <% } %>
      <div class="min-w-0">
        <h2 id="profil-nama" class="text-xl font-bold break-words"><%= nama || 'Tanpa nama' %></h2>
        <p class="break-all text-muted"><%= profile.email %></p>
        <p class="mt-2"><%- include('../../components/badge', { text: roleLabel(profile), tone: superadmin ? 'gold' : 'info', badgeIcon: superadmin ? 'verified' : 'person' }) %></p>
      </div>
    </div>

    <dl class="grid gap-4 border-t border-line p-5 sm:grid-cols-3">
      <div>
        <dt class="text-sm text-muted">Akun dibuat</dt>
        <dd class="font-medium"><%= formatTanggal(profile.createdAt, { long: true }) %></dd>
      </div>
      <div>
        <dt class="text-sm text-muted">Terakhir diperbarui</dt>
        <dd class="font-medium"><%= formatTanggal(profile.updatedAt, { long: true }) %></dd>
      </div>
      <div>
        <dt class="text-sm text-muted">Masuk terakhir</dt>
        <dd class="font-medium"><%= profile.lastLoginAt ? formatTanggal(profile.lastLoginAt, { long: true }) : 'Belum tercatat' %></dd>
      </div>
    </dl>

    <div class="flex flex-wrap gap-2 border-t border-line p-5">
      <a href="/profile/edit" class="btn btn-primary"><%- icon('edit') %>Ubah profil</a>
      <a href="/profile/password" class="btn btn-secondary"><%- icon('settings') %>Ubah password</a>
    </div>
  </section>
</div>
