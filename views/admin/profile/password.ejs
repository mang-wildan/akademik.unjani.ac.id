<!doctype html>
<html
  lang="id"
  class="layout-navbar-fixed layout-menu-fixed layout-compact"
  dir="ltr"
  data-skin="default"
  data-bs-theme="light"
  data-assets-path="/assets/"
  data-template="vertical-menu-template">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || 'Ubah Password' %></title>
  <link rel="icon" type="image/x-icon" href="/assets/img/favicon/favicon.ico" />
  <link rel="stylesheet" href="/assets/vendor/fonts/iconify-icons.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/node-waves/node-waves.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
  <link rel="stylesheet" href="/assets/vendor/css/core.css" />
  <link rel="stylesheet" href="/assets/css/demo.css" />
  <style>
    :root {
      --pass-ink: #0f172a;
      --pass-muted: #64748b;
      --pass-border: #e2e8f0;
      --pass-soft: #f8fafc;
    }

    body {
      background: linear-gradient(180deg, #f7fafc 0%, #eef2ff 100%);
    }

    .pass-hero {
      border: 0;
      border-radius: 20px;
      color: #f8fafc;
      background: linear-gradient(135deg, #07a250 0%, #0a763d 55%, #0f2a12 100%);
      box-shadow: 0 20px 40px rgba(15, 23, 42, 0.2);
      position: relative;
      overflow: hidden;
    }

    .pass-hero::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 20% 10%, rgba(255, 255, 255, 0.15), transparent 40%),
        radial-gradient(circle at 80% 0%, rgba(255, 255, 255, 0.1), transparent 38%);
      pointer-events: none;
    }

    .hero-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border-radius: 999px;
      padding: 6px 10px;
      border: 1px solid rgba(255, 255, 255, 0.26);
      background: rgba(255, 255, 255, 0.14);
      font-size: 12px;
      font-weight: 600;
    }

    .section-card {
      border: 1px solid var(--pass-border);
      border-radius: 18px;
      box-shadow: 0 12px 24px rgba(15, 23, 42, 0.06);
    }

    .section-subtitle {
      color: var(--pass-muted);
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      margin-bottom: 2px;
    }

    .meta-item {
      border: 1px solid var(--pass-border);
      border-radius: 12px;
      padding: 10px 12px;
      background: #fff;
    }

    .meta-label {
      color: var(--pass-muted);
      font-size: 12px;
      margin-bottom: 3px;
    }

    .meta-value {
      color: var(--pass-ink);
      font-weight: 700;
      word-break: break-word;
    }

    .avatar-photo {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid #fff;
      box-shadow: 0 8px 18px rgba(15, 23, 42, 0.15);
      background: #e2e8f0;
    }

    .avatar-fallback {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 1.2rem;
      color: #0f172a;
      border: 3px solid #fff;
      background: linear-gradient(135deg, #bae6fd, #c4b5fd);
      box-shadow: 0 8px 18px rgba(15, 23, 42, 0.15);
    }

    .strength-wrap {
      margin-top: 8px;
    }

    .strength-bar {
      width: 100%;
      height: 9px;
      border-radius: 999px;
      background: #e2e8f0;
      overflow: hidden;
    }

    .strength-fill {
      height: 100%;
      width: 0;
      border-radius: 999px;
      transition: width 0.25s ease, background-color 0.25s ease;
      background: #ef4444;
    }

    .helper-list {
      margin: 0;
      padding-left: 18px;
      color: #475569;
      font-size: 13px;
      display: grid;
      gap: 4px;
    }

    .status-text {
      font-size: 12px;
      font-weight: 600;
      margin-top: 4px;
    }
  </style>
  <script src="/assets/vendor/js/helpers.js"></script>
  <script src="/assets/js/config.js"></script>
</head>

<body>
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <%- include("../../partials/menu") %>
      <div class="layout-page">
        <%- include("../../partials/navbar") %>
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">
            <%
              const account = user || {};
              const fullName = (account.name || 'Pengguna').trim();
              const initials = fullName
                .split(/\s+/)
                .filter(Boolean)
                .slice(0, 2)
                .map(part => part.charAt(0))
                .join('')
                .toUpperCase() || 'U';
              const avatar = account.profilePhoto || '';
              const roleLabel = account.role === 'admin' ? 'Administrator' : 'Pengguna';
              const joinedDate = account.createdAt
                ? new Date(account.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
                : '-';
              const updatedDate = account.updatedAt
                ? new Date(account.updatedAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
                : '-';
            %>

            <div class="card pass-hero mb-4">
              <div class="card-body position-relative">
                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3">
                  <div>
                    <h4 class="mb-1 text-white">Ubah Password Akun</h4>
                    <p class="mb-2 text-white-75">Jaga keamanan akun dengan password yang kuat dan unik untuk setiap sistem.</p>
                    <div class="d-flex flex-wrap gap-2">
                      <span class="hero-chip"><span class="iconify" data-icon="ri:shield-check-line"></span> Mode keamanan aktif</span>
                      <span class="hero-chip"><span class="iconify" data-icon="ri:calendar-check-line"></span> Bergabung: <%= joinedDate %></span>
                      <span class="hero-chip"><span class="iconify" data-icon="ri:user-settings-line"></span> Role: <%= roleLabel %></span>
                    </div>
                  </div>
                  <a href="/profile" class="btn btn-outline-light">
                    <span class="iconify me-1" data-icon="ri:arrow-left-line"></span> Kembali ke Profil
                  </a>
                </div>
              </div>
            </div>

            <% if (error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <%= error %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <% } %>

            <form method="POST" action="/profile/password" data-disable-submit>
              <div class="row g-4">
                <div class="col-lg-8">
                  <div class="card section-card h-100">
                    <div class="card-header bg-transparent border-0 pb-0 d-flex justify-content-between align-items-center">
                      <div>
                        <p class="section-subtitle">Keamanan Login</p>
                        <h5 class="mb-0 card-title">Form Ubah Password</h5>
                      </div>
                      <small class="text-muted">Minimal 6 karakter</small>
                    </div>
                    <div class="card-body">
                      <div class="row g-4">
                        <div class="col-12">
                          <label class="form-label fw-medium" for="currentPasswordInput">Password Saat Ini</label>
                          <input
                            type="password"
                            id="currentPasswordInput"
                            name="currentPassword"
                            class="form-control"
                            required
                            autocomplete="current-password"
                            placeholder="Masukkan password saat ini" />
                        </div>
                        <div class="col-md-6">
                          <label class="form-label fw-medium" for="newPasswordInput">Password Baru</label>
                          <input
                            type="password"
                            id="newPasswordInput"
                            name="newPassword"
                            class="form-control"
                            required
                            minlength="6"
                            autocomplete="new-password"
                            placeholder="Minimal 6 karakter" />
                          <div class="strength-wrap">
                            <div class="strength-bar"><div id="strengthFill" class="strength-fill"></div></div>
                            <div id="strengthText" class="status-text text-muted">Kekuatan password: belum diisi</div>
                          </div>
                        </div>
                        <div class="col-md-6">
                          <label class="form-label fw-medium" for="confirmPasswordInput">Konfirmasi Password Baru</label>
                          <input
                            type="password"
                            id="confirmPasswordInput"
                            name="confirmPassword"
                            class="form-control"
                            required
                            minlength="6"
                            autocomplete="new-password"
                            placeholder="Ulangi password baru" />
                          <div id="matchText" class="status-text text-muted">Konfirmasi password belum diisi</div>
                        </div>
                        <div class="col-12">
                          <div class="meta-item">
                            <div class="meta-label">Terakhir update profil</div>
                            <div class="meta-value"><%= updatedDate %></div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="col-lg-4">
                  <div class="card section-card mb-4">
                    <div class="card-header bg-transparent border-0 pb-0">
                      <p class="section-subtitle">Akun Aktif</p>
                      <h5 class="mb-0 card-title">Informasi Pengguna</h5>
                    </div>
                    <div class="card-body">
                      <div class="d-flex align-items-center gap-3 mb-3">
                        <% if (avatar) { %>
                          <img src="<%= avatar %>" alt="Foto Profil" class="avatar-photo">
                        <% } else { %>
                          <div class="avatar-fallback"><%= initials %></div>
                        <% } %>
                        <div>
                          <div class="fw-semibold"><%= fullName %></div>
                          <small class="text-muted"><%= account.email || '-' %></small>
                        </div>
                      </div>
                      <div class="meta-item mb-2">
                        <div class="meta-label">Role</div>
                        <div class="meta-value"><%= roleLabel %></div>
                      </div>
                      <div class="meta-item">
                        <div class="meta-label">Bergabung Sejak</div>
                        <div class="meta-value"><%= joinedDate %></div>
                      </div>
                    </div>
                  </div>

                  <div class="card section-card">
                    <div class="card-header bg-transparent border-0 pb-0">
                      <p class="section-subtitle">Panduan</p>
                      <h5 class="mb-0 card-title">Tips Password Aman</h5>
                    </div>
                    <div class="card-body">
                      <ul class="helper-list mb-3">
                        <li>Gunakan minimal 8 karakter agar lebih kuat.</li>
                        <li>Kombinasikan huruf besar, huruf kecil, angka, dan simbol.</li>
                        <li>Jangan gunakan nama atau tanggal lahir sebagai password.</li>
                        <li>Gunakan password yang berbeda dengan akun lain.</li>
                      </ul>
                      <div class="d-grid gap-2">
                        <a href="/profile/edit" class="btn btn-outline-primary">
                          <span class="iconify me-1" data-icon="ri:user-settings-line"></span> Edit Profil
                        </a>
                        <a href="/profile" class="btn btn-outline-secondary">
                          <span class="iconify me-1" data-icon="ri:user-3-line"></span> Lihat Profil
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="d-flex justify-content-end gap-3 mt-4">
                <a href="/profile" class="btn btn-label-secondary">Batal</a>
                <button type="submit" class="btn btn-warning px-4">
                  <span class="iconify me-1" data-icon="ri:lock-password-line"></span> Ubah Password
                </button>
              </div>
            </form>
          </div>
          <div class="content-backdrop fade"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="layout-overlay layout-menu-toggle"></div>
  <div class="drag-target"></div>

  <script src="/assets/vendor/libs/jquery/jquery.js"></script>
  <script src="/assets/vendor/libs/popper/popper.js"></script>
  <script src="/assets/vendor/js/bootstrap.js"></script>
  <script src="/assets/vendor/libs/node-waves/node-waves.js"></script>
  <script src="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
  <script src="/assets/vendor/js/menu.js"></script>
  <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
  <script src="/assets/js/main.js"></script>
  <script>
    (function () {
      const newPasswordInput = document.getElementById('newPasswordInput');
      const confirmPasswordInput = document.getElementById('confirmPasswordInput');
      const strengthFill = document.getElementById('strengthFill');
      const strengthText = document.getElementById('strengthText');
      const matchText = document.getElementById('matchText');

      const scorePassword = value => {
        let score = 0;
        if (!value) return score;
        if (value.length >= 6) score += 1;
        if (value.length >= 8) score += 1;
        if (/[A-Z]/.test(value) && /[a-z]/.test(value)) score += 1;
        if (/\d/.test(value)) score += 1;
        if (/[^A-Za-z0-9]/.test(value)) score += 1;
        return Math.min(score, 5);
      };

      const updateStrength = () => {
        const value = newPasswordInput.value || '';
        const score = scorePassword(value);
        const percent = score * 20;
        strengthFill.style.width = `${percent}%`;

        if (!value) {
          strengthFill.style.backgroundColor = '#94a3b8';
          strengthText.className = 'status-text text-muted';
          strengthText.textContent = 'Kekuatan password: belum diisi';
          return;
        }

        if (score <= 2) {
          strengthFill.style.backgroundColor = '#ef4444';
          strengthText.className = 'status-text text-danger';
          strengthText.textContent = 'Kekuatan password: lemah';
          return;
        }
        if (score === 3) {
          strengthFill.style.backgroundColor = '#f59e0b';
          strengthText.className = 'status-text text-warning';
          strengthText.textContent = 'Kekuatan password: sedang';
          return;
        }

        strengthFill.style.backgroundColor = '#22c55e';
        strengthText.className = 'status-text text-success';
        strengthText.textContent = 'Kekuatan password: kuat';
      };

      const updateMatch = () => {
        const newPass = newPasswordInput.value || '';
        const confirmPass = confirmPasswordInput.value || '';

        if (!confirmPass) {
          matchText.className = 'status-text text-muted';
          matchText.textContent = 'Konfirmasi password belum diisi';
          return;
        }

        if (newPass === confirmPass) {
          matchText.className = 'status-text text-success';
          matchText.textContent = 'Konfirmasi password cocok';
          return;
        }

        matchText.className = 'status-text text-danger';
        matchText.textContent = 'Konfirmasi password tidak cocok';
      };

      newPasswordInput.addEventListener('input', () => {
        updateStrength();
        updateMatch();
      });
      confirmPasswordInput.addEventListener('input', updateMatch);

      updateStrength();
      updateMatch();
    })();
  </script>
</body>
</html>
