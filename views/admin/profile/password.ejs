<%# Ubah password sendiri (/profile/password). Isian password tidak pernah dikirim balik saat galat. %>
<div class="max-w-md">
  <div class="mb-6">
    <a href="/profile" class="mb-2 flex min-h-6 w-fit items-center gap-1 text-sm font-medium text-muted hover:text-ink"><%- icon('arrow_back', 'size-4') %>Kembali ke Profil Saya</a>
    <p class="eyebrow">Akun</p>
    <h1 class="mt-2 text-2xl font-bold md:text-3xl">Ubah Password</h1>
    <p class="mt-1 text-muted">Masukkan password saat ini, lalu password baru dua kali.</p>
  </div>

  <% if (errors._form) { %>
    <div class="mb-6"><%- include('../../components/alert', { alertTone: 'danger', alertTitle: 'Password belum diubah', alertText: errors._form }) %></div>
  <% } %>

  <form method="POST" action="/profile/password" class="card card-body grid gap-5">
    <%- include('../../components/form-field', { name: 'currentPassword', label: 'Password Saat Ini', type: 'password', required: true, error: errors.currentPassword, autocomplete: 'current-password' }) %>
    <%- include('../../components/form-field', { name: 'newPassword', label: 'Password Baru', type: 'password', required: true, error: errors.newPassword, help: 'Minimal 8 karakter.', autocomplete: 'new-password' }) %>
    <%- include('../../components/form-field', { name: 'confirmPassword', label: 'Konfirmasi Password Baru', type: 'password', required: true, error: errors.confirmPassword, autocomplete: 'new-password' }) %>
    <div class="flex justify-end gap-2 border-t border-line pt-5">
      <a href="/profile" class="btn btn-secondary">Batal</a>
      <button type="submit" class="btn btn-primary">Simpan</button>
    </div>
  </form>
</div>
