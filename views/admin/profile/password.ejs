<%# Ubah password sendiri (/profile/password). Isian password tidak pernah dikirim balik saat galat. %>
<div class="max-w-form">
  <%- include('../_ui/page-header', { admin: true, eyebrow: 'Akun', heading: 'Ubah Password', lead: 'Masukkan password saat ini, lalu password baru dua kali.', breadcrumb: [{ label: 'Profil Saya', href: '/profile' }, { label: 'Ubah Password' }] }) %>

  <p class="mb-4 text-sm text-muted">Masukkan password saat ini, lalu password baru dua kali.</p>

  <form method="POST" action="/profile/password" data-save-form x-data="dirtyGuard" x-on:input="mark" x-on:change="mark" x-on:submit="submitted" x-on:beforeunload.window="beforeUnload" class="grid gap-5 rounded-card border border-line bg-surface p-4">
    <%- include('../_ui/error-summary', { errors }) %>
    <%- include('../_ui/field', { name: 'currentPassword', label: 'Password Saat Ini', type: 'password', required: true, error: errors.currentPassword, autocomplete: 'current-password' }) %>
    <%- include('../_ui/field', { name: 'newPassword', label: 'Password Baru', type: 'password', required: true, error: errors.newPassword, help: 'Minimal 8 karakter.', autocomplete: 'new-password' }) %>
    <%- include('../_ui/field', { name: 'confirmPassword', label: 'Konfirmasi Password Baru', type: 'password', required: true, error: errors.confirmPassword, autocomplete: 'new-password' }) %>
    <div class="form-actions max-lg:bottom-[calc(4rem+env(safe-area-inset-bottom))]">
      <a href="/profile" class="btn btn-secondary">Batal</a>
      <button type="submit" class="btn btn-primary">Simpan</button>
    </div>
  </form>
</div>
