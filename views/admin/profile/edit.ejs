<!doctype html>
<html
  lang="id"
  class="layout-navbar-fixed layout-menu-fixed layout-compact"
  dir="ltr"
  data-skin="default"
  data-bs-theme="light"
  data-assets-path="/assets/"
  data-template="vertical-menu-template">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || 'Edit Profil' %></title>
  <link rel="icon" type="image/x-icon" href="/assets/img/favicon/favicon.ico" />
  <link rel="stylesheet" href="/assets/vendor/fonts/iconify-icons.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/node-waves/node-waves.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
  <link rel="stylesheet" href="/assets/vendor/css/core.css" />
  <link rel="stylesheet" href="/assets/css/demo.css" />
  <style>
    :root {
      --profile-edit-ink: #0f172a;
      --profile-edit-muted: #64748b;
      --profile-edit-border: #e2e8f0;
    }

    body {
      background: linear-gradient(180deg, #f7fafc 0%, #eef2ff 100%);
    }

    .edit-hero {
      border: 0;
      border-radius: 20px;
      background: linear-gradient(135deg, #07a250 0%, #0a763d 55%, #0f2a12 100%);
      color: #f8fafc;
      box-shadow: 0 20px 40px rgba(15, 23, 42, 0.18);
      position: relative;
      overflow: hidden;
    }

    .edit-hero::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 20% 12%, rgba(255, 255, 255, 0.18), transparent 42%),
        radial-gradient(circle at 84% 0%, rgba(255, 255, 255, 0.12), transparent 38%);
      pointer-events: none;
    }

    .hero-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border-radius: 999px;
      padding: 6px 10px;
      border: 1px solid rgba(255, 255, 255, 0.28);
      background: rgba(255, 255, 255, 0.14);
      font-size: 12px;
      font-weight: 600;
    }

    .section-card {
      border: 1px solid var(--profile-edit-border);
      border-radius: 18px;
      box-shadow: 0 12px 24px rgba(15, 23, 42, 0.06);
    }

    .section-subtitle {
      color: var(--profile-edit-muted);
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      margin-bottom: 2px;
    }

    .avatar-preview-wrap {
      border: 1px dashed #cbd5e1;
      border-radius: 14px;
      background: #f8fafc;
      padding: 12px;
    }

    .avatar-preview {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid #fff;
      box-shadow: 0 8px 20px rgba(15, 23, 42, 0.16);
      background: #e2e8f0;
      display: none;
    }

    .avatar-fallback {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 1.5rem;
      color: #0f172a;
      background: linear-gradient(135deg, #bae6fd, #c4b5fd);
      border: 3px solid #fff;
      box-shadow: 0 8px 20px rgba(15, 23, 42, 0.12);
    }

    .meta-item {
      border: 1px solid var(--profile-edit-border);
      border-radius: 12px;
      padding: 10px 12px;
      background: #fff;
    }

    .meta-label {
      font-size: 12px;
      color: var(--profile-edit-muted);
      margin-bottom: 4px;
    }

    .meta-value {
      font-weight: 700;
      color: var(--profile-edit-ink);
      word-break: break-word;
    }

    .helper-list {
      margin: 0;
      padding-left: 18px;
      color: #475569;
      font-size: 13px;
      display: grid;
      gap: 4px;
    }
  </style>
  <script src="/assets/vendor/js/helpers.js"></script>
  <script src="/assets/js/config.js"></script>
</head>

<body>
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <%- include("../../partials/menu") %>
      <div class="layout-page">
        <%- include("../../partials/navbar") %>
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">
            <%
              const data = profile || {};
              const fullName = (values && values.name ? values.name : (data.name || 'Pengguna'));
              const initials = fullName
                .split(/\s+/)
                .filter(Boolean)
                .slice(0, 2)
                .map(part => part.charAt(0))
                .join('')
                .toUpperCase() || 'U';
              const roleLabel = locals.roleLabel(data.role);
              const joinedDate = data.createdAt
                ? new Date(data.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
                : '-';
              const updatedDate = data.updatedAt
                ? new Date(data.updatedAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
                : '-';
              const currentPhoto = values && values.profilePhoto ? values.profilePhoto : '';
            %>

            <div class="card edit-hero mb-4">
              <div class="card-body position-relative">
                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3">
                  <div>
                    <h4 class="mb-1 text-white">Edit Profil Akun</h4>
                    <p class="mb-2 text-white-75">Perbarui data profil dan foto agar identitas akun lebih jelas dan profesional.</p>
                    <div class="d-flex flex-wrap gap-2">
                      <span class="hero-chip"><span class="iconify" data-icon="ri:shield-user-line"></span> <%= roleLabel %></span>
                      <span class="hero-chip"><span class="iconify" data-icon="ri:calendar-check-line"></span> Bergabung: <%= joinedDate %></span>
                      <span class="hero-chip"><span class="iconify" data-icon="ri:refresh-line"></span> Update: <%= updatedDate %></span>
                    </div>
                  </div>
                  <a href="/profile" class="btn btn-outline-light">
                    <span class="iconify me-1" data-icon="ri:arrow-left-line"></span> Kembali ke Profil
                  </a>
                </div>
              </div>
            </div>

            <% if (error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <%= error %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <% } %>

            <form method="POST" action="/profile/edit" enctype="multipart/form-data" data-disable-submit>
              <div class="row g-4">
                <div class="col-lg-8">
                  <div class="card section-card h-100">
                    <div class="card-header bg-transparent border-0 pb-0 d-flex justify-content-between align-items-center">
                      <div>
                        <p class="section-subtitle">Informasi Akun</p>
                        <h5 class="mb-0 card-title">Data Profil</h5>
                      </div>
                      <small class="text-muted"><span class="text-danger">*</span> Wajib diisi</small>
                    </div>
                    <div class="card-body">
                      <div class="row g-4">
                        <div class="col-md-6">
                          <label class="form-label fw-medium" for="nameInput">Nama <span class="text-danger">*</span></label>
                          <input
                            type="text"
                            id="nameInput"
                            name="name"
                            class="form-control"
                            required
                            value="<%= values && values.name ? values.name : '' %>"
                            placeholder="Nama lengkap" />
                          <div class="form-text">Gunakan nama yang tampil pada sistem admin.</div>
                        </div>
                        <div class="col-md-6">
                          <label class="form-label fw-medium" for="emailInput">Email <span class="text-danger">*</span></label>
                          <input
                            type="email"
                            id="emailInput"
                            name="email"
                            class="form-control"
                            required
                            value="<%= values && values.email ? values.email : '' %>"
                            placeholder="you@example.com" />
                          <div class="form-text">Email dipakai untuk masuk akun.</div>
                        </div>
                        <div class="col-md-6">
                          <div class="meta-item">
                            <div class="meta-label">Role</div>
                            <div class="meta-value"><%= roleLabel %></div>
                          </div>
                        </div>
                        <div class="col-md-6">
                          <div class="meta-item">
                            <div class="meta-label">Bergabung Sejak</div>
                            <div class="meta-value"><%= joinedDate %></div>
                          </div>
                        </div>
                        <div class="col-12">
                          <div class="meta-item">
                            <div class="meta-label">Terakhir Diperbarui</div>
                            <div class="meta-value"><%= updatedDate %></div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="col-lg-4">
                  <div class="card section-card mb-4">
                    <div class="card-header bg-transparent border-0 pb-0">
                      <p class="section-subtitle">Foto Profil</p>
                      <h5 class="mb-0 card-title">Upload Avatar</h5>
                    </div>
                    <div class="card-body">
                      <div class="avatar-preview-wrap mb-3">
                        <div class="d-flex align-items-center gap-3">
                          <img id="profilePhotoPreview" class="avatar-preview" src="<%= currentPhoto %>" alt="Foto Profil">
                          <div id="profilePhotoFallback" class="avatar-fallback"><%= initials %></div>
                          <div>
                            <div class="fw-semibold">Foto Profil</div>
                            <small class="text-muted">PNG/JPG/WEBP, maks 2MB.</small>
                          </div>
                        </div>
                      </div>

                      <label class="form-label fw-medium" for="profilePhotoInput">Pilih Foto Baru</label>
                      <input
                        type="file"
                        id="profilePhotoInput"
                        name="profilePhoto"
                        class="form-control"
                        accept="image/png,image/jpeg,image/jpg,image/webp" />
                      <div class="form-text mb-3">Jika dipilih, foto lama akan diganti otomatis.</div>

                      <input type="hidden" id="removeProfilePhotoInput" name="removeProfilePhoto" value="0">
                      <button type="button" id="removePhotoBtn" class="btn btn-outline-danger w-100">
                        <span class="iconify me-1" data-icon="ri:delete-bin-6-line"></span> Hapus Foto Profil
                      </button>
                    </div>
                  </div>

                  <div class="card section-card">
                    <div class="card-header bg-transparent border-0 pb-0">
                      <p class="section-subtitle">Tips</p>
                      <h5 class="mb-0 card-title">Rekomendasi Profil</h5>
                    </div>
                    <div class="card-body">
                      <ul class="helper-list">
                        <li>Gunakan nama asli agar identitas akun jelas.</li>
                        <li>Pastikan email aktif untuk keamanan akun.</li>
                        <li>Gunakan foto wajah/logo yang mudah dikenali.</li>
                        <li>Perbarui password berkala dari menu Ubah Password.</li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>

              <div class="d-flex justify-content-end gap-3 mt-4">
                <a href="/profile" class="btn btn-label-secondary">Batal</a>
                <button type="submit" class="btn btn-primary px-4">
                  <span class="iconify me-1" data-icon="ri:save-line"></span> Simpan Perubahan
                </button>
              </div>
            </form>
          </div>
          <div class="content-backdrop fade"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="layout-overlay layout-menu-toggle"></div>
  <div class="drag-target"></div>

  <script src="/assets/vendor/libs/jquery/jquery.js"></script>
  <script src="/assets/vendor/libs/popper/popper.js"></script>
  <script src="/assets/vendor/js/bootstrap.js"></script>
  <script src="/assets/vendor/libs/node-waves/node-waves.js"></script>
  <script src="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
  <script src="/assets/vendor/js/menu.js"></script>
  <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
  <script src="/assets/js/main.js"></script>
  <script>
    (function () {
      const fileInput = document.getElementById('profilePhotoInput');
      const preview = document.getElementById('profilePhotoPreview');
      const fallback = document.getElementById('profilePhotoFallback');
      const removeBtn = document.getElementById('removePhotoBtn');
      const removeInput = document.getElementById('removeProfilePhotoInput');

      const showPreview = src => {
        if (!src) {
          preview.style.display = 'none';
          fallback.style.display = 'inline-flex';
          return;
        }
        preview.src = src;
        preview.style.display = 'inline-block';
        fallback.style.display = 'none';
      };

      if (preview.getAttribute('src')) {
        showPreview(preview.getAttribute('src'));
      } else {
        showPreview('');
      }

      fileInput.addEventListener('change', e => {
        const file = e.target.files && e.target.files[0];
        if (!file) return;
        removeInput.value = '0';
        const reader = new FileReader();
        reader.onload = ev => showPreview(ev.target.result);
        reader.readAsDataURL(file);
      });

      removeBtn.addEventListener('click', () => {
        removeInput.value = '1';
        fileInput.value = '';
        showPreview('');
      });
    })();
  </script>
</body>
</html>
