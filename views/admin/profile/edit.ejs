<%# Ubah profil sendiri (/profile/edit). Tanpa JavaScript; foto diunggah lewat multipart biasa. %>
<%
  const fotoSaatIni = profile.profilePhoto || '';
%>
<div class="max-w-form">
  <%- include('../_ui/page-header', { admin: true, eyebrow: 'Akun', heading: 'Ubah Profil', lead: 'Nama dan email ini dipakai untuk masuk dan tampil di panel admin.', breadcrumb: [{ label: 'Profil Saya', href: '/profile' }, { label: 'Ubah Profil' }] }) %>

  <p class="mb-4 text-sm text-muted">Nama dan email ini dipakai untuk masuk dan tampil di panel admin.</p>

  <form method="POST" action="/profile/edit" enctype="multipart/form-data" data-save-form x-data="dirtyGuard" x-on:input="mark" x-on:change="mark" x-on:submit="submitted" x-on:beforeunload.window="beforeUnload" class="grid gap-5 rounded-card border border-line bg-surface p-4">
    <%- include('../_ui/error-summary', { errors }) %>
    <%- include('../_ui/field', { name: 'name', label: 'Nama', required: true, value: values.name, error: errors.name, autocomplete: 'name' }) %>
    <%- include('../_ui/field', { name: 'email', label: 'Email', type: 'email', required: true, value: values.email, error: errors.email, autocomplete: 'email' }) %>

    <fieldset class="grid gap-4 border-t border-line pt-5">
      <legend class="sr-only">Foto profil</legend>
      <% if (fotoSaatIni) { %>
        <div class="flex items-center gap-4">
          <img src="<%= fotoSaatIni %>" alt="Foto profil saat ini" width="64" height="64" class="size-16 shrink-0 rounded-full border border-line object-cover">
          <p class="min-w-0 text-sm text-muted">Foto profil saat ini. Unggah foto baru untuk menggantinya.</p>
        </div>
      <% } %>
      <%- include('../_ui/upload-field', {
        name: 'profilePhoto', label: fotoSaatIni ? 'Ganti foto profil' : 'Foto profil',
        accept: 'image/jpeg,image/png,image/webp',
        limitText: fotoSaatIni ? 'JPG/PNG/WEBP, maks. 2 MB. Biarkan kosong jika tidak diganti' : 'JPG/PNG/WEBP, maks. 2 MB. Opsional',
        error: errors.profilePhoto,
      }) %>
      <% if (fotoSaatIni) { %>
        <div class="flex min-h-11 items-center gap-2">
          <input type="checkbox" id="f-removeProfilePhoto" name="removeProfilePhoto" value="1"<%= values.removeProfilePhoto ? ' checked' : '' %> class="size-6 shrink-0 rounded border-control text-primary focus:ring-primary">
          <label for="f-removeProfilePhoto" class="text-sm font-medium">Hapus foto profil <span class="text-muted">(diabaikan jika Anda mengunggah foto baru)</span></label>
        </div>
      <% } %>
    </fieldset>

    <div class="form-actions max-lg:bottom-[calc(4rem+env(safe-area-inset-bottom))]">
      <a href="/profile" class="btn btn-secondary">Batal</a>
      <button type="submit" class="btn btn-primary">Simpan</button>
    </div>
  </form>
</div>
