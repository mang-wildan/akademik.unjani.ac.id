<%# Pola acuan form admin (docs/POLA-ADMIN.md): validasi per-kolom, rich text, lampiran, sematkan. Beda dari Pengumuman: gambar sampul wajib saat Terbit (FR-M-02). %>
<div class="mb-6">
  <a href="/admin/<%= basePath %>" class="mb-2 inline-flex min-h-6 items-center gap-1 text-sm font-medium text-muted hover:text-ink"><%- icon('arrow_back', 'size-4') %>Kembali ke <%= listLabel %></a>
  <h1 class="text-2xl font-bold"><%= mode === 'edit' ? `Ubah ${singularLabel}` : `Tambah ${singularLabel}` %></h1>
</div>

<% if (errors._form) { %>
  <div class="mb-6"><%- include('../../components/alert', { alertTone: 'danger', alertTitle: 'Gagal menyimpan', alertText: errors._form }) %></div>
<% } %>

<form method="POST" action="/admin/<%= basePath %><%= mode === 'edit' ? `/${item._id}` : '' %>" enctype="multipart/form-data" class="card card-body grid gap-5 lg:grid-cols-3">
  <div class="lg:col-span-2 space-y-5">
    <%- include('../../components/form-field', { name: 'title', label: 'Judul', required: true, value: values.title, error: errors.title, placeholder: 'Tulis judul yang jelas dan ringkas' }) %>
    <%- include('../../components/richtext-field', { name: 'body', label: 'Isi', required: true, value: values.body, error: errors.body }) %>
  </div>

  <div class="space-y-5">
    <%- include('../../components/form-field', {
      name: 'kategori', label: 'Kategori', type: 'select', placeholder: 'Tanpa kategori',
      value: values.kategori, error: errors.kategori,
      options: kategoriList.map(k => ({ value: k._id, label: k.nama })),
    }) %>
    <%- include('../../components/form-field', {
      name: 'status', label: 'Status', type: 'select', required: true,
      value: values.status || 'draft', error: errors.status,
      options: [{ value: 'draft', label: 'Draf' }, { value: 'published', label: 'Terbit' }],
    }) %>

    <div class="flex min-h-11 items-center gap-2">
      <input type="checkbox" id="f-pinned" name="pinned" value="on" <%= values.pinned ? 'checked' : '' %> class="size-6 shrink-0 rounded border-control text-primary focus:ring-primary">
      <label for="f-pinned" class="text-sm font-medium">Sematkan di Beranda <span class="text-muted">(maks. 4)</span></label>
    </div>

    <%- include('../../components/file-upload', {
      name: 'featuredImage', label: 'Gambar Sampul', accept: 'image/png,image/jpeg,image/webp',
      limitText: 'JPG/PNG/WEBP, maks. 5 MB. Diubah otomatis ke WebP. Wajib diisi saat status Terbit.', error: errors.featuredImage,
      current: (mode === 'edit' && item.featuredImage) ? { label: 'Gambar saat ini', href: item.featuredImage } : null,
    }) %>
    <% if (mode === 'edit' && item.featuredImage) { %>
      <img src="<%= item.featuredImage %>" alt="" class="aspect-video w-full rounded-control border border-line object-cover">
    <% } %>

    <div>
      <% if (mode === 'edit' && item.attachments && item.attachments.length) { %>
        <input type="hidden" name="attachmentsEditable" value="1">
        <p class="field-label">Lampiran saat ini</p>
        <ul class="mb-2 space-y-1">
          <% item.attachments.forEach(a => { %>
            <li class="flex min-h-11 items-center gap-2 rounded-control border border-line px-3">
              <input type="checkbox" id="keep-<%= a._id %>" name="keepAttachment" value="<%= a._id %>" checked class="size-4 rounded border-control text-primary">
              <label for="keep-<%= a._id %>" class="line-clamp-1 flex-1 text-sm"><%= a.judul %></label>
            </li>
          <% }) %>
        </ul>
        <p class="field-help mb-3">Hapus centang untuk menghapus lampiran saat disimpan.</p>
      <% } %>
      <label for="f-attachments" class="field-label">Tambah Lampiran (PDF)</label>
      <input type="file" id="f-attachments" name="attachments" accept="application/pdf" multiple
             class="block w-full rounded-control border border-dashed border-control bg-surface p-2 text-sm text-muted file:mr-3 file:min-h-10 file:cursor-pointer file:rounded-control file:border-0 file:bg-primary-soft file:px-4 file:font-semibold file:text-primary hover:file:bg-success-soft">
      <p class="field-help">PDF, maks. 10 MB per file, sampai 5 file sekaligus.</p>
    </div>
  </div>

  <div class="flex justify-end gap-2 border-t border-line pt-5 lg:col-span-3">
    <a href="/admin/<%= basePath %>" class="btn btn-secondary">Batal</a>
    <button type="submit" class="btn btn-primary">Simpan</button>
  </div>
</form>
