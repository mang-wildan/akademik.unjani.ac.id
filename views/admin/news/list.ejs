<!doctype html>
<html
  lang="id"
  class="layout-navbar-fixed layout-menu-fixed layout-compact"
  dir="ltr"
  data-skin="default"
  data-bs-theme="light"
  data-assets-path="/assets/"
  data-template="vertical-menu-template">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || 'Berita' %></title>
  <link rel="icon" type="image/x-icon" href="/assets/img/favicon/favicon.ico" />
  <link rel="stylesheet" href="/assets/vendor/fonts/iconify-icons.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/node-waves/node-waves.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" />
  <link rel="stylesheet" href="/assets/vendor/css/core.css" />
  <link rel="stylesheet" href="/assets/css/demo.css" />
  <script src="/assets/vendor/js/helpers.js"></script>
    <script src="/assets/js/config.js"></script>
    <style>
      .table-card-header { padding: 1rem 1.25rem 0.5rem 1.25rem; }
      .table-card-toolbar { gap: .5rem; }
      .dataTables_filter input { min-width: 220px; }
      tr.table-empty td:not(:first-child) { display: none !important; }
      tr.table-empty td:first-child { width: 100%; text-align: center; padding: 1.25rem; color: var(--bs-secondary-color); background: var(--bs-body-bg); }
      .pin-btn { min-width: 92px; display: inline-flex; align-items: center; justify-content: center; gap: .35rem; }
      .pin-btn.btn-warning { background-color: #fef3c7; border-color: #facc15; }
    </style>
</head>

<body>
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <%- include("../../partials/menu") %>
      <div class="layout-page">
        <%- include("../../partials/navbar") %>
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
              <div>
                <h4 class="mb-1">Berita</h4>
                <p class="text-muted mb-0">Kelola berita kampus.</p>
              </div>
              <div class="d-flex align-items-center gap-3">
                <span class="badge bg-label-primary px-3 py-2">Total: <%= news ? news.length : 0 %></span>
                <a class="btn btn-primary" href="/admin/news/new"><i class="ri ri-add-line me-1"></i>Tambah</a>
              </div>
            </div>

            <div class="card shadow-sm">
              <div class="table-responsive p-4">
                <table id="newsTable" class="table align-middle">
                  <thead class="table-dark">
                    <tr>
                      <th style="width:50px" class="text-center">No.</th>
                      <th>Judul</th>
                      <th style="width:90px" class="text-center">Pin</th>
                      <th>Status</th>
                      <th>Tags</th>
                      <th>Featured</th>
                      <th>Dibuat</th>
                      <th>Diperbarui</th>
                      <th class="text-end">Aksi</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (news && news.length) { %>
                    <% news.forEach(function(item, idx){ %>
                    <tr>
                      <td class="text-center"><%= idx + 1 %></td>
                      <td class="fw-semibold"><%= item.title %></td>
                      <td class="text-center pin-cell" data-order="<%= item.pinned ? 1 : 0 %>">
                        <button
                          type="button"
                          class="btn btn-sm pin-btn <%= item.pinned ? 'btn-warning text-dark' : 'btn-outline-secondary' %> pin-toggle"
                          data-url="/admin/news/<%= item._id %>/pin"
                          data-title="<%= item.title %>"
                          data-pinned="<%= !!item.pinned %>">
                          <i class="ri <%= item.pinned ? 'ri-pushpin-2-fill' : 'ri-pushpin-line' %> pin-icon"></i>
                          <span class="pin-label"><%= item.pinned ? 'Pinned' : 'Pin' %></span>
                        </button>
                      </td>
                      <td><span class="badge bg-label-<%= item.status === 'published' ? 'success' : 'secondary' %>"><%= item.status %></span></td>
                      <td>
                        <% const cleanTags = (() => {
                             const out = [];
                             (item.tags || []).forEach(t => {
                               if (t && typeof t === 'object') {
                                 const val = String(t.value || t.val || '').trim();
                                 if (val) out.push(val);
                                 return;
                               }
                               if (typeof t === 'string') {
                                 const text = t.trim();
                                 const matches = text.match(/\"?value\"?\s*:\s*\"([^\"]*)\"/gi);
                                 if (matches && matches.length) {
                                   matches.forEach(m => {
                                     const v = m.replace(/.*\"?value\"?\s*:\s*\"([^\"]*)\".*/, '$1').trim();
                                     if (v) out.push(v);
                                   });
                                   return;
                                 }
                                 text
                                   .replace(/[\[\]{}"]/g, ' ')
                                   .split(/[\s,]+/)
                                   .map(v => v.trim())
                                   .filter(Boolean)
                                   .forEach(v => out.push(v));
                               }
                             });
                             return out.filter(Boolean);
                           })(); %>
                        <% if (cleanTags.length) { %>
                          <% cleanTags.slice(0,3).forEach(function(t){ %>
                            <span class="badge bg-label-primary me-1"><%= t %></span>
                          <% }); %>
                          <% if (cleanTags.length > 3) { %><small class="text-muted">+<%= cleanTags.length - 3 %></small><% } %>
                        <% } else { %>
                          <span class="text-muted">-</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (item.featuredImage) { %>
                          <img src="<%= item.featuredImage %>" alt="thumb" class="rounded" style="width:70px;height:50px;object-fit:cover;">
                        <% } else { %>
                          <span class="text-muted">-</span>
                        <% } %>
                      </td>
                      <td data-order="<%= item.createdAt ? item.createdAt.getTime() : 0 %>">
                        <div><%= item.createdAt ? item.createdAt.toLocaleDateString() : '-' %></div>
                        <small class="text-muted"><%= item.createdBy ? (item.createdBy.name || item.createdBy.email || '') : '' %></small>
                      </td>
                      <td>
                        <div><%= item.updatedAt ? item.updatedAt.toLocaleDateString() : '-' %></div>
                        <small class="text-muted"><%= item.updatedBy ? (item.updatedBy.name || item.updatedBy.email || '') : '' %></small>
                      </td>
                      <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary me-2" href="/admin/news/<%= item._id %>/edit">
                          <i class="ri ri-pencil-line"></i>
                        </a>
                              <form action="/admin/news/<%= item._id %>/delete" method="POST" class="d-inline" data-disable-submit>
                                <button class="btn btn-sm btn-outline-danger" type="submit">
                                  <i class="ri ri-delete-bin-line"></i>
                                </button>
                              </form>
                      </td>
                    </tr>
                    <% }); %>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
          <div class="content-backdrop fade"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="layout-overlay layout-menu-toggle"></div>
  <div class="drag-target"></div>

  <script src="/assets/vendor/libs/jquery/jquery.js"></script>
  <script src="/assets/vendor/libs/popper/popper.js"></script>
  <script src="/assets/vendor/js/bootstrap.js"></script>
  <script src="/assets/vendor/libs/node-waves/node-waves.js"></script>
  <script src="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
  <script src="/assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
  <script src="/assets/vendor/js/menu.js"></script>
  <script src="/assets/js/main.js"></script>
  <script>
    $(function () {
      const table = $('#newsTable');
      if (!table.length) return;
      const dt = table.DataTable({
        responsive: true,
        pageLength: 10,
        order: [[6, 'desc']],
        orderFixed: [[2, 'desc']],
        columnDefs: [
          { targets: [0, 8], orderable: false, searchable: false },
          { targets: [2], searchable: false }
        ],
        language: { searchPlaceholder: 'Cari berita...', search: '', lengthMenu: 'Tampilkan _MENU_', emptyTable: 'Belum ada berita.' },
        dom: '<"row align-items-center mb-3"<"col-md-6"l><"col-md-6 text-md-end"f>>t<"row align-items-center mt-3"<"col-md-6"i><"col-md-6 text-md-end"p>>'
      });
      dt.on('order.dt search.dt', function () {
        let i = 1;
        dt.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell) {
          cell.innerHTML = i++;
        });
      }).draw();
      const wrapper = table.closest('.dataTables_wrapper');
      wrapper.find('.dataTables_filter input').addClass('form-control form-control-sm');
      wrapper.find('.dataTables_length select').addClass('form-select form-select-sm');

      table.on('click', '.pin-toggle', function () {
        const btn = $(this);
        const pinCell = btn.closest('.pin-cell');
        const url = btn.data('url');
        const title = btn.data('title') || 'Berita';
        const willPin = btn.data('pinned') !== true;
        const previous = btn.data('pinned') === true;

        const setVisual = pinned => {
          btn.data('pinned', pinned);
          pinCell.attr('data-order', pinned ? 1 : 0);
          btn.toggleClass('btn-warning text-dark', pinned);
          btn.toggleClass('btn-outline-secondary', !pinned);
          btn.find('.pin-icon').toggleClass('ri-pushpin-2-fill', pinned).toggleClass('ri-pushpin-line', !pinned);
          btn.find('.pin-label').text(pinned ? 'Pinned' : 'Pin');
        };

        btn.prop('disabled', true);
        fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ pinned: willPin })
        })
          .then(async res => {
            const data = await res.json().catch(() => ({}));
            if (!res.ok || !data.success) {
              throw new Error(data.message || 'Gagal memperbarui pin berita.');
            }
            setVisual(willPin);
            dt.order([[6, 'desc']]).draw(false);
            Swal.fire({
              icon: 'success',
              title: 'Berhasil',
              text: data.message || `${title} diperbarui.`,
              timer: 1400,
              showConfirmButton: false
            });
          })
          .catch(err => {
            setVisual(previous);
            Swal.fire({
              icon: 'error',
              title: 'Gagal',
              text: err.message || 'Gagal memperbarui pin berita.'
            });
          })
          .finally(() => btn.prop('disabled', false));
      });
    });
  </script>
</body>

</html>
