<!doctype html>
<html
  lang="en"
  class="layout-navbar-fixed layout-menu-fixed layout-compact"
  dir="ltr"
  data-skin="default"
  data-bs-theme="light"
  data-assets-path="/assets/"
  data-template="vertical-menu-template">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || 'Edit Berita' %></title>
  <link rel="icon" type="image/x-icon" href="/assets/img/favicon/favicon.ico" />
  <link rel="stylesheet" href="/assets/vendor/fonts/iconify-icons.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/node-waves/node-waves.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
  <link rel="stylesheet" href="/assets/vendor/css/core.css" />
  <link rel="stylesheet" href="/assets/css/demo.css" />
  <script src="/assets/vendor/js/helpers.js"></script>
  <script src="/assets/js/config.js"></script>
  <link rel="stylesheet" href="/assets/vendor/libs/tagify/tagify.css" />

  <link rel="stylesheet" href="https://uicdn.toast.com/editor/latest/toastui-editor.min.css" />
  <style>
    .toastui-editor-defaultUI {
      border-radius: 12px;
      overflow: hidden;
    }
  </style>
</head>

<body>
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <%- include("../../partials/menu") %>
      <div class="layout-page">
        <%- include("../../partials/navbar") %>
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
              <div>
                <h4 class="mb-1">Edit Berita</h4>
                <p class="text-muted mb-0">Perbarui konten berita.</p>
              </div>
              <a class="btn btn-outline-secondary" href="/admin/news"><i class="ri ri-arrow-left-line me-1"></i>Kembali</a>
            </div>
            <% if (error) { %>
              <div class="alert alert-danger d-flex align-items-center gap-2">
                <i class="ri-error-warning-line fs-5"></i>
                <span><%= error %></span>
              </div>
            <% } %>

            <form method="POST" action="/admin/news/<%= values._id %>" enctype="multipart/form-data" data-disable-submit>
              <div class="row gy-4">
                <div class="col-xl-8">
                  <div class="card shadow-sm">
                    <div class="card-body">
                      <div class="mb-3">
                        <label class="form-label fw-semibold">Judul</label>
                        <input type="text" name="title" class="form-control form-control-lg" placeholder="Tulis judul" required value="<%= values.title || '' %>">
                        <small class="text-muted">Judul akan menjadi slug otomatis.</small>
                      </div>
                      <div class="mb-3">
                        <label class="form-label fw-semibold">Konten</label>
                        <input type="hidden" id="bodyInput" name="body" value="">
                        <div id="editor" class="border rounded" aria-label="Editor konten"></div>
                        <small class="text-muted">Tambahkan teks, gambar, video (embed), tabel, dan tautan.</small>
                      </div>
                      <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="pinSwitch" name="pinned" value="true" <%= values.pinned ? 'checked' : '' %>>
                        <label class="form-check-label fw-semibold" for="pinSwitch">Pin Berita</label>
                        <div class="text-muted small">Maksimal 4 berita bisa di-pin. Unpin yang lain jika batas tercapai.</div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="col-xl-4">
                  <div class="position-sticky" style="top: 92px;">
                    <div class="card shadow-sm mb-4">
                      <div class="card-header d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">Publikasi</h6>
                        <span class="badge bg-label-secondary text-uppercase"><%= values.status || 'draft' %></span>
                      </div>
                      <div class="card-body">
                        <div class="mb-3">
                          <label class="form-label">Status</label>
                          <select class="form-select" name="status">
                            <option value="draft" <%= values.status === 'draft' ? 'selected' : '' %>>Draft</option>
                            <option value="published" <%= values.status === 'published' ? 'selected' : '' %>>Published</option>
                          </select>
                        </div>
                        <div class="mb-3">
                          <label class="form-label">Tags</label>
                          <div class="form-floating form-floating-outline">
                            <input id="TagifyBasic" class="form-control" name="tags" value="<%= values.tags ? values.tags.join(',') : '' %>" />
                            <label for="TagifyBasic"></label>
                          </div>
                          <small class="text-muted">Tekan Enter setelah setiap tag.</small>
                        </div>
                        <div class="mb-3">
                          <label class="form-label">Featured Image</label>
                          <% if (values.featuredImage) { %>
                            <div class="mb-2">
                              <img id="featuredPreview" src="<%= values.featuredImage %>" alt="featured" class="rounded border w-100" style="max-height: 180px; object-fit: cover;">
                            </div>
                          <% } else { %>
                            <img id="featuredPreview" src="/assets/img/illustrations/placeholder-light.png" alt="preview" class="rounded border w-100 mb-2" style="max-height: 180px; object-fit: cover;">
                          <% } %>
                          <input type="file" id="featuredInput" name="featuredImage" accept="image/*" class="form-control">
                          <small class="text-muted d-block">Biarkan kosong jika tidak ingin mengganti.</small>
                        </div>
                        <div class="d-flex gap-2">
                          <button type="submit" class="btn btn-primary flex-grow-1">Simpan Perubahan</button>
                          <a href="/admin/news" class="btn btn-outline-secondary">Batal</a>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </form>
          </div>
          <div class="content-backdrop fade"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="layout-overlay layout-menu-toggle"></div>
  <div class="drag-target"></div>

  <script src="/assets/vendor/libs/jquery/jquery.js"></script>
  <script src="/assets/vendor/libs/popper/popper.js"></script>
  <script src="/assets/vendor/js/bootstrap.js"></script>
  <script src="/assets/vendor/libs/node-waves/node-waves.js"></script>
  <script src="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
  <script src="/assets/vendor/js/menu.js"></script>
  <script src="/assets/js/main.js"></script>

   <!-- Vendor JS -->
   <script src="/assets/vendor/libs/tagify/tagify.js"></script>

  <!-- Page JS -->
  <script src="/assets/js/forms-tagify.js"></script>
  <script src="https://uicdn.toast.com/editor/latest/toastui-editor-all.min.js"></script>
  <script>
    const bodyInput = document.getElementById('bodyInput');
    const initialHtml = <%- JSON.stringify(values.body || '') %>;
    const editor = new toastui.Editor({
      el: document.querySelector('#editor'),
      height: '460px',
      initialEditType: 'wysiwyg',
      previewStyle: 'vertical',
      initialValue: initialHtml || '',
      usageStatistics: false,
      toolbarItems: [
        ['heading', 'bold', 'italic', 'strike'],
        ['hr', 'quote'],
        ['ul', 'ol', 'task'],
        ['table', 'link'],
        ['image', 'code', 'codeblock'],
        ['scrollSync']
      ]
    });
    const syncBody = () => { if (bodyInput) bodyInput.value = editor.getHTML(); };
    editor.on('change', syncBody);
    const form = document.querySelector('form[data-disable-submit]') || document.querySelector('form');
    if (form) form.addEventListener('submit', syncBody);

    const input = document.getElementById('featuredInput');
    const preview = document.getElementById('featuredPreview') || document.createElement('img');
    input.addEventListener('change', () => {
      const file = input.files && input.files[0];
      if (!file) return;
      if (!preview.id) {
        preview.id = 'featuredPreview';
        preview.className = 'rounded border mt-2';
        preview.style.maxWidth = '240px';
        preview.style.maxHeight = '150px';
        preview.style.objectFit = 'cover';
        input.insertAdjacentElement('afterend', preview);
      }
      const reader = new FileReader();
      reader.onload = e => { preview.src = e.target.result; };
      reader.readAsDataURL(file);
    });
  </script>
</body>

</html>
