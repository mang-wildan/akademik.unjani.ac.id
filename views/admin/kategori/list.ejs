<div data-list-region>
  <%- include('../_ui/page-header', { heading: 'Kategori', count: pagination.total, actions: [{ label: 'Tambah Kategori', href: `/admin/kategori/new?jenis=${state.jenis}`, buttonIcon: 'add', slideOver: true, shortcut: 'new' }] }) %>
  <div data-bulk-list x-data="bulkBar" x-on:table-selection="selection" x-bind:data-bulk-active="active" class="rounded-card border border-line bg-surface">
    <%- include('../_ui/bulk-bar', { id: 'bulk-kategori', action: '/admin/kategori/bulk', noun: 'kategori', total: pagination.total, state, actions: [{ value: 'activate', label: 'Aktifkan' }, { value: 'deactivate', label: 'Nonaktifkan' }, { value: 'delete', label: 'Hapus' }] }) %>
    <%- include('../_ui/filter-bar', {
      state, searchLabel: 'Cari nama kategori',
      statusTabs: { name: 'jenis', label: 'Jenis kategori', options: Object.entries(jenisLabel).map(([value, label]) => ({ value, label })) },
      filters: [{ name: 'isActive', label: 'Status', options: [{ value: 'true', label: 'Aktif' }, { value: 'false', label: 'Nonaktif' }] }],
    }) %>
    <% if (items.length) { %>
      <%- include('../_ui/data-table', {
        caption: `Daftar kategori ${jenisLabel[state.jenis]}`, items, state, bulkForm: 'bulk-kategori',
        columns: [
          { key: 'nama', label: 'Nama', sortable: true },
          { key: 'urutan', label: 'Urutan', sortable: true },
          { key: 'isActive', label: 'Status', cell: item => include('../_ui/badge', { text: item.isActive ? 'Aktif' : 'Nonaktif', tone: item.isActive ? 'success' : 'neutral' }) },
        ],
        rowHref: item => `/admin/kategori/${item._id}/edit`, slideOver: true,
        actions: item => include('../_ui/kategori-actions', { item }),
      }) %>
    <% } else { %>
      <%- include('../_ui/empty-state', {
        text: state.q || state.isActive ? 'Tidak ada kategori yang cocok.' : `Belum ada kategori ${jenisLabel[state.jenis].toLowerCase()}.`,
        emptyIcon: 'filter_list',
        action: state.q || state.isActive ? { label: 'Hapus filter', href: `?jenis=${state.jenis}` } : { label: 'Tambah Kategori', href: `/admin/kategori/new?jenis=${state.jenis}`, slideOver: true },
      }) %>
    <% } %>
    <%- include('../_ui/pagination', { ...pagination, state, noun: 'kategori' }) %>
  </div>
</div>
<%- include('../_ui/slide-over', { editUrl: '/admin/kategori/:id/edit', newUrl: '/admin/kategori/new' }) %>
