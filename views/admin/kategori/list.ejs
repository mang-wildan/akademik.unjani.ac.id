<%# Kategori — satu halaman, tab per jenis (Pengumuman/Dokumen/Berita). FR-M-11. %>
<%- include('../../components/page-header', { admin: true, heading: 'Kategori', lead: 'Master data kategori untuk filter di halaman publik.', breadcrumb: [{ label: 'Kategori' }], actions: [{ label: 'Tambah Kategori', href: `/admin/kategori/new?jenis=${jenis}`, icon: 'add' }] }) %>

<nav class="mb-4 flex gap-1" aria-label="Jenis kategori">
  <% ['pengumuman', 'dokumen', 'berita'].forEach(j => { %>
    <a href="?jenis=<%= j %>" class="btn <%= jenis === j ? 'btn-primary' : 'btn-secondary' %>"<%- jenis === j ? ' aria-current="page"' : '' %>><%= jenisLabel[j] %></a>
  <% }) %>
</nav>

<div class="card">
  <% if (!items.length) { %>
    <div class="p-6">
      <%- include('../../components/empty-state', { emptyIcon: 'filter_list', emptyTitle: `Belum ada kategori ${jenisLabel[jenis].toLowerCase()}`, emptyAction: { label: 'Tambah Kategori', href: `/admin/kategori/new?jenis=${jenis}` } }) %>
    </div>
  <% } else { %>
  <table class="data-table data-table--stack">
    <caption class="sr-only">Daftar kategori <%= jenisLabel[jenis] %></caption>
    <thead><tr><th scope="col">Nama</th><th scope="col">Urutan</th><th scope="col">Status</th><th scope="col"><span class="sr-only">Aksi</span></th></tr></thead>
    <tbody>
      <% items.forEach(item => { %>
        <tr data-updated="<%= item.updatedAt ? new Date(item.updatedAt).toISOString() : '' %>">
          <td data-label="Nama"><span class="line-clamp-1 font-medium"><%= item.nama %></span></td>
          <td data-label="Urutan"><%= item.urutan %></td>
          <td data-label="Status"><%- include('../../components/badge', { text: item.isActive ? 'Aktif' : 'Nonaktif', tone: item.isActive ? 'success' : 'neutral' }) %></td>
          <td data-label="Aksi">
            <div class="flex items-center gap-1 md:justify-end">
              <a href="/admin/kategori/<%= item._id %>/edit" class="btn btn-secondary px-3" aria-label="Ubah <%= item.nama %>"><%- icon('edit') %>Ubah</a>
              <button type="button" class="btn-icon text-danger hover:bg-danger-soft" data-dialog-open="hapus-<%= item._id %>" aria-label="Hapus <%= item.nama %>"><%- icon('delete') %></button>
            </div>
            <%- include('../../components/confirm-dialog', {
              dialogId: `hapus-${item._id}`, dialogTitle: `Hapus kategori ${item.nama}?`,
              dialogText: 'Konten yang memakai kategori ini akan tampil tanpa kategori. Tindakan ini tidak bisa dibatalkan.',
              action: `/admin/kategori/${item._id}/delete`, confirmLabel: 'Hapus',
            }) %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
