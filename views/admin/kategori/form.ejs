<% const heading = mode === 'edit' ? 'Ubah Kategori' : 'Tambah Kategori'; const back = `/admin/kategori?jenis=${Object.hasOwn(jenisLabel, values.jenis) ? values.jenis : 'pengumuman'}`; %>
<% if (!locals.partial) { %><%- include('../_ui/page-header', { heading }) %><% } %>
<form method="POST" action="/admin/kategori<%= mode === 'edit' ? `/${item._id}` : '' %>" data-save-form data-panel-title="<%= heading %>"
      x-data="dirtyGuard" x-on:input="mark" x-on:change="mark" x-on:submit="submitted" x-on:beforeunload.window="beforeUnload"
      class="<%= locals.partial ? '' : 'max-w-form rounded-card border border-line bg-surface' %>">
  <div class="space-y-5 p-4">
    <%- include('../_ui/error-summary', { errors }) %>
    <%- include('../_ui/field', { name: 'jenis', label: 'Jenis', type: 'select', required: true, value: values.jenis, error: errors.jenis, options: Object.entries(jenisLabel).map(([value, label]) => ({ value, label })) }) %>
    <%- include('../_ui/field', { name: 'nama', label: 'Nama kategori', required: true, value: values.nama, error: errors.nama, help: 'Maksimal 60 karakter.' }) %>
    <%- include('../_ui/field', { name: 'urutan', label: 'Urutan tampil', type: 'number', value: values.urutan ?? 0, error: errors.urutan, min: 0, max: 999 }) %>
    <%- include('../_ui/field', { name: 'isActive', label: 'Aktif', type: 'checkbox', checked: Boolean(values.isActive), error: errors.isActive, help: 'Nonaktifkan untuk menyembunyikan kategori dari filter publik.' }) %>
  </div>
  <div class="form-actions<%= locals.partial ? '' : ' max-lg:bottom-[calc(4rem+env(safe-area-inset-bottom))]' %>">
    <a href="<%= back %>" data-slide-close class="btn btn-secondary">Batal</a>
    <%- include('../_ui/button', { label: 'Simpan', type: 'submit', buttonIcon: 'check', title: 'Simpan (Ctrl+S)' }) %>
  </div>
</form>
