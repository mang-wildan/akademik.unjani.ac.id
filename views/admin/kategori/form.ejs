<%- include('../../components/page-header', { admin: true, heading: mode === 'edit' ? 'Ubah Kategori' : 'Tambah Kategori', breadcrumb: [{ label: 'Kategori', href: `/admin/kategori?jenis=${values.jenis}` }, { label: mode === 'edit' ? 'Ubah Kategori' : 'Tambah Kategori' }] }) %>

<form method="POST" action="/admin/kategori<%= mode === 'edit' ? `/${item._id}` : '' %>" class="card card-body grid max-w-xl gap-5">
  <%- include('../../components/form-field', {
    name: 'jenis', label: 'Jenis', type: 'select', required: true, value: values.jenis, error: errors.jenis,
    options: Object.entries(jenisLabel).map(([value, label]) => ({ value, label })),
  }) %>
  <%- include('../../components/form-field', { name: 'nama', label: 'Nama Kategori', required: true, value: values.nama, error: errors.nama }) %>
  <%- include('../../components/form-field', { name: 'urutan', label: 'Urutan Tampil', type: 'number', value: values.urutan, error: errors.urutan, min: 0, max: 999 }) %>
  <div class="flex min-h-11 items-center gap-2">
    <input type="checkbox" id="f-isActive" name="isActive" value="on" <%= values.isActive === undefined || values.isActive ? 'checked' : '' %> class="size-6 shrink-0 rounded border-control text-primary focus:ring-primary">
    <label for="f-isActive" class="text-sm font-medium">Aktif <span class="text-muted">(nonaktifkan untuk sembunyikan dari filter publik)</span></label>
  </div>
  <div class="flex justify-end gap-2 border-t border-line pt-5">
    <a href="/admin/kategori?jenis=<%= values.jenis %>" class="btn btn-secondary">Batal</a>
    <button type="submit" class="btn btn-primary">Simpan</button>
  </div>
</form>
