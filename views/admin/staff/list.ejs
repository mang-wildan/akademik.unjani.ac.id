<%# Daftar Pimpinan & Staf — FR-M-09. NIP ditampilkan di sini (internal), tidak pernah di publik (K-05). %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold">Pimpinan &amp; Staf</h1>
    <p class="text-muted">Kelola struktur kepemimpinan dan staf yang tampil di situs publik.</p>
  </div>
  <a href="/admin/staff/new" class="btn btn-primary"><%- icon('add') %>Tambah Staf</a>
</div>

<div class="card">
  <% if (!items.length) { %>
    <div class="p-6">
      <%- include('../../components/empty-state', { emptyIcon: 'groups', emptyTitle: 'Belum ada data staf', emptyAction: { label: 'Tambah Staf', href: '/admin/staff/new' } }) %>
    </div>
  <% } else { %>
  <table class="data-table data-table--stack">
    <caption class="sr-only">Daftar pimpinan dan staf</caption>
    <thead><tr><th scope="col">Foto</th><th scope="col">Nama</th><th scope="col">Jabatan</th><th scope="col">Kelompok</th><th scope="col">Urutan</th><th scope="col"><span class="sr-only">Aksi</span></th></tr></thead>
    <tbody>
      <% items.forEach(item => { %>
        <tr>
          <td data-label="Foto"><img src="<%= item.foto %>" alt="" class="size-12 shrink-0 rounded-full border border-line object-cover"></td>
          <td data-label="Nama"><span class="line-clamp-1 font-medium"><%= item.gelar ? `${item.gelar} ` : '' %><%= item.nama %></span></td>
          <td data-label="Jabatan"><%= item.jabatan %></td>
          <td data-label="Kelompok"><span class="badge badge-neutral"><%= item.kelompok === 'pimpinan' ? 'Pimpinan' : 'Staf' %></span></td>
          <td data-label="Urutan"><%= item.nomorUrut %></td>
          <td data-label="Aksi">
            <div class="flex items-center gap-1 md:justify-end">
              <a href="/admin/staff/<%= item._id %>/edit" class="btn btn-secondary px-3" aria-label="Ubah <%= item.nama %>"><%- icon('edit') %>Ubah</a>
              <button type="button" class="btn-icon text-danger hover:bg-danger-soft" data-dialog-open="hapus-<%= item._id %>" aria-label="Hapus <%= item.nama %>"><%- icon('delete') %></button>
            </div>
            <%- include('../../components/confirm-dialog', {
              dialogId: `hapus-${item._id}`, dialogTitle: `Hapus ${item.nama}?`,
              dialogText: 'Data staf ini akan dihapus permanen dan tidak bisa dikembalikan.',
              action: `/admin/staff/${item._id}/delete`, confirmLabel: 'Hapus',
            }) %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
