<!doctype html>
<html
  lang="id"
  class="layout-navbar-fixed layout-menu-fixed layout-compact"
  dir="ltr"
  data-skin="default"
  data-bs-theme="light"
  data-assets-path="/assets/"
  data-template="vertical-menu-template">  
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Edit Staff</title>
    <link rel="icon" type="image/x-icon" href="/assets/img/favicon/favicon.ico" />
    <link rel="stylesheet" href="/assets/vendor/fonts/iconify-icons.css" />
    <link rel="stylesheet" href="/assets/vendor/libs/node-waves/node-waves.css" />
    <link rel="stylesheet" href="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="/assets/vendor/css/core.css" />
    <link rel="stylesheet" href="/assets/css/demo.css" />
    <script src="/assets/vendor/js/helpers.js"></script>
    <script src="/assets/js/config.js"></script>
  </head>
  <body>
    <div class="layout-wrapper layout-content-navbar">
      <div class="layout-container">
        <%- include("../../partials/menu") %>
        <div class="layout-page">
          <%- include("../../partials/navbar") %>
          <div class="content-wrapper">
            <div class="container-xxl flex-grow-1 container-p-y">
              <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                  <h4 class="mb-1">Edit Staff</h4>
                  <p class="text-muted mb-0">Perbarui data staff.</p>
                </div>
                <a href="/admin/staff" class="btn btn-light border"><i class="ri ri-arrow-left-line me-1"></i>Kembali</a>
              </div>

              <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger"><%= error %></div>
              <% } %>

              <div class="card shadow-sm">
                <div class="card-body">
                  <form action="/admin/staff/<%= values._id %>" method="POST" enctype="multipart/form-data" class="row g-4" data-disable-submit>
                    <div class="col-md-6">
                      <label class="form-label">Nama</label>
                      <input type="text" name="nama" class="form-control" value="<%= values.nama || '' %>" required>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">NIP / NID</label>
                      <input type="text" name="nip" class="form-control" value="<%= values.nip || '' %>" required>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Jabatan</label>
                      <input type="text" name="jabatan" class="form-control" value="<%= values.jabatan || '' %>" required>
                    </div>
                    <div class="col-md-3">
                      <label class="form-label">Nomor Urut</label>
                      <input type="number" name="nomorUrut" class="form-control" value="<%= values.nomorUrut || 0 %>">
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Foto (JPG/PNG)</label>
                      <input type="file" name="foto" accept="image/jpeg,image/png,image/jpg" class="form-control">
                      <small class="text-muted d-block">Kosongkan bila tidak ingin mengganti.</small>
                      <% if (values.foto) { %>
                        <div class="mt-2">
                          <span class="text-muted small d-block mb-1">Foto saat ini:</span>
                          <img src="<%= values.foto %>" alt="foto" class="rounded border" style="width:120px;height:120px;object-fit:cover;">
                        </div>
                      <% } %>
                    </div>
                    <div class="col-12">
                      <button type="submit" class="btn btn-primary"><i class="ri ri-save-line me-1"></i>Simpan Perubahan</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
            <div class="content-backdrop fade"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="layout-overlay layout-menu-toggle"></div>
    <div class="drag-target"></div>

    <script src="/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="/assets/vendor/libs/popper/popper.js"></script>
    <script src="/assets/vendor/js/bootstrap.js"></script>
    <script src="/assets/vendor/libs/node-waves/node-waves.js"></script>
    <script src="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="/assets/vendor/js/menu.js"></script>
    <script src="/assets/js/main.js"></script>
  </body>
</html>
