<div class="mb-6">
  <a href="/admin/staff" class="mb-2 inline-flex min-h-6 items-center gap-1 text-sm font-medium text-muted hover:text-ink"><%- icon('arrow_back', 'size-4') %>Kembali ke Pimpinan &amp; Staf</a>
  <h1 class="text-2xl font-bold"><%= mode === 'edit' ? 'Ubah Staf' : 'Tambah Staf' %></h1>
</div>

<form method="POST" action="/admin/staff<%= mode === 'edit' ? `/${item._id}` : '' %>" enctype="multipart/form-data" class="card card-body grid gap-5 md:grid-cols-2">
  <%- include('../../components/form-field', { name: 'nama', label: 'Nama', required: true, value: values.nama, error: errors.nama }) %>
  <%- include('../../components/form-field', { name: 'gelar', label: 'Gelar', value: values.gelar, error: errors.gelar, help: 'Opsional, ditampilkan di depan nama.' }) %>
  <%- include('../../components/form-field', { name: 'jabatan', label: 'Jabatan', required: true, value: values.jabatan, error: errors.jabatan }) %>
  <%- include('../../components/form-field', {
    name: 'kelompok', label: 'Kelompok', type: 'select', required: true, value: values.kelompok, error: errors.kelompok,
    options: [{ value: 'pimpinan', label: 'Pimpinan' }, { value: 'staf', label: 'Staf' }],
  }) %>
  <%- include('../../components/form-field', { name: 'email', label: 'Email', type: 'email', value: values.email, error: errors.email, help: 'Opsional.' }) %>
  <%- include('../../components/form-field', { name: 'nomorUrut', label: 'Urutan Tampil', type: 'number', value: values.nomorUrut, error: errors.nomorUrut, min: 0, max: 999 }) %>
  <%- include('../../components/form-field', { name: 'nip', label: 'NIP/NID', value: values.nip, error: errors.nip, help: 'Internal saja — tidak pernah tampil di situs publik.' }) %>
  <div class="md:col-span-2">
    <%- include('../../components/file-upload', {
      name: 'foto', label: 'Foto', accept: 'image/jpeg,image/png', error: errors.foto,
      limitText: 'JPG/PNG, maks. 5 MB.', current: (mode === 'edit' && item.foto) ? { label: 'Foto saat ini', href: item.foto } : null,
    }) %>
  </div>
  <div class="flex justify-end gap-2 border-t border-line pt-5 md:col-span-2">
    <a href="/admin/staff" class="btn btn-secondary">Batal</a>
    <button type="submit" class="btn btn-primary">Simpan</button>
  </div>
</form>
