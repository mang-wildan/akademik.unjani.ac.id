<% const heading=mode==='edit'?'Ubah Staf':'Tambah Staf'; %>
<% if(!locals.partial){ %><%- include('../_ui/page-header',{heading}) %><% } %>
<form method="POST" action="/admin/staff<%= mode === 'edit' ? `/${item._id}` : '' %>" enctype="multipart/form-data" data-save-form data-panel-title="<%= heading %>" x-data="dirtyGuard" x-on:input="mark" x-on:change="mark" x-on:submit="submitted" x-on:beforeunload.window="beforeUnload" class="<%= locals.partial?'':'max-w-form space-y-6' %>">
<section class="form-panel space-y-5">
  <h2 class="font-serif text-lg">Identitas</h2>
<%- include('../_ui/error-summary',{errors}) %>
  <%- include('../_ui/field', { name: 'nama', label: 'Nama', required: true, value: values.nama, error: errors.nama }) %>
  <%- include('../_ui/field', { name: 'gelar', label: 'Gelar', value: values.gelar, error: errors.gelar, help: 'Opsional, ditampilkan di depan nama.' }) %>
  <%- include('../_ui/field', { name: 'nip', label: 'NIP/NID', value: values.nip, error: errors.nip, help: 'Internal saja — tidak pernah tampil di situs publik.' }) %>
  <%- include('../_ui/field', { name: 'email', label: 'Email', type: 'email', value: values.email, error: errors.email, help: 'Opsional.' }) %>
</section>
<section class="form-panel space-y-5">
  <h2 class="font-serif text-lg">Jabatan</h2>
  <%- include('../_ui/field', { name: 'jabatan', label: 'Jabatan', required: true, value: values.jabatan, error: errors.jabatan }) %>
  <%- include('../_ui/field', {
    name: 'tingkat', label: 'Tingkat', type: 'select', required: true, value: values.tingkat, error: errors.tingkat,
    options: TINGKAT, help: 'Menentukan posisi di halaman publik, dari atas ke bawah.',
  }) %>
  <%- include('../_ui/field', { name: 'nomorUrut', label: 'Urutan Tampil', type: 'number', value: values.nomorUrut, error: errors.nomorUrut, min: 0, max: 999 }) %>
</section>
<section class="form-panel space-y-5">
  <h2 class="font-serif text-lg">Foto</h2>
  <div class="min-w-0">
    <%- include('../_ui/upload-field', {
      name: 'foto', label: 'Foto', accept: 'image/jpeg,image/png', error: errors.foto,
      limitText: 'JPG/PNG, maks. 5 MB.', current: (mode === 'edit' && item.foto) ? { label: 'Foto saat ini', href: item.foto } : null,
    }) %>
  </div>
  <% if (mode === 'edit' && item.foto) { %><img src="<%= item.foto %>" alt="Foto saat ini" class="h-32 max-w-full rounded-control object-contain"><% } %>
</section>
<div class="form-actions<%= locals.partial?'':' max-lg:bottom-[calc(4rem+env(safe-area-inset-bottom))]' %>"><a href="/admin/staff" data-slide-close class="btn btn-secondary">Batal</a><%- include('../_ui/button',{label:'Simpan',type:'submit',buttonIcon:'check'}) %></div>
</form>
