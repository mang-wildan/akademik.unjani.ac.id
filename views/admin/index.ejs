<!doctype html>
<html
  lang="en"
  class="layout-navbar-fixed layout-menu-fixed layout-compact"
  dir="ltr"
  data-skin="default"
  data-bs-theme="light"
  data-assets-path="/assets/"
  data-template="vertical-menu-template">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Dashboard | Arsip Akademik</title>

    <link rel="icon" type="image/x-icon" href="<%= (siteSetting && siteSetting.favicon) ? siteSetting.favicon : '/assets/img/favicon/favicon.ico' %>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="/assets/vendor/fonts/iconify-icons.css" />
    <link rel="stylesheet" href="/assets/vendor/libs/node-waves/node-waves.css" />
    <link rel="stylesheet" href="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="/assets/vendor/css/core.css" />
    <link rel="stylesheet" href="/assets/css/demo.css" />
    <style>
      .stat-card { border: 0; color: #fff; position: relative; overflow: hidden; }
      .stat-card .badge { background: rgba(255,255,255,.18); }
      .stat-card .blur-shape { position: absolute; width: 180px; height: 180px; border-radius: 50%; filter: blur(40px); opacity: 0.35; right: -40px; top: -40px; }
      .list-group-item small { display: block; }
      .mini-btn { border-radius: 12px; }
      .pill { border-radius: 999px; padding: 4px 10px; font-size: 12px; }
      .timeline-dot { width: 10px; height: 10px; border-radius: 50%; }
      .avatar.icon-center { display: inline-flex; align-items: center; justify-content: center; }
    </style>

    <script src="/assets/vendor/js/helpers.js"></script>
    <script src="/assets/vendor/js/template-customizer.js"></script>
    <script src="/assets/js/config.js"></script>
  </head>

  <body>
    <div class="layout-wrapper layout-content-navbar">
      <div class="layout-container">
        <%- include("../partials/menu") %>
        <div class="layout-page">
          <%- include("../partials/navbar") %>

          <div class="content-wrapper">
            <div class="container-xxl flex-grow-1 container-p-y">
              <% const fmt = d => (d ? new Date(d).toLocaleDateString('id-ID') : '-'); %>

              <div class="row g-4 mb-4">
                <% const statCards = [
                  { title: 'Books', value: stats?.bookCount, desc: 'Koleksi buku digital', icon: 'ri-book-2-line', class: 'bg-gradient-primary' },
                  { title: 'Graduation', value: stats?.gradBookCount, desc: 'Arsip kelulusan', icon: 'ri-graduation-cap-line', class: 'bg-gradient-info' },
                  { title: 'Lulusan', value: stats?.lulusanCount, desc: 'Statistik lulusan', icon: 'ri-bar-chart-2-line', class: 'bg-gradient-primary' },
                  { title: 'Akreditasi', value: stats?.accCount, desc: 'Sertifikat & status', icon: 'ri-medal-2-line', class: 'bg-gradient-success' },
                  { title: 'Kalender', value: stats?.calCount, desc: 'Kalender akademik', icon: 'ri-calendar-event-line', class: 'bg-gradient-warning' },
                  { title: 'Dokumen', value: stats?.docCount, desc: 'Dokumen akademik', icon: 'ri-file-list-3-line', class: 'bg-gradient-danger' },
                  { title: 'Berita', value: stats?.newsCount, desc: 'Berita terbit', icon: 'ri-newspaper-line', class: 'bg-gradient-secondary' },
                  { title: 'Pengumuman', value: stats?.pengumumanCount, desc: 'Pengumuman aktif', icon: 'ri-megaphone-line', class: 'bg-gradient-dark' },
                  { title: 'Staff', value: stats?.staffCount, desc: 'Pimpinan & staff', icon: 'ri-team-line', class: 'bg-gradient-info' },
                ]; %>
                <% statCards.forEach(c => { %>
                  <div class="col-sm-6 col-xl-3">
                    <div class="card stat-card <%= c.class %> shadow-sm h-100">
                      <span class="blur-shape bg-white"></span>
                      <div class="card-body position-relative">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                          <span class="badge text-white"><%= c.title %></span>
                          <span class="badge bg-white text-dark rounded-circle d-flex align-items-center justify-content-center" style="width:34px; height:34px;">
                            <i class="ri <%= c.icon %>"></i>
                          </span>
                        </div>
                        <h3 class="mb-1 text-white"><%= typeof c.value === 'number' ? c.value : '—' %></h3>
                        <p class="mb-0 text-white-75"><%= c.desc %></p>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>

              <div class="row g-4">
                <div class="col-xl-7">
                  <div class="card shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                      <div>
                        <h5 class="mb-1">Update Terbaru</h5>
                        <small class="text-muted">10 aktivitas terakhir lintas modul</small>
                      </div>
                    </div>
                    <div class="list-group list-group-flush">
                      <% if (recentActivities && recentActivities.length) { %>
                        <% recentActivities.forEach(act => { %>
                          <div class="list-group-item d-flex align-items-start justify-content-between">
                            <div class="d-flex align-items-start gap-3">
                              <span class="avatar avatar-sm bg-label-<%= act.color %> icon-center">
                                <i class="ri <%= act.icon %>"></i>
                              </span>
                              <div>
                                <div class="fw-semibold"><%= act.title || 'Item' %></div>
                                <small class="text-muted"><%= act.label %> • <%= fmt(act.date) %></small>
                              </div>
                            </div>
                            <small class="text-muted text-end"><%= act.meta || '' %></small>
                          </div>
                        <% }) %>
                      <% } else { %>
                        <div class="list-group-item text-center text-muted">Data belum tersedia.</div>
                      <% } %>
                    </div>
                  </div>
                </div>

                <div class="col-xl-5">
                  <div class="card shadow-sm h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                      <h5 class="mb-0">Ringkasan Arsip</h5>
                      <small class="text-muted">Status cepat</small>
                    </div>
                    <div class="card-body">
                      <div class="table-responsive">
                        <table class="table table-sm align-middle">
                          <thead>
                            <tr>
                              <th>Kategori</th>
                              <th class="text-end">Total</th>
                              <th class="text-end">Aksi</th>
                            </tr>
                          </thead>
                          <tbody>
                            <tr>
                              <td>Books</td>
                              <td class="text-end fw-semibold"><%= stats ? stats.bookCount : '—' %></td>
                              <td class="text-end"><a href="/admin/books" class="btn btn-sm btn-outline-primary">Kelola</a></td>
                            </tr>
                            <tr>
                              <td>Graduation Books</td>
                              <td class="text-end fw-semibold"><%= stats ? stats.gradBookCount : '—' %></td>
                              <td class="text-end"><a href="/admin/graduation-books" class="btn btn-sm btn-outline-info">Kelola</a></td>
                            </tr>
                            <tr>
                              <td>Lulusan</td>
                              <td class="text-end fw-semibold"><%= stats ? stats.lulusanCount : '—' %></td>
                              <td class="text-end"><a href="/admin/lulusan" class="btn btn-sm btn-outline-primary">Kelola</a></td>
                            </tr>
                            <tr>
                              <td>Akreditasi</td>
                              <td class="text-end fw-semibold"><%= stats ? stats.accCount : '—' %></td>
                              <td class="text-end"><a href="/admin/accreditations" class="btn btn-sm btn-outline-success">Kelola</a></td>
                            </tr>
                            <tr>
                              <td>Kalender Akademik</td>
                              <td class="text-end fw-semibold"><%= stats ? stats.calCount : '—' %></td>
                              <td class="text-end"><a href="/admin/academic-calendars" class="btn btn-sm btn-outline-warning">Kelola</a></td>
                            </tr>
                            <tr>
                              <td>Dokumen Akademik</td>
                              <td class="text-end fw-semibold"><%= stats ? stats.docCount : '—' %></td>
                              <td class="text-end"><a href="/admin/academic-documents" class="btn btn-sm btn-outline-danger">Kelola</a></td>
                            </tr>
                            <tr>
                              <td>Berita</td>
                              <td class="text-end fw-semibold"><%= stats ? stats.newsCount : '—' %></td>
                              <td class="text-end"><a href="/admin/news" class="btn btn-sm btn-outline-primary">Kelola</a></td>
                            </tr>
                            <tr>
                              <td>Pengumuman</td>
                              <td class="text-end fw-semibold"><%= stats ? stats.pengumumanCount : '—' %></td>
                              <td class="text-end"><a href="/admin/pengumuman" class="btn btn-sm btn-outline-secondary">Kelola</a></td>
                            </tr>
                            <tr>
                              <td>Program Studi</td>
                              <td class="text-end fw-semibold"><%= stats ? stats.programStudiCount : '—' %></td>
                              <td class="text-end"><a href="/admin/program-studi" class="btn btn-sm btn-outline-info">Kelola</a></td>
                            </tr>
                            <tr>
                              <td>Staff</td>
                              <td class="text-end fw-semibold"><%= stats ? stats.staffCount : '—' %></td>
                              <td class="text-end"><a href="/admin/staff" class="btn btn-sm btn-outline-primary">Kelola</a></td>
                            </tr>
                            <tr>
                              <td>Dokumen RPL</td>
                              <td class="text-end fw-semibold"><%= stats ? stats.rplDocCount : '—' %></td>
                              <td class="text-end"><a href="/admin/rpl-documents" class="btn btn-sm btn-outline-warning">Kelola</a></td>
                            </tr>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="col-12">
                  <div class="card shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                      <h5 class="mb-0">Koleksi Terbaru per Modul</h5>
                      <small class="text-muted">5 item terakhir masing-masing</small>
                    </div>
                    <div class="card-body">
                      <div class="row g-3">
                        <% const recentGroups = [
                          { title: 'Books', data: latest?.latestBooks, icon: 'ri-book-2-line', color: 'primary' },
                          { title: 'Graduation', data: latest?.latestGradBooks, icon: 'ri-graduation-cap-line', color: 'info' },
                          { title: 'Lulusan', data: latest?.latestLulusan, icon: 'ri-bar-chart-2-line', color: 'primary' },
                          { title: 'Akreditasi', data: latest?.latestAccreditations, icon: 'ri-medal-2-line', color: 'success' },
                          { title: 'Kalender', data: latest?.latestCalendars, icon: 'ri-calendar-event-line', color: 'warning' },
                          { title: 'Dokumen', data: latest?.latestDocuments, icon: 'ri-file-list-3-line', color: 'danger' },
                          { title: 'Berita', data: latest?.latestNews, icon: 'ri-newspaper-line', color: 'secondary' },
                          { title: 'Pengumuman', data: latest?.latestPengumuman, icon: 'ri-megaphone-line', color: 'dark' },
                          { title: 'Staff', data: latest?.latestStaff, icon: 'ri-team-line', color: 'info' },
                          { title: 'Prodi', data: latest?.latestPrograms, icon: 'ri-book-mark-line', color: 'primary' },
                          { title: 'RPL', data: latest?.latestRplDocs, icon: 'ri-stack-line', color: 'info' },
                        ]; %>
                        <% recentGroups.forEach(group => { %>
                          <div class="col-md-6 col-lg-4 col-xl-3">
                            <div class="border rounded p-3 h-100">
                              <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="avatar avatar-sm bg-label-<%= group.color %> icon-center"><i class="ri <%= group.icon %>"></i></span>
                                <strong><%= group.title %></strong>
                              </div>
                              <% if (group.data && group.data.length) { %>
                                <ul class="list-unstyled mb-0 small">
                                  <% group.data.slice(0,5).forEach(item => { %>
                                    <li class="d-flex justify-content-between">
                                      <span class="text-truncate" style="max-width: 150px;">
                                        <%= item.title || item.name || item.tahunAjaran || item.institusi || (item.periode && item.tahun ? item.periode + ' ' + item.tahun : (item.periode || item.tahun)) || 'Item' %>
                                      </span>
                                      <span class="text-muted"><%= fmt(item.createdAt) %></span>
                                    </li>
                                  <% }) %>
                                </ul>
                              <% } else { %>
                                <div class="text-muted small">Belum ada data.</div>
                              <% } %>
                            </div>
                          </div>
                        <% }) %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="content-backdrop fade"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="layout-overlay layout-menu-toggle"></div>
    <div class="drag-target"></div>

    <script src="/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="/assets/vendor/libs/popper/popper.js"></script>
    <script src="/assets/vendor/js/bootstrap.js"></script>
    <script src="/assets/vendor/libs/node-waves/node-waves.js"></script>
    <script src="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="/assets/vendor/js/menu.js"></script>
    <script src="/assets/js/main.js"></script>
  </body>
</html>
