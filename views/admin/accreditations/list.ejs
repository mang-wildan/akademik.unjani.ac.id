<%# Daftar akreditasi — status (Berlaku/Segera berakhir/Kedaluwarsa) selalu dihitung dari berlakuSampai, tidak pernah disimpan. %>
<%- include('../../components/page-header', { admin: true, heading: 'Akreditasi', lead: 'Kelola akreditasi institusi, program studi, dan unit.', breadcrumb: [{ label: 'Akreditasi' }], actions: [{ label: 'Tambah Akreditasi', href: '/admin/accreditations/new', icon: 'add' }] }) %>

<div class="mb-4 grid grid-cols-3 gap-3">
  <%- include('../../components/stat-tile', { statLabel: 'Berlaku', statValue: formatAngka(counts.berlaku), statIcon: 'check_circle' }) %>
  <%- include('../../components/stat-tile', { statLabel: 'Segera berakhir', statValue: formatAngka(counts.segera), statIcon: 'schedule', statTone: counts.segera ? 'danger' : undefined }) %>
  <%- include('../../components/stat-tile', { statLabel: 'Kedaluwarsa', statValue: formatAngka(counts.kedaluwarsa), statIcon: 'warning', statTone: counts.kedaluwarsa ? 'danger' : undefined }) %>
</div>

<div class="card">
  <form method="get" class="flex flex-col gap-3 border-b border-line p-4 md:flex-row md:items-center">
    <nav aria-label="Status" class="flex flex-wrap gap-1">
      <% [['', 'Semua'], ['berlaku', 'Berlaku'], ['segera-berakhir', 'Segera berakhir'], ['kedaluwarsa', 'Kedaluwarsa']].forEach(([val, label]) => { %>
        <a href="?status=<%= val %><%= filters.jenis ? '&jenis=' + filters.jenis : '' %><%= filters.q ? '&q=' + encodeURIComponent(filters.q) : '' %>" class="btn <%= filters.status === val ? 'btn-primary' : 'btn-secondary' %>"<%- filters.status === val ? ' aria-current="page"' : '' %>><%= label %></a>
      <% }) %>
    </nav>
    <select name="jenis" class="field-control md:ml-auto md:w-48">
      <option value="">Semua jenis</option>
      <option value="institusi"<%= filters.jenis === 'institusi' ? ' selected' : '' %>>Institusi</option>
      <option value="prodi"<%= filters.jenis === 'prodi' ? ' selected' : '' %>>Program Studi</option>
      <option value="lainnya"<%= filters.jenis === 'lainnya' ? ' selected' : '' %>>Lainnya</option>
    </select>
    <% if (filters.status) { %><input type="hidden" name="status" value="<%= filters.status %>"><% } %>
    <label for="q" class="sr-only">Cari program studi atau unit</label>
    <input id="q" name="q" type="search" class="field-control md:w-64" placeholder="Cari program studi atau unit…" value="<%= filters.q %>">
    <button type="submit" class="btn btn-secondary"><%- icon('filter_list') %>Terapkan</button>
  </form>

  <% if (!items.length) { %>
    <div class="p-6">
      <%- include('../../components/empty-state', {
        emptyIcon: 'workspace_premium', emptyTitle: filters.status || filters.jenis || filters.q ? 'Tidak ada yang cocok' : 'Belum ada data akreditasi',
        emptyAction: (filters.status || filters.jenis || filters.q) ? { label: 'Hapus filter', href: '/admin/accreditations' } : { label: 'Tambah Akreditasi', href: '/admin/accreditations/new' },
      }) %>
    </div>
  <% } else { %>
  <table class="data-table data-table--stack">
    <caption class="sr-only">Daftar akreditasi</caption>
    <thead><tr><th scope="col">Objek</th><th scope="col">Peringkat</th><th scope="col">Lembaga</th><th scope="col">Berlaku Sampai</th><th scope="col">Status</th><th scope="col"><span class="sr-only">Aksi</span></th></tr></thead>
    <tbody>
      <% items.forEach(item => { %>
        <tr data-updated="<%= item.updatedAt ? new Date(item.updatedAt).toISOString() : '' %>">
          <td data-label="Objek">
            <span class="font-medium"><%= item.jenis === 'prodi' ? (item.programStudi ? item.programStudi.nama : '—') : (item.namaUnit || '—') %></span>
            <span class="badge badge-neutral ml-1"><%= item.jenis === 'institusi' ? 'Institusi' : item.jenis === 'prodi' ? 'Prodi' : 'Lainnya' %></span>
          </td>
          <td data-label="Peringkat"><%= item.peringkat %></td>
          <td data-label="Lembaga"><%= item.lembaga ? item.lembaga.singkatan : '—' %></td>
          <td data-label="Berlaku Sampai"><%= formatTanggal(item.berlakuSampai) %></td>
          <td data-label="Status"><%- include('../../components/badge', { text: item.status.label, tone: item.status.tone }) %></td>
          <td data-label="Aksi">
            <div class="flex items-center gap-1 md:justify-end">
              <a href="/admin/accreditations/<%= item._id %>/edit" class="btn btn-secondary px-3" aria-label="Ubah akreditasi <%= item.peringkat %>"><%- icon('edit') %>Ubah</a>
              <button type="button" class="btn-icon text-danger hover:bg-danger-soft" data-dialog-open="hapus-<%= item._id %>" aria-label="Hapus akreditasi"><%- icon('delete') %></button>
            </div>
            <%- include('../../components/confirm-dialog', {
              dialogId: `hapus-${item._id}`, dialogTitle: 'Hapus data akreditasi?',
              dialogText: 'Data akreditasi ini akan dihapus permanen dan tidak bisa dikembalikan.',
              action: `/admin/accreditations/${item._id}/delete`, confirmLabel: 'Hapus',
            }) %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
