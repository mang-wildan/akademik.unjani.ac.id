<!doctype html>
<html
  lang="id"
  class="layout-navbar-fixed layout-menu-fixed layout-compact"
  dir="ltr"
  data-skin="default"
  data-bs-theme="light"
  data-assets-path="/assets/"
  data-template="vertical-menu-template">  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title || 'Akreditasi' %></title>
    <link rel="icon" type="image/x-icon" href="/assets/img/favicon/favicon.ico" />
    <link rel="stylesheet" href="/assets/vendor/fonts/iconify-icons.css" />
    <link rel="stylesheet" href="/assets/vendor/libs/node-waves/node-waves.css" />
    <link rel="stylesheet" href="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
    <link rel="stylesheet" href="/assets/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" />
    <link rel="stylesheet" href="/assets/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css" />
    <link rel="stylesheet" href="/assets/vendor/libs/datatables-select-bs5/select.bootstrap5.css" />
    <link rel="stylesheet" href="/assets/vendor/css/core.css" />
    <link rel="stylesheet" href="/assets/css/demo.css" />
    <style>
      .table-card-header { padding: 1rem 1.25rem 0.5rem 1.25rem; }
      .table-card-toolbar { gap: .5rem; }
      .dataTables_filter input { min-width: 220px; }
      .badge-soft { background-color: var(--bs-primary-bg-subtle); color: var(--bs-primary); }
      tr.table-empty td:not(:first-child) { display: none !important; }
      tr.table-empty td:first-child {
        width: 100%;
        text-align: center;
        padding: 1.25rem;
        color: var(--bs-secondary-color);
        background: var(--bs-body-bg);
      }
    </style>
    <script src="/assets/vendor/js/helpers.js"></script>
    <script src="/assets/js/config.js"></script>
  </head>

  <body>
    <div class="layout-wrapper layout-content-navbar">
      <div class="layout-container">
        <%- include("../../partials/menu") %>
        <div class="layout-page">
          <%- include("../../partials/navbar") %>
          <div class="content-wrapper">
            <div class="container-xxl flex-grow-1 container-p-y">
              <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div>
                  <h4 class="mb-1">Data Akreditasi</h4>
                  <p class="text-muted mb-0">Kelola dokumen akreditasi institusi dan unit.</p>
                </div>
                <div class="d-flex align-items-center gap-3">
                  <span class="badge bg-label-primary px-3 py-2">Total: <%= accreditations ? accreditations.length : 0 %></span>
                  <a class="btn btn-primary" href="/admin/accreditations/new"><i class="ri ri-add-line me-1"></i>Tambah</a>
                </div>
              </div>

              <div class="card shadow-sm">
                <div class="d-flex flex-wrap justify-content-between align-items-center table-card-header">
                  <div>
                    <h6 class="mb-1">Tabel Akreditasi</h6>
                    <p class="text-muted mb-0 small">Kelola sertifikat akreditasi per unit.</p>
                  </div>
                  <div class="d-flex table-card-toolbar align-items-center">
                    <span class="badge badge-soft px-3 py-2">Total data: <%= accreditations ? accreditations.length : 0 %></span>
                  </div>
                </div>
                <div class="table-responsive m-4">
                  <table id="accreditationsTable" class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                      <tr>
                        <th style="width:60px" class="text-center">No.</th>
                        <th>Institusi / Fakultas</th>
                        <th>Unit / Prodi</th>
                        <th class="text-center">Tahun</th>
                        <th>Akreditasi</th>
                        <th>Berlaku</th>
                        <th>Sampai</th>
                        <th class="text-center">Status</th>
                        <th>Sertifikat</th>
                        <th>Dibuat</th>
                        <th>Diperbarui</th>
                        <th class="text-end">Aksi</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% if (accreditations && accreditations.length) { %>
                        <% accreditations.forEach(function(item, idx){ %>
                          <tr>
                            <td class="text-center"><%= idx + 1 %></td>
                            <td class="fw-semibold"><%= item.institusi %></td>
                            <td><%= item.unit %></td>
                            <td class="text-center"><%= item.tahun || '-' %></td>
                            <td><span class="badge bg-label-success"><%= item.akreditasi %></span></td>
                            <td><%= item.tanggalBerlaku ? new Date(item.tanggalBerlaku).toLocaleDateString('id-ID') : '-' %></td>
                            <td><%= item.berlakuSampai ? new Date(item.berlakuSampai).toLocaleDateString('id-ID') : '-' %></td>
                            <td class="text-center">
                              <div class="d-flex flex-column align-items-center gap-1">
                                <span class="badge bg-label-<%= item.isActive === false ? 'secondary' : 'success' %>">
                                  <%= item.isActive === false ? 'Nonaktif' : 'Aktif' %>
                                </span>
                                <form action="/admin/accreditations/<%= item._id %>/toggle-active" method="POST" class="d-inline">
                                  <input type="hidden" name="isActive" value="false" />
                                  <div class="form-check form-switch m-0">
                                    <input
                                      class="form-check-input status-toggle"
                                      type="checkbox"
                                      role="switch"
                                      name="isActive"
                                      value="true"
                                      <%= item.isActive === false ? '' : 'checked' %>
                                      aria-label="Toggle status aktif">
                                  </div>
                                </form>
                              </div>
                            </td>
                            <td>
                              <% if (item.sertifikat) { %>
                                <a href="<%= item.sertifikat %>" target="_blank" class="text-primary">
                                  <i class="ri ri-file-pdf-line me-1"></i>Lihat Sertifikat
                                </a>
                              <% } else { %>
                                <span class="text-muted">-</span>
                              <% } %>
                            </td>
                            <td>
                              <div><%= item.createdAt ? item.createdAt.toLocaleDateString() : '-' %></div>
                              <small class="text-muted"><%= item.createdBy ? (item.createdBy.name || item.createdBy.email || '') : '' %></small>
                            </td>
                            <td>
                              <div><%= item.updatedAt ? item.updatedAt.toLocaleDateString() : '-' %></div>
                              <small class="text-muted"><%= item.updatedBy ? (item.updatedBy.name || item.updatedBy.email || '') : '' %></small>
                            </td>
                            <td class="text-end">
                              <a class="btn btn-sm btn-outline-primary me-2" href="/admin/accreditations/<%= item._id %>/edit">
                                <i class="ri ri-pencil-line"></i>
                              </a>
                              <form action="/admin/accreditations/<%= item._id %>/delete" method="POST" class="d-inline" data-disable-submit>
                                <button class="btn btn-sm btn-outline-danger" type="submit">
                                  <i class="ri ri-delete-bin-line"></i>
                                </button>
                              </form>
                            </td>
                          </tr>
                        <% }); %>
                      <% } else { %>
                        <tr class="table-empty" data-empty="true" data-message="Belum ada data akreditasi.">
                          <td class="text-center text-muted">Belum ada data akreditasi.</td>
                          <td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td>
                        </tr>
                      <% } %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
            <div class="content-backdrop fade"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="layout-overlay layout-menu-toggle"></div>
    <div class="drag-target"></div>

    <script src="/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="/assets/vendor/libs/popper/popper.js"></script>
    <script src="/assets/vendor/js/bootstrap.js"></script>
    <script src="/assets/vendor/libs/node-waves/node-waves.js"></script>
    <script src="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="/assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <script src="/assets/vendor/js/menu.js"></script>
    <script src="/assets/js/main.js"></script>
    <script>
      $(function () {
        const table = $('#accreditationsTable');
        if (!table.length) return;
        const dt = table.DataTable({
          responsive: true,
          pageLength: 10,
          lengthMenu: [10, 25, 50, 100],
          order: [[1, 'asc']],
          columnDefs: [
            { targets: [0, 7, 8, 11], orderable: false, searchable: false }
          ],
          language: {
            searchPlaceholder: 'Cari akreditasi...',
            search: '',
            lengthMenu: 'Tampilkan _MENU_',
            emptyTable: 'Belum ada data akreditasi.'
          },
          dom: '<"row align-items-center mb-3"<"col-md-6"l><"col-md-6 text-md-end"f>>t<"row align-items-center mt-3"<"col-md-6"i><"col-md-6 text-md-end"p>>'
        });

        dt.on('order.dt search.dt', function () {
          let i = 1;
          dt.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell) {
            const row = cell.closest('tr');
            if (row && row.dataset.empty === 'true') {
              cell.innerHTML = row.dataset.message || '-';
            } else {
              cell.innerHTML = i++;
            }
          });
        }).draw();

        table.on('change', '.status-toggle', function () {
          if (this.form) this.form.submit();
        });

        // Beautify built-in controls
        const wrapper = table.closest('.dataTables_wrapper');
        wrapper.find('.dataTables_filter input').addClass('form-control form-control-sm').attr('aria-label', 'Cari akreditasi');
        wrapper.find('.dataTables_length select').addClass('form-select form-select-sm');
      });
    </script>
  </body>
</html>
