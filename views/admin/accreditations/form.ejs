<%# Akreditasi: jenis menentukan apakah Program Studi atau Nama Unit yang berlaku -- kedua kolom selalu
    ditampilkan (tanpa JS wajib) dan server (accreditationRules) yang menegakkan mana yang dipakai. %>
<div class="mb-6">
  <a href="/admin/accreditations" class="mb-2 inline-flex min-h-6 items-center gap-1 text-sm font-medium text-muted hover:text-ink"><%- icon('arrow_back', 'size-4') %>Kembali ke Akreditasi</a>
  <h1 class="text-2xl font-bold"><%= mode === 'edit' ? 'Ubah Akreditasi' : 'Tambah Akreditasi' %></h1>
</div>

<form method="POST" action="/admin/accreditations<%= mode === 'edit' ? `/${item._id}` : '' %>" enctype="multipart/form-data" class="card card-body grid gap-5 md:grid-cols-2">
  <%- include('../../components/form-field', {
    name: 'jenis', label: 'Jenis', type: 'select', required: true, value: values.jenis, error: errors.jenis, options: jenisOptions,
  }) %>
  <%- include('../../components/form-field', {
    name: 'peringkat', label: 'Peringkat', type: 'select', required: true, value: values.peringkat, error: errors.peringkat, options: peringkatOptions,
  }) %>

  <%- include('../../components/form-field', {
    name: 'programStudi', label: 'Program Studi', type: 'select', value: values.programStudi && String(values.programStudi._id || values.programStudi), error: errors.programStudi,
    placeholder: 'Pilih program studi', help: 'Isi hanya jika Jenis = Program Studi.',
    options: prodiList.map(p => ({ value: p._id, label: p.labelFakultas })),
  }) %>
  <%- include('../../components/form-field', {
    name: 'namaUnit', label: 'Nama Unit', value: values.namaUnit, error: errors.namaUnit,
    help: 'Isi hanya jika Jenis = Institusi atau Lainnya.', placeholder: 'mis. Perpustakaan, Fakultas Teknik',
  }) %>

  <%- include('../../components/form-field', {
    name: 'lembaga', label: 'Lembaga Akreditasi', type: 'select', required: true, value: values.lembaga && String(values.lembaga._id || values.lembaga), error: errors.lembaga,
    placeholder: 'Pilih lembaga', options: lembagaList.map(l => ({ value: l._id, label: `${l.nama} (${l.singkatan})` })),
  }) %>
  <%- include('../../components/form-field', { name: 'nomorSK', label: 'Nomor SK', value: values.nomorSK, error: errors.nomorSK }) %>

  <%- include('../../components/form-field', { name: 'tanggalBerlaku', label: 'Tanggal Berlaku', type: 'date', required: true, value: values.tanggalBerlaku && new Date(values.tanggalBerlaku).toISOString().slice(0, 10), error: errors.tanggalBerlaku }) %>
  <%- include('../../components/form-field', { name: 'berlakuSampai', label: 'Berlaku Sampai', type: 'date', required: true, value: values.berlakuSampai && new Date(values.berlakuSampai).toISOString().slice(0, 10), error: errors.berlakuSampai }) %>

  <div class="md:col-span-2">
    <%- include('../../components/form-field', { name: 'catatanPerpanjangan', label: 'Catatan Perpanjangan', type: 'textarea', value: values.catatanPerpanjangan, error: errors.catatanPerpanjangan, help: 'Opsional, mis. status pengajuan perpanjangan.' }) %>
  </div>

  <div class="md:col-span-2">
    <%- include('../../components/file-upload', {
      name: 'sertifikat', label: 'Sertifikat (PDF)', accept: 'application/pdf', error: errors.sertifikat,
      limitText: 'PDF, maks. 10 MB.', current: (mode === 'edit' && item.sertifikat) ? { label: 'Sertifikat saat ini', href: item.sertifikat } : null,
    }) %>
  </div>

  <div class="flex justify-end gap-2 border-t border-line pt-5 md:col-span-2">
    <a href="/admin/accreditations" class="btn btn-secondary">Batal</a>
    <button type="submit" class="btn btn-primary">Simpan</button>
  </div>
</form>
