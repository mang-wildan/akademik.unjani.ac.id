<% const heading = mode === 'edit' ? 'Ubah Buku' : 'Tambah Buku'; %>
<% if (!locals.partial) { %><%- include('../_ui/page-header', { heading }) %><% } %>
<form method="POST" action="/admin/books<%= mode === 'edit' ? `/${item._id}` : '' %>" enctype="multipart/form-data" data-save-form data-panel-title="<%= heading %>"
      x-data="dirtyGuard" x-on:input="mark" x-on:change="mark" x-on:submit="submitted" x-on:beforeunload.window="beforeUnload" class="publication-form<%= locals.partial ? ' publication-form--stacked' : '' %>">
  <%- include('../_ui/error-summary', { errors }) %>
  <div class="publication-layout">
    <section data-form-main aria-label="Isi buku" class="form-panel space-y-5">
      <%- include('../_ui/field', { name: 'title', label: 'Judul', required: true, value: values.title, error: errors.title, help: '3–200 karakter.' }) %>
      <%- include('../_ui/upload-field', { name: 'file', label: 'File PDF', accept: 'application/pdf', error: errors.file, limitText: 'PDF, maks. 10 MB.', required: mode !== 'edit', current: mode === 'edit' && item.src ? { href: item.src, label: 'Buka PDF saat ini' } : null }) %>
    </section>
    <aside data-publication-panel aria-labelledby="publication-title" class="form-panel space-y-5">
      <h2 id="publication-title" class="font-serif text-lg">Detail buku</h2>
      <%- include('../_ui/field', { name: 'year', label: 'Tahun', type: 'number', value: values.year, error: errors.year, min: 1950, max: 2100, help: 'Opsional.' }) %>
      <%- include('../_ui/upload-field', { name: 'cover', label: 'Gambar sampul', accept: 'image/png,image/jpeg,image/webp', error: errors.cover, limitText: 'JPG/PNG/WEBP, maks. 5 MB.', required: mode !== 'edit' }) %>
      <% if (mode === 'edit' && item.cover) { %><img src="<%= item.cover %>" alt="Sampul saat ini" class="h-32 w-24 rounded-control object-cover"><% } %>
    </aside>
  </div>
  <div class="form-actions<%= locals.partial ? '' : ' max-lg:bottom-[calc(4rem+env(safe-area-inset-bottom))]' %>">
    <a href="/admin/books" data-slide-close class="btn btn-secondary">Batal</a>
    <%- include('../_ui/button', { label: 'Simpan', type: 'submit', buttonIcon: 'check', title: 'Simpan (Ctrl+S)' }) %>
  </div>
</form>
