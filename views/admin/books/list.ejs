<div data-list-region>
  <%- include('../_ui/page-header', { heading: 'Buku', count: pagination.total, actions: [{ label: 'Tambah Buku', href: '/admin/books/new', buttonIcon: 'add', slideOver: true, shortcut: 'new' }] }) %>
  <div data-bulk-list x-data="bulkBar" x-on:table-selection="selection" x-bind:data-bulk-active="active" class="rounded-card border border-line bg-surface">
    <%- include('../_ui/bulk-bar', { id: 'bulk-books', action: '/admin/books/bulk', noun: 'buku', total: pagination.total, state, actions: [{ value: 'delete', label: 'Hapus' }] }) %>
    <%- include('../_ui/filter-bar', { state, searchLabel: 'Cari judul buku' }) %>
    <% if (items.length) { %>
      <%- include('../_ui/data-table', { caption: 'Daftar buku', items, state, bulkForm: 'bulk-books',
        columns: [
          { key: 'title', label: 'Judul', sortable: true, cell: item => include('../_ui/book-title', { item }) },
          { key: 'year', label: 'Tahun', sortable: true, firstDir: 'desc' },
          { key: 'updatedAt', label: 'Diperbarui', sortable: true, firstDir: 'desc', cell: item => formatTanggal(item.updatedAt) },
        ], rowHref: item => `/admin/books/${item._id}/edit`, slideOver: true,
        actions: item => include('../_ui/book-actions', { item }),
      }) %>
    <% } else { %>
      <%- include('../_ui/empty-state', { text: state.q ? 'Tidak ada buku yang cocok.' : 'Belum ada buku.', emptyIcon: 'menu_book', action: state.q ? { label: 'Hapus filter', href: '/admin/books' } : { label: 'Tambah Buku', href: '/admin/books/new', slideOver: true } }) %>
    <% } %>
    <%- include('../_ui/pagination', { ...pagination, state, noun: 'buku' }) %>
  </div>
</div>
<%- include('../_ui/slide-over', { editUrl: '/admin/books/:id/edit', newUrl: '/admin/books/new' }) %>
