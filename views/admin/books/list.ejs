<!doctype html>
<html
  lang="id"
  class="layout-navbar-fixed layout-menu-fixed layout-compact"
  dir="ltr"
  data-skin="default"
  data-bs-theme="light"
  data-assets-path="/assets/"
  data-template="vertical-menu-template">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || 'Daftar Buku' %></title>
  <link rel="icon" type="image/x-icon" href="/assets/img/favicon/favicon.ico" />
  <link rel="stylesheet" href="/assets/vendor/fonts/iconify-icons.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/node-waves/node-waves.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/datatables-select-bs5/select.bootstrap5.css" />
  <link rel="stylesheet" href="/assets/vendor/css/core.css" />
  <link rel="stylesheet" href="/assets/css/demo.css" />
  <style>
    .table-card-header { padding: 1rem 1.25rem 0.5rem 1.25rem; }
    .table-card-toolbar { gap: .5rem; }
    .dataTables_filter input { min-width: 220px; }
    .badge-soft { background-color: var(--bs-primary-bg-subtle); color: var(--bs-primary); }
    /* Make the empty-state row friendly to DataTables (no colspan) */
    tr.table-empty td:not(:first-child) { display: none !important; }
    tr.table-empty td:first-child {
      width: 100%;
      text-align: center;
      padding: 1.25rem;
      color: var(--bs-secondary-color);
      background: var(--bs-body-bg);
    }
  </style>
  <script src="/assets/vendor/js/helpers.js"></script>
  <script src="/assets/vendor/js/template-customizer.js"></script>
  <script src="/assets/js/config.js"></script>
</head>

<body>
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <%- include("../../partials/menu") %>
      <div class="layout-page">
        <%- include("../../partials/navbar") %>
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
              <div>
                <h4 class="mb-1">Daftar Buku</h4>
                <p class="text-muted mb-0">Kelola koleksi PDF dan cover.</p>
              </div>
              <div class="d-flex align-items-center gap-3">
                <span class="badge bg-label-primary px-3 py-2">Total: <%= books ? books.length : 0 %></span>
                <a class="btn btn-primary" href="/admin/books/new"><i class="ri ri-add-line me-1"></i>Tambah Buku</a>
              </div>
            </div>

            <div class="card shadow-sm">
              <div class="d-flex flex-wrap justify-content-between align-items-center table-card-header">
                <div>
                  <h6 class="mb-1">Tabel Buku</h6>
                  <p class="text-muted mb-0 small">Gunakan pencarian untuk menemukan judul dengan cepat.</p>
                </div>
                <div class="d-flex table-card-toolbar align-items-center">
                  <span class="badge badge-soft px-3 py-2">Total data: <%= books ? books.length : 0 %></span>
                </div>
              </div>
              <div class="table-responsive m-4">
                <table id="booksTable" class="table table-striped table-hover align-middle m-0">
                  <thead class="table-light">
                    <tr>
                      <th style="width:50px" class="text-center">No.</th>
                      <th style="width:36px"></th>
                      <th>Judul</th>
                      <th class="text-center">Tahun</th>
                      <th>PDF</th>
                      <th>Cover</th>
                      <th>Dibuat</th>
                      <th>Diperbarui</th>
                      <th class="text-end">Aksi</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (books && books.length) { %>
                      <% books.forEach(function(book, idx){ %>
                        <tr>
                          <td class="text-center"><%= idx + 1 %></td>
                          <td>
                            <% if (book.cover) { %>
                              <img src="<%= book.cover %>" alt="cover" class="rounded" style="width:46px;height:46px;object-fit:cover;" />
                            <% } else { %>
                              <span class="avatar avatar-sm bg-label-secondary"><i class="ri ri-book-line"></i></span>
                            <% } %>
                          </td>
                          <td>
                            <div class="fw-semibold"><%= book.title %></div>
                            <small class="text-muted d-block">ID: <%= book._id %></small>
                          </td>
                          <td class="text-center"><%= book.year || '-' %></td>
                          <td>
                            <% if (book.src) { %>
                              <a href="<%= book.src %>" target="_blank" class="text-primary">
                                <i class="ri ri-file-pdf-line me-1"></i>Lihat PDF
                              </a>
                            <% } else { %>
                              <span class="text-muted">-</span>
                            <% } %>
                          </td>
                          <td>
                            <small class="text-muted d-block text-truncate" style="max-width:160px;"><%= book.cover || '-' %></small>
                          </td>
                          <td>
                            <div><%= book.createdAt ? book.createdAt.toLocaleDateString() : '-' %></div>
                            <small class="text-muted"><%= book.createdBy ? (book.createdBy.name || book.createdBy.email || '') : '' %></small>
                          </td>
                          <td>
                            <div><%= book.updatedAt ? book.updatedAt.toLocaleDateString() : '-' %></div>
                            <small class="text-muted"><%= book.updatedBy ? (book.updatedBy.name || book.updatedBy.email || '') : '' %></small>
                          </td>
                          <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary me-2" href="/admin/books/<%= book._id %>/edit">
                              <i class="ri ri-pencil-line"></i>
                            </a>
                            <form action="/admin/books/<%= book._id %>/delete" method="POST" class="d-inline" data-disable-submit>
                              <button class="btn btn-sm btn-outline-danger" type="submit">
                                <i class="ri ri-delete-bin-line"></i>
                              </button>
                            </form>
                          </td>
                        </tr>
                      <% }); %>
                    <% } else { %>
                      <tr class="table-empty" data-empty="true" data-message="Belum ada data buku.">
                        <td class="text-center text-muted">Belum ada data buku.</td>
                        <td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <div class="content-backdrop fade"></div>
        </div>
      </div>
    </div>
  </div>
  <!-- Overlay -->
  <div class="layout-overlay layout-menu-toggle"></div>

  <!-- Drag Target Area To SlideIn Menu On Small Screens -->
  <div class="drag-target"></div>

  <script src="/assets/vendor/libs/jquery/jquery.js"></script>
  <script src="/assets/vendor/libs/popper/popper.js"></script>
  <script src="/assets/vendor/js/bootstrap.js"></script>
  <script src="/assets/vendor/libs/node-waves/node-waves.js"></script>
  <script src="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
  <script src="/assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
  <script src="/assets/vendor/js/menu.js"></script>
  <script src="/assets/js/main.js"></script>
  <script>
    $(function () {
      const $table = $('#booksTable');
      if (!$table.length) return;

      $table.DataTable({
        responsive: true,
        pageLength: 10,
        lengthMenu: [10, 25, 50, 100],
        order: [[2, 'asc']], // sort by judul by default
        columnDefs: [
          { targets: [0, 1, 4, 5, 8], orderable: false, searchable: false }
        ],
        language: {
          searchPlaceholder: 'Cari buku...',
          search: '',
          lengthMenu: 'Tampilkan _MENU_',
          emptyTable: 'Belum ada data buku.'
        },
        dom: '<"row align-items-center mb-3"<"col-md-6"l><"col-md-6 text-md-end"f>>t<"row align-items-center mt-3"<"col-md-6"i><"col-md-6 text-md-end"p>>'
      }).on('order.dt search.dt', function () {
        let i = 1;
        $table.DataTable().column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell) {
          const row = cell.closest('tr');
          if (row && row.dataset.empty === 'true') {
            cell.innerHTML = row.dataset.message || '-';
          } else {
            cell.innerHTML = i++;
          }
        });
      }).draw();

      // Beautify built-in controls
      const wrapper = $table.closest('.dataTables_wrapper');
      wrapper.find('.dataTables_filter input').addClass('form-control form-control-sm').attr('aria-label', 'Cari buku');
      wrapper.find('.dataTables_length select').addClass('form-select form-select-sm');
    });
  </script>
  <%- include("../../partials/template-customizer") %>
</body>

</html>
