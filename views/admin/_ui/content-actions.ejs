<div class="flex items-center justify-end gap-1">
  <span class="max-md:hidden"><%- include('button', { label: 'Ubah', variant: 'ghost', href: `/admin/${basePath}/${item._id}/edit`, title: `Ubah ${item.title}` }) %></span>
  <details class="relative text-left">
    <summary class="btn btn-icon btn-ghost list-none" aria-label="Aksi untuk <%= item.title %>"><%- icon('more_horiz', 'size-5') %></summary>
    <div class="absolute right-0 z-20 flex flex-col whitespace-normal w-60 space-y-1 rounded-card border border-line-strong bg-surface p-2 shadow-overlay">
      <form method="POST" action="/admin/<%= basePath %>/<%= item._id %>/pin">
        <%- include('button', { label: item.pinned ? 'Lepas sematan' : 'Sematkan', variant: 'ghost', type: 'submit', buttonIcon: 'keep' }) %>
      </form>
      <%- include('confirm-dialog', { dialogId: `hapus-${item._id}`, dialogTitle: 'Hapus konten?', dialogText: `“${item.title}” beserta lampirannya akan dihapus permanen.`, action: `/admin/${basePath}/${item._id}/delete` }) %>
    </div>
  </details>
</div>
