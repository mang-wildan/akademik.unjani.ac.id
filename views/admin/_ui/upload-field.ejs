<div class="min-w-0 space-y-3 rounded-control border border-dashed border-control bg-surface-subtle p-4">
  <%- include('field', { ...locals, type: 'file', help: `${locals.limitText || 'PDF, maks. 10 MB.'} Pilih ulang setelah gagal validasi.` }) %>
  <% if (locals.current && locals.current.href) { %>
    <a href="<%= locals.current.href %>" target="_blank" rel="noopener" class="flex min-h-11 items-center break-all rounded-control border border-line bg-surface p-3 text-sm text-primary underline"><%= locals.current.label || 'File saat ini' %> (tab baru)</a>
  <% } %>
</div>
