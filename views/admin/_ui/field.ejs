<%# Params: name, label, id? (default f-name), type=text (textarea|select|checkbox|email|password|number|date|url|file), value?, checked?, required?, disabled?, help?, error?, placeholder?, options=[{value,label}], rows=4, autocomplete?, min?, max?, accept?, multiple?. %>
<%
  const id = locals.id || `f-${locals.name}`;
  const type = locals.type || 'text';
  const value = locals.value ?? (type === 'checkbox' ? 'on' : '');
  const describedBy = [locals.help && `${id}-help`, locals.error && `${id}-error`].filter(Boolean).join(' ');
  const controlClass = `field-control scroll-mt-20 scroll-mb-40${locals.error ? ' border-danger' : ''}`;
%>
<div class="space-y-1.5">
  <% if (type === 'checkbox') { %>
    <label for="<%= id %>" class="flex min-h-11 items-center gap-2 text-sm font-medium lg:min-h-6">
      <input type="checkbox" id="<%= id %>" name="<%= locals.name %>" value="<%= value %>" class="size-5 shrink-0 scroll-mt-20 scroll-mb-40 accent-primary<%= locals.error ? ' outline outline-danger' : '' %>" aria-describedby="<%= describedBy %>" aria-invalid="<%= Boolean(locals.error) %>"<% if (locals.checked) { %> checked<% } %><% if (locals.required) { %> required<% } %><% if (locals.disabled) { %> disabled<% } %>>
      <span class="min-w-0 break-words"><%= locals.label %><% if (locals.required) { %> <span class="text-muted">(wajib)</span><% } %></span>
    </label>
  <% } else { %>
  <label for="<%= id %>" class="block text-sm font-medium"><%= locals.label %><% if (locals.required) { %> <span class="text-muted">(wajib)</span><% } %></label>
  <% if (type === 'textarea') { %>
    <textarea id="<%= id %>" name="<%= locals.name %>" class="<%= controlClass %>" rows="<%= locals.rows || 4 %>" aria-describedby="<%= describedBy %>" aria-invalid="<%= Boolean(locals.error) %>"<% if (locals.required) { %> required<% } %><% if (locals.disabled) { %> disabled<% } %> placeholder="<%= locals.placeholder || '' %>"><%= value %></textarea>
  <% } else if (type === 'select') { %>
    <select id="<%= id %>" name="<%= locals.name %>" class="<%= controlClass %>" aria-describedby="<%= describedBy %>" aria-invalid="<%= Boolean(locals.error) %>"<% if (locals.required) { %> required<% } %><% if (locals.disabled) { %> disabled<% } %>>
      <% if (locals.placeholder) { %><option value=""><%= locals.placeholder %></option><% } %>
      <% (locals.options || []).forEach(option => { %><option value="<%= option.value %>"<% if (String(option.value) === String(value)) { %> selected<% } %>><%= option.label %></option><% }) %>
    </select>
  <% } else { %>
    <input type="<%= type %>" id="<%= id %>" name="<%= locals.name %>" class="<%= controlClass %>" aria-describedby="<%= describedBy %>" aria-invalid="<%= Boolean(locals.error) %>"<% if (type !== 'file') { %> value="<%= value %>"<% } %><% if (locals.required) { %> required<% } %><% if (locals.disabled) { %> disabled<% } %><% if (locals.placeholder) { %> placeholder="<%= locals.placeholder %>"<% } %><% if (locals.autocomplete) { %> autocomplete="<%= locals.autocomplete %>"<% } %><% if (locals.min !== undefined) { %> min="<%= locals.min %>"<% } %><% if (locals.max !== undefined) { %> max="<%= locals.max %>"<% } %><% if (type === 'file' && locals.multiple) { %> multiple<% } %><% if (locals.accept) { %> accept="<%= locals.accept %>"<% } %>>
  <% } %>
  <% } %>
  <% if (locals.help) { %><p id="<%= id %>-help" class="text-xs text-muted"><%= locals.help %></p><% } %>
  <% if (locals.error) { %><p id="<%= id %>-error" class="flex items-start gap-1 text-xs text-danger"><%- icon('error', 'size-4') %><%= locals.error %></p><% } %>
</div>
