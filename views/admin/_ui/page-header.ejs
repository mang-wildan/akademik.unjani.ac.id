<%# Params: heading, count? (termasuk 0), actions?=[{label,href,buttonIcon?,variant?,title?}]. Breadcrumb ada di shell. %>
<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div class="flex min-w-0 flex-wrap items-baseline gap-3">
    <h1 class="min-w-0 max-w-full break-words font-serif text-[2rem] leading-9 font-bold lg:text-[2.5rem] lg:leading-11"><%= locals.heading %></h1>
    <% if (locals.count !== undefined && locals.count !== null) { %><span class="font-mono text-xs text-muted tabular-nums"><%= locals.count %></span><% } %>
  </div>
  <% if (locals.actions && locals.actions.length) { %><div class="flex flex-wrap gap-2"><% locals.actions.forEach((action, index) => { %><%- include('button', { ...action, variant: action.variant || (index === 0 ? 'primary' : 'secondary') }) %><% }) %></div><% } %>
</div>
