<%# Params: heading, count? (termasuk 0), actions?=[{label,href,buttonIcon?,variant?,title?}]. Breadcrumb ada di shell. %>
<div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <div class="flex min-w-0 flex-wrap items-baseline gap-2">
    <h1 class="break-words text-lg font-semibold"><%= locals.heading %></h1>
    <% if (locals.count !== undefined && locals.count !== null) { %><span class="text-sm text-muted tabular-nums"><%= locals.count %></span><% } %>
  </div>
  <% if (locals.actions && locals.actions.length) { %><div class="flex flex-wrap gap-2"><% locals.actions.forEach((action, index) => { %><%- include('button', { ...action, variant: action.variant || (index === 0 ? 'primary' : 'secondary') }) %><% }) %></div><% } %>
</div>
