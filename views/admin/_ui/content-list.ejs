<%- include('./page-header', { heading: listLabel, count: counts.total, actions: [{ label: `Tambah ${singularLabel}`, href: `/admin/${basePath}/new`, buttonIcon: 'add', shortcut: 'new' }] }) %>
<% if (basePath === 'news') { %><p class="mb-3 text-sm text-muted">Berita memerlukan gambar sampul untuk diterbitkan.</p><% } %>
<div data-bulk-list x-data="bulkBar" x-on:table-selection="selection" x-bind:data-bulk-active="active" class="rounded-card border border-line bg-surface">
  <%- include('./bulk-bar', { id: 'bulk-form', action: `/admin/${basePath}/bulk`, noun: listLabel.toLowerCase(), total: pagination.total, state, actions: [{ value: 'publish', label: 'Terbitkan' }, { value: 'unpublish', label: 'Jadikan draf' }, { value: 'delete', label: 'Hapus' }] }) %>
  <%- include('./filter-bar', { state, searchLabel: `Cari judul ${listLabel.toLowerCase()}`, statusTabs: { options: [{ value: '', label: 'Semua' }, { value: 'published', label: 'Terbit' }, { value: 'draft', label: 'Draf' }] }, filters: [{ name: 'kategori', label: 'Kategori', options: kategoriList.map(k => ({ value: k._id, label: k.nama })) }] }) %>
  <% if (!items.length) { %>
    <%- include('./empty-state', { text: `Tidak ada ${listLabel.toLowerCase()} yang cocok.`, emptyIcon: basePath === 'news' ? 'newspaper' : 'campaign', action: { label: 'Hapus filter', href: `/admin/${basePath}` } }) %>
  <% } else { %>
    <%- include('./data-table', {
      caption: `Daftar ${listLabel.toLowerCase()}`, items, state, rowHref: item => `/admin/${basePath}/${item._id}/edit`,
      columns: [
        { key: 'title', label: 'Judul', sortable: true, cell: item => include('./content-title', { item }) },
        { key: 'kategori', label: 'Kategori', cell: item => include('./badge', { text: item.kategori ? item.kategori.nama : 'Tanpa kategori', tone: 'neutral' }) },
        { key: 'status', label: 'Status', cell: item => include('./badge', { text: item.status === 'published' ? 'Terbit' : 'Draf', tone: item.status === 'published' ? 'success' : 'neutral' }) },
        { key: 'updatedAt', label: 'Diperbarui', sortable: true, firstDir: 'desc', cell: item => formatTanggal(item.updatedAt) },
      ], actions: item => include('./content-actions', { item, basePath }),
    }) %>
  <% } %>
  <%- include('./pagination', { ...pagination, state, noun: listLabel.toLowerCase() }) %>
</div>
