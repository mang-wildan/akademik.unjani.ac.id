<%# Params: text (wajib), tone=neutral (success|warning|danger|info), badgeIcon?. Status = titik dekoratif + teks (bukan warna saja). %>
<%
  const tones = { neutral: 'text-muted', success: 'text-success', warning: 'text-warning', danger: 'text-danger', info: 'text-info' };
%>
<span class="inline-flex items-center gap-1.5 text-sm font-medium <%= tones[locals.tone] || tones.neutral %>"><% if (locals.badgeIcon) { %><%- icon(locals.badgeIcon, 'size-4') %><% } else { %><span class="size-1.5 shrink-0 rounded-full bg-current" aria-hidden="true"></span><% } %><%= locals.text %></span>
