<%# Params: dialogId, dialogTitle (pertanyaan), dialogText, action (POST), confirmLabel=Hapus, triggerLabel=Hapus. Tanpa JS, dialog open menampilkan form konfirmasi. %>
<div x-data="confirmDialog">
  <button type="button" class="btn btn-ghost text-danger" x-on:click="show" x-cloak aria-haspopup="dialog" aria-controls="<%= locals.dialogId %>"><%= locals.triggerLabel || 'Hapus' %></button>
  <dialog open id="<%= locals.dialogId %>" x-ref="dialog" x-on:click="backdrop" aria-labelledby="<%= locals.dialogId %>-title" aria-describedby="<%= locals.dialogId %>-text" class="m-auto w-[calc(100%-2rem)] max-w-[400px] rounded-card border border-line-strong bg-surface p-4 text-ink shadow-overlay backdrop:bg-canvas/60">
    <form method="POST" action="<%= locals.action %>">
      <h2 id="<%= locals.dialogId %>-title" class="text-md font-semibold"><%= locals.dialogTitle %></h2>
      <p id="<%= locals.dialogId %>-text" class="mt-2 whitespace-normal text-sm text-muted"><%= locals.dialogText %></p>
      <div class="mt-6 flex justify-end gap-2">
        <button type="submit" formmethod="dialog" formnovalidate autofocus class="btn btn-secondary">Batal</button>
        <%- include('button', { label: locals.confirmLabel || 'Hapus', variant: 'danger', type: 'submit' }) %>
      </div>
    </form>
  </dialog>
</div>
