<%# Params: dialogId, dialogTitle (pertanyaan), dialogText, action (POST), confirmLabel=Hapus, triggerLabel=Hapus, fields?={name:value} (input hidden). Tanpa JS, dialog open menampilkan form konfirmasi. %>
<div x-data="confirmDialog">
  <button type="button" class="btn btn-ghost text-danger" x-on:click="show" x-cloak aria-haspopup="dialog" aria-controls="<%= locals.dialogId %>"><%= locals.triggerLabel || 'Hapus' %></button>
  <dialog open id="<%= locals.dialogId %>" x-ref="dialog" x-on:click="backdrop" aria-labelledby="<%= locals.dialogId %>-title" aria-describedby="<%= locals.dialogId %>-text" class="confirm-dialog m-auto w-[calc(100%-2rem)] max-w-[480px] rounded-card border border-line-strong border-t-4 border-t-danger bg-surface p-6 text-left text-ink shadow-overlay backdrop:bg-ink/40">
    <form method="POST" action="<%= locals.action %>">
      <% Object.entries(locals.fields || {}).forEach(([name, value]) => { %><input type="hidden" name="<%= name %>" value="<%= value %>"><% }) %>
      <h2 id="<%= locals.dialogId %>-title" class="whitespace-normal break-words font-serif text-[1.375rem] leading-7 font-bold"><%= locals.dialogTitle %></h2>
      <p id="<%= locals.dialogId %>-text" class="mt-3 whitespace-normal break-words text-sm text-muted"><%= locals.dialogText %></p>
      <div class="mt-8 flex flex-wrap justify-end gap-2">
        <button type="submit" formmethod="dialog" formnovalidate autofocus class="btn btn-secondary">Batal</button>
        <%- include('button', { label: locals.confirmLabel || 'Hapus', variant: 'danger', type: 'submit' }) %>
      </div>
    </form>
  </dialog>
</div>
