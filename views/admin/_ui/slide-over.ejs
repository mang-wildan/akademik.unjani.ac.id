<%#
  Panel samping untuk form pendek (DESIGN §7.7, SPEC FR-ADM-40..46, ARCHITECTURE §2.5).
  Params: editUrl (mis. '/admin/kategori/:id/edit'), newUrl (mis. '/admin/kategori/new').
  - Sertakan sekali per halaman daftar, DI LUAR [data-list-region]: setelah simpan, isi region itu
    dimuat ulang dari URL daftar yang sama dengan ?partial=1.
  - Pemicu: tautan dengan atribut data-slide-over (data-table: slideOver: true; button/page-header
    action: slideOver: true). Tanpa JS tautan membuka halaman form penuh.
  - Form di dalam panel: method POST; [data-panel-title] memberi judul panel; [data-save-form] untuk Ctrl/Cmd+S;
    [data-slide-close] (mis. tautan Batal) menutup panel; data-no-slide = kirim seperti biasa.
  - Respons simpan (?partial=1): JSON { ok: true, message } atau redirect ke daftar dengan ?success=;
    gagal validasi → HTML form (422 atau 200) beserta error.
%>
<div x-data="slideOver" data-edit-url="<%= locals.editUrl %>" data-new-url="<%= locals.newUrl %>" x-on:click.document="intercept" x-on:popstate.window="popstate" x-on:beforeunload.window="beforeUnload">
  <dialog x-ref="panel" x-on:keydown.escape="escape" x-on:cancel="cancel" x-on:close="nativeClose" x-on:click="backdrop" aria-labelledby="slide-over-title" class="slide-over">
    <div class="flex h-full flex-col">
      <div class="flex h-14 shrink-0 items-center gap-2 border-b border-line pr-2 pl-4 lg:h-12">
        <h2 id="slide-over-title" class="min-w-0 flex-1 truncate text-md font-semibold" x-text="title"></h2>
        <button type="button" x-on:click="requestClose" aria-label="Tutup panel" class="btn btn-icon text-muted"><%- icon('close', 'size-5') %></button>
      </div>

      <div x-show="confirming" x-cloak role="alert" class="flex flex-wrap items-center gap-2 border-b border-line bg-warning-soft px-4 py-2">
        <p class="flex-1 text-sm font-medium text-warning">Perubahan belum disimpan.</p>
        <button type="button" x-ref="discard" x-on:click="discard" class="btn btn-ghost text-danger">Buang perubahan</button>
        <button type="button" x-on:click="keepEditing" class="btn btn-secondary">Lanjut mengedit</button>
      </div>

      <div x-show="error" x-cloak role="alert" class="flex items-start gap-2 border-b border-line bg-danger-soft px-4 py-2 text-sm text-danger">
        <%- icon('error', 'size-5 mt-0.5') %>
        <p class="flex-1" x-text="error"></p>
        <a x-show="loadFailed" x-bind:href="href" class="shrink-0 font-medium underline">Buka di halaman penuh</a>
      </div>

      <div x-show="loading" x-cloak class="space-y-5 p-4" aria-hidden="true">
        <% [1, 2, 3].forEach(() => { %>
          <div class="space-y-2"><div class="h-4 w-1/3 animate-pulse rounded-control bg-sunken"></div><div class="h-11 animate-pulse rounded-control bg-sunken lg:h-8"></div></div>
        <% }) %>
      </div>

      <div x-ref="body" class="min-h-0 flex-1 overflow-y-auto" x-on:submit="submit" x-on:input="markDirty" x-on:change="markDirty" x-on:click="bodyClick"></div>
    </div>
  </dialog>
  <template x-ref="toastTemplate"><%- include('toast', { success: 'Tersimpan' }) %></template>
</div>
