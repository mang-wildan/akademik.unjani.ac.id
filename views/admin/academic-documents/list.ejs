<%# Daftar dokumen akademik — FR-M-06. %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold">Dokumen Akademik</h1>
    <p class="text-muted">Kelola dokumen PDF yang tampil di halaman Dokumen Akademik.</p>
  </div>
  <a href="/admin/academic-documents/new" class="btn btn-primary"><%- icon('add') %>Tambah Dokumen</a>
</div>

<div class="mb-4 grid grid-cols-2 gap-3">
  <%- include('../../components/stat-tile', { statLabel: 'Total Dokumen', statValue: formatAngka(counts.total), statIcon: 'description' }) %>
  <%- include('../../components/stat-tile', { statLabel: 'Disematkan', statValue: formatAngka(counts.totalPinned), statIcon: 'keep' }) %>
</div>

<div class="card">
  <% if (!items.length) { %>
    <div class="p-6">
      <%- include('../../components/empty-state', { emptyIcon: 'description', emptyTitle: 'Belum ada dokumen akademik', emptyAction: { label: 'Tambah Dokumen', href: '/admin/academic-documents/new' } }) %>
    </div>
  <% } else { %>
  <table class="data-table data-table--stack">
    <caption class="sr-only">Daftar dokumen akademik</caption>
    <thead><tr><th scope="col">Nama</th><th scope="col">Kategori</th><th scope="col">Ukuran</th><th scope="col">Diperbarui</th><th scope="col"><span class="sr-only">Aksi</span></th></tr></thead>
    <tbody>
      <% items.forEach(item => { %>
        <tr>
          <td data-label="Nama">
            <span class="flex items-center gap-1 font-medium">
              <% if (item.pinned) { %><%- icon('keep', 'size-4 text-accent shrink-0') %><% } %>
              <span class="line-clamp-1"><%= item.name %></span>
            </span>
          </td>
          <td data-label="Kategori"><% if (item.kategori) { %><span class="badge badge-info"><%= item.kategori.nama %></span><% } else { %><span class="text-muted">—</span><% } %></td>
          <td data-label="Ukuran"><%= item.fileSize ? formatUkuranFile(item.fileSize) : '—' %></td>
          <td data-label="Diperbarui"><%= formatTanggal(item.updatedAt) %></td>
          <td data-label="Aksi">
            <div class="flex items-center gap-1 md:justify-end">
              <a href="/admin/academic-documents/<%= item._id %>/edit" class="btn btn-secondary px-3" aria-label="Ubah <%= item.name %>"><%- icon('edit') %>Ubah</a>
              <div class="relative" x-data="disclosure" x-on:click.outside="close" x-on:keydown.escape="closeAndFocus">
                <button type="button" class="btn-icon" x-ref="trigger" x-on:click="toggle" x-bind:aria-expanded="open" aria-haspopup="true" aria-label="Aksi lain untuk <%= item.name %>"><%- icon('more_vert') %></button>
                <div x-show="open" x-cloak class="menu-enter absolute right-0 z-10 mt-1 w-48 rounded-card border border-line bg-surface p-2 shadow-raised">
                  <form action="/admin/academic-documents/<%= item._id %>/pin" method="POST">
                    <button type="submit" class="flex min-h-11 w-full items-center gap-2 rounded-control px-3 text-left text-sm font-medium text-ink hover:bg-sunken"><%- icon('keep', 'size-5') %><%= item.pinned ? 'Lepas sematan' : 'Sematkan' %></button>
                  </form>
                  <button type="button" class="flex min-h-11 w-full items-center gap-2 rounded-control px-3 text-sm font-medium text-danger hover:bg-danger-soft" data-dialog-open="hapus-<%= item._id %>"><%- icon('delete', 'size-5') %>Hapus</button>
                </div>
              </div>
            </div>
            <%- include('../../components/confirm-dialog', {
              dialogId: `hapus-${item._id}`, dialogTitle: `Hapus dokumen?`,
              dialogText: `"${item.name}" akan dihapus permanen dan tidak bisa dikembalikan.`,
              action: `/admin/academic-documents/${item._id}/delete`, confirmLabel: 'Hapus',
            }) %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
