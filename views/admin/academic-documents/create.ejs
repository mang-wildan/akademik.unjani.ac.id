<!doctype html>
<html
  lang="en"
  class="layout-navbar-fixed layout-menu-fixed layout-compact"
  dir="ltr"
  data-skin="default"
  data-bs-theme="light"
  data-assets-path="/assets/"
  data-template="vertical-menu-template">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || 'Tambah Dokumen Akademik' %></title>
  <link rel="icon" type="image/x-icon" href="/assets/img/favicon/favicon.ico" />
  <link rel="stylesheet" href="/assets/vendor/fonts/iconify-icons.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/node-waves/node-waves.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
  <link rel="stylesheet" href="/assets/vendor/css/core.css" />
  <link rel="stylesheet" href="/assets/css/demo.css" />
  <script src="/assets/vendor/js/helpers.js"></script>
  <script src="/assets/js/config.js"></script>
  <style>
    .upload-zone {
      transition: all 0.25s ease;
      background-color: #f8fafb;
      cursor: pointer;
    }
    .upload-zone:hover {
      background-color: #eef6f3;
      border-color: var(--bs-primary) !important;
    }
    .cover-preview {
      object-fit: cover;
      width: 100%;
      height: 100%;
    }
  </style>
</head>

<body>
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <%- include("../../partials/menu") %>
      <div class="layout-page">
        <%- include("../../partials/navbar") %>
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
              <div>
                <h4 class="fw-bold mb-0">Tambah Dokumen Akademik</h4>
                <p class="text-muted mb-0">Unggah cover gambar dan file PDF dokumen.</p>
              </div>
              <a class="btn btn-label-secondary" href="/admin/academic-documents">
                <span class="iconify me-1" data-icon="ri:arrow-left-line"></span> Kembali
              </a>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <div class="d-flex align-items-center">
                <span class="iconify me-2 fs-4" data-icon="ri:error-warning-fill"></span>
                <span><%= error %></span>
              </div>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <% } %>

            <form method="POST" action="/admin/academic-documents" enctype="multipart/form-data" data-disable-submit>
              <div class="row g-4">
                <div class="col-lg-8">
                  <div class="card shadow-sm h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                      <h5 class="mb-0 card-title">Informasi Dokumen</h5>
                      <small class="text-muted"><span class="text-danger">*</span> Wajib diisi</small>
                    </div>
                    <div class="card-body">
                      <div class="mb-4">
                        <label class="form-label fw-medium" for="nameInput">Nama Dokumen <span class="text-danger">*</span></label>
                        <input type="text" id="nameInput" name="name" class="form-control" required
                          placeholder="Contoh: Panduan Akademik 2026"
                          value="<%= values && values.name ? values.name : '' %>" />
                      </div>
                      <div class="mb-4">
                        <label class="form-label fw-medium" for="ketInput">Keterangan</label>
                        <textarea id="ketInput" name="keterangan" rows="3" class="form-control" placeholder="Ringkasan singkat..."><%= values && values.keterangan ? values.keterangan : '' %></textarea>
                      </div>
                      <div class="mb-4">
                        <div class="form-check form-switch">
                          <input class="form-check-input" type="checkbox" id="pinSwitch" name="pinned" value="true" <%= values && values.pinned ? 'checked' : '' %>>
                          <label class="form-check-label fw-semibold" for="pinSwitch">Pin Dokumen</label>
                          <div class="text-muted small">Maksimal 4 dokumen bisa di-pin. Gunakan untuk menyorot dokumen penting.</div>
                        </div>
                      </div>
                      <div class="mb-4">
                        <label class="form-label fw-medium" for="pdfInput">File PDF <span class="text-danger">*</span></label>
                        <input type="file" name="file" id="pdfInput" accept="application/pdf" class="form-control" required />
                        <div class="form-text">Unggah file PDF resmi. Maks disarankan &lt; 10MB.</div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="col-lg-4">
                  <div class="card shadow-sm h-100">
                    <div class="card-header">
                      <h5 class="mb-0 card-title">Cover Dokumen</h5>
                    </div>
                    <div class="card-body">
                      <input type="file" name="cover" id="coverInput" accept="image/png,image/jpg,image/jpeg" class="d-none" required />

                      <label for="coverInput" class="upload-zone d-block border border-2 border-dashed rounded-3 p-2 text-center position-relative" style="min-height: 280px;">
                        <div id="coverPlaceholder" class="d-flex flex-column align-items-center justify-content-center h-100 py-5"
                          style="display:<%= values && values.cover ? 'none !important' : 'flex' %>;">
                          <div class="bg-label-primary rounded p-3 mb-3">
                            <span class="iconify fs-1 text-primary" data-icon="ri:image-add-line"></span>
                          </div>
                          <h6 class="mb-1">Klik untuk upload cover</h6>
                          <small class="text-muted">Format: JPG/PNG. Rasio 3:4 disarankan.</small>
                        </div>

                        <div id="previewContainer" class="position-absolute top-0 start-0 w-100 h-100 p-2"
                          style="display:<%= values && values.cover ? 'block' : 'none' %>;">
                          <img id="coverPreview" src="<%= values && values.cover ? values.cover : '' %>" alt="Preview cover" class="cover-preview rounded-2 shadow-sm" />
                          <button type="button" id="btnRemoveCover" class="btn btn-sm btn-icon btn-danger position-absolute top-0 end-0 m-3 shadow">
                            <span class="iconify" data-icon="ri:close-line"></span>
                          </button>
                        </div>
                      </label>
                      <div class="form-text text-center mt-2">Pastikan cover jelas dan representatif.</div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="row mt-4">
                <div class="col-12">
                  <div class="card shadow-sm">
                    <div class="card-body d-flex justify-content-end gap-3">
                      <a href="/admin/academic-documents" class="btn btn-label-secondary">Batal</a>
                      <button type="submit" class="btn btn-primary px-4">
                        <span class="iconify me-1" data-icon="ri:save-line"></span> Simpan
                      </button>
                    </div>
                  </div>
                </div>
              </div>

            </form>
          </div>
          <div class="content-backdrop fade"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="layout-overlay layout-menu-toggle"></div>
  <div class="drag-target"></div>

  <script src="/assets/vendor/libs/jquery/jquery.js"></script>
  <script src="/assets/vendor/libs/popper/popper.js"></script>
  <script src="/assets/vendor/js/bootstrap.js"></script>
  <script src="/assets/vendor/libs/node-waves/node-waves.js"></script>
  <script src="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
  <script src="/assets/vendor/js/menu.js"></script>
  <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
  <script src="/assets/js/main.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const coverInput = document.getElementById('coverInput');
      const coverPreview = document.getElementById('coverPreview');
      const coverPlaceholder = document.getElementById('coverPlaceholder');
      const previewContainer = document.getElementById('previewContainer');
      const btnRemoveCover = document.getElementById('btnRemoveCover');

      if (coverInput) {
        coverInput.addEventListener('change', (e) => {
          const [file] = e.target.files;
          if (file) {
            coverPreview.src = URL.createObjectURL(file);
            previewContainer.style.display = 'block';
            coverPlaceholder.style.setProperty('display', 'none', 'important');
          }
        });

        btnRemoveCover.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          coverInput.value = '';
          coverPreview.src = '';
          previewContainer.style.display = 'none';
          coverPlaceholder.style.setProperty('display', 'flex', 'important');
        });
      }
    });
  </script>
</body>

</html>
