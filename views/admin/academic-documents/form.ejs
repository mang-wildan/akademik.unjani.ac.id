<div class="mb-6">
  <a href="/admin/academic-documents" class="mb-2 inline-flex min-h-6 items-center gap-1 text-sm font-medium text-muted hover:text-ink"><%- icon('arrow_back', 'size-4') %>Kembali ke Dokumen Akademik</a>
  <h1 class="text-2xl font-bold"><%= mode === 'edit' ? 'Ubah Dokumen Akademik' : 'Tambah Dokumen Akademik' %></h1>
</div>

<% if (errors._form) { %>
  <div class="mb-6"><%- include('../../components/alert', { alertTone: 'danger', alertTitle: 'Gagal menyimpan', alertText: errors._form }) %></div>
<% } %>

<form method="POST" action="/admin/academic-documents<%= mode === 'edit' ? `/${item._id}` : '' %>" enctype="multipart/form-data" class="card card-body grid gap-5 md:grid-cols-2">
  <div class="md:col-span-2">
    <%- include('../../components/form-field', { name: 'name', label: 'Judul Dokumen', required: true, value: values.name, error: errors.name }) %>
  </div>
  <%- include('../../components/form-field', {
    name: 'kategori', label: 'Kategori', type: 'select', required: true, value: values.kategori && String(values.kategori._id || values.kategori), error: errors.kategori,
    placeholder: 'Pilih kategori', options: kategoriList.map(k => ({ value: k._id, label: k.nama })),
  }) %>
  <div class="flex min-h-11 items-center gap-2">
    <input type="checkbox" id="f-pinned" name="pinned" value="on" <%= values.pinned ? 'checked' : '' %> class="size-6 shrink-0 rounded border-control text-primary focus:ring-primary">
    <label for="f-pinned" class="text-sm font-medium">Sematkan di Beranda <span class="text-muted">(maks. 4)</span></label>
  </div>
  <div class="md:col-span-2">
    <%- include('../../components/form-field', { name: 'keterangan', label: 'Keterangan', type: 'textarea', value: values.keterangan, error: errors.keterangan, help: 'Opsional.' }) %>
  </div>
  <div class="md:col-span-2">
    <%- include('../../components/file-upload', {
      name: 'file', label: 'File (PDF)', accept: 'application/pdf', error: errors.file,
      limitText: 'PDF, maks. 10 MB.', current: (mode === 'edit' && item.file) ? { label: 'File saat ini', href: item.file } : null,
    }) %>
  </div>
  <div class="flex justify-end gap-2 border-t border-line pt-5 md:col-span-2">
    <a href="/admin/academic-documents" class="btn btn-secondary">Batal</a>
    <button type="submit" class="btn btn-primary">Simpan</button>
  </div>
</form>
