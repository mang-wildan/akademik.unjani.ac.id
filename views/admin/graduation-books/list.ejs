<%# Daftar buku wisuda — FR-M-07b. %>
<%- include('../../components/page-header', { admin: true, heading: 'Buku Wisuda', lead: 'Kelola buku wisuda per periode dan tahun.', breadcrumb: [{ label: 'Buku Wisuda' }], actions: [{ label: 'Tambah Buku Wisuda', href: '/admin/graduation-books/new', icon: 'add' }] }) %>

<div class="card">
  <% if (!items.length) { %>
    <div class="p-6">
      <%- include('../../components/empty-state', { emptyIcon: 'school', emptyTitle: 'Belum ada buku wisuda', emptyAction: { label: 'Tambah Buku Wisuda', href: '/admin/graduation-books/new' } }) %>
    </div>
  <% } else { %>
  <table class="data-table data-table--stack">
    <caption class="sr-only">Daftar buku wisuda</caption>
    <thead><tr><th scope="col">Sampul</th><th scope="col">Judul</th><th scope="col">Periode</th><th scope="col">Tahun</th><th scope="col"><span class="sr-only">Aksi</span></th></tr></thead>
    <tbody>
      <% items.forEach(item => { %>
        <tr>
          <td data-label="Sampul"><img src="<%= item.cover %>" alt="" class="h-16 w-12 shrink-0 rounded-control border border-line object-cover"></td>
          <td data-label="Judul"><span class="line-clamp-1 font-medium"><%= item.title %></span></td>
          <td data-label="Periode"><%= item.periode %></td>
          <td data-label="Tahun"><%= item.year %></td>
          <td data-label="Aksi">
            <div class="flex items-center gap-1 md:justify-end">
              <a href="/admin/graduation-books/<%= item._id %>/edit" class="btn btn-secondary px-3" aria-label="Ubah <%= item.title %>"><%- icon('edit') %>Ubah</a>
              <button type="button" class="btn-icon text-danger hover:bg-danger-soft" data-dialog-open="hapus-<%= item._id %>" aria-label="Hapus <%= item.title %>"><%- icon('delete') %></button>
            </div>
            <%- include('../../components/confirm-dialog', {
              dialogId: `hapus-${item._id}`, dialogTitle: 'Hapus buku wisuda?',
              dialogText: `"${item.title}" akan dihapus permanen dan tidak bisa dikembalikan.`,
              action: `/admin/graduation-books/${item._id}/delete`, confirmLabel: 'Hapus',
            }) %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
