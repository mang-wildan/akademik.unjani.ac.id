<%- include('../../components/page-header', { admin: true, heading: mode === 'edit' ? 'Ubah Buku Wisuda' : 'Tambah Buku Wisuda', breadcrumb: [{ label: 'Buku Wisuda', href: '/admin/graduation-books' }, { label: mode === 'edit' ? 'Ubah Buku Wisuda' : 'Tambah Buku Wisuda' }] }) %>

<form method="POST" action="/admin/graduation-books<%= mode === 'edit' ? `/${item._id}` : '' %>" enctype="multipart/form-data" class="card card-body grid gap-5 md:grid-cols-2">
  <div class="md:col-span-2">
    <%- include('../../components/form-field', { name: 'title', label: 'Judul', required: true, value: values.title, error: errors.title }) %>
  </div>
  <%- include('../../components/form-field', {
    name: 'periode', label: 'Periode', type: 'select', required: true, value: values.periode, error: errors.periode,
    options: [{ value: 'I', label: 'Periode I' }, { value: 'II', label: 'Periode II' }, { value: 'III', label: 'Periode III' }],
  }) %>
  <%- include('../../components/form-field', { name: 'year', label: 'Tahun', type: 'number', required: true, value: values.year, error: errors.year, min: 1950, max: 2100 }) %>
  <%- include('../../components/file-upload', {
    name: 'file', label: 'File (PDF)', accept: 'application/pdf', error: errors.file,
    limitText: 'PDF, maks. 10 MB.', current: (mode === 'edit' && item.src) ? { label: 'File saat ini', href: item.src } : null,
  }) %>
  <%- include('../../components/file-upload', {
    name: 'cover', label: 'Gambar Sampul', accept: 'image/png,image/jpeg,image/webp', error: errors.cover,
    limitText: 'JPG/PNG/WEBP, maks. 5 MB.', current: (mode === 'edit' && item.cover) ? { label: 'Sampul saat ini', href: item.cover } : null,
  }) %>
  <div class="flex justify-end gap-2 border-t border-line pt-5 md:col-span-2">
    <a href="/admin/graduation-books" class="btn btn-secondary">Batal</a>
    <button type="submit" class="btn btn-primary">Simpan</button>
  </div>
</form>
