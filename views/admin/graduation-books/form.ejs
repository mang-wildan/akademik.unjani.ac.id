<% const heading = mode === 'edit' ? 'Ubah Buku Wisuda' : 'Tambah Buku Wisuda'; %>
<% if (!locals.partial) { %><%- include('../_ui/page-header', { heading }) %><% } %>
<form method="POST" action="/admin/graduation-books<%= mode === 'edit' ? `/${item._id}` : '' %>" enctype="multipart/form-data" data-save-form data-panel-title="<%= heading %>" x-data="dirtyGuard" x-on:input="mark" x-on:change="mark" x-on:submit="submitted" x-on:beforeunload.window="beforeUnload" class="<%= locals.partial ? '' : 'max-w-form rounded-card border border-line bg-surface' %>">
<div class="space-y-5 p-4">
<%- include('../_ui/error-summary', { errors }) %>
  <div class="md:col-span-2">
    <%- include('../_ui/field', { name: 'title', label: 'Judul', required: true, value: values.title, error: errors.title }) %>
  </div>
  <%- include('../_ui/field', {
    name: 'periode', label: 'Periode', type: 'select', required: true, value: values.periode, error: errors.periode,
    options: [{ value: 'I', label: 'Periode I' }, { value: 'II', label: 'Periode II' }, { value: 'III', label: 'Periode III' }],
  }) %>
  <%- include('../_ui/field', { name: 'year', label: 'Tahun', type: 'number', required: true, value: values.year, error: errors.year, min: 1950, max: 2100 }) %>
  <%- include('../_ui/upload-field', {
    name: 'file', label: 'File (PDF)', accept: 'application/pdf', error: errors.file,
    limitText: 'PDF, maks. 10 MB.', current: (mode === 'edit' && item.src) ? { label: 'File saat ini', href: item.src } : null,
  }) %>
  <%- include('../_ui/upload-field', {
    name: 'cover', label: 'Gambar Sampul', accept: 'image/png,image/jpeg,image/webp', error: errors.cover,
    limitText: 'JPG/PNG/WEBP, maks. 5 MB.', current: (mode === 'edit' && item.cover) ? { label: 'Sampul saat ini', href: item.cover } : null,
  }) %>
</div>
  <div class="form-actions<%= locals.partial ? '' : ' max-lg:bottom-[calc(4rem+env(safe-area-inset-bottom))]' %>">
    <a href="/admin/graduation-books" data-slide-close class="btn btn-secondary">Batal</a>
    <%- include('../_ui/button', { label: 'Simpan', type: 'submit', buttonIcon: 'check' }) %>
  </div>
</form>
