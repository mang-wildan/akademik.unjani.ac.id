<!doctype html>
<html
  lang="id"
  class="layout-navbar-fixed layout-menu-fixed layout-compact"
  dir="ltr"
  data-skin="default"
  data-bs-theme="light"
  data-assets-path="/assets/"
  data-template="vertical-menu-template">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || 'Profil Akademik' %></title>
  <link rel="icon" type="image/x-icon" href="/assets/img/favicon/favicon.ico" />
  <link rel="stylesheet" href="/assets/vendor/fonts/iconify-icons.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/node-waves/node-waves.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
  <link rel="stylesheet" href="/assets/vendor/css/core.css" />
  <link rel="stylesheet" href="/assets/css/demo.css" />
  <script src="/assets/vendor/js/helpers.js"></script>
  <script src="/assets/js/config.js"></script>
  <style>
    .hero-card {
      background: linear-gradient(135deg, #065f46 0%, #047857 55%, #14532d 100%);
      color: #ecfdf5;
      border: none;
      box-shadow: 0 16px 34px rgba(20, 83, 45, 0.24);
    }
    .meta-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 11px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.14);
      border: 1px solid rgba(255, 255, 255, 0.22);
      font-weight: 600;
      color: #ecfdf5;
    }
    .value-card {
      border: 1px solid var(--bs-border-color);
      border-radius: 16px;
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
    }
    .list-bullet li {
      margin-bottom: 0.5rem;
    }
    .list-bullet li:last-child {
      margin-bottom: 0;
    }
  </style>
</head>
<body>
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <%- include("../../partials/menu") %>
      <div class="layout-page">
        <%- include("../../partials/navbar") %>
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">
            <%
              const misi = Array.isArray(values && values.misi) ? values.misi : [];
              const tugas = Array.isArray(values && values.tugas) ? values.tugas : [];
              const fungsi = Array.isArray(values && values.fungsi) ? values.fungsi : [];
            %>

            <div class="card hero-card mb-4">
              <div class="card-body d-flex flex-column flex-lg-row align-items-start align-items-lg-center gap-3">
                <div class="flex-grow-1">
                  <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="meta-chip"><span class="iconify" data-icon="ri:article-line"></span> Profil Landing</span>
                    <span class="meta-chip"><span class="iconify" data-icon="ri:time-line"></span> <%= lastUpdatedLabel || '-' %></span>
                  </div>
                  <h4 class="mb-1 text-white">Konten Profil Akademik</h4>
                  <p class="mb-0 text-white-75">Kelola ringkasan, visi, misi, tugas, fungsi, dan kontak layanan pada halaman publik <code class="text-white">/profil</code>.</p>
                </div>
                <div class="d-flex gap-2">
                  <a href="/admin/profil-akademik/edit" class="btn btn-light text-success fw-semibold">
                    <span class="iconify me-1" data-icon="ri:edit-2-line"></span>Edit Konten
                  </a>
                </div>
              </div>
            </div>

            <% if (success) { %>
              <div class="alert alert-success alert-dismissible fade show" role="alert">
                <span class="iconify me-1" data-icon="ri:checkbox-circle-line"></span><%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
              </div>
            <% } %>

            <div class="row g-4">
              <div class="col-12">
                <div class="card value-card">
                  <div class="card-header">
                    <h5 class="mb-0">Informasi Inti</h5>
                  </div>
                  <div class="card-body">
                    <div class="mb-3">
                      <div class="text-muted small mb-1">Judul Halaman</div>
                      <div class="fw-semibold"><%= (values && values.judulHalaman) || '-' %></div>
                    </div>
                    <div class="mb-3">
                      <div class="text-muted small mb-1">Ringkasan</div>
                      <div><%= (values && values.ringkasan) || '-' %></div>
                    </div>
                    <div>
                      <div class="text-muted small mb-1">Visi</div>
                      <div><%= (values && values.visi) || '-' %></div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-lg-4">
                <div class="card value-card h-100">
                  <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">Misi</h6>
                    <span class="badge bg-label-primary"><%= misi.length %> Butir</span>
                  </div>
                  <div class="card-body">
                    <ul class="list-bullet ps-3 mb-0">
                      <% if (misi.length) { %>
                        <% misi.forEach(function(item){ %>
                          <li><%= item %></li>
                        <% }); %>
                      <% } else { %>
                        <li>-</li>
                      <% } %>
                    </ul>
                  </div>
                </div>
              </div>
              <div class="col-lg-4">
                <div class="card value-card h-100">
                  <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">Tugas</h6>
                    <span class="badge bg-label-success"><%= tugas.length %> Butir</span>
                  </div>
                  <div class="card-body">
                    <ul class="list-bullet ps-3 mb-0">
                      <% if (tugas.length) { %>
                        <% tugas.forEach(function(item){ %>
                          <li><%= item %></li>
                        <% }); %>
                      <% } else { %>
                        <li>-</li>
                      <% } %>
                    </ul>
                  </div>
                </div>
              </div>
              <div class="col-lg-4">
                <div class="card value-card h-100">
                  <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">Fungsi</h6>
                    <span class="badge bg-label-warning"><%= fungsi.length %> Butir</span>
                  </div>
                  <div class="card-body">
                    <ul class="list-bullet ps-3 mb-0">
                      <% if (fungsi.length) { %>
                        <% fungsi.forEach(function(item){ %>
                          <li><%= item %></li>
                        <% }); %>
                      <% } else { %>
                        <li>-</li>
                      <% } %>
                    </ul>
                  </div>
                </div>
              </div>

              <div class="col-12">
                <div class="card value-card">
                  <div class="card-header">
                    <h5 class="mb-0">Kontak Layanan</h5>
                  </div>
                  <div class="card-body">
                    <div class="row g-3">
                      <div class="col-md-6">
                        <div class="text-muted small mb-1">Email</div>
                        <div class="fw-semibold"><%= (values && values.kontakEmail) || '-' %></div>
                      </div>
                      <div class="col-md-6">
                        <div class="text-muted small mb-1">Telepon</div>
                        <div class="fw-semibold"><%= (values && values.kontakTelepon) || '-' %></div>
                      </div>
                      <div class="col-md-8">
                        <div class="text-muted small mb-1">Alamat Layanan</div>
                        <div class="fw-semibold"><%= (values && values.alamatLayanan) || '-' %></div>
                      </div>
                      <div class="col-md-4">
                        <div class="text-muted small mb-1">Jam Layanan</div>
                        <div class="fw-semibold"><%= (values && values.jamLayanan) || '-' %></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="content-backdrop fade"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="layout-overlay layout-menu-toggle"></div>
  <div class="drag-target"></div>
  <script src="/assets/vendor/libs/jquery/jquery.js"></script>
  <script src="/assets/vendor/libs/popper/popper.js"></script>
  <script src="/assets/vendor/js/bootstrap.js"></script>
  <script src="/assets/vendor/libs/node-waves/node-waves.js"></script>
  <script src="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
  <script src="/assets/vendor/js/menu.js"></script>
  <script src="/assets/js/main.js"></script>
</body>
</html>
