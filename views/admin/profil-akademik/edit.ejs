<%# Profil Bidang Akademik -- dokumen singleton, satu halaman lihat+ubah. FR-M-10b. %>
<div class="mb-6">
  <h1 class="text-2xl font-bold">Profil Bidang Akademik</h1>
  <p class="text-muted">Terakhir diperbarui <%= formatTanggal(lastUpdatedAt, { long: true }) %>.</p>
</div>

<form method="POST" action="/admin/profil-akademik" class="card card-body grid gap-5">
  <%- include('../../components/form-field', { name: 'judulHalaman', label: 'Judul Halaman', required: true, value: values.judulHalaman, error: errors.judulHalaman }) %>
  <%- include('../../components/form-field', { name: 'ringkasan', label: 'Ringkasan', type: 'textarea', required: true, value: values.ringkasan, error: errors.ringkasan, rows: 6, help: '300-1200 karakter.' }) %>
  <%- include('../../components/form-field', { name: 'visi', label: 'Visi', type: 'textarea', required: true, value: values.visi, error: errors.visi, rows: 3, help: '80-500 karakter.' }) %>

  <div class="grid gap-5 md:grid-cols-3">
    <%- include('../../components/form-field', { name: 'misi', label: 'Misi', type: 'textarea', required: true, value: values.misi, error: errors.misi, rows: 5, help: 'Satu butir per baris.' }) %>
    <%- include('../../components/form-field', { name: 'tugas', label: 'Tugas', type: 'textarea', required: true, value: values.tugas, error: errors.tugas, rows: 5, help: 'Satu butir per baris.' }) %>
    <%- include('../../components/form-field', { name: 'fungsi', label: 'Fungsi', type: 'textarea', required: true, value: values.fungsi, error: errors.fungsi, rows: 5, help: 'Satu butir per baris.' }) %>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    <%- include('../../components/form-field', { name: 'kontakEmail', label: 'Email Kontak', type: 'email', value: values.kontakEmail, error: errors.kontakEmail, help: 'Opsional.' }) %>
    <%- include('../../components/form-field', { name: 'kontakTelepon', label: 'Telepon Kontak', value: values.kontakTelepon, error: errors.kontakTelepon, help: 'Opsional.' }) %>
    <%- include('../../components/form-field', { name: 'alamatLayanan', label: 'Alamat Layanan', value: values.alamatLayanan, error: errors.alamatLayanan, help: 'Opsional.' }) %>
    <%- include('../../components/form-field', { name: 'jamLayanan', label: 'Jam Layanan', value: values.jamLayanan, error: errors.jamLayanan, placeholder: 'Senin-Jumat, 08.00-15.30 WIB' }) %>
  </div>

  <div class="flex justify-end border-t border-line pt-5">
    <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
  </div>
</form>
