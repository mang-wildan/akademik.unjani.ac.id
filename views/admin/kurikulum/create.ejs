<!doctype html>
<html lang="en" class="layout-navbar-fixed layout-menu-fixed layout-compact" dir="ltr" data-bs-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tambah Kurikulum</title>
    <link rel="icon" type="image/x-icon" href="/assets/img/favicon/favicon.ico" />
    <link rel="stylesheet" href="/assets/vendor/fonts/iconify-icons.css" />
    <link rel="stylesheet" href="/assets/vendor/libs/node-waves/node-waves.css" />
    <link rel="stylesheet" href="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="/assets/vendor/css/core.css" />
    <link rel="stylesheet" href="/assets/css/demo.css" />
    <script src="/assets/vendor/js/helpers.js"></script>
    <script src="/assets/js/config.js"></script>
  </head>
  <body>
    <div class="layout-wrapper layout-content-navbar">
      <div class="layout-container">
        <%- include("../../partials/menu") %>
        <div class="layout-page">
          <%- include("../../partials/navbar") %>
          <div class="content-wrapper">
            <div class="container-xxl flex-grow-1 container-p-y">
              <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                  <h4 class="mb-1">Tambah Kurikulum</h4>
                  <p class="text-muted mb-0">Isi data kurikulum beserta cover (JPG/PNG).</p>
                </div>
                <a href="/admin/kurikulum" class="btn btn-light border"><i class="ri ri-arrow-left-line me-1"></i>Kembali</a>
              </div>

              <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger"><%= error %></div>
              <% } %>

              <div class="card shadow-sm">
                <div class="card-body">
                  <form action="/admin/kurikulum" method="POST" enctype="multipart/form-data" class="row g-4" data-disable-submit>
                    <div class="col-md-6">
                      <label class="form-label">Nama Kurikulum</label>
                      <input type="text" name="nama" class="form-control" value="<%= values.nama || '' %>" required>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Program Studi</label>
                      <input type="text" name="programStudi" class="form-control" value="<%= values.programStudi || '' %>" required>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Fakultas</label>
                      <input type="text" name="fakultas" class="form-control" value="<%= values.fakultas || '' %>" required>
                    </div>
                    <div class="col-md-3">
                      <label class="form-label">Tahun</label>
                      <input type="text" name="tahun" class="form-control" value="<%= values.tahun || '' %>" placeholder="2025/2026 atau 2025" required>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Cover (JPG/PNG)</label>
                      <input type="file" name="cover" accept="image/jpeg,image/png,image/jpg" class="form-control" required>
                      <small class="text-muted">Unggah gambar sampul kurikulum.</small>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">File Kurikulum (PDF)</label>
                      <input type="file" name="file" accept="application/pdf" class="form-control" required>
                      <small class="text-muted">Unggah dokumen kurikulum dalam format PDF.</small>
                    </div>
                    <div class="col-12">
                      <button type="submit" class="btn btn-primary"><i class="ri ri-save-line me-1"></i>Simpan</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
            <div class="content-backdrop fade"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="layout-overlay layout-menu-toggle"></div>
    <div class="drag-target"></div>

    <script src="/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="/assets/vendor/libs/popper/popper.js"></script>
    <script src="/assets/vendor/js/bootstrap.js"></script>
    <script src="/assets/vendor/libs/node-waves/node-waves.js"></script>
    <script src="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="/assets/vendor/js/menu.js"></script>
    <script src="/assets/js/main.js"></script>
  </body>
</html>
