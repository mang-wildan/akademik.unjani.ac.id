<%# Daftar kurikulum per program studi — FR-M-05. %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold">Kurikulum</h1>
    <p class="text-muted">Kelola dokumen kurikulum per program studi dan tahun.</p>
  </div>
  <a href="/admin/kurikulum/new" class="btn btn-primary"><%- icon('add') %>Tambah Kurikulum</a>
</div>

<div class="card">
  <% if (!items.length) { %>
    <div class="p-6">
      <%- include('../../components/empty-state', { emptyIcon: 'menu_book', emptyTitle: 'Belum ada kurikulum', emptyAction: { label: 'Tambah Kurikulum', href: '/admin/kurikulum/new' } }) %>
    </div>
  <% } else { %>
  <table class="data-table data-table--stack">
    <caption class="sr-only">Daftar kurikulum</caption>
    <thead><tr><th scope="col">Program Studi</th><th scope="col">Fakultas</th><th scope="col">Tahun</th><th scope="col"><span class="sr-only">Aksi</span></th></tr></thead>
    <tbody>
      <% items.forEach(item => { %>
        <tr>
          <td data-label="Program Studi"><span class="font-medium"><%= item.prodi ? item.prodi.nama : (item.programStudi || '—') %></span></td>
          <td data-label="Fakultas"><%= item.prodi && item.prodi.fakultas ? item.prodi.fakultas.nama : (item.fakultas || '—') %></td>
          <td data-label="Tahun"><%= item.tahun %></td>
          <td data-label="Aksi">
            <div class="flex items-center gap-1 md:justify-end">
              <a href="/admin/kurikulum/<%= item._id %>/edit" class="btn btn-secondary px-3" aria-label="Ubah kurikulum <%= item.tahun %>"><%- icon('edit') %>Ubah</a>
              <button type="button" class="btn-icon text-danger hover:bg-danger-soft" data-dialog-open="hapus-<%= item._id %>" aria-label="Hapus kurikulum"><%- icon('delete') %></button>
            </div>
            <%- include('../../components/confirm-dialog', {
              dialogId: `hapus-${item._id}`, dialogTitle: 'Hapus kurikulum?',
              dialogText: 'Dokumen kurikulum ini akan dihapus permanen dan tidak bisa dikembalikan.',
              action: `/admin/kurikulum/${item._id}/delete`, confirmLabel: 'Hapus',
            }) %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
