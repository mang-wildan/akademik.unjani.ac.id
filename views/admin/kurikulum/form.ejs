<%- include('../../components/page-header', { admin: true, heading: mode === 'edit' ? 'Ubah Kurikulum' : 'Tambah Kurikulum', breadcrumb: [{ label: 'Kurikulum', href: '/admin/kurikulum' }, { label: mode === 'edit' ? 'Ubah Kurikulum' : 'Tambah Kurikulum' }] }) %>

<form method="POST" action="/admin/kurikulum<%= mode === 'edit' ? `/${item._id}` : '' %>" enctype="multipart/form-data" class="card card-body grid max-w-xl gap-5">
  <%- include('../../components/form-field', {
    name: 'prodi', label: 'Program Studi', type: 'select', required: true, value: values.prodi && String(values.prodi._id || values.prodi), error: errors.prodi,
    placeholder: 'Pilih program studi', options: prodiList.map(p => ({ value: p._id, label: p.labelFakultas })),
  }) %>
  <%- include('../../components/form-field', {
    name: 'tahun', label: 'Tahun Kurikulum', required: true, value: values.tahun, error: errors.tahun, placeholder: '2025/2026', help: 'Ditulis seperti 2021 atau 2025/2026.',
  }) %>
  <%- include('../../components/file-upload', {
    name: 'file', label: 'File Kurikulum (PDF)', accept: 'application/pdf', error: errors.file,
    limitText: 'PDF, maks. 10 MB.', current: (mode === 'edit' && item.file) ? { label: 'File saat ini', href: item.file } : null,
  }) %>
  <div class="flex justify-end gap-2 border-t border-line pt-5">
    <a href="/admin/kurikulum" class="btn btn-secondary">Batal</a>
    <button type="submit" class="btn btn-primary">Simpan</button>
  </div>
</form>
