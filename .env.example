# Di server produksi wajib "production" (menyembunyikan detail error, cookie secure).
NODE_ENV=development
PORT=8000
MONGO_URI=mongodb://localhost:27017/your-db-name
# Opsional. Isi bila koneksi mongodb+srv:// gagal dengan "querySrv ECONNREFUSED"
# (resolver DNS lokal menolak query SRV), mis. DNS_SERVERS=8.8.8.8,1.1.1.1
DNS_SERVERS=
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1h
# reCAPTCHA v2 (checkbox). Setelah 2x gagal per email dalam 15 menit; 10x gagal per IP/email diblokir 1 jam.
RECAPTCHA_SITE_KEY=your_recaptcha_v2_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_v2_secret_key
# Kosongkan jika aplikasi diakses langsung. Isi jumlah proxy (mis. 1 untuk Nginx)
# jika berjalan di belakang reverse proxy, agar IP pengunjung terbaca benar.
TRUST_PROXY=
# Alamat publik situs. Wajib di produksi jika reverse proxy tidak meneruskan
# header Host, agar proteksi CSRF (cek Origin) tidak menolak form yang sah.
APP_ORIGIN=

# Asisten Akademik (chatbot). Kosongkan GEMINI_API_KEY untuk menonaktifkan widget.
# Kunci gratis: https://aistudio.google.com -> Get API key. Jangan pernah di-commit.
GEMINI_API_KEY=
# Opsional. Bawaan: gemini-flash-lite-latest
GEMINI_MODEL=
# Opsional. Bawaan: 10 pesan per jam per IP dan 150 pesan per hari untuk seluruh situs.
CHAT_IP_LIMIT=
CHAT_DAILY_LIMIT=
