{
  "name": "baa.unjani.ac.id",
  "version": "0.0.1",
  "description": "Aplikasi Bidang Akademik UNJANI",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "build:assets": "node scripts/build-assets.js",
    "build:css": "tailwindcss -i assets/css/app.css -o public/css/app.css --minify",
    "build:css:admin": "tailwindcss -i assets/css/admin.css -o public/css/admin.css --minify",
    "build:manifest": "node scripts/build-manifest.js",
    "build": "npm run build:assets && npm run build:css && npm run build:css:admin && npm run build:manifest",
    "dev:css": "tailwindcss -i assets/css/app.css -o public/css/app.css --watch",
    "migrate": "node scripts/migrate"
  },
  "keywords": [
    "express",
    "mongoose",
    "jwt",
    "ejs",
    "bcrypt",
    "template"
  ],
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@alpinejs/csp": "^3.17.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/crimson-text": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@fontsource/ubuntu-mono": "^5.3.0",
    "@material-symbols/svg-400": "^0.47.5",
    "@tailwindcss/cli": "^4.3.3",
    "nodemon": "^3.1.4",
    "simple-icons": "^16.34.0",
    "tailwindcss": "^4.3.3"
  }
}
